  "platform_customizations": {
    "custom_css": [
      "/* Make variant groups (Size, Color, etc.) sit side by side instead of stacked */.variant-picker__form {display: flex; flex-direction: row; flex-wrap: wrap; gap: var(--gap-md);}",
      " /* Prevent variant groups from stretching tall when in a row */.variant-picker__form {align-items: flex-start; /* stop them stretching */}",
      " /* Let each option group wrap neatly */.variant-option {flex: 0 0 auto; /* keep natural width & height */}",
      " /* Make variant pills wide enough for up to 15 characters */.variant-option__button-label {flex: 0 0 auto !important; /* stop squishing */ min-width: 15ch; /* fits ~15 characters */ max-width: 100%; /* prevent overflow */ padding: 8px 16px; /* extra breathing room */ white-space: nowrap; /* keep text on one line */}"
    ]
  }
