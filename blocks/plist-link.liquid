{%- comment -%}
  A product list's header link: bold words beside a round holographic coin with an arrow (the
  Popular categories coin, assets/base.css .oce-disk). Links to its own URL, or else the list's
  collection. Pointing at it nudges the arrow on and sweeps a glint across the coin once.
{%- endcomment -%}
{%- liquid
  assign link_url = block.settings.link
  if link_url == blank
    assign link_url = closest.collection.url
  endif
-%}
{%- if link_url != blank -%}
  <a class="plist-link" href="{{ link_url }}" {{ block.shopify_attributes }}>
    <span class="plist-link__label">{{ block.settings.label | escape }}</span>
    <span class="plist-link__disk oce-disk" aria-hidden="true">
      {%- render 'gicon', name: 'arrow_forward', size: 18 -%}
    </span>
  </a>
{%- endif -%}

{% stylesheet %}
  .plist-link {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: clamp(12px, 2vw, 18px);
    color: var(--color-foreground);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Big, in the site's heading style */
  .plist-link__label {
    font-family: var(--font-heading--family);
    font-size: clamp(1.625rem, 6vw, 2.75rem);
    font-weight: 750;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .plist-link__disk {
    display: grid;
    flex: none;
    place-items: center;
    width: clamp(44px, 9vw, 60px);
    height: clamp(44px, 9vw, 60px);
    margin-block-end: 6px;
    border-radius: 50%;
    transition: transform 0.25s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  .plist-link__disk svg {
    position: relative;
    width: 55%;
    height: 55%;
    transition: transform 0.25s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  /* The coin's glint: still until pointed at, then one sweep */
  .plist-link .plist-link__disk::after {
    animation: none;
  }

  @media (hover: hover) {
    .plist-link:hover .plist-link__disk {
      transform: translateY(-1px);
    }

    .plist-link:hover .plist-link__disk svg {
      transform: translateX(2px);
    }

    .plist-link:hover .plist-link__disk::after {
      animation: plist-link-glint 0.8s cubic-bezier(0.45, 0, 0.25, 1) 0.1s 1 both;
    }
  }

  .plist-link:active .plist-link__disk {
    transform: translateY(2px);
  }

  .plist-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 999px;
  }

  @keyframes plist-link-glint {
    from {
      transform: translateX(-110%);
    }
    to {
      transform: translateX(110%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plist-link__disk,
    .plist-link__disk svg {
      transition: none;
    }

    .plist-link:hover .plist-link__disk::after {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Link with coin arrow",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "See all NEW boots"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Leave empty to link to the section's collection."
    }
  ]
}
{% endschema %}
