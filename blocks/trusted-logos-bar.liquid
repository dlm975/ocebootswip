{% doc %}
  A bold label ("Worn by") with the logos on the same line, scattered and overlapping like stickers
  (best with logos on transparent backgrounds).
  Logos are uploaded via theme editor image pickers (up to 12).
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  /* One line: a bold label, then every logo, still, sized to share the row */
  .tlb-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: {{ block.settings.section_padding | at_least: 14 }}px var(--page-margin, 16px);
    background: {{ block.settings.section_background }};
    box-sizing: border-box;
  }

  .tlb-header-{{ ai_gen_id }} {
    flex: none;
  }

  .tlb-label-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.label_color }};
    font-family: var(--font-heading--family);
    font-size: clamp(1.0625rem, 4.4vw, 1.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .tlb-bar-{{ ai_gen_id }} {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* The logos scattered and overlapping like stickers: each turned and nudged a little, still */
  .tlb-track-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding-block: 6px;
  }

  .tlb-track-{{ ai_gen_id }} img {
    --r: 0deg;
    --y: 0px;
    position: relative;
    display: block;
    flex: 0 1 auto;
    min-width: 0;
    width: auto;
    height: 34px;
    margin-inline-start: -8px;
    object-fit: contain;
    filter: drop-shadow(0 2px 4px rgb(18 18 18 / 0.14)) {{ block.settings.logo_filter | replace: 'none', '' }};
    opacity: {{ block.settings.logo_opacity | divided_by: 100.0 }};
    transform: translateY(var(--y)) rotate(var(--r));
  }

  .tlb-track-{{ ai_gen_id }} img:first-child {
    margin-inline-start: 0;
  }

  .tlb-track-{{ ai_gen_id }} img:nth-child(6n + 1) { --r: -8deg; --y: -4px; z-index: 3; }
  .tlb-track-{{ ai_gen_id }} img:nth-child(6n + 2) { --r: 6deg; --y: 5px; z-index: 5; }
  .tlb-track-{{ ai_gen_id }} img:nth-child(6n + 3) { --r: -4deg; --y: -6px; z-index: 2; }
  .tlb-track-{{ ai_gen_id }} img:nth-child(6n + 4) { --r: 9deg; --y: 3px; z-index: 6; }
  .tlb-track-{{ ai_gen_id }} img:nth-child(6n + 5) { --r: -7deg; --y: 6px; z-index: 4; }
  .tlb-track-{{ ai_gen_id }} img:nth-child(6n) { --r: 5deg; --y: -3px; z-index: 1; }

  /* The second set was only for a scrolling loop */
  .tlb-track-{{ ai_gen_id }} img[aria-hidden="true"] {
    display: none;
  }

  /* Desktop: the label and the logos in one centred row */
  @media screen and (min-width: 750px) {
    .tlb-{{ ai_gen_id }} {
      justify-content: center;
      gap: 40px;
      padding-block: {{ block.settings.section_padding | at_least: 22 }}px;
    }

    .tlb-bar-{{ ai_gen_id }} {
      flex: 0 1 auto;
    }

    .tlb-track-{{ ai_gen_id }} {
      width: auto;
    }

    .tlb-track-{{ ai_gen_id }} img {
      height: {{ block.settings.logo_height | at_least: 44 }}px;
      margin-inline-start: -10px;
    }
  }

  .tlb-empty-{{ ai_gen_id }} {
    margin: 0;
    font-size: 13px;
    color: #64748B;
  }
{% endstyle %}

<div class="tlb-{{ ai_gen_id }}" {{ block.shopify_attributes }}>

  {% if block.settings.heading_text != blank %}
    <div class="tlb-header-{{ ai_gen_id }}">
      <p class="tlb-label-{{ ai_gen_id }}">{{ block.settings.heading_text }}</p>
    </div>
  {% endif %}

  <div class="tlb-bar-{{ ai_gen_id }}">
    {% liquid
      assign has_logos = false
      for i in (1..12)
        assign logo_key = 'logo_' | append: i
        if block.settings[logo_key] != blank
          assign has_logos = true
          break
        endif
      endfor
    %}

    {% if has_logos %}
      <div class="tlb-track-{{ ai_gen_id }}">
        {% comment %} First pass {% endcomment %}
        {% for i in (1..12) %}
          {% assign logo_key = 'logo_' | append: i %}
          {% if block.settings[logo_key] != blank %}
            <img
              src="{{ block.settings[logo_key] | image_url: width: 400 }}"
              alt=""
              loading="lazy"
            >
          {% endif %}
        {% endfor %}
        {% comment %} Duplicate for seamless loop {% endcomment %}
        {% for i in (1..12) %}
          {% assign logo_key = 'logo_' | append: i %}
          {% if block.settings[logo_key] != blank %}
            <img
              src="{{ block.settings[logo_key] | image_url: width: 400 }}"
              alt=""
              loading="lazy"
              aria-hidden="true"
            >
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p class="tlb-empty-{{ ai_gen_id }}">Add logo images in the theme editor to populate this bar.</p>
    {% endif %}
  </div>

</div>

{% schema %}
{
  "name": "Trusted logos bar",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "Trusted by the Best"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label font size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "header_gap",
      "label": "Gap below label",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Top / bottom padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Scrolling bar"
    },
    {
      "type": "color",
      "id": "bar_background",
      "label": "Bar background",
      "default": "#F1F5F9"
    },
    {
      "type": "color",
      "id": "bar_border_color",
      "label": "Border color",
      "default": "#64748B40"
    },
    {
      "type": "range",
      "id": "bar_padding",
      "label": "Bar vertical padding",
      "min": 6,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Gap between logos",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed (s per loop)",
      "min": 5,
      "max": 60,
      "step": 5,
      "default": 25
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "select",
      "id": "logo_filter",
      "label": "Logo colour style",
      "options": [
        { "value": "none", "label": "Full colour" },
        { "value": "grayscale(100%)", "label": "Grayscale" },
        { "value": "brightness(0)", "label": "Black" },
        { "value": "brightness(0) invert(1)", "label": "White" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Logos (upload up to 12)"
    },
    { "type": "image_picker", "id": "logo_1",  "label": "Logo 1"  },
    { "type": "image_picker", "id": "logo_2",  "label": "Logo 2"  },
    { "type": "image_picker", "id": "logo_3",  "label": "Logo 3"  },
    { "type": "image_picker", "id": "logo_4",  "label": "Logo 4"  },
    { "type": "image_picker", "id": "logo_5",  "label": "Logo 5"  },
    { "type": "image_picker", "id": "logo_6",  "label": "Logo 6"  },
    { "type": "image_picker", "id": "logo_7",  "label": "Logo 7"  },
    { "type": "image_picker", "id": "logo_8",  "label": "Logo 8"  },
    { "type": "image_picker", "id": "logo_9",  "label": "Logo 9"  },
    { "type": "image_picker", "id": "logo_10", "label": "Logo 10" },
    { "type": "image_picker", "id": "logo_11", "label": "Logo 11" },
    { "type": "image_picker", "id": "logo_12", "label": "Logo 12" }
  ],
  "presets": [
    { "name": "Trusted logos bar" }
  ]
}
{% endschema %}
