{%- liquid
  assign handle_text = block.settings.handle | strip
  assign has_handle = false
  if handle_text != blank
    assign has_handle = true
  endif
-%}

{%- if has_handle or request.design_mode or request.visual_preview_mode -%}
  <div
    id="pdp-ig-{{ block.id }}"
    class="pdp-ig"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.link != blank -%}
      <a class="pdp-ig__inner" href="{{ block.settings.link }}" target="_blank" rel="noopener">
    {%- else -%}
      <span class="pdp-ig__inner">
    {%- endif -%}

      {%- if block.settings.avatar != blank -%}
        <img
          class="pdp-ig__avatar"
          src="{{ block.settings.avatar | image_url: width: 96 }}"
          alt=""
          width="48"
          height="48"
          loading="lazy"
          decoding="async"
        >
      {%- endif -%}

      <span class="pdp-ig__handle">
        {%- unless handle_text contains '@' -%}@{%- endunless -%}
        {{- handle_text | default: 'yourhandle' -}}
      </span>

      {%- if block.settings.verified -%}
        <svg class="pdp-ig__badge" viewBox="0 0 24 24" width="15" height="15" aria-label="Verified" role="img">
          <path fill="{{ block.settings.badge_color | default: '#3897f0' }}" d="M23.5 12c0-1.4-.8-2.6-1.9-3.3.3-1.3-.1-2.7-1.1-3.7s-2.4-1.4-3.7-1.1C16.1 2.8 14.9 2 13.5 2h-3c-1.4 0-2.6.8-3.3 1.9-1.3-.3-2.7.1-3.7 1.1S2.1 7.4 2.4 8.7C1.3 9.4.5 10.6.5 12s.8 2.6 1.9 3.3c-.3 1.3.1 2.7 1.1 3.7s2.4 1.4 3.7 1.1c.7 1.1 1.9 1.9 3.3 1.9h3c1.4 0 2.6-.8 3.3-1.9 1.3.3 2.7-.1 3.7-1.1s1.4-2.4 1.1-3.7c1.1-.7 1.9-1.9 1.9-3.3z"/>
          <path fill="#fff" d="M10.6 16.2l-3.3-3.3 1.5-1.5 1.8 1.8 4.6-4.6 1.5 1.5z"/>
        </svg>
      {%- endif -%}

    {%- if block.settings.link != blank -%}
      </a>
    {%- else -%}
      </span>
    {%- endif -%}
  </div>
{%- endif -%}

<style>
  /* Sits directly above the product images. The script below lifts it into
     the media column — sections and details-column blocks can't render
     there, so it's moved at runtime and revealed once in place. */
  .pdp-ig {
    display: none;
    width: 100%;
    margin-bottom: 10px;
  }

  .pdp-ig--placed {
    display: block;
  }

  .pdp-ig__inner {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    text-decoration: none;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  a.pdp-ig__inner {
    transition: opacity 0.2s cubic-bezier(0.32, 0.72, 0, 1);
  }

  a.pdp-ig__inner:hover {
    opacity: 0.65;
  }

  .pdp-ig__avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .pdp-ig__handle {
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .pdp-ig__badge {
    flex-shrink: 0;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .pdp-ig {
      /* the gallery goes edge-to-edge on mobile, so re-inset just this row */
      padding-inline: var(--page-margin, 16px);
      margin-bottom: 8px;
    }
  }
</style>

<script>
  (function () {
    var el = document.getElementById('pdp-ig-{{ block.id }}');
    if (!el) return;

    function place() {
      var media = document.querySelector('.product-information__media');
      if (!media) {
        /* Not the product page layout we expect — show it where it is
           rather than leaving it permanently hidden. */
        el.classList.add('pdp-ig--placed');
        return;
      }
      if (el.parentElement !== media) media.insertBefore(el, media.firstChild);
      el.classList.add('pdp-ig--placed');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', place, { once: true });
    } else {
      place();
    }
  })();
</script>

{% schema %}
{
  "name": "Instagram Handle",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows a handle with a verified badge directly above the product images. Add it anywhere in the product details column — it moves itself above the gallery."
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@oceboots",
      "info": "The @ is added automatically if you leave it off."
    },
    {
      "type": "checkbox",
      "id": "verified",
      "label": "Show verified badge",
      "default": true
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge colour",
      "default": "#3897f0"
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Profile picture",
      "info": "Optional — shown as a small circle before the handle."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional — links the handle to your Instagram profile."
    }
  ],
  "presets": [
    {
      "name": "Instagram Handle",
      "category": "Product"
    }
  ]
}
{% endschema %}
