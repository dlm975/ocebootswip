{%- doc -%}
  Add-on offer for the product page, styled after the cart drawer's "You
  might also like" pill.

  Two lists are held: a default set, and an alternate set used when the
  product being viewed matches a keyword (adidas out of the box). The
  keyword is a setting rather than hardcoded, so a third brand only needs
  another copy of this block rather than a code change.
{%- enddoc -%}

{%- liquid
  assign p = closest.product
  if p == blank and request.visual_preview_mode
    assign p = collections.all.products.first
  endif

  assign keyword = block.settings.match_keyword | strip | downcase
  assign title_lower = p.title | downcase

  assign picks = block.settings.products
  assign matched = false
  if keyword != blank and title_lower contains keyword
    assign matched = true
    assign picks = block.settings.products_alt
  endif

  assign limit = block.settings.max_items | default: 2
  assign heading = block.settings.heading | default: 'Add to your order'
  assign shown = 0
-%}

{%- capture cards -%}
  {%- for item in picks -%}
    {%- if shown >= limit -%}
      {%- break -%}
    {%- endif -%}

    {%- comment -%}
      Never offer the product already being viewed as an add-on to itself.
    {%- endcomment -%}
    {%- unless item.id == p.id -%}
      {%- liquid
        assign shown = shown | plus: 1
        assign variant = item.selected_or_first_available_variant
        assign can_add = false
        if item.variants.size == 1 and variant.available
          assign can_add = true
        endif

        comment
          The price moved onto the button, so the card no longer needs its
          own price line — which is most of what makes it short.

          money already renders in the active market's presentment
          currency, so the figure follows the region selector on its own.
          The theme's own product-card setting decides whether the code is
          shown beside it, which is the same rule snippets/price.liquid
          applies to any product that is not the one being viewed.
        endcomment
        assign use_code = settings.currency_code_enabled_product_cards

        if item.price_varies
          assign base_price = item.price_min
        else
          assign base_price = item.price
        endif

        if base_price == 0
          assign price_label = block.settings.free_label | default: 'FREE'
        else
          if use_code
            assign price_label = base_price | money_with_currency
          else
            assign price_label = base_price | money
          endif
          if item.price_varies
            assign price_label = price_label | prepend: 'from '
          endif
        endif

        assign show_was = false
        if item.compare_at_price > item.price
          assign show_was = true
          if use_code
            assign was_label = item.compare_at_price | money_with_currency
          else
            assign was_label = item.compare_at_price | money
          endif
        endif
      -%}
      <div class="pa__card">
        <a class="pa__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
          {%- if item.featured_image -%}
            <img
              src="{{ item.featured_image | image_url: width: 160 }}"
              alt=""
              width="60"
              height="60"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}
        </a>

        <div class="pa__info">
          <a class="pa__title" href="{{ item.url }}">{{ item.title }}</a>
        </div>

        {%- capture price_tag -%}
          {%- if show_was -%}
            <s class="pa__was">{{ was_label }}</s>
          {%- endif -%}
          <span class="pa__now">{{ price_label }}</span>
        {%- endcapture -%}

        {%- if can_add -%}
          <button
            type="button"
            class="pa__add"
            data-pa-add
            data-variant-id="{{ variant.id }}"
          >
            <span class="pa__add-label">
              <span aria-hidden="true">+</span> {{ block.settings.button_label | default: 'Add' }}
            </span>
            <span class="pa__sep" aria-hidden="true">-</span>
            {{ price_tag }}
          </button>
        {%- else -%}
          {%- comment -%}
            More than one variant, so a size has to be picked. Adding the
            first one here would quietly put the wrong size in the cart.
          {%- endcomment -%}
          <a class="pa__add" href="{{ item.url }}">
            <span class="pa__add-label">{{ block.settings.choose_label | default: 'Choose' }}</span>
            <span class="pa__sep" aria-hidden="true">-</span>
            {{ price_tag }}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if cards != blank -%}
  <div
    class="pa"
    style="
      --pa-bg: {{ block.settings.background }};
      --pa-fg: {{ block.settings.text_color }};
      --pa-radius: {{ block.settings.radius }}px;
      --pa-card-bg: {{ block.settings.card_background }};
      --pa-card-border: {{ block.settings.card_border }};
      --pa-btn-bg: {{ block.settings.button_background }};
      --pa-btn-fg: {{ block.settings.button_text_color }};
    "
    {{ block.shopify_attributes }}
  >
    <span class="pa__heading">{{ heading }}</span>
    <div class="pa__list">{{ cards }}</div>
  </div>
{%- elsif request.design_mode -%}
  {%- comment -%}
    Editor only. With nothing chosen this renders nothing at all on the
    storefront, which is indistinguishable from it being broken.
  {%- endcomment -%}
  <div class="pa pa--empty">
    <span class="pa__heading">{{ heading }}</span>
    <span class="pa__empty">
      {%- if matched -%}
        This product matches "{{ block.settings.match_keyword }}", so the
        alternate list is used. Pick products under "Products for matching
        titles". This message is only visible here in the editor.
      {%- else -%}
        Pick add-on products in this block's settings. This message is only
        visible here in the editor.
      {%- endif -%}
    </span>
  </div>
{%- endif -%}

<style>
  .pa {
    display: block;
    width: 100%;
    box-sizing: border-box;
    background: var(--pa-bg, #f5f5f5);
    color: var(--pa-fg, #111);
    border-radius: var(--pa-radius, 16px);
    padding: 7px;
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
  }

  .pa__heading {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  /* Side by side rather than the cart's side-scroller: the details column
     is narrow, and two short cards cost roughly half the height that
     stacking them did. */
  .pa__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  /* Thumbnail and title on the top row, the button spanning underneath
     carrying the price. The second row takes the free space and the
     button sits at its bottom, so a card whose title wraps does not
     leave its neighbour's button floating halfway up. */
  .pa__card {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'media info'
      'action action';
    align-items: center;
    gap: 4px 7px;
    padding: 5px;
    border-radius: calc(var(--pa-radius, 16px) - 6px);
    background: var(--pa-card-bg, #fff);
    border: 1px solid var(--pa-card-border, #e6e6e6);
    box-sizing: border-box;
    min-width: 0;
  }

  .pa__media {
    grid-area: media;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    overflow: hidden;
    background: rgb(0 0 0 / 4%);
    display: block;
  }

  .pa__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .pa__info {
    grid-area: info;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  /* Two lines before the price moved out; one now, which is what takes
     the card's top row down to the thumbnail's own height. */
  .pa__title {
    color: inherit;
    font-size: 0.66rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* Price pieces now live inside the button. Showing the currency code
     makes this line noticeably longer, so the shrink order matters: the
     old price gives way first, then the label, and the actual price never
     shrinks or clips. */
  .pa__add-label {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Drops out with the label when the line runs short, so the dash is
     never left dangling against the price. */
  .pa__sep {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    opacity: 0.7;
  }

  .pa__was {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    opacity: 0.6;
    font-weight: 500;
  }

  .pa__now {
    flex: 0 0 auto;
    font-weight: 700;
  }

  /* Set explicitly rather than left to inherit: buttons do not take
     their type from the page, browsers substitute the system UI font.
     That is what kept this one upright while everything around it is
     set in the theme's italic cut. Named here for the anchor variant
     too, so both states match. */
  .pa__add {
    grid-area: action;
    align-self: end;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: 22px;
    padding: 0 7px;
    border: none;
    border-radius: 999px;
    background: var(--pa-btn-bg, #111);
    color: var(--pa-btn-fg, #fff);
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .pa__add:hover {
    opacity: 0.9;
  }

  .pa__add:active {
    transform: scale(0.97);
  }

  .pa__add[disabled] {
    opacity: 0.5;
    cursor: default;
  }

  .pa__empty {
    display: block;
    font-size: 0.74rem;
    line-height: 1.4;
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .pa__add {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    /* Delegated from document and bound once: this block can appear on the
       page more than once, and the product details column is re-rendered
       on every variant change, which would discard a directly-bound
       listener. */
    if (window.__productAddonsBound) return;
    window.__productAddonsBound = true;

    function sectionIds() {
      var ids = [];
      document.querySelectorAll('cart-items-component[data-section-id]').forEach(function (el) {
        var id = el.dataset.sectionId;
        if (id && ids.indexOf(id) === -1) ids.push(id);
      });
      return ids.join(',');
    }

    document.addEventListener('click', function (event) {
      var btn = event.target.closest('[data-pa-add]');
      if (!btn || btn.hasAttribute('disabled')) return;

      btn.setAttribute('disabled', 'disabled');

      var url = (window.Theme && Theme.routes && Theme.routes.cart_add_url) || '/cart/add.js';

      fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          items: [{ id: Number(btn.dataset.variantId), quantity: 1 }],
          sections: sectionIds()
        })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          document.dispatchEvent(
            new CustomEvent('cart:update', {
              bubbles: true,
              detail: { data: { source: 'product-addons', sections: data.sections || null } }
            })
          );

          /* Show the shopper it landed. The drawer is the theme's own
             component, so only ask if it is actually there and openable. */
          var drawer = document.querySelector('cart-drawer-component');
          if (drawer && typeof drawer.open === 'function') drawer.open();

          btn.removeAttribute('disabled');
        })
        .catch(function (error) {
          console.error(error);
          btn.removeAttribute('disabled');
        });
    });
  })();
</script>

{% schema %}
{
  "name": "Add-on Offer",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "A small offer row for the product details column. Shows one set of products normally, and a different set on products whose title matches the keyword below."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Add to your order"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Products to show",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "pcs",
      "default": 2
    },
    {
      "type": "header",
      "content": "Default products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 8,
      "info": "Shown on every product that does not match the keyword."
    },
    {
      "type": "header",
      "content": "Matching products"
    },
    {
      "type": "text",
      "id": "match_keyword",
      "label": "Keyword in the product title",
      "default": "adidas",
      "info": "Not case sensitive. Products whose title contains this word show the alternate list instead."
    },
    {
      "type": "product_list",
      "id": "products_alt",
      "label": "Products for matching titles",
      "limit": 8
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add button text",
      "default": "Add"
    },
    {
      "type": "text",
      "id": "choose_label",
      "label": "Button text when a size must be picked",
      "default": "Choose"
    },
    {
      "type": "text",
      "id": "free_label",
      "label": "Wording for a zero price",
      "default": "FREE",
      "info": "Shown in place of the amount when an add-on costs nothing."
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e6e6e6"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Add-on Offer",
      "category": "Product"
    }
  ]
}
{% endschema %}
