{%- doc -%}
  Add-on offer for the product page, styled after the cart drawer's "You
  might also like" pill.

  Two lists are held: a default set, and an alternate set used when the
  product being viewed matches a keyword (adidas out of the box). The
  keyword is a setting rather than hardcoded, so a third brand only needs
  another copy of this block rather than a code change.
{%- enddoc -%}

{%- liquid
  assign p = closest.product
  if p == blank and request.visual_preview_mode
    assign p = collections.all.products.first
  endif

  assign keyword = block.settings.match_keyword | strip | downcase
  assign title_lower = p.title | downcase
  assign brand_lower = p.metafields.custom.brand.value | downcase

  # Boots only (they have a Size option): no add-ons on the studs or socks themselves
  assign is_boot = false
  for option_name in p.options
    assign option_lower = option_name | downcase
    if option_lower == 'size'
      assign is_boot = true
    endif
  endfor

  # The brand's own list (adidas studs on adidas boots) by the boot's brand, or its title
  assign picks = block.settings.products
  assign matched = false
  if keyword != blank
    if title_lower contains keyword or brand_lower == keyword
      assign matched = true
      assign picks = block.settings.products_alt
    endif
  endif
  if is_boot == false and request.design_mode == false
    assign picks = nil
  endif

  assign limit = block.settings.max_items | default: 2
  assign heading = block.settings.heading | default: 'Add to your order'
  assign shown = 0
-%}

{%- capture cards -%}
  {%- for item in picks -%}
    {%- if shown >= limit -%}
      {%- break -%}
    {%- endif -%}

    {%- comment -%}
      Never offer the product already being viewed as an add-on to itself.
    {%- endcomment -%}
    {%- unless item.id == p.id -%}
      {%- liquid
        assign shown = shown | plus: 1
        assign variant = item.selected_or_first_available_variant
        assign can_add = false
        if item.variants.size == 1 and variant.available
          assign can_add = true
        endif

        comment
          The price moved onto the button, so the card no longer needs its
          own price line — which is most of what makes it short.

          money already renders in the active market's presentment
          currency, so the figure follows the region selector on its own.
          The theme's own product-card setting decides whether the code is
          shown beside it, which is the same rule snippets/price.liquid
          applies to any product that is not the one being viewed.
        endcomment
        assign use_code = settings.currency_code_enabled_product_cards

        if item.price_varies
          assign base_price = item.price_min
        else
          assign base_price = item.price
        endif

        if base_price == 0
          assign price_label = block.settings.free_label | default: 'FREE'
        else
          if use_code
            assign price_label = base_price | money_with_currency
          else
            assign price_label = base_price | money
          endif
          if item.price_varies
            assign price_label = price_label | prepend: 'from '
          endif
        endif

        assign show_was = false
        if item.compare_at_price > item.price
          assign show_was = true
          if use_code
            assign was_label = item.compare_at_price | money_with_currency
          else
            assign was_label = item.compare_at_price | money
          endif
        endif
      -%}
      <div class="pa__card">
        <a class="pa__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
          {%- if item.featured_image -%}
            <img
              src="{{ item.featured_image | image_url: width: 320 }}"
              alt=""
              width="60"
              height="60"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}
        </a>

        <div class="pa__info">
          <a class="pa__title" href="{{ item.url }}">{{ item.title }}</a>
        </div>

        {%- capture price_tag -%}
          {%- if show_was -%}
            <s class="pa__was">{{ was_label }}</s>
          {%- endif -%}
          <span class="pa__now">{{ price_label }}</span>
        {%- endcapture -%}

        {%- if can_add -%}
          <button
            type="button"
            class="pa__add"
            data-pa-add
            data-variant-id="{{ variant.id }}"
          >
            <span class="pa__add-label">
              <span aria-hidden="true">+</span> {{ block.settings.button_label | default: 'Add' }}
            </span>
            <span class="pa__sep" aria-hidden="true">-</span>
            {{ price_tag }}
          </button>
        {%- else -%}
          {%- comment -%}
            More than one variant, so a size has to be picked. Adding the
            first one here would quietly put the wrong size in the cart.
          {%- endcomment -%}
          <a class="pa__add" href="{{ item.url }}">
            <span class="pa__add-label">{{ block.settings.choose_label | default: 'Choose' }}</span>
            <span class="pa__sep" aria-hidden="true">-</span>
            {{ price_tag }}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if cards != blank -%}
  <div
    class="pa"
    style="
      --pa-bg: {{ block.settings.background }};
      --pa-fg: {{ block.settings.text_color }};
      --pa-radius: {{ block.settings.radius }}px;
      --pa-card-bg: {{ block.settings.card_background }};
      --pa-card-border: {{ block.settings.card_border }};
      --pa-btn-bg: {{ block.settings.button_background }};
      --pa-btn-fg: {{ block.settings.button_text_color }};
    "
    {{ block.shopify_attributes }}
  >
    <span class="pa__heading">
      <span>{{ heading }}</span>
      {%- comment -%} An iridescent plus, raised like the size keys {%- endcomment -%}
      <svg class="pa__plus" viewBox="0 0 34 34" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="pa-irid-{{ block.id }}" x1="3" y1="3" x2="31" y2="31" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#ff9fd6"/>
            <stop offset="0.28" stop-color="#c7a8ff"/>
            <stop offset="0.52" stop-color="#8fd0ff"/>
            <stop offset="0.76" stop-color="#8ef2d4"/>
            <stop offset="1" stop-color="#fff0a0"/>
          </linearGradient>
          <linearGradient id="pa-gloss-{{ block.id }}" x1="0" y1="4" x2="0" y2="20" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0.9"/>
            <stop offset="1" stop-color="#ffffff" stop-opacity="0"/>
          </linearGradient>
        </defs>
        {%- comment -%} Each layer drawn twice: a black stroke, then the fill over its inner half, so only the outer edge shows {%- endcomment -%}
        <g transform="translate(-1.5 2.5)" fill="none" stroke="#121212" stroke-width="3.2">
          <rect x="13" y="4" width="8" height="26" rx="3"/>
          <rect x="4" y="13" width="26" height="8" rx="3"/>
        </g>
        <g class="pa__plus-side" transform="translate(-1.5 2.5)" fill="#a9a3cf">
          <rect x="13" y="4" width="8" height="26" rx="3"/>
          <rect x="4" y="13" width="26" height="8" rx="3"/>
        </g>
        <g fill="none" stroke="#121212" stroke-width="3.2">
          <rect x="13" y="4" width="8" height="26" rx="3"/>
          <rect x="4" y="13" width="26" height="8" rx="3"/>
        </g>
        <g fill="url(#pa-irid-{{ block.id }})">
          <rect x="13" y="4" width="8" height="26" rx="3"/>
          <rect x="4" y="13" width="26" height="8" rx="3"/>
        </g>
        <g fill="url(#pa-gloss-{{ block.id }})">
          <rect x="14" y="5" width="6" height="11" rx="2.5"/>
          <rect x="5" y="14" width="24" height="3.5" rx="1.75"/>
        </g>
      </svg>
    </span>
    <div class="pa__list">{{ cards }}</div>
  </div>

  {%- comment -%}
    After this boot is added to the cart (the main button or the floating bar), these add-ons are
    offered once more in a popup before the cart opens.
  {%- endcomment -%}
  <dialog class="pa-pop" data-pa-pop data-product-id="{{ p.id }}" aria-labelledby="pa-pop-title-{{ block.id }}">
    <div class="pa-pop__scrim" data-pa-pop-close></div>
    <div class="pa-pop__card" data-pa-pop-card>
      <p class="pa-pop__done">
        {%- render 'gicon', name: 'check', class: 'pa-pop__tick', size: 16 -%}
        <span>In your cart</span>
      </p>
      <h2 class="pa-pop__title" id="pa-pop-title-{{ block.id }}">Add these also?</h2>
      <div class="pa__list pa-pop__list">{{ cards }}</div>
      <div class="pa-pop__actions">
        <button type="button" class="pa-pop__skip" data-pa-pop-close>No thanks</button>
        <button type="button" class="pa-pop__go" data-pa-pop-close>Continue</button>
      </div>
    </div>
  </dialog>
{%- elsif request.design_mode -%}
  {%- comment -%}
    Editor only. With nothing chosen this renders nothing at all on the
    storefront, which is indistinguishable from it being broken.
  {%- endcomment -%}
  <div class="pa pa--empty">
    <span class="pa__heading">{{ heading }}</span>
    <span class="pa__empty">
      {%- if matched -%}
        This product matches "{{ block.settings.match_keyword }}", so the
        alternate list is used. Pick products under "Products for matching
        titles". This message is only visible here in the editor.
      {%- else -%}
        Pick add-on products in this block's settings. This message is only
        visible here in the editor.
      {%- endif -%}
    </span>
  </div>
{%- endif -%}

<style>
  /* The site's newer look: no grey panel; a bold heading over raised off-white cards (like the size
     keys), each with the holographic + Add key */
  .pa {
    display: block;
    width: 100%;
    box-sizing: border-box;
    background: none;
    color: var(--pa-fg, #121212);
    padding: 0;
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
  }

  /* "Add-ons:" in big bold type */
  .pa__heading {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .pa__plus {
    flex: none;
    width: 0.95em;
    height: 0.95em;
    overflow: visible;
    filter: drop-shadow(-1px 3px 4px rgb(90 80 160 / 0.28));
    transition: filter 0.6s ease;
  }

  @media (hover: hover) {
    .pa:hover .pa__plus {
      filter: drop-shadow(-1px 3px 4px rgb(90 80 160 / 0.28)) hue-rotate(60deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pa__plus {
      transition: none;
    }
  }

  /* ---- The popup after adding the boot to the cart ---- */
  .pa-pop {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 16px;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .pa-pop[open] {
    display: grid;
    place-items: center;
  }

  .pa-pop::backdrop {
    background: transparent;
  }

  .pa-pop__scrim {
    position: absolute;
    inset: 0;
    background: rgb(255 255 255 / 0.6);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .pa-pop__card {
    position: relative;
    width: min(440px, 100%);
    padding: 20px 18px 16px;
    border-radius: 24px;
    background: #ffffff;
    color: #121212;
    box-shadow: 0 0 0 1px rgb(18 18 18 / 0.06), 0 24px 60px rgb(18 18 18 / 0.22);
  }

  .pa-pop__done {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 6px;
    color: rgb(18 18 18 / 0.6);
    font-size: 0.8125rem;
    font-weight: 650;
  }

  .pa-pop__tick {
    display: grid;
    flex: none;
    place-items: center;
    width: 18px;
    height: 18px;
    padding: 2px;
    border-radius: 50%;
    background: #25d366;
    color: #ffffff;
  }

  .pa-pop__title {
    margin: 0 0 14px;
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .pa-pop__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
  }

  .pa-pop__skip {
    padding: 8px 2px;
    border: 0;
    background: none;
    color: rgb(18 18 18 / 0.6);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 650;
    cursor: pointer;
  }

  .pa-pop__go {
    height: 44px;
    padding: 0 22px;
    border: 0;
    border-radius: 999px;
    background: #121212;
    color: #ffffff;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
  }

  /* The popup is a 3:4 card (shorter screens shrink it to fit); the add-ons inside are big, one per
     row, filling the space between the heading and the buttons */
  .pa-pop__card {
    display: flex;
    flex-direction: column;
    width: min(420px, 100%, calc((100svh - 32px) * 0.75));
    aspect-ratio: 3 / 4;
    padding: 20px 18px 14px;
    box-sizing: border-box;
  }

  .pa-pop .pa-pop__list {
    flex: 1;
    grid-template-columns: 1fr;
    align-content: center;
    gap: 10px;
  }

  .pa-pop__list .pa__card {
    gap: 10px 14px;
    padding: 12px;
    border-radius: 18px;
  }

  .pa-pop__list .pa__media {
    width: 64px;
    height: 64px;
    border-radius: 12px;
  }

  .pa-pop__list .pa__title {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .pa-pop__list .pa__add {
    min-height: 42px;
    padding: 0 14px;
    font-size: 0.9375rem;
  }

  .pa-pop__actions {
    margin-top: 10px;
  }

  /* An add-on added from the popup: its button shows it */
  .pa__add.is-added {
    pointer-events: none;
    opacity: 0.55;
  }

  /* Side by side rather than the cart's side-scroller: the details column
     is narrow, and two short cards cost roughly half the height that
     stacking them did. */
  .pa__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding-inline-start: 2px;
  }

  /* Thumbnail and title on the top row, the button spanning underneath
     carrying the price. The second row takes the free space and the
     button sits at its bottom, so a card whose title wraps does not
     leave its neighbour's button floating halfway up. */
  .pa__card {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'media info'
      'action action';
    align-items: center;
    gap: 6px 8px;
    margin-block-end: 3px;
    padding: 8px;
    border-radius: 14px;
    background: linear-gradient(180deg, #ffffff 0%, #f7f7f5 100%);
    border: 1px solid #d4d4d8;
    box-shadow:
      inset 0 1px 0 #ffffff,
      -2px 3px 0 #d4d4d8,
      -2px 4px 8px rgb(18 18 18 / 0.06);
    box-sizing: border-box;
    min-width: 0;
  }

  .pa__media {
    grid-area: media;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 0 0 1px rgb(18 18 18 / 0.06);
    display: block;
  }

  .pa__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .pa__info {
    grid-area: info;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  /* Two lines before the price moved out; one now, which is what takes
     the card's top row down to the thumbnail's own height. */
  .pa__title {
    color: inherit;
    font-size: 0.66rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* Price pieces now live inside the button. Showing the currency code
     makes this line noticeably longer, so the shrink order matters: the
     old price gives way first, then the label, and the actual price never
     shrinks or clips. */
  .pa__add-label {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Drops out with the label when the line runs short, so the dash is
     never left dangling against the price. */
  .pa__sep {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    opacity: 0.7;
  }

  .pa__was {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    opacity: 0.6;
    font-weight: 500;
  }

  .pa__now {
    flex: 0 0 auto;
    font-weight: 600;
  }

  /* Set explicitly rather than left to inherit: buttons do not take
     their type from the page, browsers substitute the system UI font.
     That is what kept this one upright while everything around it is
     set in the theme's italic cut. Named here for the anchor variant
     too, so both states match. */
  .pa__add {
    grid-area: action;
    align-self: end;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: 22px;
    padding: 0 7px;
    border: none;
    border-radius: var(--brand-radius-md);
    background: var(--pa-btn-bg, #121212);
    color: var(--pa-btn-fg, #fff);
    font-size: 0.66rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .pa__add:hover {
    opacity: 0.9;
  }

  .pa__add:active {
    transform: scale(0.97);
  }

  .pa__add[disabled] {
    opacity: 0.5;
    cursor: default;
  }

  .pa__empty {
    display: block;
    font-size: 0.74rem;
    line-height: 1.4;
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .pa__add {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    /* Delegated from document and bound once: this block can appear on the
       page more than once, and the product details column is re-rendered
       on every variant change, which would discard a directly-bound
       listener. */
    if (window.__productAddonsBound) return;
    window.__productAddonsBound = true;

    function sectionIds() {
      var ids = [];
      document.querySelectorAll('cart-items-component[data-section-id]').forEach(function (el) {
        var id = el.dataset.sectionId;
        if (id && ids.indexOf(id) === -1) ids.push(id);
      });
      return ids.join(',');
    }

    document.addEventListener('click', function (event) {
      var btn = event.target.closest('[data-pa-add]');
      if (!btn || btn.hasAttribute('disabled')) return;

      btn.setAttribute('disabled', 'disabled');

      var url = (window.Theme && Theme.routes && Theme.routes.cart_add_url) || '/cart/add.js';

      fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          items: [{ id: Number(btn.dataset.variantId), quantity: 1 }],
          sections: sectionIds()
        })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          document.dispatchEvent(
            new CustomEvent('cart:update', {
              bubbles: true,
              detail: { data: { source: 'product-addons', sections: data.sections || null } }
            })
          );

          /* In the popup: the button shows it landed, and the cart opens when the popup closes.
             Elsewhere: show the shopper it landed in the drawer (the theme's own component, so
             only ask if it is actually there and openable). */
          if (btn.closest('[data-pa-pop]')) {
            btn.classList.add('is-added');
            var label = btn.querySelector('.pa__add-label');
            if (label) label.textContent = '\u2713 Added';
            return;
          }
          var drawer = document.querySelector('cart-drawer-component');
          if (drawer && typeof drawer.open === 'function') drawer.open();

          btn.removeAttribute('disabled');
        })
        .catch(function (error) {
          console.error(error);
          btn.removeAttribute('disabled');
        });
    });

    /* ---- The popup: offered once a boot from this page lands in the cart ----
       Listening before the cart drawer does (capture), so the drawer waits behind the popup and
       opens as it closes. Once per page. */
    var offered = false;
    var restoreAutoOpen = false;
    var reduced = function () { return window.matchMedia('(prefers-reduced-motion: reduce)').matches; };
    var EASE = 'cubic-bezier(0.3, 0.7, 0.3, 1)';

    document.addEventListener('cart:update', function (event) {
      var data = event.detail && event.detail.data;
      if (offered || !data || data.source !== 'product-form-component' || data.didError) return;
      var pop = document.querySelector('[data-pa-pop]');
      if (!pop || String(data.productId) !== pop.dataset.productId) return;
      if (!pop.querySelector('[data-pa-add], .pa__add')) return;
      offered = true;
      var drawer = document.querySelector('cart-drawer-component');
      if (drawer && drawer.hasAttribute('auto-open')) {
        drawer.removeAttribute('auto-open');
        restoreAutoOpen = true;
      }
      pop.showModal();
      if (!reduced()) {
        var card = pop.querySelector('[data-pa-pop-card]');
        var scrim = pop.querySelector('.pa-pop__scrim');
        scrim.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, easing: 'linear' });
        card.animate(
          [{ opacity: 0, transform: 'translateY(16px) scale(0.96)' }, { opacity: 1, transform: 'none' }],
          { duration: 550, easing: EASE }
        );
      }
    }, true);

    function closePop(pop) {
      if (!pop.open || pop.dataset.closing) return;
      pop.dataset.closing = '1';
      var finish = function () {
        pop.close();
        delete pop.dataset.closing;
        var drawer = document.querySelector('cart-drawer-component');
        if (drawer) {
          if (restoreAutoOpen) drawer.setAttribute('auto-open', '');
          restoreAutoOpen = false;
          if (typeof drawer.open === 'function') drawer.open();
        }
      };
      if (reduced()) return finish();
      var card = pop.querySelector('[data-pa-pop-card]');
      var scrim = pop.querySelector('.pa-pop__scrim');
      scrim.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 220, easing: 'linear', fill: 'forwards' });
      card.animate(
        [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateY(8px) scale(0.98)' }],
        { duration: 200, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' }
      ).finished.then(function () {
        finish();
        pop.getAnimations({ subtree: true }).forEach(function (a) { a.cancel(); });
      });
    }

    document.addEventListener('click', function (event) {
      var closer = event.target.closest('[data-pa-pop-close]');
      if (closer) closePop(closer.closest('[data-pa-pop]'));
    });
    document.addEventListener('cancel', function (event) {
      if (event.target.matches && event.target.matches('[data-pa-pop]')) {
        event.preventDefault();
        closePop(event.target);
      }
    }, true);
  })();
</script>

