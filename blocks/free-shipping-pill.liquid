{%- liquid
  assign p = closest.product
  if p == blank and request.visual_preview_mode
    assign p = collections.all.products.first
  endif

  comment
    Merchants pick the products that should NOT carry the pill, so the
    default for a new product is to show it.

    Two lists are consulted: the shared one in Theme settings → Cart,
    which the cart's shipping bar also reads, and this block's own. The
    shared list is the one to maintain — the block list is kept only so
    that existing configurations keep working.
  endcomment
  assign excluded = false

  for item in settings.cart_ship_excluded_products
    if item.id == p.id
      assign excluded = true
      break
    endif
  endfor

  unless excluded
    for item in block.settings.excluded_products
      if item.id == p.id
        assign excluded = true
        break
      endif
    endfor
  endunless

  assign shared_tag = settings.cart_ship_excluded_tag | strip
  if shared_tag != blank and p.tags contains shared_tag
    assign excluded = true
  endif

  assign tag = block.settings.excluded_tag | strip
  if tag != blank and p.tags contains tag
    assign excluded = true
  endif

  assign show = true
  if excluded and request.design_mode == false
    assign show = false
  endif
-%}

{%- if show and block.settings.text != blank -%}
  <span
    id="fsp-{{ block.id }}"
    class="fsp{% if excluded %} fsp--excluded{% endif %}"
    style="--fsp-bg: {{ block.settings.background }}; --fsp-fg: {{ block.settings.text_color }};"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.show_icon -%}
      <span class="fsp__disk oce-disk" aria-hidden="true">
        {%- render 'gicon', name: 'local_shipping', class: 'fsp__icon', size: 14 -%}
      </span>
    {%- endif -%}
    <span class="fsp__text">{{ block.settings.text }}</span>
    {%- if excluded -%}
      <span class="fsp__note"> (hidden on this product)</span>
    {%- endif -%}
  </span>
{%- endif -%}

<style>
  /* Overlaid on the product image, top right. Hidden until the script
     moves it there, so it never flashes beside the price first. */
  media-gallery:has(> .fsp) {
    position: relative;
  }

  /* The site's newer look: frosted glass with a light rim, the truck in a small holographic disk
     (assets/base.css .oce-disk), and bold text */
  .fsp {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 4px 14px 4px 4px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.66);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    backdrop-filter: blur(16px) saturate(180%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.75),
      inset 0 1px 0 rgb(255 255 255 / 0.95),
      0 0 0 1px rgb(18 18 18 / 0.06),
      0 8px 22px rgb(18 18 18 / 0.14);
    color: var(--fsp-fg, #121212);
    font-size: 0.75rem;
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: -0.005em;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .fsp__disk {
    display: grid;
    flex: none;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
  }

  .fsp__disk .fsp__icon {
    position: relative;
    width: 15px;
    height: 15px;
  }

  /* No disk (icon turned off): even padding */
  .fsp:not(:has(.fsp__disk)) {
    padding: 8px 14px;
  }

  .fsp--placed {
    display: inline-flex;
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 5;
    pointer-events: none;
    max-width: calc(100% - 24px);
  }

  @media screen and (min-width: 750px) {
    .fsp--placed {
      top: 16px;
      right: 16px;
      font-size: 0.8125rem;
    }
  }

  /* Only rendered in the theme editor, so a merchant can see the block is
     present but deliberately suppressed on the product being previewed. */
  .fsp--excluded {
    opacity: 0.5;
  }

  .fsp__note {
    font-weight: 500;
  }
</style>

<script>
  (function () {
    var id = 'fsp-{{ block.id }}';
    var pill = document.getElementById(id);
    if (!pill) return;

    function gallery() {
      var media = document.querySelector('.product-information__media');
      return (media && media.querySelector('media-gallery')) || document.querySelector('media-gallery');
    }

    function place() {
      /* A re-render (choosing another size) draws a fresh pill back in the details column and
         redraws the gallery without the one moved there: keep the newest and move it again. */
      var fresh = document.getElementById(id);
      if (fresh && fresh !== pill) {
        if (pill.isConnected) pill.remove();
        pill = fresh;
      }
      var g = gallery();
      if (g && pill.parentElement !== g) g.appendChild(pill);
      /* Revealed either way — without a gallery it still shows where the
         merchant put it rather than vanishing. */
      pill.classList.add('fsp--placed');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', place, { once: true });
    } else {
      place();
    }

    window.addEventListener('load', place);

    /* Put it back the moment the product area is redrawn. Mutation observers run before the
       next paint, so the pill never disappears for a frame. */
    var area = document.querySelector('.product-information') || document.body;
    new MutationObserver(function () {
      var g = gallery();
      var fresh = document.getElementById(id);
      if (!pill.isConnected || (g && pill.parentElement !== g) || (fresh && fresh !== pill)) place();
    }).observe(area, { childList: true, subtree: true });
  })();
</script>

{% schema %}
{
  "name": "Free Shipping Pill",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "A pill overlaid on the top right of the product image. Add it anywhere in the product details column — it moves itself onto the image."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Qualified for free shipping"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Hide on certain products"
    },
    {
      "type": "product_list",
      "id": "excluded_products",
      "label": "Products to hide it on (legacy)",
      "limit": 50,
      "info": "Maintain the list in Theme settings → Cart → Free shipping bar instead — it drives both this pill and the cart's shipping bar. Anything listed here is still hidden as well."
    },
    {
      "type": "text",
      "id": "excluded_tag",
      "label": "Or hide on products with this tag",
      "info": "Optional — useful when more than 50 products need excluding. Case sensitive."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F1F5F9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#121212"
    }
  ],
  "presets": [
    {
      "name": "Free Shipping Pill",
      "category": "Product"
    }
  ]
}
{% endschema %}
