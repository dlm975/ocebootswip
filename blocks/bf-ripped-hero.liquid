{% doc %}
  Black Friday alternate of the landing page hero ("Hero image with button").
  Same tile as the original hero (padding, aspect ratio, radius, shadow), but the
  hero image has a 3D ripped hole torn through it: a jagged torn edge with a white
  paper rim, curled paper flaps folded back over the image, and a drop shadow cast
  into the hole. Inside the hole: "SALE IS LIVE" and a SHOP NOW button.

  The tear is drawn as SVG by the <bf-ripped-hero> element at the tile's real pixel
  size (redrawn on resize, same shape every time via a seeded random). The hole keeps
  the tile's own aspect ratio. Without JS the tile shows the plain sale panel.
{% enddoc %}
{% assign uid = block.id | replace: '_', '' | downcase %}

{% style %}
  .bfrh-{{ uid }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    box-sizing: border-box;
    padding: 20px 35px;
  }

  .bfrh-{{ uid }} .bfrh__tile {
    position: relative;
    width: 100%;
    aspect-ratio: 10 / 11;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    box-shadow: 0 4px 8px rgb(0 0 0 / 0.18), 0 10px 20px rgb(0 0 0 / 0.14);
    container-type: inline-size;
    background: {{ block.settings.hole_color }};
    isolation: isolate;
  }

  @media screen and (min-width: 750px) {
    .bfrh-{{ uid }} .bfrh__tile {
      aspect-ratio: 20 / 9;
    }
  }

  /* What you see through the hole */
  .bfrh-{{ uid }} .bfrh__inside {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 50% at 50% 50%, {{ block.settings.hole_glow_color | color_modify: 'alpha', 0.35 }}, transparent 70%),
      radial-gradient(ellipse 80% 80% at 50% 50%, transparent 40%, rgb(0 0 0 / 0.55) 100%),
      {{ block.settings.hole_color }};
  }

  .bfrh-{{ uid }} .bfrh__paper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .bfrh-{{ uid }} .bfrh__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.2cqw;
    text-align: center;
    pointer-events: none;
  }

  .bfrh-{{ uid }} .bfrh__eyebrow {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: 'Oswald', 'Arial Narrow', Impact, sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    text-indent: 0.22em;
    font-size: clamp(11px, 1.5cqw, 22px);
    opacity: 0.85;
  }

  .bfrh-{{ uid }} .bfrh__heading {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: 'Oswald', 'Arial Narrow', Impact, sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.95;
    letter-spacing: 0.02em;
    font-size: {{ block.settings.heading_size_desktop | divided_by: 10.0 }}cqw;
    text-shadow: 0 0.04em 0.18em rgb(0 0 0 / 0.6);
  }

  .bfrh-{{ uid }} .bfrh__button {
    pointer-events: auto;
    display: inline-block;
    padding: 0.9em 2.2em;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-family: 'Oswald', 'Arial Narrow', Impact, sans-serif;
    font-weight: 700;
    font-size: clamp(14px, 1.45cqw, 22px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.45);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .bfrh-{{ uid }} .bfrh__button:hover,
  .bfrh-{{ uid }} .bfrh__button:focus-visible {
    background: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgb(0 0 0 / 0.55);
  }

  @media screen and (max-width: 749px) {
    .bfrh-{{ uid }} .bfrh__content {
      gap: 4cqw;
    }

    .bfrh-{{ uid }} .bfrh__eyebrow {
      font-size: clamp(10px, 3.2cqw, 16px);
    }

    .bfrh-{{ uid }} .bfrh__heading {
      font-size: {{ block.settings.heading_size_mobile | divided_by: 10.0 }}cqw;
    }

    .bfrh-{{ uid }} .bfrh__button {
      font-size: clamp(13px, 4cqw, 18px);
    }
  }

  /* Rip-open intro: content appears once the hole has torn open */
  .bfrh-{{ uid }}[data-animate] .bfrh__content > * {
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.2, 1.4, 0.4, 1);
  }

  .bfrh-{{ uid }}[data-animate][data-open] .bfrh__content > * {
    opacity: 1;
    transform: none;
  }

  .bfrh-{{ uid }}[data-animate][data-open] .bfrh__heading { transition-delay: 0.05s; }
  .bfrh-{{ uid }}[data-animate][data-open] .bfrh__button { transition-delay: 0.2s; }
{% endstyle %}

<bf-ripped-hero
  class="bfrh-{{ uid }}"
  data-seed="{{ block.settings.seed }}"
  data-hole="{{ block.settings.hole_size }}"
  data-rough="{{ block.settings.roughness }}"
  data-flaps="{{ block.settings.flap_count }}"
  data-image-opacity="{{ block.settings.image_opacity | divided_by: 100.0 }}"
  data-dim="{{ block.settings.overlay_opacity | divided_by: 100.0 }}"
  data-dim-color="{{ block.settings.overlay_color }}"
  {% if block.settings.hero_image %}
    data-image="{{ block.settings.hero_image | image_url: width: 2400 }}"
  {% endif %}
  {% if block.settings.animate and request.design_mode == false %}
    data-animate
  {% endif %}
  {{ block.shopify_attributes }}
>
  <div class="bfrh__tile">
    <div class="bfrh__inside"></div>
    <svg class="bfrh__paper" aria-hidden="true" focusable="false"></svg>
    <div class="bfrh__content">
      {% if block.settings.eyebrow != blank %}
        <p class="bfrh__eyebrow">{{ block.settings.eyebrow }}</p>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h1 class="bfrh__heading">{{ block.settings.heading }}</h1>
      {% endif %}
      {% if block.settings.button_text != blank %}
        <a class="bfrh__button" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">
          {{- block.settings.button_text -}}
        </a>
      {% endif %}
    </div>
  </div>
</bf-ripped-hero>

<script>
  (() => {
    if (customElements.get('bf-ripped-hero')) return;

    const NS = 'http://www.w3.org/2000/svg';
    let uidCounter = 0;

    // Small seeded PRNG so the tear is identical on every load and resize.
    const mulberry32 = (a) => () => {
      a |= 0; a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };

    const el = (name, attrs = {}) => {
      const node = document.createElementNS(NS, name);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
      return node;
    };

    const pathOf = (pts) =>
      'M' + pts.map((p) => p[0].toFixed(1) + ',' + p[1].toFixed(1)).join('L') + 'Z';

    const easeOutBack = (t) => 1 + 2.2 * Math.pow(t - 1, 3) + 1.2 * Math.pow(t - 1, 2);
    const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);

    class BfRippedHero extends HTMLElement {
      connectedCallback() {
        this.tile = this.querySelector('.bfrh__tile');
        this.svg = this.querySelector('.bfrh__paper');
        this.id_ = 'bfrh' + ++uidCounter;
        this.progress = 1;

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.animate_ = this.hasAttribute('data-animate') && !reduce;
        if (!this.animate_) {
          this.removeAttribute('data-animate');
          this.setAttribute('data-open', '');
        } else {
          this.progress = 0;
        }

        this.ro = new ResizeObserver(() => this.build());
        this.ro.observe(this.tile);
        this.build();

        if (this.animate_) {
          this.io = new IntersectionObserver((entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              this.io.disconnect();
              this.play();
            }
          }, { threshold: 0.35 });
          this.io.observe(this.tile);
        }
      }

      disconnectedCallback() {
        this.ro?.disconnect();
        this.io?.disconnect();
        cancelAnimationFrame(this.raf);
      }

      play() {
        const start = performance.now();
        const dur = 1100;
        const step = (now) => {
          const t = Math.min(1, (now - start) / dur);
          this.progress = t;
          this.render();
          if (t > 0.55) this.setAttribute('data-open', '');
          if (t < 1) this.raf = requestAnimationFrame(step);
        };
        this.raf = requestAnimationFrame(step);
      }

      // Builds the tear geometry for the tile's current size.
      build() {
        const W = this.tile.clientWidth;
        const H = this.tile.clientHeight;
        if (!W || !H) return;
        this.W = W; this.H = H;

        const rand = mulberry32(parseInt(this.dataset.seed || '7', 10) * 9973 + 17);
        const holeScale = parseFloat(this.dataset.hole || '70') / 100;
        const rough = parseFloat(this.dataset.rough || '50') / 100;
        const flapCount = parseInt(this.dataset.flaps || '7', 10);

        const cx = W / 2, cy = H / 2;
        const rx = (W * holeScale) / 2, ry = (H * holeScale) / 2;
        const unit = Math.min(W, H);

        // Superellipse outline: same ratio as the tile, soft-cornered like a torn panel.
        const N = Math.max(70, Math.round((rx + ry) / 7));
        const n = 4;
        const base = [];
        for (let i = 0; i < N; i++) {
          const a = (i / N) * Math.PI * 2;
          const c = Math.cos(a), s = Math.sin(a);
          base.push([
            cx + rx * Math.sign(c) * Math.pow(Math.abs(c), 2 / n),
            cy + ry * Math.sign(s) * Math.pow(Math.abs(s), 2 / n),
          ]);
        }

        // Low-frequency wobble + sharp shards along the edge.
        const w1 = rand() * 6.28, w2 = rand() * 6.28;
        const amp = unit * 0.05 * (0.4 + rough);
        const edge = base.map(([x, y], i) => {
          const a = (i / N) * Math.PI * 2;
          const nx = x - cx, ny = y - cy;
          const len = Math.hypot(nx / rx, ny / ry) || 1;
          let d = Math.sin(a * 3 + w1) * 0.35 + Math.sin(a * 7 + w2) * 0.2;
          d += (rand() - 0.5) * 0.9;
          if (i % 2 === 0) d += 0.35 * rough; // alternate in/out -> spiky tear
          d *= amp;
          const ux = nx / len / rx, uy = ny / len / ry;
          const ul = Math.hypot(ux, uy) || 1;
          return [x + (ux / ul) * d, y + (uy / ul) * d];
        });

        // Pick flap spans spread around the hole; each span becomes a straight fold line
        // with a triangular flap folded back over the paper.
        const flaps = [];
        const used = new Array(N).fill(false);
        const spanMin = Math.max(3, Math.round(N * 0.045));
        const spanMax = Math.max(spanMin + 1, Math.round(N * 0.085));
        const offset = Math.floor(rand() * N);
        for (let f = 0; f < flapCount; f++) {
          const span = spanMin + Math.floor(rand() * (spanMax - spanMin + 1));
          const startIdx = (offset + Math.floor((f / flapCount) * N + (rand() - 0.5) * (N / flapCount) * 0.4) + N) % N;
          let ok = true;
          for (let k = -1; k <= span + 1; k++) if (used[(startIdx + k + N) % N]) ok = false;
          if (!ok) continue;
          for (let k = 0; k <= span; k++) used[(startIdx + k) % N] = true;
          flaps.push({ i: startIdx, span });
        }

        // Hole outline (printed surface) with fold lines straightened.
        const isInner = new Array(N).fill(false);
        for (const fl of flaps) for (let k = 1; k < fl.span; k++) isInner[(fl.i + k) % N] = true;
        const holeIdx = [];
        for (let i = 0; i < N; i++) if (!isInner[i]) holeIdx.push(i);

        // White torn rim: paper core showing just inside the printed edge.
        const rimDepth = unit * 0.012 * (0.6 + rough);
        const rimOf = (i) => {
          const [x, y] = edge[i];
          const dx = cx - x, dy = cy - y;
          const l = Math.hypot(dx, dy) || 1;
          const r = rimDepth * (0.4 + rand() * 1.4);
          return [x + (dx / l) * r, y + (dy / l) * r];
        };
        const rimPts = holeIdx.map((i) => (isInner[i] ? edge[i] : rimOf(i)));

        // Flap shapes, in fold-local coordinates.
        const flapGeo = flaps.map((fl) => {
          const A = edge[fl.i];
          const B = edge[(fl.i + fl.span) % N];
          const mx = (A[0] + B[0]) / 2, my = (A[1] + B[1]) / 2;
          const bx = B[0] - A[0], by = B[1] - A[1];
          const bl = Math.hypot(bx, by) || 1;
          // Normal pointing into the hole (towards centre).
          let nx = -by / bl, ny = bx / bl;
          if (nx * (cx - mx) + ny * (cy - my) < 0) { nx = -nx; ny = -ny; }

          // Tip of the torn-away triangle (inside the hole before folding).
          let depth = bl * (0.55 + rand() * 0.45);
          const along = 0.25 + rand() * 0.5;
          // Keep the folded-back tip on the tile.
          const margin = unit * 0.03;
          const outX = -nx, outY = -ny;
          const room = Math.min(
            outX > 0 ? (W - margin - mx) / outX : outX < 0 ? (mx - margin) / -outX : Infinity,
            outY > 0 ? (H - margin - my) / outY : outY < 0 ? (my - margin) / -outY : Infinity,
          );
          depth = Math.max(bl * 0.25, Math.min(depth, room * 0.9));

          // Jagged torn edges of the flap (two sides from A->T and T->B).
          const jag = (P, Q, count) => {
            const pts = [];
            for (let k = 1; k < count; k++) {
              const t = k / count;
              const j = (rand() - 0.5) * depth * 0.18 * (0.5 + rough);
              pts.push([P[0] + (Q[0] - P[0]) * t, P[1] + (Q[1] - P[1]) * t, j]);
            }
            return pts;
          };
          // Local coords: u along fold (0..1 from A to B in px), v = distance from fold.
          const T = [along * bl, depth];
          const side1 = jag([0, 0], T, 4);
          const side2 = jag(T, [bl, 0], 4);
          const local = [[0, 0, 0], ...side1, [T[0], T[1], 0], ...side2, [bl, 0, 0]];
          const curl = 0.08 + rand() * 0.12;
          return { A, ux: bx / bl, uy: by / bl, nx, ny, local, depth, bl, curl };
        });

        this.geo = { edge, holeIdx, rimPts, flapGeo, W, H, cx, cy };
        this.render();
      }

      render() {
        const g = this.geo;
        if (!g) return;
        const { W, H, cx, cy } = g;
        const p = this.progress;
        const grow = this.animate_ ? easeOutBack(Math.min(1, p / 0.7)) : 1;
        const fold = this.animate_ ? easeOutCubic(Math.max(0, Math.min(1, (p - 0.15) / 0.85))) : 1;
        const scalePt = ([x, y]) => [cx + (x - cx) * grow, cy + (y - cy) * grow];

        const svg = this.svg;
        const id = this.id_;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        svg.replaceChildren();

        const img = this.dataset.image;
        const unit = Math.min(W, H);
        const holePts = g.holeIdx.map((i) => scalePt(g.edge[i]));
        const rimPts = g.rimPts.map(scalePt);
        // Drawn past the tile edge so filters never fray the tile's own border.
        const pad = unit * 0.1;
        const frame = `M${-pad},${-pad}H${W + pad}V${H + pad}H${-pad}Z`;

        const defs = el('defs');
        const shadow = el('filter', { id: id + 'sh', x: '-10%', y: '-10%', width: '120%', height: '120%' });
        shadow.append(el('feDropShadow', {
          dx: 0, dy: (unit * 0.012).toFixed(1), stdDeviation: (unit * 0.018).toFixed(1),
          'flood-color': '#000', 'flood-opacity': 0.75,
        }));
        const flapShadow = el('filter', { id: id + 'fs', x: '-30%', y: '-30%', width: '160%', height: '160%' });
        flapShadow.append(el('feDropShadow', {
          dx: (unit * 0.004).toFixed(1), dy: (unit * 0.008).toFixed(1), stdDeviation: (unit * 0.009).toFixed(1),
          'flood-color': '#000', 'flood-opacity': 0.45,
        }));
        // Fibrous look on the torn white rim.
        const rough = el('filter', { id: id + 'rf' });
        rough.append(
          el('feTurbulence', { type: 'fractalNoise', baseFrequency: 0.9, numOctaves: 2, seed: 3, result: 'n' }),
          el('feDisplacementMap', { in: 'SourceGraphic', in2: 'n', scale: (unit * 0.006).toFixed(1) }),
        );
        const edgeBlur = el('filter', { id: id + 'eb', x: '-10%', y: '-10%', width: '120%', height: '120%' });
        edgeBlur.append(el('feGaussianBlur', { stdDeviation: (unit * 0.008).toFixed(1) }));
        const holeClip = el('clipPath', { id: id + 'hc' });
        holeClip.append(el('path', { d: frame + pathOf(holePts), 'clip-rule': 'evenodd' }));
        defs.append(shadow, flapShadow, rough, edgeBlur, holeClip);
        svg.append(defs);

        // Paper (rim + printed image) casting a shadow down into the hole.
        const paper = el('g', { filter: `url(#${id}sh)` });
        paper.append(el('path', {
          d: frame + pathOf(rimPts), 'fill-rule': 'evenodd', fill: '#f4f2ee', filter: `url(#${id}rf)`,
        }));
        const printed = el('g', { 'clip-path': `url(#${id}hc)` });
        printed.append(el('rect', { width: W, height: H, fill: '#1a1a1a' }));
        if (img) {
          printed.append(el('image', {
            href: img, x: 0, y: 0, width: W, height: H,
            preserveAspectRatio: 'xMidYMid slice', opacity: this.dataset.imageOpacity || 1,
          }));
        }
        const dim = parseFloat(this.dataset.dim || '0');
        if (dim > 0) printed.append(el('rect', { width: W, height: H, fill: this.dataset.dimColor || '#000', opacity: dim }));
        // Subtle darkening right at the torn edge where the paper lifts.
        printed.append(el('path', {
          d: pathOf(holePts), fill: 'none', stroke: '#000', 'stroke-opacity': 0.35,
          'stroke-width': (unit * 0.02).toFixed(1), 'stroke-linejoin': 'round',
          filter: `url(#${id}eb)`,
        }));
        paper.append(printed);
        svg.append(paper);

        // Flaps: torn triangles folded back over the paper, showing the white reverse side.
        const theta = Math.PI * (0.5 + 0.5 * fold); // 90deg (edge-on) -> 180deg (flat back)
        g.flapGeo.forEach((f, idx) => {
          const A = scalePt(f.A);
          const ux = f.ux, uy = f.uy;
          const proj = Math.cos(theta); // +1 into hole, -1 folded out over paper
          const pts = f.local.map(([u, v, j]) => {
            const uu = u * grow + j * 0.6;
            const vv = (v + j) * grow;
            // Curl: points further from the fold lift and roll slightly back toward it.
            const curlBack = 1 - f.curl * Math.pow(v / f.depth, 2);
            const vp = vv * proj * curlBack;
            return [A[0] + ux * uu + f.nx * vp, A[1] + uy * uu + f.ny * vp];
          });
          if (Math.abs(proj) < 0.02) return;

          const foldMid = [A[0] + ux * f.bl * grow * 0.5, A[1] + uy * f.bl * grow * 0.5];
          const tipV = f.depth * grow * proj;
          const tip = [foldMid[0] + f.nx * tipV, foldMid[1] + f.ny * tipV];
          const gid = `${id}g${idx}`;
          const grad = el('linearGradient', {
            id: gid, gradientUnits: 'userSpaceOnUse',
            x1: foldMid[0].toFixed(1), y1: foldMid[1].toFixed(1), x2: tip[0].toFixed(1), y2: tip[1].toFixed(1),
          });
          grad.append(
            el('stop', { offset: '0', 'stop-color': '#bdbab4' }),
            el('stop', { offset: '0.18', 'stop-color': '#e9e7e2' }),
            el('stop', { offset: '0.55', 'stop-color': '#ffffff' }),
            el('stop', { offset: '1', 'stop-color': '#dedbd5' }),
          );
          defs.append(grad);

          const flap = el('g', { filter: `url(#${id}fs)` });
          flap.append(el('path', { d: pathOf(pts), fill: `url(#${gid})` }));
          // Crease line along the fold.
          const B = pts[pts.length - 1];
          flap.append(el('path', {
            d: `M${A[0].toFixed(1)},${A[1].toFixed(1)}L${B[0].toFixed(1)},${B[1].toFixed(1)}`,
            stroke: '#8f8b84', 'stroke-opacity': 0.55, 'stroke-width': Math.max(1, unit * 0.0025).toFixed(1),
            'stroke-linecap': 'round',
          }));
          svg.append(flap);
        });
      }
    }

    customElements.define('bf-ripped-hero', BfRippedHero);
  })();
</script>

{% schema %}
{
  "name": "Black Friday ripped hero",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "label": "Image opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Ripped hole"
    },
    {
      "type": "range",
      "id": "hole_size",
