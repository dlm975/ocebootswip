{%- liquid
  assign stars_text = block.settings.text | default: '1000+ HAPPY CUSTOMERS'
-%}

{%- if block.settings.show_stars or stars_text != blank -%}
  <span
    id="psr-{{ block.id }}"
    class="psr{% if block.settings.placement == 'in_place' %} psr--in-place{% endif %}"
    style="--psr-color: {{ block.settings.star_color }}; --psr-fg: {{ block.settings.text_color }}; --psr-size: {{ block.settings.star_size }}px;"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.show_stars -%}
      <span class="psr__stars oce-stars" aria-hidden="true"></span>
    {%- endif -%}

    {%- if stars_text != blank -%}
      <span class="psr__text">{{ stars_text }}</span>
    {%- endif -%}
  </span>
{%- endif -%}

<style>
  /* Hidden until the script lifts it alongside the price — see below. */
  .psr {
    display: none;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    box-sizing: border-box;
  }

  /* Hug the content so it never stretches to the column or grows beside
     the price. */
  .psr--placed {
    display: inline-flex;
    flex: 0 0 auto;
    width: fit-content;
    max-width: 100%;
    align-self: center;
  }

  /* Left where the merchant placed it (Position: where it's placed), e.g. between title and price */
  .psr--in-place.psr--placed {
    align-self: flex-start;
  }

  /* Stars in WhatsApp green (the Star colour setting), bold text */
  .psr__stars {
    --oce-star: var(--psr-size, 13px);
    --oce-star-color: var(--psr-color, #25d366);
  }

  .psr__text {
    color: var(--psr-fg, #121212);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: -0.005em;
    line-height: 1.25;
  }

  /* The price element survives variant changes — only its inner container
     is swapped — so this can sit inside it without being wiped.
     product-price is a custom element with no default layout, so make it a
     row; the price container is a plain div and would otherwise take the
     full line and push this underneath. Wrapping stays on as a safety
     valve for very narrow screens. */
  product-price:has(> .psr) {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 10px;
    row-gap: 4px;
  }

  product-price:has(> .psr) > [ref='priceContainer'] {
    flex: 0 1 auto;
    width: auto;
    min-width: 0;
  }
</style>

<script>
  (function () {
    var el = document.getElementById('psr-{{ block.id }}');
    if (!el) return;

    function findPrice() {
      var scope = document.querySelector('.product-details');
      return (scope && scope.querySelector('product-price')) || document.querySelector('product-price');
    }

    function place() {
      if (el.classList.contains('psr--in-place')) {
        el.classList.add('psr--placed');
        return;
      }
      var price = findPrice();
      if (price && el.parentElement !== price) price.appendChild(el);
      /* Revealed either way — if the price block isn't on the template it
         still shows where the merchant put it rather than vanishing. */
      el.classList.add('psr--placed');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', place, { once: true });
    } else {
      place();
    }

    window.addEventListener('load', place);
    document.addEventListener('variant:update', place);
  })();
</script>

{% schema %}
{
  "name": "Star Rating",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Five stars and a line of social proof, shown beside the product price. Add it anywhere in the product details column — it moves itself next to the price."
    },
    {
      "type": "select",
      "id": "placement",
      "label": "Position",
      "options": [
        {
          "value": "beside_price",
          "label": "Beside the price"
        },
        {
          "value": "in_place",
          "label": "Where it's placed"
        }
      ],
      "default": "beside_price"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show stars",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "1000+ HAPPY CUSTOMERS"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star colour",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size",
      "min": 9,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    }
  ],
  "presets": [
    {
      "name": "Star Rating",
      "category": "Product"
    }
  ]
}
{% endschema %}
