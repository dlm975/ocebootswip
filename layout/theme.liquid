<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- render 'collection-in-stock-default' -%}
 {%- render 'ecom_header' -%}
    {%- render 'stylesheets' -%}

    {%- comment -%} The site icon: the O from the OCEBOOTS wordmark (assets/oce-icon-*.png), in the sizes
      browsers, phones' home screens and search results use {%- endcomment -%}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'oce-icon-32.png' | asset_url }}">
    <link rel="icon" type="image/png" sizes="48x48" href="{{ 'oce-icon-48.png' | asset_url }}">
    <link rel="icon" type="image/png" sizes="96x96" href="{{ 'oce-icon-96.png' | asset_url }}">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ 'oce-icon-192.png' | asset_url }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'oce-icon-180.png' | asset_url }}">
    <meta name="apple-mobile-web-app-title" content="OCEBOOTS">
    <meta name="application-name" content="OCEBOOTS">

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- # Oswald Bold for the BFSALE "% OFF" badge -%}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap">
    {%- # Shrinks sale price lines on product cards to fit one line -%}
    <script src="{{ 'price-fit.js' | asset_url }}" defer></script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer></script>
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'cart-customisation' -%}
    {%- render 'color-schemes' -%}
    {%- render 'brand-typography' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% # theme-check-disable ParserBlockingScript %}
    <script src="{{ 'critical.js' | asset_url }}"></script>
    {% # theme-check-enable ParserBlockingScript %}

    {% render 'search-modal' %}
    {% render 'custom-search-overlay' %}
    {%- if template.name == 'product' -%}
      <script>
        /* Tidy Shopify search-analytics params (_pos/_sid/_ss/…) out of
           the address bar. Runs after load, so the analytics request has
           already been recorded server-side — this is cosmetic only. */
        (function () {
          var url = new URL(window.location.href);
          var removed = false;
          ['_pos', '_sid', '_ss', '_psq', '_fid'].forEach(function (p) {
            if (url.searchParams.has(p)) { url.searchParams.delete(p); removed = true; }
          });
          if (removed) history.replaceState(history.state, '', url.toString());
        })();
      </script>
    {%- endif -%}
    {%- comment -%}
      The floating Instagram button (snippets/instagram-widget.liquid) and Shop By Size bar
      (snippets/size-widget.liquid) are switched off: Shop by Size is in the menu.
    {%- endcomment -%}

    {%- comment -%} Every page, so it lives in the layout rather than a section {%- endcomment -%}
    {% render 'flying-banner' %}

    {%- comment -%} Phones: floating nav with Search and Size (not on product pages) {%- endcomment -%}
    {% render 'mobile-dock' %}


    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

{%- render "ecom_footer"-%}</body>
</html>
