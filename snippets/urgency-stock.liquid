{%- doc -%}
  Low-stock message ("Only 1 left in stock!") with a pulsing dot. Shown when the variant's tracked
  inventory is above 0 and at or below the threshold. Used by the Stock Urgency block and by the
  variant picker's size grid, which shows it next to the size label.

  @param {variant} variant - The variant to check
  @param {number} threshold - Show when stock is at or below this
  @param {string} [dot_color] - red, orange or amber (default red)
  @param {string} [style] - Inline style for the wrapper
  @param {string} [attributes] - Extra attributes for the wrapper
  @param {boolean} [preview] - Always show (theme editor preview)
{%- enddoc -%}

{% liquid
  assign inventory_quantity = variant.inventory_quantity
  assign show_urgency = false
  if variant.inventory_management == 'shopify' and inventory_quantity > 0 and inventory_quantity <= threshold
    assign show_urgency = true
  endif
  assign dot = dot_color | default: 'red'
%}

{% if show_urgency or preview %}
  <div
    class="product-urgency-stock"
    {% if style != blank %}style="{{ style }}"{% endif %}
    {{ attributes }}
  >
    <span class="urgency-dot urgency-dot--{{ dot }}"></span>
    <span class="urgency-text">
      {% if show_urgency == false or inventory_quantity == 1 %}
        Only 1 left in stock!
      {% else %}
        Only {{ inventory_quantity }} left in stock!
      {% endif %}
    </span>
  </div>
{% endif %}

{% stylesheet %}
  /* Orange: bold deep-orange text and an orange dot with a soft, slow pulse */
  .product-urgency-stock {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-block: 2px;
    font-size: 0.8125rem;
    font-weight: 750;
    letter-spacing: -0.005em;
  }

  .urgency-dot {
    position: relative;
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #f97316;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.45);
  }

  .urgency-dot::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    box-shadow: 0 0 0 0 rgb(249 115 22 / 0.45);
    animation: urgency-pulse 2.2s cubic-bezier(0.3, 0.7, 0.3, 1) infinite;
  }

  @keyframes urgency-pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(249 115 22 / 0.5);
    }
    70%,
    100% {
      box-shadow: 0 0 0 8px rgb(249 115 22 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .urgency-dot::after {
      animation: none;
    }
  }

  .urgency-text {
    color: #c2410c;
  }
{% endstylesheet %}
