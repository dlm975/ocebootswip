{%- doc -%}
  Low-stock message ("Only 1 left in stock!") with a pulsing dot. Shown when the variant's tracked
  inventory is above 0 and at or below the threshold. Used by the Stock Urgency block and by the
  variant picker's size grid, which shows it next to the size label.

  @param {variant} variant - The variant to check
  @param {number} threshold - Show when stock is at or below this
  @param {string} [dot_color] - red, orange or amber (default red)
  @param {string} [style] - Inline style for the wrapper
  @param {string} [attributes] - Extra attributes for the wrapper
  @param {boolean} [preview] - Always show (theme editor preview)
{%- enddoc -%}

{% liquid
  assign inventory_quantity = variant.inventory_quantity
  assign show_urgency = false
  if variant.inventory_management == 'shopify' and inventory_quantity > 0 and inventory_quantity <= threshold
    assign show_urgency = true
  endif
  assign dot = dot_color | default: 'red'
%}

{% if show_urgency or preview %}
  <div
    class="product-urgency-stock"
    {% if style != blank %}style="{{ style }}"{% endif %}
    {{ attributes }}
  >
    <span class="urgency-dot urgency-dot--{{ dot }}"></span>
    <span class="urgency-text">
      {% if show_urgency == false or inventory_quantity == 1 %}
        Only 1 left in stock!
      {% else %}
        Only {{ inventory_quantity }} left in stock!
      {% endif %}
    </span>
  </div>
{% endif %}

{% stylesheet %}
  .product-urgency-stock {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    padding-block: 2px;
  }

  .urgency-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .urgency-dot--red {
    background: var(--brand-red);
    box-shadow: 0 0 0 0 rgba(229,62,62,0.4);
    animation: urgency-pulse-red 1.6s ease-in-out infinite;
  }

  .urgency-dot--orange {
    background: #EC4899;
    box-shadow: 0 0 0 0 rgba(237,137,54,0.4);
    animation: urgency-pulse-orange 1.6s ease-in-out infinite;
  }

  .urgency-dot--amber {
    background: #d69e2e;
    box-shadow: 0 0 0 0 rgba(214,158,46,0.4);
    animation: urgency-pulse-amber 1.6s ease-in-out infinite;
  }

  @keyframes urgency-pulse-red {
    0%   { box-shadow: 0 0 0 0 rgba(229,62,62,0.5); }
    70%  { box-shadow: 0 0 0 7px rgba(229,62,62,0); }
    100% { box-shadow: 0 0 0 0 rgba(229,62,62,0); }
  }

  @keyframes urgency-pulse-orange {
    0%   { box-shadow: 0 0 0 0 rgba(237,137,54,0.5); }
    70%  { box-shadow: 0 0 0 7px rgba(237,137,54,0); }
    100% { box-shadow: 0 0 0 0 rgba(237,137,54,0); }
  }

  @keyframes urgency-pulse-amber {
    0%   { box-shadow: 0 0 0 0 rgba(214,158,46,0.5); }
    70%  { box-shadow: 0 0 0 7px rgba(214,158,46,0); }
    100% { box-shadow: 0 0 0 0 rgba(214,158,46,0); }
  }

  /* Navy text: pink text is too faint at this size; the dot carries the accent */
  .urgency-text {
    color: var(--brand-navy, #1F2937);
  }
{% endstylesheet %}
