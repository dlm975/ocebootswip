{%- doc -%}
  Renders the "See actual size label" hang tag that floats over the product
  gallery, or the dialog it opens. Callers must only render this when the
  product's `custom.custom_actual_size_label` metafield holds an image.

  @param {object} image - the size label image (MediaImage from the metafield)
  @param {string} dialog_id - id of the dialog-component the tag opens
  @param {string} part - 'tag' or 'dialog'

  @example
  {% render 'actual-size-label', image: size_label, dialog_id: 'actual-size-label-123', part: 'tag' %}
{%- enddoc -%}

{%- if part == 'tag' -%}
  <button
    type="button"
    class="actual-size-tag"
    aria-haspopup="dialog"
    aria-controls="{{ dialog_id }}"
    on:click="#{{ dialog_id }}/showDialog"
  >
    <img
      class="actual-size-tag__image"
      src="{{ 'actual-size-tag.png' | asset_url }}"
      alt="See actual size label"
      width="600"
      height="225"
      decoding="async"
    >
  </button>
{%- else -%}
  {%- assign image_alt = image.alt | default: 'Actual size label' -%}
  <dialog-component id="{{ dialog_id }}">
    <dialog
      ref="dialog"
      class="actual-size-dialog"
      aria-label="Actual size label"
      scroll-lock
    >
      <button
        type="button"
        class="button button-unstyled actual-size-dialog__close"
        aria-label="{{ 'actions.close' | t }}"
        on:click="#{{ dialog_id }}/closeDialog"
      >
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
      {{
        image.preview_image
        | image_url: width: 2400
        | image_tag:
          class: 'actual-size-dialog__image',
          loading: 'lazy',
          sizes: '(min-width: 750px) 90vw, 100vw',
          widths: '600, 900, 1200, 1600, 2000, 2400',
          alt: image_alt
      }}
    </dialog>
  </dialog-component>

  <script>
    (function () {
      /* The free shipping pill is moved onto the gallery by its own script and
         may be hidden per product, so measure it rather than assume its size. */
      var GAP = 12;
      var root = document.documentElement;
      var observed = null;
      var observer = 'ResizeObserver' in window ? new ResizeObserver(update) : null;

      function update() {
        var pill = document.querySelector('media-gallery .fsp--placed');
        var tag = Array.prototype.find.call(document.querySelectorAll('.actual-size-tag'), function (el) {
          return el.offsetParent;
        });

        if (observer && pill && pill !== observed) {
          observer.observe(pill);
          observed = pill;
        }

        if (!pill || !tag || !pill.offsetHeight) {
          root.style.removeProperty('--size-tag-top');
          return;
        }

        var top = pill.getBoundingClientRect().bottom - tag.offsetParent.getBoundingClientRect().top + GAP;
        root.style.setProperty('--size-tag-top', Math.round(top) + 'px');
      }

      /* Next frame, so the pill's own DOMContentLoaded/load placement has run first */
      function schedule() {
        requestAnimationFrame(update);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', schedule, { once: true });
      } else {
        schedule();
      }
      window.addEventListener('load', schedule);
      window.addEventListener('resize', schedule);
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  /* ── Floating size tag (assets/actual-size-tag.png) ──
     The PNG has transparent padding around the label: 5.47% of its width at
     the top, 4.69% at the bottom and 11.67% at each side. Negative margins
     cancel it so the visible label, not the image box, lines up 12px under
     the free shipping pill and with the pill's right edge. */
  .actual-size-tag {
    --size-tag-width: 150px;

    position: absolute;
    /* --size-tag-top is set by the script below so the tag sits under the free shipping pill */
    top: var(--size-tag-top, 16px);
    right: 16px;
    /* Below the free shipping pill (z-index 5) so it can never cover it */
    z-index: var(--layer-raised);
    display: block;
    width: var(--size-tag-width);
    margin: calc(var(--size-tag-width) * -0.0547) calc(var(--size-tag-width) * -0.1167) 0 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .actual-size-tag__image {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.2s ease;
  }

  .actual-size-tag:focus-visible {
    outline: none;
  }

  .actual-size-tag:focus-visible .actual-size-tag__image {
    outline: 2px solid #111111;
    outline-offset: -4px;
    border-radius: 12px;
  }

  @media (hover: hover) {
    .actual-size-tag:hover .actual-size-tag__image {
      transform: scale(1.05);
    }
  }

  @media screen and (max-width: 749px) {
    .actual-size-tag {
      --size-tag-width: 120px;

      top: auto;
      right: 12px;
      bottom: 12px;
      margin: 0 calc(var(--size-tag-width) * -0.1167) calc(var(--size-tag-width) * -0.0469) 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .actual-size-tag__image {
      transition: none;
    }
  }

  /* ── Lightbox ── */
  .actual-size-dialog {
    max-width: calc(100vw - 32px);
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: 8px;
    background-color: #ffffff;
    overflow: visible;
    box-shadow: var(--shadow-popover);
  }

  .actual-size-dialog::backdrop {
    background: rgb(0 0 0 / 0.75);
  }

  .actual-size-dialog[open] {
    animation: elementSlideInTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .actual-size-dialog.dialog-closing {
    animation: elementSlideOutTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .actual-size-dialog__image {
    display: block;
    width: auto;
    height: auto;
    max-width: calc(100vw - 32px);
    max-height: calc(100dvh - 32px);
    object-fit: contain;
    border-radius: inherit;
    touch-action: pinch-zoom;
  }

  .actual-size-dialog__close {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: var(--layer-flat);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--minimum-touch-target, 44px);
    height: var(--minimum-touch-target, 44px);
    border-radius: 50%;
    background-color: rgb(255 255 255 / 0.92);
    color: #111111;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.2);
  }

  .actual-size-dialog__close svg {
    width: 16px;
    height: 16px;
  }
{% endstylesheet %}
