{%- doc -%}
  Phones: a small floating nav at the bottom middle of the screen: a search icon and a size icon.
  - Search: the nav grows into a search bar that glides up to the upper-middle of the screen, the
    page fading behind a white blur. Typing shows suggested collections and product cards, as the
    main search does (it uses the same helpers, assets/search-suggestions.js, and result section),
    and the bar moves to the top to make room for them.
  - Size slides up a sheet with the size picker (snippets/size-drill-menu.liquid, as in the menu
    drawer): US / UK / EU, each opening its sizes, each size linking to its boots.
  Not on the home page, nor on product pages (where the floating buy bar sits at the bottom).
  Animations: Motion.
{%- enddoc -%}

{%- liquid
  assign size_link = nil
  for link in linklists['header-menu'].links
    assign first_title = link.links.first.title | upcase
    if first_title contains 'US ' and first_title contains ' - UK ' and first_title contains ' - EU '
      assign size_link = link
      break
    endif
  endfor
-%}

{%- unless template.name == 'product' or template.name == 'index' -%}
  <nav
    class="mdock"
    aria-label="Quick navigation"
    data-mdock
  >
    <button
      type="button"
      class="mdock__button"
      data-mdock-search
      aria-label="Search"
    >
      {%- render 'gicon', name: 'search', class: 'mdock__icon--search', size: 22 -%}
      <span class="mdock__label mdock__label--search" aria-hidden="true">Search</span>
    </button>
    {%- if size_link -%}
      <span
        class="mdock__divider"
        aria-hidden="true"
      ></span>
      <button
        type="button"
        class="mdock__button"
        data-mdock-size
        aria-haspopup="dialog"
        aria-controls="mdock-sizes"
        aria-label="Shop by size"
      >
        {%- render 'gicon', name: 'straighten', size: 22 -%}
        <span class="mdock__label" aria-hidden="true">Size</span>
      </button>
    {%- endif -%}
  </nav>

  <div
    class="msearch"
    data-msearch
    data-suggest-url="{{ routes.predictive_search_url }}"
    data-search-url="{{ routes.search_url }}"
    role="dialog"
    aria-modal="true"
    aria-label="Search"
    hidden
  >
    <div
      class="msearch__veil"
      data-msearch-veil
    ></div>
    <div
      class="msearch__stage"
      data-msearch-stage
    >
      <div
        class="msearch__spacer"
        data-msearch-spacer
      ></div>
      <form
        class="msearch__bar"
        data-msearch-bar
        action="{{ routes.search_url }}"
        method="get"
        autocomplete="off"
        role="search"
      >
        <input
          type="hidden"
          name="type"
          value="product"
        >
        {%- render 'gicon', name: 'search', class: 'msearch__glass', size: 22 -%}
        <input
          class="msearch__input"
          data-msearch-input
          type="search"
          name="q"
          placeholder="Search boots"
          enterkeyhint="search"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          aria-label="Search"
        >
        <button
          type="button"
          class="msearch__close"
          data-msearch-close
          aria-label="Close search"
        >
          {%- render 'gicon', name: 'close', size: 20 -%}
        </button>
      </form>
      <div
        class="msearch__results"
        data-msearch-results
        aria-live="polite"
      >
        <p
          class="cs-fixed"
          data-msearch-fixed
          hidden
        ></p>
        <section
          class="cs-suggest"
          data-msearch-suggest
          hidden
          aria-label="Suggested categories"
        >
          <ul
            class="cs-suggest__list"
            data-msearch-suggest-list
            role="list"
          ></ul>
        </section>
        <section
          class="cs-products"
          data-msearch-products
          hidden
          aria-label="Products"
        >
          <h2 class="cs-label">Products</h2>
          <div data-msearch-grid></div>
          <a
            class="cs-viewall"
            data-msearch-viewall
            href="{{ routes.search_url }}"
          >
            <span data-msearch-viewall-text>View all results</span>
            {%- render 'gicon', name: 'arrow_forward', size: 16 -%}
          </a>
        </section>
        <p
          class="cs-none"
          data-msearch-none
          hidden
        ></p>
      </div>
    </div>
  </div>

  {%- if size_link -%}
    <dialog
      class="mdock-sheet"
      id="mdock-sizes"
      aria-labelledby="mdock-sizes-title"
      data-mdock-sheet
    >
      <div
        class="mdock-sheet__scrim"
        data-mdock-scrim
      ></div>
      <div
        class="mdock-sheet__panel"
        data-mdock-panel
      >
        <span
          class="mdock-sheet__grabber"
          aria-hidden="true"
        ></span>
        <div class="mdock-sheet__head">
          <h2
            class="mdock-sheet__title"
            id="mdock-sizes-title"
          >
            Shop by size
          </h2>
          <button
            type="button"
            class="mdock-sheet__close"
            data-mdock-close
            aria-label="Close"
          >
            {%- render 'gicon', name: 'close', size: 22 -%}
          </button>
        </div>
        <div class="mdock-sheet__body">
          {% render 'size-drill-menu', parent_link: size_link, variant: 'drawer', id: 'mdock-size' %}
        </div>
      </div>
    </dialog>
  {%- endif -%}

  <script type="module">
    import { animate } from 'motion';

    /*
      Holding the page still under a sheet. Phones (iOS especially) ignore overflow: hidden on the
      page, so it is pinned in place instead, then put back exactly where it was.
    */
    let locks = 0;
    let lockedAt = 0;
    const lockPage = (className) => {
      document.documentElement.classList.add(className);
      if (locks++ > 0) return;
      lockedAt = window.scrollY;
      const body = document.body.style;
      body.position = 'fixed';
      body.top = -lockedAt + 'px';
      body.left = '0';
      body.right = '0';
    };
    const unlockPage = (className) => {
      document.documentElement.classList.remove(className);
      if (--locks > 0) return;
      locks = 0;
      const body = document.body.style;
      ['position', 'top', 'left', 'right'].forEach((p) => body.removeProperty(p));
      window.scrollTo({ top: lockedAt, behavior: 'instant' });
    };

    const dock = document.querySelector('[data-mdock]');
    const sheet = document.querySelector('[data-mdock-sheet]');
    if (dock) {
      const EASE = [0.3, 0.7, 0.3, 1];
      const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      setUpSearch(dock, EASE, reduced);

      if (sheet) {
        const panel = sheet.querySelector('[data-mdock-panel]');
        const scrim = sheet.querySelector('[data-mdock-scrim]');
        let state = 'closed';
        let token = 0;
        const stop = (el) => el.getAnimations().forEach((a) => a.cancel());

        const finish = () => {
          state = 'closed';
          [panel, scrim].forEach((el) => {
            stop(el);
            el.style.removeProperty('transform');
            el.style.removeProperty('opacity');
          });
          sheet.close();
          unlockPage('mdock-open');
        };

        // Opening (or reopening while it slides away): from wherever the sheet is now
        const open = () => {
          if (state === 'open') return;
          const midway = state === 'closing';
          token++;
          state = 'open';
          if (!sheet.open) {
            sheet.showModal();
            lockPage('mdock-open');
          }
          if (reduced()) return;
          const panelFrom = midway ? getComputedStyle(panel).transform : 'translateY(100%)';
          const scrimFrom = midway ? getComputedStyle(scrim).opacity : 0;
          stop(panel);
          stop(scrim);
          animate(scrim, { opacity: [scrimFrom, 1] }, { duration: 0.3, ease: 'linear' });
          animate(panel, { transform: [panelFrom, 'translateY(0%)'] }, { duration: 0.55, ease: EASE });
        };

        // Closing (also partway through opening): from wherever it is, a quick slide away
        const close = () => {
          if (state !== 'open') return;
          if (reduced()) return finish();
          const mine = ++token;
          state = 'closing';
          const panelFrom = getComputedStyle(panel).transform;
          const scrimFrom = getComputedStyle(scrim).opacity;
          stop(panel);
          stop(scrim);
          const done = () => {
            if (mine === token) finish();
          };
          Promise.all([
            animate(scrim, { opacity: [scrimFrom, 0] }, { duration: 0.24, ease: 'linear' }),
            animate(panel, { transform: [panelFrom, 'translateY(100%)'] }, { duration: 0.3, ease: [0.4, 0, 1, 1] }),
          ]).then(done, () => {});
        };

        dock.querySelector('[data-mdock-size]')?.addEventListener('click', open);
        sheet.querySelector('[data-mdock-close]').addEventListener('click', close);
        scrim.addEventListener('click', close);
        sheet.addEventListener('cancel', (event) => {
          event.preventDefault();
          close();
        });
        // Choosing a size goes to its boots: close the sheet behind it
        sheet.addEventListener('click', (event) => {
          if (event.target.closest('a[href]')) close();
        });
      }
    }

    /** The nav's search: grows into a bar mid-screen, results like the main search's */
    function setUpSearch(dock, EASE, reduced) {
      const layer = document.querySelector('[data-msearch]');
      const button = dock.querySelector('[data-mdock-search]');
      if (!layer || !button) return;
      const veil = layer.querySelector('[data-msearch-veil]');
      const stage = layer.querySelector('[data-msearch-stage]');
      const spacer = layer.querySelector('[data-msearch-spacer]');
      const bar = layer.querySelector('[data-msearch-bar]');
      const input = layer.querySelector('[data-msearch-input]');
      const results = layer.querySelector('[data-msearch-results]');
      const suggestSection = layer.querySelector('[data-msearch-suggest]');
      const suggestList = layer.querySelector('[data-msearch-suggest-list]');
      const productsSection = layer.querySelector('[data-msearch-products]');
      const grid = layer.querySelector('[data-msearch-grid]');
      const viewAll = layer.querySelector('[data-msearch-viewall]');
      const viewAllText = layer.querySelector('[data-msearch-viewall-text]');
      const none = layer.querySelector('[data-msearch-none]');
      const fixedNote = layer.querySelector('[data-msearch-fixed]');
      const suggestUrl = layer.dataset.suggestUrl;
      const searchUrl = layer.dataset.searchUrl;
      const restTop = () => Math.round(window.innerHeight * 0.28); // where the bar rests: upper middle
      let raised = false; // results showing: bar at the top
      let closing = null;

      const clean = (query) => query.replace(/\*+/g, ' ').replace(/\s+/g, ' ').trim();

      /* ---------- Opening and closing ---------- */
      const contents = () => bar.querySelectorAll('.msearch__glass, .msearch__input, .msearch__close');

      /** Show or hide the nav at once (no fade), for the hand-over between the nav and the bar */
      const dockNow = (searching) => {
        dock.style.transition = 'none';
        dock.classList.toggle('is-searching', searching);
        dock.getBoundingClientRect();
        requestAnimationFrame(() => dock.style.removeProperty('transition'));
      };

      function open() {
        if (!layer.hidden) return;
        const from = dock.getBoundingClientRect();
        layer.hidden = false;
        spacer.style.height = restTop() + 'px';
        raised = false;
        // Focus at once, inside the tap, so phones bring the keyboard up
        input.focus({ preventScroll: true });
        lockPage('msearch-open');
        // The bar takes over from the nav in the same frame, at the nav's size and place
        dockNow(true);
        if (reduced()) return;
        const to = bar.getBoundingClientRect();
        animate(veil, { opacity: [0, 1] }, { duration: 0.35, ease: 'linear' });
        // Its contents show once it has room for them
        contents().forEach((el) => animate(el, { opacity: [0, 1] }, { duration: 0.3, delay: 0.12, ease: 'linear' }));
        // The nav itself grows into the bar: same centre line, so it rises and widens
        animate(
          bar,
          {
            width: [from.width + 'px', to.width + 'px'],
            height: [from.height + 'px', to.height + 'px'],
            transform: ['translateY(' + (from.top - to.top) + 'px)', 'translateY(0px)'],
          },
          { duration: 0.55, ease: EASE }
        ).then(() => {
          ['width', 'height', 'transform'].forEach((p) => bar.style.removeProperty(p));
        });
      }

      function close() {
        if (layer.hidden || closing) return closing;
        input.blur();
        const finish = () => {
          // The nav takes back over from the bar in the same frame: no gap between them
          dockNow(false);
          layer.hidden = true;
          unlockPage('msearch-open');
          [veil, bar, results, ...contents()].forEach((el) => {
            el.getAnimations().forEach((a) => a.cancel());
            ['opacity', 'width', 'height', 'transform'].forEach((p) => el.style.removeProperty(p));
          });
          input.value = '';
          showEmpty();
          closing = null;
        };
        if (reduced()) {
          finish();
          return Promise.resolve();
        }
        // From exactly where everything is now (also partway through opening)
        const seen = bar.getBoundingClientRect();
        const veilFrom = getComputedStyle(veil).opacity;
        const resultsFrom = getComputedStyle(results).opacity;
        const contentsFrom = [...contents()].map((el) => getComputedStyle(el).opacity);
        [veil, bar, results, ...contents()].forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
        ['width', 'height', 'transform'].forEach((p) => bar.style.removeProperty(p));
        const rest = bar.getBoundingClientRect();
        const to = dock.getBoundingClientRect();
        contents().forEach((el, i) => animate(el, { opacity: [contentsFrom[i], 0] }, { duration: 0.15, ease: 'linear' }));
        closing = Promise.all([
          animate(veil, { opacity: [veilFrom, 0] }, { duration: 0.3, ease: 'linear' }),
          animate(results, { opacity: [resultsFrom, 0] }, { duration: 0.18, ease: 'linear' }),
          animate(
            bar,
            {
              width: [seen.width + 'px', to.width + 'px'],
              height: [seen.height + 'px', to.height + 'px'],
              transform: ['translateY(' + (seen.top - rest.top) + 'px)', 'translateY(' + (to.top - rest.top) + 'px)'],
            },
            { duration: 0.45, ease: EASE }
          ),
        ]).then(finish, finish);
        return closing;
      }

      /** Bar to the top when there are results, back to the upper middle when there aren't */
      function raise(up) {
        if (up === raised) return;
        raised = up;
        const from = spacer.getBoundingClientRect().height;
        const to = up ? 0 : restTop();
        spacer.getAnimations().forEach((a) => a.cancel());
        if (reduced()) {
          spacer.style.height = to + 'px';
          return;
        }
        animate(spacer, { height: [from + 'px', to + 'px'] }, { duration: 0.5, ease: EASE }).then(() => {
          if (!spacer.getAnimations().length) spacer.style.height = to + 'px';
        });
      }

      /* ---------- Results (as the main search) ---------- */
      const cache = new Map();
      let controller = null;
      let timer = null;
      let shown = '';

      function fetchResults(query) {
        if (cache.has(query)) return Promise.resolve(cache.get(query));
        if (controller) controller.abort();
        controller = new AbortController();
        return window.OceSearchSuggest.fetchResults(query, suggestUrl, controller.signal).then((data) => {
          cache.set(query, data);
          return data;
        });
      }

      function suggestionsFor(query, data) {
        const api = window.OceSearchSuggest;
        if (!api) return [];
        const list = api.suggest(data.query || query, data.titles, api.readCatalog('cs-catalog'), searchUrl, 4);
        api.remember(query, list);
        return list;
      }

      function showEmpty() {
        suggestSection.hidden = true;
        productsSection.hidden = true;
        none.hidden = true;
        fixedNote.hidden = true;
        suggestList.replaceChildren();
        grid.replaceChildren();
        shown = '';
        raise(false);
      }

      function showResults(query, data) {
        const first = !shown;
        suggestList.replaceChildren();
        const suggestions = suggestionsFor(query, data);
        // Misspelt: say what was searched instead
        const searched = data.query || query;
        fixedNote.hidden = !data.corrected;
        fixedNote.textContent = data.corrected ? 'Showing results for “' + searched + '”' : '';
        suggestions.forEach((s) => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.className = 'cs-suggest__link';
          link.href = s.url;
          link.textContent = s.text;
          item.append(link);
          suggestList.append(item);
        });
        suggestSection.hidden = suggestions.length === 0;
        grid.replaceChildren();
        if (data.grid) grid.append(data.grid.cloneNode(true));
        productsSection.hidden = !data.grid;
        viewAll.href = searchUrl + '?q=' + encodeURIComponent(searched) + '&type=product';
        viewAllText.textContent = 'View all results for “' + searched + '”';
        none.hidden = !!data.grid;
        none.textContent = data.grid ? '' : 'No results for “' + query + '”';
        shown = query;
        raise(true);
        if (first && !reduced()) {
          animate(results, { opacity: [0, 1], transform: ['translateY(12px)', 'translateY(0px)'] }, { duration: 0.45, ease: EASE });
        }
      }

      input.addEventListener('input', () => {
        clearTimeout(timer);
        const query = clean(input.value);
        if (!query || !window.OceSearchSuggest) {
          if (controller) controller.abort();
          showEmpty();
          return;
        }
        timer = setTimeout(() => {
          fetchResults(query)
            .then((data) => {
              if (clean(input.value) === query) showResults(query, data);
            })
            .catch(() => {});
        }, cache.has(query) ? 0 : 140);
      });

      // Search key: no trip to the results page. The suggestions and product cards show here at
      // once, and the keyboard steps aside so they can be seen ("View all results" leads on).
      bar.addEventListener('submit', (event) => {
        event.preventDefault();
        clearTimeout(timer);
        const query = clean(input.value);
        input.blur();
        if (!query || !window.OceSearchSuggest) return;
        fetchResults(query)
          .then((data) => {
            if (clean(input.value) === query && shown !== query) showResults(query, data);
          })
          .catch(() => {});
      });

      layer.querySelector('[data-msearch-close]').addEventListener('click', () => close());
      // A tap on the blur (not the bar or a result) closes
      stage.addEventListener('click', (event) => {
        if (event.target === stage || event.target === spacer || event.target === results) close();
      });
      layer.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') close();
      });
      button.addEventListener('click', open);
    }
  </script>
{%- endunless -%}

{% stylesheet %}
  .mdock,
  .mdock-sheet {
    display: none;
  }

  @media screen and (max-width: 749px) {
    /* The floating nav: a white pill at the bottom middle */
    .mdock {
      position: fixed;
      left: 50%;
      bottom: calc(14px + env(safe-area-inset-bottom, 0px));
      z-index: 20;
      display: flex;
      align-items: center;
      padding: 5px;
      border-radius: 999px;
      /* Glass: the page shows through, blurred and a little brighter, with a light rim */
      background: rgb(255 255 255 / 0.5);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      backdrop-filter: blur(20px) saturate(180%);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.8),
        inset 0 0 0 1px rgb(255 255 255 / 0.35),
        0 0 0 1px rgb(18 18 18 / 0.06),
        0 10px 30px rgb(18 18 18 / 0.16);
      transform: translateX(-50%);
    }

    /* Room at the foot of the page so the nav never hides the last of it: given inside the
       (dark) footer, so the page ends on the footer and never on a white strip */
    body:has(.mdock) footer.section-wrapper:last-of-type {
      padding-block-end: calc(76px + env(safe-area-inset-bottom, 0px));
    }

    body:has(.mdock):not(:has(footer.section-wrapper)) {
      padding-block-end: 76px;
    }

    .mdock {
      transition: opacity 0.15s linear;
    }

    /* While searching, the nav has become the search bar */
    .mdock.is-searching {
      opacity: 0;
      pointer-events: none;
    }

    .mdock__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-width: 52px;
      height: 44px;
      padding: 0 16px;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: #121212;
      font: inherit;
      font-size: 0.9375rem;
      font-weight: 650;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      transition: background-color 0.2s ease, transform 0.2s cubic-bezier(0.3, 0.7, 0.3, 1);
    }

    .mdock__button svg {
      flex: none;
      width: 22px;
      height: 22px;
    }

    .mdock__button:active {
      background: rgb(255 255 255 / 0.6);
      transform: scale(0.96);
    }

    /* The magnifier fills more of its box than the ruler, and "Search" is the longer word: both a
       touch smaller, so the two buttons read the same size */
    .mdock__button svg.mdock__icon--search {
      width: 19px;
      height: 19px;
    }

    .mdock__label--search {
      font-size: 0.875rem !important;
    }

    .mdock__label {
      font-size: 0.9375rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .mdock__divider {
      width: 1px;
      height: 22px;
      background: rgb(18 18 18 / 0.12);
    }

    /* The size sheet */
    .mdock-sheet[open] {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: flex-end;
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      overflow: hidden;
    }

    .mdock-sheet__scrim {
      position: absolute;
      inset: 0;
      touch-action: none;
      background: rgb(0 0 0 / 0.45);
    }

    .mdock-sheet__panel {
      position: relative;
      width: 100%;
      max-height: 88vh;
      max-height: 88dvh;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 18px 0 calc(20px + env(safe-area-inset-bottom, 0px));
      border-radius: 20px 20px 0 0;
      background: #ffffff;
      color: #121212;
      box-shadow: 0 -10px 40px rgb(0 0 0 / 0.2);
    }

    .mdock-sheet__grabber {
      position: absolute;
      top: 8px;
      left: 50%;
      width: 40px;
      height: 4px;
      margin-left: -20px;
      border-radius: 2px;
      background: rgb(18 18 18 / 0.2);
    }

    .mdock-sheet__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 6px 16px 4px 20px;
    }

    .mdock-sheet__title {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 750;
      letter-spacing: -0.02em;
    }

    .mdock-sheet__close {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgb(18 18 18 / 0.06);
      color: #121212;
      cursor: pointer;
    }

    .mdock-sheet__body {
      padding-inline: 20px;
    }

    html.mdock-open,
    html.msearch-open {
      overflow: hidden;
    }

    /* ---- Search: a bar mid-screen over a white blur ---- */
    .msearch {
      --cs-ink: #121212;
      --cs-muted: rgb(18 18 18 / 0.55);
      --cs-ease: cubic-bezier(0.3, 0.7, 0.3, 1);
      --cs-gutter: 16px;
      position: fixed;
      inset: 0;
      z-index: 60;
      color: #121212;
    }

    .msearch[hidden] {
      display: none;
    }

    .msearch__veil {
      position: absolute;
      inset: 0;
      touch-action: none;
      background: rgb(255 255 255 / 0.8);
