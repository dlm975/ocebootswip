<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,maximum-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  # Collection pages: title, description, canonical and indexing written from what the collection
  # is (snippets/seo-collection)
  assign seo_canonical = canonical_url
  assign seo_robots = ''
  if request.page_type == 'collection' and collection
    capture seo_title_out
      render 'seo-collection', mode: 'title', c: collection
    endcapture
    capture seo_desc_out
      render 'seo-collection', mode: 'description', c: collection
    endcapture
    capture seo_canon_out
      render 'seo-collection', mode: 'canonical', c: collection
    endcapture
    capture seo_robots
      render 'seo-collection', mode: 'robots', c: collection
    endcapture
    assign seo_title_out = seo_title_out | strip
    assign seo_desc_out = seo_desc_out | strip
    assign seo_canon_out = seo_canon_out | strip
    assign seo_robots = seo_robots | strip
    if seo_title_out != blank
      assign page_title = seo_title_out
    endif
    if seo_desc_out != blank
      assign page_description = seo_desc_out
    endif
    if seo_canon_out != blank
      assign seo_canonical = seo_canon_out
    endif
  endif
  # The home page: what the site is, not the store's internal title ("oceboots.com")
  if request.page_type == 'index'
    assign range_count = collections['all-football-boots'].all_products_count | default: 1000
    assign page_title = 'OCEBOOTS | Football Boots NZ – New, Pre-Owned & Rare'
    assign page_description = 'New Zealand’s largest range of football boots: ' | append: range_count | append: ' pairs of Nike Mercurial, Phantom, Tiempo, adidas Predator, F50 and more, new and pre-owned. Shipped worldwide.'
  endif

  # Pages without a description of their own get one, so search results show something useful
  if page_description == blank
    case request.page_type
      when 'page'
        assign page_description = page.content | strip_html | strip_newlines | strip | truncate: 155
      when 'article'
        assign page_description = article.excerpt_or_content | strip_html | strip_newlines | strip | truncate: 155
      when 'blog'
        assign page_description = 'Football boot news, releases and stories from OCEBOOTS.'
      when 'policy'
        assign page_description = page_title | append: ' for OCEBOOTS, New Zealand’s football boot store.'
    endcase
    if page_description == blank
      assign page_description = 'OCEBOOTS: New Zealand’s largest range of football boots, new and pre-owned, from Nike, adidas, Puma and Mizuno. Shipped worldwide.'
    endif
  endif

  # Search results, the cart and account pages are not pages to find in Google
  if request.page_type == 'search' or request.page_type == 'cart' or request.page_type contains 'customers/'
    assign seo_robots = 'noindex'
  endif

  # A filtered or sorted collection is the same page: it stays out of search results
  if request.page_type == 'collection' and seo_robots == blank
    if current_tags or request.path contains '+'
      assign seo_robots = 'noindex'
    endif
  endif

  assign og_title = page_title | default: shop.name
  assign og_url = seo_canonical | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="OCEBOOTS"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- liquid
    # The site's name after the page's ("… – OCEBOOTS"), unless the title already carries it
    assign title_lower = page_title | downcase
    assign shop_lower = shop.name | downcase
  -%}
  {%- unless title_lower contains 'oceboots' or title_lower contains shop_lower %} &ndash; OCEBOOTS{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ seo_canonical }}"
>
{%- if seo_robots == 'noindex' %}
  <meta name="robots" content="noindex, follow">
{%- endif %}

{% if page_description %}
  <meta
    name="description"
    content="{{ page_description | escape }}"
  >
{% endif %}

{%- render 'seo-site' -%}
