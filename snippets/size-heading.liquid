{%- comment -%}
  Render straight after a collection's heading. On a size page the heading shows just the size that
  was clicked ("EU 41"): the menu's size links carry it as ?size=EU+41. A size collection reached
  another way (its title is "US 8 - UK 7 - EU 41") shows its size in the shopper's chosen system
  (US / UK / EU, as picked in the size selector), a third read as the nearest whole size.
  Runs as the heading is read, before the page is drawn, so the full title never shows first.
{%- endcomment -%}
<script>
  (function () {
    var heading = document.currentScript && document.currentScript.previousElementSibling;
    if (!heading) return;
    var whole = function (n) {
      var parts = n.split(' ');
      if (parts[1] === '1/3' || parts[1] === '2/3') return String(Math.round(parseFloat(parts[0]) + (parts[1] === '1/3' ? 1 / 3 : 2 / 3)));
      return n;
    };
    var text = null;
    var clicked = (new URLSearchParams(location.search).get('size') || '').trim();
    var asked = clicked.match(/^(US|UK|EU)\s*([0-9]+(?:\.[0-9]+)?(?:\s+[12]\/3)?)$/i);
    if (asked) {
      text = asked[1].toUpperCase() + ' ' + whole(asked[2].replace(/\s+/g, ' '));
    } else {
      var title = heading.textContent.trim();
      if (/^US\s*[0-9.]+\s*-\s*UK\s*[0-9.]+\s*-\s*EU\s*[0-9.]/i.test(title)) {
        var system = 'us';
        try {
          var saved = localStorage.getItem('csh-size-system');
          if (saved === 'us' || saved === 'uk' || saved === 'eu') system = saved;
        } catch (e) {}
        var found = title.match(new RegExp('\\b' + system + '\\s*([0-9]+(?:\\.[0-9]+)?(?:\\s+[12]/3)?)', 'i'));
        if (found) text = system.toUpperCase() + ' ' + whole(found[1].replace(/\s+/g, ' '));
      }
    }
    if (text) heading.textContent = text;
  })();
</script>
