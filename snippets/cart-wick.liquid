{%- doc -%}
  A burning bomb fuse around the checkout button. The rope is a hairline
  outline of the button; a spark starts at the top middle, travels
  clockwise, and consumes the rope behind it, so over 5 minutes the whole
  outline burns away and then resets.

  The spark's position is derived from a timestamp kept in localStorage
  rather than from a CSS animation. A CSS animation inside the drawer
  would pause and restart every time the dialog closes and reopens (a
  closed dialog has no layout), which would reset the fuse. Reading the
  clock instead means the fuse keeps burning while the drawer is shut and
  is exactly where it should be when it reopens — and it stays in step
  across page loads and between the drawer and the cart page.

  Expects to be rendered as a sibling of .cart__checkout-button inside a
  positioned wrapper.
{%- enddoc -%}

<cart-wick class="cart-wick" aria-hidden="true">
  <svg class="cart-wick__svg" xmlns="http://www.w3.org/2000/svg" focusable="false">
    <path class="cart-wick__rope"></path>
    <path class="cart-wick__edge"></path>
    <g class="cart-wick__spark">
      <circle class="cart-wick__flare" r="4"></circle>
      <circle class="cart-wick__core" r="1.6"></circle>
      <circle class="cart-wick__ember" r="1" style="--ex: 8px; --ey: -8px;"></circle>
      <circle class="cart-wick__ember" r="0.85" style="--ex: -7px; --ey: -9px;"></circle>
      <circle class="cart-wick__ember" r="0.9" style="--ex: 9px; --ey: 6px;"></circle>
      <circle class="cart-wick__ember" r="0.75" style="--ex: -8px; --ey: 7px;"></circle>
      <circle class="cart-wick__ember" r="0.8" style="--ex: 2px; --ey: -11px;"></circle>
      <circle class="cart-wick__ember" r="0.7" style="--ex: -11px; --ey: 1px;"></circle>
    </g>
  </svg>
</cart-wick>

{% stylesheet %}
  .cart-wick {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
    z-index: 1;
  }

  /* overflow must stay visible so the spark's glow and its embers are not
     clipped at the button's edge, which is exactly where they sit. */
  .cart-wick__svg {
    position: absolute;
    inset: 0;
    display: block;
    overflow: visible;
  }

  /* The unburnt rope: a hairline yellow outline, complete all the way
     around the button at the start. JS trims it back from the front as
     the spark advances, so what is left is only the length still to
     burn. */
  .cart-wick__rope {
    fill: none;
    stroke: #ffd23f;
    stroke-width: 1.25;
    stroke-linecap: butt;
    filter: drop-shadow(0 0 1.5px rgb(255 210 63 / 55%));
  }

  /* A short hot length immediately ahead of the spark, so the rope glows
     as it is about to catch rather than switching from cold to gone. */
  .cart-wick__edge {
    fill: none;
    stroke: #ffb020;
    stroke-width: 1.6;
    stroke-linecap: butt;
    filter: drop-shadow(0 0 3px rgb(255 122 24 / 90%));
  }

  /* Hidden until JS gives it a position. Its circles default to cx/cy 0,
     so without this it would show in the button's top-left corner for as
     long as anything stopped it being placed. */
  .cart-wick__spark {
    opacity: 0;
    filter: drop-shadow(0 0 6px rgb(255 176 32 / 95%));
  }

  .cart-wick__flare {
    fill: #ff7a18;
    transform-box: fill-box;
    transform-origin: center;
    animation: cart-wick-flare 0.16s steps(2, end) infinite alternate;
  }

  .cart-wick__core {
    fill: #fff6d5;
    transform-box: fill-box;
    transform-origin: center;
    animation: cart-wick-flare 0.22s steps(2, end) infinite alternate-reverse;
  }

  .cart-wick__ember {
    fill: #ffcf5c;
    transform-box: fill-box;
    transform-origin: center;
    animation: cart-wick-ember 0.6s linear infinite;
  }

  .cart-wick__ember:nth-of-type(2) {
    animation-delay: 0.15s;
    animation-duration: 0.52s;
  }

  .cart-wick__ember:nth-of-type(3) {
    animation-delay: 0.3s;
    animation-duration: 0.68s;
  }

  .cart-wick__ember:nth-of-type(4) {
    animation-delay: 0.45s;
    animation-duration: 0.58s;
  }

  /* Stepped rather than eased — a fuse flickers, it does not breathe. */
  @keyframes cart-wick-flare {
    from {
      transform: scale(0.82);
      opacity: 0.95;
    }

    to {
      transform: scale(1.25);
      opacity: 0.6;
    }
  }

  @keyframes cart-wick-ember {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 0.9;
    }

    100% {
      transform: translate(var(--ex, 6px), var(--ey, -6px)) scale(0.15);
      opacity: 0;
    }
  }

  /* Nothing to burn down to when there is nothing to buy. */
  .cart__checkout-wick:has(.cart__checkout-button[disabled]) .cart-wick {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-wick {
      display: none;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    if (customElements.get('cart-wick')) return;

    /* One lap per 5 minutes. */
    var PERIOD = 5 * 60 * 1000;

    /* Shared by every instance on the page so the drawer and the cart
       page never disagree about where the spark is. */
    var started = null;

    function startedAt() {
      if (started !== null) return started;

      var stored = null;
      try {
        stored = window.localStorage.getItem('cart-wick-start');
      } catch (_) {
        /* Private mode or blocked storage — fall through to a fresh
           start so the fuse still burns, it just restarts per page. */
      }

      var parsed = stored === null ? NaN : parseInt(stored, 10);
      if (isFinite(parsed)) {
        started = parsed;
        return started;
      }

      started = Date.now();
      try {
        window.localStorage.setItem('cart-wick-start', String(started));
      } catch (_) {
        /* no-op */
      }
      return started;
    }

    function progress() {
      var elapsed = Date.now() - startedAt();
      return (((elapsed % PERIOD) + PERIOD) % PERIOD) / PERIOD;
    }

    /* Starts at the top middle and runs clockwise, finishing back at the
       top middle. Path length 0 is therefore the spark's starting point
       and the burn travels right first, as asked. Left open rather than
       closed with Z — the ends already meet, and a Z would add a
       zero-length segment that upsets getPointAtLength at the wrap. */
    function roundedRect(x, y, w, h, r) {
      var right = x + w;
      var bottom = y + h;
      var mid = x + w / 2;
      return (
        'M ' + mid + ' ' + y +
        ' H ' + (right - r) +
        ' A ' + r + ' ' + r + ' 0 0 1 ' + right + ' ' + (y + r) +
        ' V ' + (bottom - r) +
        ' A ' + r + ' ' + r + ' 0 0 1 ' + (right - r) + ' ' + bottom +
        ' H ' + (x + r) +
        ' A ' + r + ' ' + r + ' 0 0 1 ' + x + ' ' + (bottom - r) +
        ' V ' + (y + r) +
        ' A ' + r + ' ' + r + ' 0 0 1 ' + (x + r) + ' ' + y +
        ' H ' + mid
      );
    }

    class CartWick extends HTMLElement {
      /* Deliberately does NOT look up its children here. connectedCallback
         fires the moment the element is inserted, and once the definition
         is registered that happens before the children are attached — so
         on a morph (which the drawer does on every cart update) every
         querySelector would return null. Collecting refs from the frame
         loop instead lets it pick them up as soon as they exist, and
         recover rather than dying until the next full page load. */
      connectedCallback() {
        this.ready = false;
        this.length = 0;
        this.lastProbe = 0;

        this.frameFn = () => {
          this.frame = window.requestAnimationFrame(this.frameFn);
          this.render();
        };

        /* Guard against two loops if connect fires without an
           intervening disconnect. */
        if (this.frame) window.cancelAnimationFrame(this.frame);
        this.frame = window.requestAnimationFrame(this.frameFn);
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
          this.observer = null;
        }
        if (this.frame) window.cancelAnimationFrame(this.frame);
        this.frame = null;
        this.ready = false;
      }

      collect() {
        this.svg = this.querySelector('.cart-wick__svg');
        this.rope = this.querySelector('.cart-wick__rope');
        this.edge = this.querySelector('.cart-wick__edge');
        this.spark = this.querySelector('.cart-wick__spark');
        this.button = this.parentElement && this.parentElement.querySelector('.cart__checkout-button');

        this.ready = !!(this.svg && this.rope && this.edge && this.spark && this.button);

        if (this.ready && !this.observer && 'ResizeObserver' in window) {
          this.observer = new ResizeObserver(() => this.measure());
          this.observer.observe(this.button);
        }

        return this.ready;
      }

      measure() {
        /* A morph can swap the button out from under us while leaving
           this element in place. A detached node reports zero size, which
           would look identical to a closed drawer and stall for good, so
           re-collect instead. */
        if (!this.button || !this.button.isConnected) {
          if (this.observer) {
            this.observer.disconnect();
            this.observer = null;
          }
          if (!this.collect()) {
            this.length = 0;
            return;
          }
        }

        var w = this.button.offsetWidth;
        var h = this.button.offsetHeight;

        /* Zero while the drawer's dialog is closed — there is no layout
           to read, so stand down until it opens. */
        if (!w || !h) {
          this.length = 0;
          return;
        }

        /* Follow whatever radius the checkout button settings produced,
           rather than assuming a pill. */
        var radius = parseFloat(getComputedStyle(this.button).borderTopLeftRadius) || 0;
        var inset = 1.5;
        var iw = w - inset * 2;
        var ih = h - inset * 2;
        var r = Math.max(0, Math.min(radius - inset, Math.min(iw, ih) / 2));
        var d = roundedRect(inset, inset, iw, ih, r);

        this.svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);
        this.svg.setAttribute('width', w);
        this.svg.setAttribute('height', h);
        this.rope.setAttribute('d', d);
        this.edge.setAttribute('d', d);

        this.length = this.rope.getTotalLength();

        /* Reaching here means the button has real layout, which only
           happens once the drawer is actually open (a closed dialog has
           none). Starting the clock here rather than on page load is
           what makes the 5 minutes run from the first cart opening. */
        startedAt();
      }

      render() {
        /* Keep retrying until the children are actually there. */
        if (!this.ready && !this.collect()) return;

        if (!this.length) {
          /* Re-probe occasionally in case the drawer opened without the
             ResizeObserver firing. Throttled because reading offsetWidth
             forces layout. */
          var now = Date.now();
          if (now - this.lastProbe > 250) {
            this.lastProbe = now;
            this.measure();
          }
          return;
        }

        var length = this.length;
        var at = Math.min(progress() * length, length);
        var left = Math.max(0, length - at);

        /* Show only the rope still to burn, the span from the spark round
           to the end. Dash `left` then gap `at` sums to exactly one
           perimeter, and starting the pattern `left` into itself puts the
           gap over [0, at] — the part already burnt — and the dash over
           [at, L]. `left` is used rather than the equivalent -at because
           a negative dash offset is invalid in SVG 1.1. */
        this.rope.style.strokeDasharray = left + ' ' + at;
        this.rope.style.strokeDashoffset = String(left);

        /* The hot length is clamped to what is left, so it shrinks into
           nothing at the finish rather than wrapping onto burnt rope. */
        var edge = Math.min(20, left);
        this.edge.style.strokeDasharray = edge + ' ' + Math.max(0.01, length - edge);
        this.edge.style.strokeDashoffset = String(left);

        var point = this.rope.getPointAtLength(at);
        this.spark.setAttribute('transform', 'translate(' + point.x + ' ' + point.y + ')');

        /* Only ever revealed once it has a real position, so it can never
           be caught sitting at the SVG's untransformed origin. */
        this.spark.style.opacity = left < 0.5 ? '0' : '1';
      }
    }

    customElements.define('cart-wick', CartWick);
  })();
</script>
