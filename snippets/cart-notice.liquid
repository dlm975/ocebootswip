{%- doc -%}
  A single boxed line above the cart items, with a pulsing blinker.
  Rendered from cart-products, so it appears in both the drawer and on the
  cart page. Content and colours come from Theme settings → Cart.
{%- enddoc -%}

{%- if settings.cart_notice_show and settings.cart_notice_text != blank -%}
  <div
    class="cart-notice{% unless settings.cart_notice_full_width %} cart-notice--hug{% endunless %}"
    style="
      --cn-bg: {{ settings.cart_notice_background }};
      --cn-fg: {{ settings.cart_notice_text_color }};
      --cn-dot: {{ settings.cart_notice_dot_color }};
      --cn-radius: {{ settings.cart_notice_radius }}px;
      --cn-size: {{ settings.cart_notice_size }}px;
      --cn-border-width: {{ settings.cart_notice_border_width }}px;
      --cn-border-color: {{ settings.cart_notice_border_color }};
    "
  >
    {%- if settings.cart_notice_blinker -%}
      <span class="cart-notice__dot" aria-hidden="true"></span>
    {%- endif -%}
    <span>{{ settings.cart_notice_text }}</span>
  </div>
{%- endif -%}

{% stylesheet %}
  .cart-notice {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-block-end: var(--margin-md, 12px);
    padding: 9px 14px;
    border-radius: var(--cn-radius, 12px);
    border: var(--cn-border-width, 0) solid var(--cn-border-color, transparent);
    background: var(--cn-bg, #e7f6ee);
    color: var(--cn-fg, #15803d);
    font-size: var(--cn-size, 12px);
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
  }

  .cart-notice--hug {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }

  .cart-notice__dot {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cn-dot, #16a34a);
    animation: cart-notice-pulse 1.8s ease-out infinite;
  }

  /* The ring expands out of the dot and fades. Scaling the dot itself would
     nudge the text beside it on every pulse. */
  @keyframes cart-notice-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--cn-dot, #16a34a) 65%, transparent);
    }

    70% {
      box-shadow: 0 0 0 8px transparent;
    }

    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-notice__dot {
      animation: none;
    }
  }
{% endstylesheet %}
