    75% { transform: translate3d(calc(var(--cn-rx) * 0.0000), calc(var(--cn-ry) * 1.0000), calc(var(--cn-rz) * -1.0000)); }
    77.7778% { transform: translate3d(calc(var(--cn-rx) * -0.3420), calc(var(--cn-ry) * 0.8660), calc(var(--cn-rz) * -0.9397)); }
    80.5556% { transform: translate3d(calc(var(--cn-rx) * -0.6428), calc(var(--cn-ry) * 0.5000), calc(var(--cn-rz) * -0.7660)); }
    83.3333% { transform: translate3d(calc(var(--cn-rx) * -0.8660), calc(var(--cn-ry) * 0.0000), calc(var(--cn-rz) * -0.5000)); }
    86.1111% { transform: translate3d(calc(var(--cn-rx) * -0.9848), calc(var(--cn-ry) * -0.5000), calc(var(--cn-rz) * -0.1736)); }
    88.8889% { transform: translate3d(calc(var(--cn-rx) * -0.9848), calc(var(--cn-ry) * -0.8660), calc(var(--cn-rz) * 0.1736)); }
    91.6667% { transform: translate3d(calc(var(--cn-rx) * -0.8660), calc(var(--cn-ry) * -1.0000), calc(var(--cn-rz) * 0.5000)); }
    94.4444% { transform: translate3d(calc(var(--cn-rx) * -0.6428), calc(var(--cn-ry) * -0.8660), calc(var(--cn-rz) * 0.7660)); }
    97.2222% { transform: translate3d(calc(var(--cn-rx) * -0.3420), calc(var(--cn-ry) * -0.5000), calc(var(--cn-rz) * 0.9397)); }
    100% { transform: translate3d(calc(var(--cn-rx) * -0.0000), calc(var(--cn-ry) * -0.0000), calc(var(--cn-rz) * 1.0000)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-notice__particle {
      animation: none;
      transform: translate3d(calc(var(--cn-rx) * -1), 0, 0);
    }
  }
{% endstylesheet %}
