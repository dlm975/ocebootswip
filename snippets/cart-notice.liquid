{%- doc -%}
  A single boxed line above the cart items, with a pulsing blinker.
  Rendered from cart-products, so it appears in both the drawer and on the
  cart page. Content and colours come from Theme settings → Cart.
{%- enddoc -%}

{%- liquid
  comment
    Every value falls back in Liquid rather than relying on the setting
    being present in settings_data.json. A setting that exists only as a
    schema default reads as nil here, which would blank the text, empty
    every custom property, and switch the whole notice off.
  endcomment
  assign notice_text = settings.cart_notice_text | default: 'Buy Now to secure FREE Shipping'

  assign show_notice = true
  if settings.cart_notice_show == false
    assign show_notice = false
  endif

  assign show_blinker = true
  if settings.cart_notice_blinker == false
    assign show_blinker = false
  endif

  assign hug = false
  if settings.cart_notice_full_width == false
    assign hug = true
  endif

  assign cn_bg = settings.cart_notice_background | default: '#e7f6ee'
  assign cn_fg = settings.cart_notice_text_color | default: '#15803d'
  assign cn_dot = settings.cart_notice_dot_color | default: '#16a34a'
  assign cn_radius = settings.cart_notice_radius | default: 12
  assign cn_size = settings.cart_notice_size | default: 12
  assign cn_bw = settings.cart_notice_border_width | default: 0
  assign cn_bc = settings.cart_notice_border_color | default: '#c9e7d6'
-%}

{%- if show_notice and notice_text != blank -%}
  <div
    class="cart-notice{% if hug %} cart-notice--hug{% endif %}"
    style="
      --cn-bg: {{ cn_bg }};
      --cn-fg: {{ cn_fg }};
      --cn-dot: {{ cn_dot }};
      --cn-radius: {{ cn_radius }}px;
      --cn-size: {{ cn_size }}px;
      --cn-border-width: {{ cn_bw }}px;
      --cn-border-color: {{ cn_bc }};
    "
  >
    {%- if show_blinker -%}
      <span class="cart-notice__dot" aria-hidden="true"></span>
    {%- endif -%}
    <span>{{ notice_text }}</span>
  </div>
{%- endif -%}

{% stylesheet %}
  .cart-notice {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-block-end: var(--margin-md, 12px);
    padding: 9px 14px;
    border-radius: var(--cn-radius, 12px);
    border: var(--cn-border-width, 0) solid var(--cn-border-color, transparent);
    background: var(--cn-bg, #e7f6ee);
    color: var(--cn-fg, #15803d);
    font-size: var(--cn-size, 12px);
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
  }

  .cart-notice--hug {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }

  .cart-notice__dot {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cn-dot, #16a34a);
    animation: cart-notice-pulse 1.8s ease-out infinite;
  }

  /* The ring expands out of the dot and fades. Scaling the dot itself would
     nudge the text beside it on every pulse. */
  @keyframes cart-notice-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--cn-dot, #16a34a) 65%, transparent);
    }

    70% {
      box-shadow: 0 0 0 8px transparent;
    }

    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-notice__dot {
      animation: none;
    }
  }
{% endstylesheet %}
