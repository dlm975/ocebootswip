    55.5556% { transform: translate3d(calc(var(--cn-rx) * 0.6428), calc(var(--cn-ry) * -0.8660), calc(var(--cn-rz) * 0.7660)); }
    58.3333% { transform: translate3d(calc(var(--cn-rx) * 0.8660), calc(var(--cn-ry) * -1.0000), calc(var(--cn-rz) * 0.5000)); }
    61.1111% { transform: translate3d(calc(var(--cn-rx) * 0.9848), calc(var(--cn-ry) * -0.8660), calc(var(--cn-rz) * 0.1736)); }
    63.8889% { transform: translate3d(calc(var(--cn-rx) * 0.9848), calc(var(--cn-ry) * -0.5000), calc(var(--cn-rz) * -0.1736)); }
    66.6667% { transform: translate3d(calc(var(--cn-rx) * 0.8660), calc(var(--cn-ry) * -0.0000), calc(var(--cn-rz) * -0.5000)); }
    69.4444% { transform: translate3d(calc(var(--cn-rx) * 0.6428), calc(var(--cn-ry) * 0.5000), calc(var(--cn-rz) * -0.7660)); }
