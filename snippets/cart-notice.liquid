    41.6667% { transform: translate3d(calc(var(--cn-rx) * -0.8660), calc(var(--cn-ry) * 1.0000), calc(var(--cn-rz) * 0.5000)); }
    44.4444% { transform: translate3d(calc(var(--cn-rx) * -0.6428), calc(var(--cn-ry) * 0.8660), calc(var(--cn-rz) * 0.7660)); }
    47.2222% { transform: translate3d(calc(var(--cn-rx) * -0.3420), calc(var(--cn-ry) * 0.5000), calc(var(--cn-rz) * 0.9397)); }
