{%- doc -%}
  "Secure free shipping" notice with a particle orbiting the pill in a 3D
  figure of eight. Rendered from cart-summary, between the total and the
  checkout button.
{%- enddoc -%}

{%- liquid
  comment
    Every value falls back in Liquid rather than relying on the setting
    being present in settings_data.json.
  endcomment
  assign notice_text = settings.cart_notice_text | default: 'SECURE FREE SHIPPING'

  assign show_notice = true
  if settings.cart_notice_show == false
    assign show_notice = false
  endif

  assign show_orbit = true
  if settings.cart_notice_blinker == false
    assign show_orbit = false
  endif

  assign hug = false
  if settings.cart_notice_full_width == false
    assign hug = true
  endif

  assign cn_bg = settings.cart_notice_background | default: '#e7f6ee'
  assign cn_fg = settings.cart_notice_text_color | default: '#15803d'
  assign cn_dot = settings.cart_notice_dot_color | default: '#16a34a'
  assign cn_radius = settings.cart_notice_radius | default: 12
  assign cn_size = settings.cart_notice_size | default: 12
  assign cn_bw = settings.cart_notice_border_width | default: 0
  assign cn_bc = settings.cart_notice_border_color | default: '#c9e7d6'
  assign cn_speed = settings.cart_notice_orbit_seconds | default: 5
-%}

{%- if show_notice and notice_text != blank -%}
  <div
    class="cart-notice{% if hug %} cart-notice--hug{% endif %}"
    style="
      --cn-bg: {{ cn_bg }};
      --cn-fg: {{ cn_fg }};
      --cn-dot: {{ cn_dot }};
      --cn-radius: {{ cn_radius }}px;
      --cn-size: {{ cn_size }}px;
      --cn-border-width: {{ cn_bw }}px;
      --cn-border-color: {{ cn_bc }};
      --cn-speed: {{ cn_speed }}s;
    "
  >
    <span class="cart-notice__body">{{ notice_text }}</span>

    {%- if show_orbit -%}
      <span class="cart-notice__orbit" aria-hidden="true">
        <i class="cart-notice__particle"></i>
      </span>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  /* The pill is a 3D stage. Its background lives on __body at z = 0 so the
     particle can be sorted in front of or behind it by depth alone — a
     descendant of the background element would always paint on top. */
  .cart-notice {
    /* The drawer summary is a flex column with align-items: center, so its
       children shrink-wrap. On top of that, container-type applies inline
       size containment, so the text inside stops contributing any width at
       all — together they collapsed the pill to a sliver and wrapped the
       label onto three lines. Both are settled by claiming the full width
       explicitly. */
    align-self: stretch;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;

    position: relative;
    display: flex;
    container-type: inline-size;
    perspective: 520px;
    transform-style: preserve-3d;
    margin-block-end: 0;

    /* Room for the orbit to swing outside the pill without being clipped */
    padding-inline: 14px;
    padding-block: 2px;
  }

  .cart-notice--hug {
    align-self: center;
    width: fit-content;
    min-width: min(260px, 100%);
    max-width: 100%;
    margin-inline: auto;
  }

  .cart-notice__body {
    position: relative;
    flex: 1 1 auto;
    transform: translateZ(0);
    padding: 9px 14px;
    border-radius: var(--cn-radius, 12px);
    border: var(--cn-border-width, 0) solid var(--cn-border-color, transparent);
    background: var(--cn-bg, #e7f6ee);
    color: var(--cn-fg, #15803d);
    font-size: var(--cn-size, 12px);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
  }

  .cart-notice__orbit {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  .cart-notice__particle {
    /* x spans the pill via container units so the path tracks its width;
       y is taller than the pill so the loops break above and below it;
       z is deep enough to pass clearly behind. */
    --cn-rx: 44cqw;
    --cn-ry: 21px;
    --cn-rz: 62px;

    position: absolute;
    top: 50%;
    left: 50%;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--cn-dot, #16a34a);
    box-shadow: 0 0 10px var(--cn-dot, #16a34a);
    animation: cart-notice-orbit var(--cn-speed, 5s) linear infinite;
  }

@keyframes cart-notice-orbit {
    0% { transform: translate3d(calc(var(--cn-rx) * 0.0000), calc(var(--cn-ry) * 0.0000), calc(var(--cn-rz) * 1.0000)); }
    2.7778% { transform: translate3d(calc(var(--cn-rx) * 0.3420), calc(var(--cn-ry) * 0.5000), calc(var(--cn-rz) * 0.9397)); }
    5.5556% { transform: translate3d(calc(var(--cn-rx) * 0.6428), calc(var(--cn-ry) * 0.8660), calc(var(--cn-rz) * 0.7660)); }
    8.3333% { transform: translate3d(calc(var(--cn-rx) * 0.8660), calc(var(--cn-ry) * 1.0000), calc(var(--cn-rz) * 0.5000)); }
    11.1111% { transform: translate3d(calc(var(--cn-rx) * 0.9848), calc(var(--cn-ry) * 0.8660), calc(var(--cn-rz) * 0.1736)); }
    13.8889% { transform: translate3d(calc(var(--cn-rx) * 0.9848), calc(var(--cn-ry) * 0.5000), calc(var(--cn-rz) * -0.1736)); }
    16.6667% { transform: translate3d(calc(var(--cn-rx) * 0.8660), calc(var(--cn-ry) * 0.0000), calc(var(--cn-rz) * -0.5000)); }
    19.4444% { transform: translate3d(calc(var(--cn-rx) * 0.6428), calc(var(--cn-ry) * -0.5000), calc(var(--cn-rz) * -0.7660)); }
    22.2222% { transform: translate3d(calc(var(--cn-rx) * 0.3420), calc(var(--cn-ry) * -0.8660), calc(var(--cn-rz) * -0.9397)); }
    25% { transform: translate3d(calc(var(--cn-rx) * 0.0000), calc(var(--cn-ry) * -1.0000), calc(var(--cn-rz) * -1.0000)); }
    27.7778% { transform: translate3d(calc(var(--cn-rx) * -0.3420), calc(var(--cn-ry) * -0.8660), calc(var(--cn-rz) * -0.9397)); }
    30.5556% { transform: translate3d(calc(var(--cn-rx) * -0.6428), calc(var(--cn-ry) * -0.5000), calc(var(--cn-rz) * -0.7660)); }
    33.3333% { transform: translate3d(calc(var(--cn-rx) * -0.8660), calc(var(--cn-ry) * -0.0000), calc(var(--cn-rz) * -0.5000)); }
    36.1111% { transform: translate3d(calc(var(--cn-rx) * -0.9848), calc(var(--cn-ry) * 0.5000), calc(var(--cn-rz) * -0.1736)); }
