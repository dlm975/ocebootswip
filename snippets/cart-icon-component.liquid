{%- doc -%}
  Renders the cart icon, which displays the number of items in the cart via a bubble.
{%- enddoc -%}
<cart-icon
  class="
    header-actions__cart-icon
    {% unless cart == empty %} header-actions__cart-icon--has-cart{% endunless %}
  "
  data-testid="cart-icon"
>
  <span
    class="svg-wrapper"
    aria-hidden="true"
  >
    {{ 'icon-cart.svg' | inline_asset_content }}
  </span>

  {% render 'cart-bubble', limit: 100, live_region: true, test_id: test_id %}
</cart-icon>

{% stylesheet %}
  cart-icon:has(.cart-bubble__text-count:empty) {
    --cart-bubble-size: 10px;
    --cart-bubble-top: 9px;
    --cart-bubble-right: 9px;

    .svg-wrapper {
      --cart-bubble-top: 4px;
      --cart-bubble-right: 4px;
    }
  }

  /* Red blinker — shown only while the cart holds something. The
     has-cart class is set server-side and re-toggled by cart-icon.js on
     every cart:update, so it follows add and remove without a reload. */
  /* Doubled class deliberately: header-actions.liquid sets
     --cart-bubble-size on this same element at single-class specificity,
     so a plain .--has-cart rule would win or lose on stylesheet order.
     The theme uses the same doubled pattern for the glyph mask. */
  .header-actions__cart-icon.header-actions__cart-icon--has-cart {
    --cart-blinker-color: #ff1f1f;

    /* Overrides the header's 20px. The donut mask cut into the cart
       glyph is sized from this same variable, so the notch shrinks with
       the dot rather than leaving a gap around it. */
    --cart-bubble-size: 14px;
  }

  /* The blink sits on the bubble, not on its background: the background
     is already the target of the theme's add-to-cart "grow" animation at
     the same specificity, and one element can only run one of them. */
  .header-actions__cart-icon--has-cart .cart-bubble {
    animation: cartBlinkerBlink 1.1s ease-in-out infinite;
  }

  .header-actions__cart-icon--has-cart .cart-bubble__background {
    background-color: var(--cart-blinker-color);
    box-shadow: 0 0 9px 1px rgb(255 31 31 / 80%);
  }

  .header-actions__cart-icon--has-cart .cart-bubble__text {
    color: #fff;
    font-size: 9px;
    font-weight: 700;
  }

  /* Halo ring. A pseudo-element on the background keeps it out of the
     markup, and painting it here leaves it under the count, which has
     its own stacking level. */
  .header-actions__cart-icon--has-cart .cart-bubble__background::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background-color: var(--cart-blinker-color);
    animation: cartBlinkerPulse 1.1s ease-out infinite;
    pointer-events: none;
  }

  /* A hard on/off swing rather than a gentle fade — the steep holds at
     each end are what make it read as a blink instead of a breathe. The
     scale pop adds size change on top of the brightness change. */
  @keyframes cartBlinkerBlink {
    0%,
    40% {
      opacity: 1;
      transform: scale(1.12);
    }

    55%,
    90% {
      opacity: 0.12;
      transform: scale(0.88);
    }

    100% {
      opacity: 1;
      transform: scale(1.12);
    }
  }

  @keyframes cartBlinkerPulse {
    0% {
      opacity: 0.75;
      transform: scale(1);
    }

    65%,
    100% {
      opacity: 0;
      transform: scale(3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-actions__cart-icon--has-cart .cart-bubble,
    .header-actions__cart-icon--has-cart .cart-bubble__background::after {
      animation: none;
    }

    .header-actions__cart-icon--has-cart .cart-bubble__background::after {
      content: none;
    }
  }
{% endstylesheet %}
