{%- doc -%}
  Renders the cart icon, which displays the number of items in the cart via a bubble.
{%- enddoc -%}
<cart-icon
  class="
    header-actions__cart-icon
    {% unless cart == empty %} header-actions__cart-icon--has-cart{% endunless %}
  "
  data-testid="cart-icon"
>
  <span
    class="svg-wrapper"
    aria-hidden="true"
  >
    {{ 'icon-cart.svg' | inline_asset_content }}
  </span>

  {% render 'cart-bubble', limit: 100, live_region: true, test_id: test_id %}
</cart-icon>

{% stylesheet %}
  cart-icon:has(.cart-bubble__text-count:empty) {
    --cart-bubble-size: 10px;
    --cart-bubble-top: 9px;
    --cart-bubble-right: 9px;

    .svg-wrapper {
      --cart-bubble-top: 4px;
      --cart-bubble-right: 4px;
    }
  }

  /* Red blinker — shown only while the cart holds something. The
     has-cart class is set server-side and re-toggled by cart-icon.js on
     every cart:update, so it follows add and remove without a reload. */
  .header-actions__cart-icon--has-cart {
    --cart-blinker-color: #e02b2b;
  }

  /* The blink sits on the bubble, not on its background: the background
     is already the target of the theme's add-to-cart "grow" animation at
     the same specificity, and one element can only run one of them. */
  .header-actions__cart-icon--has-cart .cart-bubble {
    animation: cartBlinkerBlink 1.8s ease-in-out infinite;
  }

  .header-actions__cart-icon--has-cart .cart-bubble__background {
    background-color: var(--cart-blinker-color);
  }

  .header-actions__cart-icon--has-cart .cart-bubble__text {
    color: #fff;
  }

  /* Halo ring. A pseudo-element on the background keeps it out of the
     markup, and painting it here leaves it under the count, which has
     its own stacking level. */
  .header-actions__cart-icon--has-cart .cart-bubble__background::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background-color: var(--cart-blinker-color);
    animation: cartBlinkerPulse 1.8s ease-out infinite;
    pointer-events: none;
  }

  @keyframes cartBlinkerBlink {
    0%,
    55%,
    100% {
      opacity: 1;
    }

    75% {
      opacity: 0.45;
    }
  }

  @keyframes cartBlinkerPulse {
    0% {
      opacity: 0.5;
      transform: scale(1);
    }

    70%,
    100% {
      opacity: 0;
      transform: scale(2.4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-actions__cart-icon--has-cart .cart-bubble,
    .header-actions__cart-icon--has-cart .cart-bubble__background::after {
      animation: none;
    }

    .header-actions__cart-icon--has-cart .cart-bubble__background::after {
      content: none;
    }
  }
{% endstylesheet %}
