{%- doc -%}
  The Boot Match mark: one flame (a small tongue each side of a tall one) whose round body is a
  football, its panels cut out so whatever is behind shows through. Drawn in fire colours, from
  deep red at the base to gold at the tip.

  @param {string} id - A unique id for the gradient and mask (more than one mark can be on a page)
  @param {string} [class] - Classes for the svg
{%- enddoc -%}
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="16 0 68 100"
  aria-hidden="true"
  focusable="false"
  {%- if class %}
    class="{{ class }}"
  {%- endif %}
>
  <defs>
    <linearGradient id="{{ id }}-fire" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#e0201b"/>
      <stop offset="0.55" stop-color="#ff6a00"/>
      <stop offset="1" stop-color="#ffc531"/>
    </linearGradient>
    <mask id="{{ id }}-ball" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
      {%- comment -%} The flame, white; the ball's panels, black (cut out) {%- endcomment -%}
      <path fill="#fff" d="M50 96 A30 30 0 0 1 20 66 C20 51 22 40 27 30 C30 38 33 42 37 44 C37 28 44 14 52 3 C58 15 66 26 64 40 C68 36 72 31 76 25 C80 36 80 50 80 66 A30 30 0 0 1 50 96 Z"/>
      <path fill="#000" d="M50.00 57.40 L58.18 63.34 L55.05 72.96 L44.95 72.96 L41.82 63.34 Z M69.22 39.55 L72.20 48.71 L64.40 54.38 L56.60 48.71 L59.58 39.55 Z M81.10 76.10 L73.30 81.77 L65.50 76.10 L68.48 66.94 L78.12 66.94 Z M50.00 98.70 L42.20 93.03 L45.18 83.87 L54.82 83.87 L57.80 93.03 Z M18.90 76.10 L21.88 66.94 L31.52 66.94 L34.50 76.10 L26.70 81.77 Z M30.78 39.55 L40.42 39.55 L43.40 48.71 L35.60 54.38 L27.80 48.71 Z"/>
    </mask>
  </defs>
  <rect x="0" y="0" width="100" height="100" fill="url(#{{ id }}-fire)" mask="url(#{{ id }}-ball)"/>
</svg>
