{%- doc -%}
  Five stars and a short line of social proof, above the cart items.
  Rendered from cart-products, so it shows in the drawer and on the cart
  page. Text and colours come from Theme settings → Cart.
{%- enddoc -%}

{%- liquid
  comment
    Values fall back in Liquid so this works whether or not the settings
    have reached settings_data.json.
  endcomment
  assign show_stars = true
  if settings.cart_stars_show == false
    assign show_stars = false
  endif

  assign stars_text = settings.cart_stars_text | default: '1000+ HAPPY CUSTOMERS'
  assign star_color = settings.cart_stars_color | default: '#16a34a'
  assign star_text_color = settings.cart_stars_text_color | default: '#15803d'
  assign star_size = settings.cart_stars_size | default: 15
-%}

{%- if show_stars and stars_text != blank -%}
  <div
    class="cart-stars"
    style="
      --cs-color: {{ star_color }};
      --cs-fg: {{ star_text_color }};
      --cs-size: {{ star_size }}px;
    "
  >
    <span class="cart-stars__row" aria-hidden="true">
      {%- for i in (1..5) -%}
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      {%- endfor -%}
    </span>
    <span class="cart-stars__text">{{ stars_text }}</span>
  </div>
{%- endif -%}

{% stylesheet %}
  .cart-stars {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px 8px;
    width: 100%;
    margin-block-end: 12px;
  }

  .cart-stars__row {
    display: inline-flex;
    gap: 2px;
    color: var(--cs-color, #16a34a);
  }

  .cart-stars__row svg {
    width: var(--cs-size, 15px);
    height: var(--cs-size, 15px);
    display: block;
  }

  .cart-stars__text {
    color: var(--cs-fg, #15803d);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }
{% endstylesheet %}
