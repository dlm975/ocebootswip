{%- doc -%}
  Five stars and a short line of social proof, above the cart items.
  Rendered from cart-products, so it shows in the drawer and on the cart
  page. Text and colours come from Theme settings → Cart.
{%- enddoc -%}

{%- liquid
  comment
    Values fall back in Liquid so this works whether or not the settings
    have reached settings_data.json.
  endcomment
  assign show_stars = true
  if settings.cart_stars_show == false
    assign show_stars = false
  endif

  assign stars_text = settings.cart_stars_text | default: '1000+ HAPPY CUSTOMERS'
  assign star_color = settings.cart_stars_color | default: '#25D366'
  assign star_text_color = settings.cart_stars_text_color | default: '#121212'
  assign star_size = settings.cart_stars_size | default: 15
-%}

{%- if show_stars and stars_text != blank -%}
  <div
    class="cart-stars"
    style="
      --cs-color: {{ star_color }};
      --cs-fg: {{ star_text_color }};
      --cs-size: {{ star_size }}px;
    "
  >
    <span class="cart-stars__row oce-stars" aria-hidden="true"></span>
    <span class="cart-stars__text">{{ stars_text }}</span>
  </div>
{%- endif -%}

{% stylesheet %}
  /* Sits inside .cart__total-container, a flex column, immediately above
     the TOTAL row. Stretch rather than the container's own alignment so
     it spans the full width and centres its own contents. */
  .cart-stars {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px 8px;
    align-self: stretch;
    width: 100%;
    margin-block-end: 4px;
  }

  /* Stars in the holographic foil (assets/base.css .oce-stars) */
  .cart-stars__row {
    --oce-star: var(--cs-size, 15px);
  }

  .cart-stars__text {
    color: var(--cs-fg, #121212);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.01em;
    line-height: 1.2;
  }
{% endstylesheet %}
