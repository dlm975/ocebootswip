{% comment %} Shop By Size floating widget {% endcomment %}
{%- liquid
  # Apply the size filter to whatever collection we're currently on,
  # instead of always redirecting to all-football-boots
  assign sbz_base_url = '/collections/all-football-boots'
  if template.name == 'collection' and collection != blank
    assign sbz_base_url = collection.url
  endif
-%}

<!-- Floating trigger -->
<button id="sbz-trigger" aria-label="Shop by size">
  <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true" style="flex-shrink:0">
    <rect x="1" y="1" width="7.5" height="7.5" rx="1.5"/>
    <rect x="11.5" y="1" width="7.5" height="7.5" rx="1.5"/>
    <rect x="1" y="11.5" width="7.5" height="7.5" rx="1.5"/>
    <rect x="11.5" y="11.5" width="7.5" height="7.5" rx="1.5"/>
  </svg>
  <span>Shop By Size</span>
</button>

<!-- Overlay -->
<div id="sbz-overlay" aria-hidden="true" role="dialog" aria-label="Shop by size" aria-modal="true">
  <div class="sbz-backdrop" id="sbz-backdrop"></div>
  <div class="sbz-panel">

    <div class="sbz-grabber" aria-hidden="true"></div>

    <button class="sbz-close" id="sbz-close" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" width="18" height="18">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <h2 class="sbz-title">Shop By Size</h2>

    <!-- Segmented control -->
    <div class="sbz-switcher" id="sbz-switcher" role="group" aria-label="Size system">
      <button class="sbz-sys sbz-sys-active" data-sys="us">US</button>
      <button class="sbz-sys" data-sys="uk">UK</button>
      <button class="sbz-sys" data-sys="eu">EU</button>
      <span class="sbz-switcher-pill" id="sbz-switcher-pill" aria-hidden="true"></span>
    </div>

    <!-- Size grids — built by JS -->
    <div class="sbz-grid" id="sbz-grid-us" data-sys="us"></div>
    <div class="sbz-grid sbz-grid-hidden" id="sbz-grid-uk" data-sys="uk"></div>
    <div class="sbz-grid sbz-grid-hidden" id="sbz-grid-eu" data-sys="eu"></div>

    <!-- Shop Now -->
    <a class="sbz-shop-btn" id="sbz-shop-btn" href="#" aria-disabled="true">
      Shop Now
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </a>

  </div>
</div>

<style>
  /* --- Floating trigger --- */
  #sbz-trigger {
    position: fixed;
    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    left: 24px;
    z-index: 9000;
    height: 52px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(10, 10, 10, 0.82);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    backdrop-filter: blur(16px) saturate(180%);
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    box-shadow: 0 10px 28px -8px rgba(0, 0, 0, 0.45);
    transition: transform 0.2s cubic-bezier(0.32, 0.72, 0, 1), box-shadow 0.2s ease, background 0.2s ease;
    white-space: nowrap;
  }

  #sbz-trigger:hover {
    background: rgba(30, 30, 30, 0.92);
    transform: translateY(-2px);
    box-shadow: 0 14px 34px -8px rgba(0, 0, 0, 0.55);
  }

  #sbz-trigger:active { transform: scale(0.95); }

  /* --- Overlay --- */
  #sbz-overlay {
    position: fixed;
    inset: 0;
    z-index: 9998;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  #sbz-overlay.sbz-open {
    opacity: 1;
    pointer-events: all;
    /* block background page scroll on touch without locking body
       (body locks break inner scrolling on iOS Safari) */
    touch-action: none;
  }

  .sbz-backdrop {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(0px) brightness(1);
    transition: backdrop-filter 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #sbz-overlay.sbz-open .sbz-backdrop {
    backdrop-filter: blur(18px) brightness(0.45);
  }

  /* --- Panel: centered dialog on desktop, bottom sheet on mobile --- */
  .sbz-panel {
    position: relative;
    z-index: 1;
    background: #111111;
    border-radius: 22px;
    width: min(480px, 94vw);
    max-height: 88dvh;
    overflow-y: scroll;
    touch-action: pan-y;
    overscroll-behavior: contain;
    scrollbar-width: none;
    padding: 28px 24px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    transform: translateY(16px);
    transition: transform 0.38s cubic-bezier(0.32, 0.72, 0, 1);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6);
  }

  .sbz-panel::-webkit-scrollbar { display: none; }

  #sbz-overlay.sbz-open .sbz-panel {
    transform: translateY(0);
  }

  /* iOS-style grabber handle, sheet mode only */
  .sbz-grabber {
    display: none;
    width: 36px;
    height: 5px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.22);
    flex-shrink: 0;
    margin: -8px 0 -6px;
  }

  @media screen and (max-width: 749px) {
    #sbz-overlay { align-items: flex-end; }

    .sbz-panel {
      width: 100%;
      max-height: 86dvh;
      border-radius: 22px 22px 0 0;
      padding-bottom: calc(28px + env(safe-area-inset-bottom, 0px));
      transform: translateY(100%);
    }

    .sbz-grabber { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    #sbz-overlay, .sbz-backdrop, .sbz-panel { transition-duration: 0.01s; }
  }

  /* --- Close --- */
  .sbz-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    background: rgba(255, 255, 255, 0.08);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.6);
    transition: background 0.15s, color 0.15s;
    padding: 0;
  }

  .sbz-close:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
  }

  /* --- Title --- */
  .sbz-title {
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin: 0;
  }

  /* --- Segmented control (Apple style) --- */
  .sbz-switcher {
    position: relative;
    display: flex;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 3px;
    width: 100%;
    max-width: 280px;
  }

  .sbz-sys {
    flex: 1;
    padding: 8px 0;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    cursor: pointer;
    position: relative;
    z-index: 1;
    transition: color 0.2s ease;
    border-radius: 999px;
  }

  .sbz-sys.sbz-sys-active {
    color: #111111;
  }

  /* Sliding white pill */
  .sbz-switcher-pill {
    position: absolute;
    top: 3px;
    left: 3px;
    width: calc(33.333% - 2px);
    height: calc(100% - 6px);
    background: #ffffff;
    border-radius: 999px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  /* --- Size grid --- */
  .sbz-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 7px;
    width: 100%;
  }

  .sbz-grid-hidden {
    display: none;
  }

  .sbz-size-btn {
    padding: 10px 4px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.8);
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    text-align: center;
    transition: background 0.15s, border-color 0.15s, color 0.15s, transform 0.15s cubic-bezier(0.32, 0.72, 0, 1);
    white-space: nowrap;
  }

  .sbz-size-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.22);
    color: #ffffff;
  }

  .sbz-size-btn,
  .sbz-sys,
  .sbz-close {
    -webkit-tap-highlight-color: transparent;
  }

  .sbz-size-btn:active { transform: scale(0.93); }

  .sbz-size-btn.sbz-size-selected {
    background: #ffffff;
    border-color: #ffffff;
    color: #111111;
    font-weight: 700;
  }

  /* --- Shop Now --- */
  .sbz-shop-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 32px;
    background: #ffffff;
    color: #111111;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
    border-radius: 999px;
    opacity: 0.25;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
  }

  .sbz-shop-btn.sbz-shop-active {
    opacity: 1;
    pointer-events: auto;
  }

  .sbz-shop-btn.sbz-shop-active:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  }
</style>

<script>
  (function () {
    const trigger  = document.getElementById('sbz-trigger');
    const overlay  = document.getElementById('sbz-overlay');
    const backdrop = document.getElementById('sbz-backdrop');
    const closeBtn = document.getElementById('sbz-close');
    const switcher = document.getElementById('sbz-switcher');
    const pill     = document.getElementById('sbz-switcher-pill');
    const shopBtn  = document.getElementById('sbz-shop-btn');

    const SYSTEMS = {
      us: [6.5, 7, 7.5, 8, 8.5, 9, 9.5, 10, 10.5, 11, 11.5, 12, 12.5, 13],
      uk: [5.5, 6, 6.5, 7, 7.5, 8, 8.5, 9, 9.5, 10, 10.5, 11, 11.5, 12],
      eu: [39, 40, 40.5, 41, 42, 42.5, 43, 44, 44.5, 45, 45.5, 46, 47, 47.5]
    };

    /* Filter query strings only — the collection they get applied to is
       resolved at render time to whichever collection the shopper is on
       (falls back to all-football-boots off-collection), so choosing a
       size filters the current collection instead of leaving it. */
    const BASE_URL = {{ sbz_base_url | json }};

    /* ─────────────────────────────────────────────────────────────
       Variant option values are exact-match against these strings.
       This table was captured from the live catalogue's facet values
       (post-rename, 2026-09-08) — the real data mixes plain EU sizes
       ("EU 41"), adidas thirds ("EU 41 1/3"), a couple of entries
       missing the "EU" prefix, and brand-dependent EU assignments,
       so the strings are listed verbatim rather than generated.

       Shopify ORs multiple filter.v.option.size values and ignores
       ones that match nothing, so extra values are harmless. If new
       size strings are added to the catalogue, add them here too.
       ───────────────────────────────────────────────────────────── */

    /* Exact option values per US size button. */
    const US_VALUES = {
      '6.5':  ['US 6.5 - UK 6 - EU 39', 'US 6.5 - UK 5.5 - EU 39', 'US 6.5 - UK 5.5'],
      '7':    ['US 7 - UK 6 - EU 40', 'US 7 - UK 6.5 - EU 40'],
      '7.5':  ['US 7.5 - UK 6.5 - EU 40.5', 'US 7.5 - UK 7 - EU 40 2/3'],
      '8':    ['US 8 - UK 7 - EU 41', 'US 8 - UK 7.5 - EU 41 1/3'],
      '8.5':  ['US 8.5 - UK 7.5 - EU 41', 'US 8.5 - UK 7.5 - EU 42', 'US 8.5 - UK 8 - EU 42'],
      '9':    ['US 9 - UK 8 - EU 42', 'US 9 - UK 8 - EU 42.5', 'US 9 - UK 8.5 - EU 42 2/3'],
      '9.5':  ['US 9.5 - UK 8.5 - EU 43', 'US 9.5 - UK 9 - EU 43 1/3'],
      '10':   ['US 10 - UK 9 - EU 43', 'US 10 - UK 9 - EU 44', 'US 10 - UK 9.5 - EU 44'],
      '10.5': ['US 10.5 - UK 9.5 - EU 44', 'US 10.5 - UK 9.5 - EU 44.5', 'US 10.5 - UK 10 - EU 44 2/3'],
      '11':   ['US 11 - UK 10 - EU 45', 'US 11 - UK 10.5 - EU 45 1/3'],
      '11.5': ['US 11.5 - UK 10.5 - EU 45', 'US 11.5 - UK 10.5 - EU 45.5', 'US 11.5 - UK 11 - EU 46'],
      '12':   ['US 12 - UK 11 - EU 46', 'US 12 - UK 11.5 - EU 46 2/3'],
      '12.5': ['US 12.5 - UK 11.5 - EU 47'],
      '13':   ['US 13 - UK 12 - EU 47.5', 'US 13 - UK 12.5 - EU 48', 'US 13 - UK 12.5 - 48']
    };

    /* UK buttons cut across US rows (a UK size can appear in two US
       sizes' mappings), so they get their own table. */
    const UK_VALUES = {
      '5.5':  ['US 6.5 - UK 5.5 - EU 39', 'US 6.5 - UK 5.5'],
      '6':    ['US 6.5 - UK 6 - EU 39', 'US 7 - UK 6 - EU 40'],
      '6.5':  ['US 7 - UK 6.5 - EU 40', 'US 7.5 - UK 6.5 - EU 40.5'],
      '7':    ['US 7.5 - UK 7 - EU 40 2/3', 'US 8 - UK 7 - EU 41'],
      '7.5':  ['US 8 - UK 7.5 - EU 41 1/3', 'US 8.5 - UK 7.5 - EU 41', 'US 8.5 - UK 7.5 - EU 42'],
      '8':    ['US 8.5 - UK 8 - EU 42', 'US 9 - UK 8 - EU 42', 'US 9 - UK 8 - EU 42.5'],
      '8.5':  ['US 9 - UK 8.5 - EU 42 2/3', 'US 9.5 - UK 8.5 - EU 43'],
      '9':    ['US 9.5 - UK 9 - EU 43 1/3', 'US 10 - UK 9 - EU 43', 'US 10 - UK 9 - EU 44'],
      '9.5':  ['US 10 - UK 9.5 - EU 44', 'US 10.5 - UK 9.5 - EU 44', 'US 10.5 - UK 9.5 - EU 44.5'],
      '10':   ['US 10.5 - UK 10 - EU 44 2/3', 'US 11 - UK 10 - EU 45'],
      '10.5': ['US 11 - UK 10.5 - EU 45 1/3', 'US 11.5 - UK 10.5 - EU 45', 'US 11.5 - UK 10.5 - EU 45.5'],
      '11':   ['US 11.5 - UK 11 - EU 46', 'US 12 - UK 11 - EU 46'],
      '11.5': ['US 12 - UK 11.5 - EU 46 2/3', 'US 12.5 - UK 11.5 - EU 47'],
      '12':   ['US 13 - UK 12 - EU 47.5']
    };

    /* EU buttons share the corresponding US size's value set. */
    const EU_TO_US = {
      '39': '6.5', '40': '7', '40.5': '7.5', '41': '8', '42': '8.5',
      '42.5': '9', '43': '9.5', '44': '10', '44.5': '10.5', '45': '11',
      '45.5': '11.5', '46': '12', '47': '12.5', '47.5': '13'
    };

    /* Build "filter.v.option.size=...&..." query strings, deduped,
       encoded to match Shopify's own filter URLs (spaces as +). */
    function buildQuery(values) {
      var seen = {};
      return values
        .filter(function (v) { if (seen[v]) return false; seen[v] = true; return true; })
        .map(function (v) {
          return 'filter.v.option.size=' + encodeURIComponent(v).replace(/%20/g, '+');
        })
        .join('&') + '&sort_by=created-descending&grid=default';
    }

    const QUERIES = { us: {}, uk: {}, eu: {} };
    Object.keys(US_VALUES).forEach(function (s) { QUERIES.us[s] = buildQuery(US_VALUES[s]); });
    Object.keys(UK_VALUES).forEach(function (s) { QUERIES.uk[s] = buildQuery(UK_VALUES[s]); });
    Object.keys(EU_TO_US).forEach(function (s) { QUERIES.eu[s] = buildQuery(US_VALUES[EU_TO_US[s]]); });

    let activeSys = 'us';
    let selectedSize = null;

    /* Build grids once */
    Object.keys(SYSTEMS).forEach(function (sys) {
      var grid = document.getElementById('sbz-grid-' + sys);
      SYSTEMS[sys].forEach(function (size) {
        var btn = document.createElement('button');
        btn.className = 'sbz-size-btn';
        btn.dataset.sys = sys;
        btn.dataset.size = size;
        btn.textContent = String(size);
        btn.addEventListener('click', function () { selectSize(sys, size, btn); });
        grid.appendChild(btn);
      });
    });

    function selectSize(sys, size, btn) {
      document.querySelectorAll('#sbz-grid-' + sys + ' .sbz-size-btn').forEach(function (b) {
        b.classList.remove('sbz-size-selected');
      });
      btn.classList.add('sbz-size-selected');
      selectedSize = size;

      const query = QUERIES[sys][String(size)];
      shopBtn.href = query ? (BASE_URL + '?' + query) : '#';
      shopBtn.classList.add('sbz-shop-active');
      shopBtn.removeAttribute('aria-disabled');
    }

    function setSys(sys) {
      /* Update button states */
      var sysBtns = switcher.querySelectorAll('.sbz-sys');
      var idx = 0;
      sysBtns.forEach(function (btn, i) {
        btn.classList.remove('sbz-sys-active');
        if (btn.dataset.sys === sys) {
          btn.classList.add('sbz-sys-active');
          idx = i;
        }
      });

      /* Slide the pill */
      pill.style.transform = 'translateX(calc(' + idx + ' * (100% + 2px)))';

      /* Swap grids */
      Object.keys(SYSTEMS).forEach(function (s) {
        var grid = document.getElementById('sbz-grid-' + s);
        grid.classList.toggle('sbz-grid-hidden', s !== sys);
      });

      /* Reset selection if switching system */
      if (sys !== activeSys) {
        selectedSize = null;
        shopBtn.classList.remove('sbz-shop-active');
        shopBtn.href = '#';
        shopBtn.setAttribute('aria-disabled', 'true');
      }

      activeSys = sys;
    }

    switcher.querySelectorAll('.sbz-sys').forEach(function (btn) {
      btn.addEventListener('click', function () { setSys(btn.dataset.sys); });
    });

    function openWidget() {
      overlay.classList.add('sbz-open');
      overlay.setAttribute('aria-hidden', 'false');
    }

    function closeWidget() {
      overlay.classList.remove('sbz-open');
      overlay.setAttribute('aria-hidden', 'true');
    }

    trigger.addEventListener('click', openWidget);
    closeBtn.addEventListener('click', closeWidget);
    backdrop.addEventListener('click', closeWidget);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.classList.contains('sbz-open')) closeWidget();
    });
  })();
</script>
