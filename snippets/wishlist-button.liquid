{%- doc -%}
  Heart that saves a product to the wishlist (assets/wishlist.js): an ink outline that turns red
  and fills when saved. On product cards it sits in the image's top-right corner.

  @param {object} product - The product
  @param {string} [class] - Extra classes, e.g. 'wishlist-toggle--card'
{%- enddoc -%}
<button
  type="button"
  class="wishlist-toggle{% if class %} {{ class }}{% endif %}"
  data-wishlist-toggle
  data-handle="{{ product.handle }}"
  data-title="{{ product.title | escape }}"
  aria-pressed="false"
  aria-label="Save {{ product.title | escape }} to wishlist"
>
  <span
    class="wishlist-toggle__icon"
    aria-hidden="true"
  >
    {%- render 'wishlist-heart-svg', class: 'wishlist-toggle__heart wishlist-toggle__heart--outline' -%}
    {%- render 'wishlist-heart-svg', filled: true, class: 'wishlist-toggle__heart wishlist-toggle__heart--filled' -%}
  </span>
</button>

{% stylesheet %}
  /* Just the heart: ink outline, red and filled once saved */
  .wishlist-toggle {
    --wishlist-red: #e8323c;

    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: #121212;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .wishlist-toggle:focus-visible {
    outline: 2px solid #121212;
    outline-offset: -2px;
  }

  .wishlist-toggle__icon {
    display: grid;
    width: 24px;
    height: 24px;
  }

  .wishlist-toggle__heart {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
  }

  /* Saved: a red heart grows in over the outline, which turns red with it */
  .wishlist-toggle__heart--filled {
    color: var(--wishlist-red);
    opacity: 0;
    transform: scale(0.4);
  }

  .wishlist-toggle[aria-pressed='true'] .wishlist-toggle__heart--filled {
    opacity: 1;
    transform: none;
  }

  .wishlist-toggle[aria-pressed='true'] .wishlist-toggle__heart--outline {
    color: var(--wishlist-red);
  }

  [data-wishlist-ready] .wishlist-toggle__heart--filled {
    transition: opacity 0.2s ease, transform 0.42s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  [data-wishlist-ready] .wishlist-toggle__heart--outline {
    transition: color 0.2s ease;
  }

  /* On product cards: the image's top-right corner */
  .wishlist-toggle--card {
    --wishlist-offset: 2px;

    position: absolute;
    inset-block-start: calc(var(--wishlist-offset) + var(--padding-block-start, 0px));
    inset-inline-end: calc(var(--wishlist-offset) + var(--padding-inline-end, 0px));
    z-index: var(--layer-raised, 2);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-wishlist-ready] .wishlist-toggle__heart--filled,
    [data-wishlist-ready] .wishlist-toggle__heart--outline {
      transition: none;
    }
  }
{% endstylesheet %}
