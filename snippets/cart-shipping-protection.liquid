{%- doc -%}
  Shipping protection add-on: a switch that adds or removes a real product
  from the cart. Rendered above the cart total.
{%- enddoc -%}

{%- liquid
  assign sp_product = settings.cart_protection_product
  assign sp_variant = sp_product.variants.first

  assign sp_on = false
  assign sp_key = ''
  for item in cart.items
    if item.variant_id == sp_variant.id
      assign sp_on = true
      assign sp_key = item.key
      break
    endif
  endfor
-%}

{%- if settings.cart_protection_show and sp_variant != blank -%}
  <div class="csp{% if sp_on %} csp--on{% endif %}">
    <div class="csp__media" aria-hidden="true">
      {%- if settings.cart_protection_image != blank -%}
        <img src="{{ settings.cart_protection_image | image_url: width: 96 }}" alt="" width="40" height="40" loading="lazy" decoding="async">
      {%- else -%}
        <span class="csp__emoji">🛡️</span>
      {%- endif -%}
    </div>

    <div class="csp__copy">
      <span class="csp__title">
        {{ settings.cart_protection_title | default: 'Shipping Protection' }}
        {%- if sp_variant.price > 0 %}
          <span class="csp__price">{{ sp_variant.price | money }}</span>
        {%- endif -%}
      </span>
      {%- if settings.cart_protection_text != blank -%}
        <span class="csp__text">{{ settings.cart_protection_text }}</span>
      {%- endif -%}
    </div>

    <button
      type="button"
      class="csp__switch"
      role="switch"
      aria-checked="{% if sp_on %}true{% else %}false{% endif %}"
      aria-label="{{ settings.cart_protection_title | default: 'Shipping Protection' | escape }}"
      data-csp-toggle
      data-variant-id="{{ sp_variant.id }}"
      data-line-key="{{ sp_key }}"
    >
      <span class="csp__knob"></span>
    </button>
  </div>
{%- endif -%}

<style>
  .csp {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    margin-block: 8px;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.1));
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.02);
  }

  .csp__media {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.05);
  }

  .csp__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .csp__emoji {
    font-size: 1.05rem;
    line-height: 1;
  }

  .csp__copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .csp__title {
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .csp__price {
    font-weight: 600;
    opacity: 0.6;
  }

  .csp__text {
    font-size: 0.68rem;
    line-height: 1.3;
    opacity: 0.6;
  }

  /* iOS-style switch */
  .csp__switch {
    flex-shrink: 0;
    position: relative;
    width: 46px;
    height: 28px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(120, 120, 128, 0.32);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.28s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .csp__switch[aria-checked='true'] {
    background: #34c759;
  }

  .csp__switch[disabled] {
    opacity: 0.5;
    cursor: wait;
  }

  .csp__knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.25);
    transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .csp__switch[aria-checked='true'] .csp__knob {
    transform: translateX(18px);
  }

  @media (prefers-reduced-motion: reduce) {
    .csp__switch,
    .csp__knob {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    /* Delegated from document rather than bound to the button: the cart
       drawer morphs its HTML after every change, which would throw away a
       listener attached directly to the switch. */
    if (window.__cspBound) return;
    window.__cspBound = true;

    function routes() {
      var r = (window.Theme && Theme.routes) || {};
      return {
        add: r.cart_add_url || '/cart/add.js',
        change: r.cart_change_url || '/cart/change.js'
      };
    }

    function sectionIds() {
      var ids = [];
      document.querySelectorAll('cart-items-component[data-section-id]').forEach(function (el) {
        var id = el.dataset.sectionId;
        if (id && ids.indexOf(id) === -1) ids.push(id);
      });
      return ids.join(',');
    }

    document.addEventListener('click', function (event) {
      var btn = event.target.closest('[data-csp-toggle]');
      if (!btn || btn.hasAttribute('disabled')) return;

      var turningOn = btn.getAttribute('aria-checked') !== 'true';
      var url = routes();

      /* Flip immediately so the switch feels instant; the re-rendered cart
         carries the true state, and a failure re-reads from it too. */
      btn.setAttribute('aria-checked', turningOn ? 'true' : 'false');
      btn.setAttribute('disabled', 'disabled');

      var body = turningOn
        ? { items: [{ id: Number(btn.dataset.variantId), quantity: 1 }], sections: sectionIds() }
        : { id: btn.dataset.lineKey, quantity: 0, sections: sectionIds() };

      fetch(turningOn ? url.add : url.change, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body)
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          document.dispatchEvent(
            new CustomEvent('cart:update', {
              bubbles: true,
              detail: {
                data: {
                  source: 'shipping-protection',
                  sections: data.sections || null
                }
              }
            })
          );
        })
        .catch(function (error) {
          console.error(error);
          btn.setAttribute('aria-checked', turningOn ? 'false' : 'true');
        })
        .finally(function () {
          btn.removeAttribute('disabled');
        });
    });
  })();
</script>
