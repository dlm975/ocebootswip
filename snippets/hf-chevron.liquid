{%- doc -%}
  The dropdown arrow for the hero finder's selects. The selects set
  appearance:none, which removes the native arrow, so this draws it back
  in. Its own pointer events are disabled in CSS so clicking the arrow
  still opens the select underneath it.
{%- enddoc -%}

<svg
  class="hf__chevron"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  width="14"
  height="14"
  aria-hidden="true"
  focusable="false"
>
  <polyline points="6 9 12 15 18 9"/>
</svg>
