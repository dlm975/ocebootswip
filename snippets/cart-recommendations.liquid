{%- doc -%}
  "You might also like" — a pill of hand-picked products above the cart
  totals. Products are chosen in Theme settings → Cart.
{%- enddoc -%}

{%- liquid
  assign show_recs = true
  if settings.cart_recs_show == false
    assign show_recs = false
  endif

  assign heading = settings.cart_recs_heading | default: 'You might also like'
  assign max_items = settings.cart_recs_max | default: 4
  assign picks = settings.cart_recs_products

  comment
    Anything already in the cart is skipped — suggesting a product the
    shopper has just added reads as a bug.
  endcomment
  assign in_cart = ''
  for item in cart.items
    assign in_cart = in_cart | append: ',' | append: item.product_id | append: ','
  endfor

  assign shown = 0
-%}

{%- if show_recs and picks.size == 0 and request.design_mode -%}
  {%- comment -%}
    Editor only. With no products chosen this section renders nothing at
    all on the storefront, which is indistinguishable from it being broken.
  {%- endcomment -%}
  <div class="cart-recs cart-recs--empty">
    <span class="cart-recs__heading">{{ heading }}</span>
    <span class="cart-recs__empty">
      Pick products under Theme settings → Cart → You might also like. This
      message is only visible here in the editor.
    </span>
  </div>
{%- endif -%}

{%- if show_recs and picks.size > 0 and cart.item_count > 0 -%}
  {%- capture cards -%}
    {%- for p in picks -%}
      {%- liquid
        assign needle = ',' | append: p.id | append: ','
        assign skip = false
        if in_cart contains needle
          assign skip = true
        endif
        unless p.available
          assign skip = true
        endunless
        if shown >= max_items
          assign skip = true
        endif
      -%}

      {%- unless skip -%}
        {%- liquid
          assign shown = shown | plus: 1
          assign variant = p.selected_or_first_available_variant
          assign can_add = false
          if p.variants.size == 1 and variant.available
            assign can_add = true
          endif
        -%}
        <div class="cart-recs__card">
          <a class="cart-recs__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
            {%- if p.featured_image -%}
              <img
                src="{{ p.featured_image | image_url: width: 160 }}"
                alt=""
                width="64"
                height="64"
                loading="lazy"
                decoding="async"
              >
            {%- endif -%}
          </a>

          <div class="cart-recs__info">
            <a class="cart-recs__title" href="{{ p.url }}">{{ p.title }}</a>
            <span class="cart-recs__price">
              {%- if p.compare_at_price > p.price -%}
                <s class="cart-recs__was">{{ p.compare_at_price | money }}</s>
              {%- endif -%}
              <span class="cart-recs__now">{{ p.price | money }}</span>
            </span>
          </div>

          {%- if can_add -%}
            <button
              type="button"
              class="cart-recs__add"
              data-cart-recs-add
              data-variant-id="{{ variant.id }}"
            >
              <span aria-hidden="true">+</span> {{ settings.cart_recs_button_label | default: 'Add' }}
            </button>
          {%- else -%}
            {%- comment -%}
              More than one variant, so a size has to be picked. Adding the
              first one here would quietly put the wrong size in the cart.
            {%- endcomment -%}
            <a class="cart-recs__add" href="{{ p.url }}">
              {{ settings.cart_recs_choose_label | default: 'Choose' }}
            </a>
          {%- endif -%}
        </div>
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if cards != blank -%}
    <div
      class="cart-recs"
      style="
        --cr-bg: {{ settings.cart_recs_background | default: '#f5f5f5' }};
        --cr-fg: {{ settings.cart_recs_text_color | default: '#111111' }};
        --cr-radius: {{ settings.cart_recs_radius | default: 16 }}px;
        --cr-btn-bg: {{ settings.cart_recs_button_background | default: '#111111' }};
        --cr-btn-fg: {{ settings.cart_recs_button_text | default: '#ffffff' }};
        --cr-card-bg: {{ settings.cart_recs_card_background | default: '#ffffff' }};
        --cr-card-border: {{ settings.cart_recs_card_border | default: '#e6e6e6' }};
      "
    >
      <div class="cart-recs__head">
        <span class="cart-recs__heading">{{ heading }}</span>
        <div class="cart-recs__nav">
          <button type="button" class="cart-recs__arrow" data-cart-recs-prev aria-label="Previous">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button type="button" class="cart-recs__arrow" data-cart-recs-next aria-label="Next">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
      <div class="cart-recs__row" data-cart-recs-row>{{ cards }}</div>
    </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  /* The drawer summary is a flex column with align-items: center, so its
     children shrink-wrap their content. Left alone, this pill grew as wide
     as all the cards laid end to end and burst out of the drawer once a
     second product appeared. Stretch it and pin it to the container width
     so the cards scroll inside it instead of widening it. */
  .cart-recs {
    align-self: stretch;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    background: var(--cr-bg, #f5f5f5);
    color: var(--cr-fg, #111);
    border-radius: var(--cr-radius, 16px);
    padding: 12px;
    margin-block-end: 12px;
  }

  /* The drawer summary spaces its children with --gap-2xl, which left a
     canyon between the suggestions and the total. Tighten it here only,
     and drop the pill's own margin so the two do not stack. */
  .cart-drawer__summary:has(.cart-recs) {
    gap: 12px;
  }

  .cart-drawer__summary .cart-recs {
    margin-block-end: 0;
  }

  .cart-recs__head {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-block-end: 8px;
  }

  .cart-recs__heading {
    font-size: 0.78rem;
    font-weight: 700;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cart-recs__nav {
    display: flex;
    gap: 2px;
    flex-shrink: 0;
  }

  .cart-recs__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .cart-recs__arrow:disabled {
    opacity: 0.25;
    cursor: default;
  }

  .cart-recs__empty {
    display: block;
    font-size: 0.68rem;
    line-height: 1.4;
    opacity: 0.65;
  }

  /* One card at a time with the next peeking, so the row reads as pageable
     rather than as a list that happens to be cut off. */
  .cart-recs__row {
    display: flex;
    gap: 10px;
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .cart-recs__row::-webkit-scrollbar {
    display: none;
  }

  /* Image, text and button on one line — the text sits beside the image,
     not under it. */
  .cart-recs__card {
    flex: 0 0 auto;
    width: calc(100% - 26px);
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 8px;
    border-radius: 12px;
    background: var(--cr-card-bg, #ffffff);
    border: 1px solid var(--cr-card-border, rgb(0 0 0 / 8%));
  }

  .cart-recs__media {
    flex-shrink: 0;
    display: block;
    width: 52px;
    height: 52px;
    border-radius: 9px;
    overflow: hidden;
    background: rgb(0 0 0 / 4%);
  }

  .cart-recs__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .cart-recs__info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .cart-recs__title {
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.25;
    color: inherit;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-recs__price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 0.72rem;
  }

  .cart-recs__was {
    opacity: 0.45;
  }

  .cart-recs__now {
    font-weight: 700;
  }

  .cart-recs__add {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 8px 14px;
    border: none;
    border-radius: 999px;
    background: var(--cr-btn-bg, #111);
    color: var(--cr-btn-fg, #fff);
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .cart-recs__add[disabled] {
    opacity: 0.5;
    cursor: wait;
  }
{% endstylesheet %}

<script>
  (function () {
    /* Delegated from document: the cart re-renders after every change, so a
       listener bound to these buttons would be discarded on first use. */
    if (window.__cartRecsBound) return;
    window.__cartRecsBound = true;

    document.addEventListener('scroll', function (event) {
      var t = event.target;
      if (t && t.nodeType === 1 && t.hasAttribute && t.hasAttribute('data-cart-recs-row')) {
        syncArrows(t);
      }
    }, true);

    /* The cart re-renders after every change, so re-check on the next frame
       rather than only at load. */
    document.addEventListener('cart:update', function () {
      requestAnimationFrame(trackRows);
    });

    window.addEventListener('load', trackRows);
    if (document.readyState !== 'loading') trackRows();

    function sectionIds() {
      var ids = [];
      document.querySelectorAll('cart-items-component[data-section-id]').forEach(function (el) {
        var id = el.dataset.sectionId;
        if (id && ids.indexOf(id) === -1) ids.push(id);
      });
      return ids.join(',');
    }

    /* Arrows page the row by one card. Buttons disable at each end so they
       do not look live when there is nowhere left to scroll. */
    function row(from) {
      var wrap = from.closest('.cart-recs');
      return wrap && wrap.querySelector('[data-cart-recs-row]');
    }

    function syncArrows(el) {
      var wrap = el.closest('.cart-recs');
      if (!wrap) return;
      var r = wrap.querySelector('[data-cart-recs-row]');
      var prev = wrap.querySelector('[data-cart-recs-prev]');
      var next = wrap.querySelector('[data-cart-recs-next]');
      if (!r || !prev || !next) return;

      /* A closed <dialog> has no layout, so both measurements read 0 and
         the maths below would disable each arrow. Nothing re-measured once
         the drawer opened, so they stayed dead — and a disabled button
         fires no click at all. Leave them alone until the row has width. */
      if (!r.clientWidth) return;

      var maxScroll = Math.max(0, r.scrollWidth - r.clientWidth - 1);
      prev.disabled = r.scrollLeft <= 0;
      next.disabled = r.scrollLeft >= maxScroll;
    }

    /* Opening the drawer takes the row from zero width to its real size,
       which is the moment the arrows can finally be measured. */
    var rowObserver = 'ResizeObserver' in window
      ? new ResizeObserver(function (entries) {
          entries.forEach(function (entry) { syncArrows(entry.target); });
        })
      : null;

    function trackRows() {
      document.querySelectorAll('[data-cart-recs-row]').forEach(function (r) {
        syncArrows(r);
        if (rowObserver) {
          rowObserver.unobserve(r);
          rowObserver.observe(r);
        }
      });
    }

    document.addEventListener('click', function (event) {
      var arrow = event.target.closest('[data-cart-recs-prev], [data-cart-recs-next]');
      if (arrow) {
        var r = row(arrow);
        if (!r) return;
        var card = r.querySelector('.cart-recs__card');
        var step = card ? card.getBoundingClientRect().width + 10 : r.clientWidth;
        var dir = arrow.hasAttribute('data-cart-recs-next') ? 1 : -1;
        r.scrollBy({ left: step * dir, behavior: 'smooth' });
        return;
      }

      var btn = event.target.closest('[data-cart-recs-add]');
      if (!btn || btn.hasAttribute('disabled')) return;

      btn.setAttribute('disabled', 'disabled');

      var url = (window.Theme && Theme.routes && Theme.routes.cart_add_url) || '/cart/add.js';

      fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          items: [{ id: Number(btn.dataset.variantId), quantity: 1 }],
          sections: sectionIds()
        })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          document.dispatchEvent(
            new CustomEvent('cart:update', {
              bubbles: true,
              detail: { data: { source: 'cart-recommendations', sections: data.sections || null } }
            })
          );
        })
        .catch(function (error) {
          console.error(error);
          btn.removeAttribute('disabled');
        });
    });
  })();
</script>
