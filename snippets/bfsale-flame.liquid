{%- doc -%}
  Animated flame emoji shown in the top-right corner of BFSALE product card images.
  Uses the native emoji, so it renders in Apple's style on Apple devices and the platform's own style elsewhere.
{%- enddoc -%}

<span class="bfsale-flame" aria-hidden="true">🔥</span>

{% stylesheet %}
  .bfsale-flame {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: var(--layer-raised, 2);
    font-size: 1.5rem;
    line-height: 1;
    font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
    transform-origin: 50% 90%;
    filter: drop-shadow(0 0 4px rgb(255 120 0 / 0.55));
    animation: bfsale-flicker 1.6s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes bfsale-flicker {
    0%,
    100% {
      transform: scale(1) rotate(0deg);
      filter: drop-shadow(0 0 4px rgb(255 120 0 / 0.55));
    }
    20% {
      transform: scale(1.08, 1.14) rotate(-4deg);
      filter: drop-shadow(0 0 7px rgb(255 90 0 / 0.75));
    }
    40% {
      transform: scale(0.97, 1.03) rotate(3deg);
      filter: drop-shadow(0 0 5px rgb(255 140 0 / 0.6));
    }
    60% {
      transform: scale(1.05, 1.1) rotate(-2deg);
      filter: drop-shadow(0 0 8px rgb(255 80 0 / 0.8));
    }
    80% {
      transform: scale(0.99, 1.04) rotate(2deg);
      filter: drop-shadow(0 0 5px rgb(255 130 0 / 0.6));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bfsale-flame {
      animation: none;
    }
  }

  [product-grid-view='zoom-out'] .bfsale-flame {
    display: none;
  }
{% endstylesheet %}
