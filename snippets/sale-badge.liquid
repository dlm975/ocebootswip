{%- doc -%}
  Sale badge for the redesign: a copy of bfsale-badge with only the font changed. Same flames, colours,
  outline, shadow and placement; the text is set in the brand font (upright Inter) and reads "35% off".

  It reuses the original's markup classes (bfsale-fire, bfsale-badge-anchor, bfsale-badge), so the
  flames, positioning and colours come from snippets/bfsale-badge; .sale-badge only swaps the font.

  Chosen with Theme settings > Badges > "Sale badge style". The original stays in snippets/bfsale-badge.

  @param {product} product - The product to render the badge for
  @param {boolean} [inline] - Render an inline badge instead of the card-image anchor
{%- enddoc -%}

{%- liquid
  assign sb_variant = product.selected_or_first_available_variant
  assign sb_percent = 0
  if sb_variant.compare_at_price > sb_variant.price
    assign sb_percent = sb_variant.compare_at_price | minus: sb_variant.price | times: 100.0 | divided_by: sb_variant.compare_at_price | round | divided_by: 5.0 | ceil | times: 5
  endif
-%}

{%- capture sb_fire -%}
  <span class="bfsale-fire {% if inline %}bfsale-fire--inline{% else %}bfsale-fire--card{% endif %}" data-bfsale-fire{% if sb_percent <= 0 %} hidden{% endif %}>
    <span class="bfsale-fire__flames" aria-hidden="true">
      {%- for i in (1..7) -%}<i class="bfsale-fire__flame"></i>{%- endfor -%}
      {%- for i in (1..3) -%}<i class="bfsale-fire__ember"></i>{%- endfor -%}
    </span>
    <span class="bfsale-badge sale-badge" data-bfsale-badge>
      {%- if sb_percent > 0 %}{{ sb_percent }}% off{% endif -%}
    </span>
  </span>
{%- endcapture -%}

{%- if inline -%}
  {{ sb_fire }}
{%- else -%}
  <div class="bfsale-badge-anchor">{{ sb_fire }}</div>
{%- endif -%}

{% stylesheet %}
  /* Only the font differs from the original badge. The original's padding is tuned for Oswald italic
     (low capitals, glyphs leaning right); upright Inter sits centred, so the padding evens out. */
  .bfsale-badge.sale-badge {
    font-family: var(--font-body--family);
    font-style: normal;
    font-weight: 750;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
    text-transform: none;
    padding: 0.38em 0.85em 0.36em;
  }
{% endstylesheet %}
