{%- layout none -%}
{%- comment -%}
  Boot Match feed (sections/boot-match.liquid loads it as /collections/<handle>?view=bootmatch&page=N):
  the collection's boots that can be bought, 250 a page, as compact JSON.
  h handle · t title · u url · i image · m price (formatted) · s sizes in stock · k condition ·
  g generation tag (without "gen:")
{%- endcomment -%}
{%- paginate collection.products by 250 -%}
{"page":{{ paginate.current_page }},"pages":{{ paginate.pages }},"items":[
  {%- assign sep = '' -%}
  {%- for p in collection.products -%}
    {%- unless p.available -%}{%- continue -%}{%- endunless -%}
    {%- liquid
      assign size_i = nil
      assign cond_i = nil
      for option in p.options_with_values
        assign option_name = option.name | downcase
        if option_name contains 'size'
          assign size_i = forloop.index0
        elsif option_name contains 'condition'
          assign cond_i = forloop.index0
        endif
      endfor
      assign gen = ''
      for tag in p.tags
        if tag contains 'gen:'
          assign gen = tag | remove_first: 'gen:' | strip
          break
        endif
      endfor
      assign cond = ''
      assign sizes = ''
      for v in p.variants
        if v.available
          if size_i != nil
            assign sizes = sizes | append: '|' | append: v.options[size_i]
          endif
          if cond_i != nil and cond == ''
            assign cond = v.options[cond_i]
          endif
        endif
      endfor
      assign size_list = sizes | remove_first: '|' | split: '|' | uniq
    -%}
    {{- sep -}}{"h":{{ p.handle | json }},"t":{{ p.title | json }},"u":{{ p.url | json }},"i":{% if p.featured_image %}{{ p.featured_image | image_url: width: 640 | json }}{% else %}""{% endif %},"m":{{ p.price | money | strip_html | json }},"s":{{ size_list | json }},"k":{{ cond | json }},"g":{{ gen | json }}}
    {%- assign sep = ',' -%}
  {%- endfor -%}
]}
{%- endpaginate -%}
