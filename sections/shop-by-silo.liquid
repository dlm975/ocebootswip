{%- comment -%}
  Shop by silo: the key silos (Nike Mercurial, Nike Phantom, adidas Predator ...) with a drop-down of
  every generation of each one, as image tiles, each linking to that generation's collection.

  - Desktop (990px+): the silos sit in a row like the header menu. Hovering (or focusing) one shows
    its generations in the panel below, which eases to each silo's height; the first silo is shown
    to begin with. Clicking a silo opens its collection.
  - Phones and tablets: the silos are rows like the menu drawer. Tapping one drops its generations
    down from under its title (its arrow becomes an X); tapping again closes it. One open at a time.

  Generations are collections (product tag gen:<brand>-<model>-<generation>). A tile's label is the
  collection title without the silo's name ("Nike Mercurial Vapor 16" -> "Vapor 16"); collections
  with no boots in stock are left out. Animations: Motion (motion.dev).
{%- endcomment -%}

{%- liquid
  assign section_id = 'ssilo-' | append: section.id
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }}">
  <shop-by-silo
    class="ssilo spacing-style"
    id="{{ section_id }}"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="ssilo__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- capture panels -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign silo_title = block.settings.title | strip
          assign silo_prefix = silo_title | append: ' '
          assign last_word = silo_title | split: ' ' | last
          assign shown = 0
        -%}
        <div
          class="ssilo__panel"
          id="{{ section_id }}-{{ block.id }}"
          data-silo-panel="{{ block.id }}"
          {% unless forloop.first %}hidden{% endunless %}
          {{ block.shopify_attributes }}
        >
          <ul class="ssilo__grid" role="list">
            {%- for generation in block.settings.generations -%}
              {%- if generation.products_count > 0 -%}
                {%- liquid
                  assign shown = shown | plus: 1
                  assign label = generation.title | remove_first: silo_prefix | strip
                  if label == generation.title
                    assign brand_word = silo_title | split: ' ' | first | append: ' '
                    assign label = generation.title | remove_first: brand_word
                  endif
                  # A bare number or code reads with its model ("6" -> "Phantom 6", "19" -> "X 19")
                  if label.size <= 2
                    assign label = last_word | append: ' ' | append: label
                  endif
                  assign image = generation.featured_image
                -%}
                <li class="ssilo__tile" data-silo-tile>
                  <a class="ssilo__card" href="{{ generation.url }}">
                    <span class="ssilo__media">
                      {%- if image -%}
                        {{
                          image
                          | image_url: width: 400
                          | image_tag:
                            widths: '160, 240, 320, 400',
                            sizes: '(min-width: 990px) 12vw, 30vw',
                            loading: 'lazy',
                            class: 'ssilo__image',
                            alt: ''
                        }}
                      {%- endif -%}
                    </span>
                    <span class="ssilo__label">{{ label | escape }}</span>
                    <span class="ssilo__count">
                      {{- generation.products_count }}
                      {{ generation.products_count | pluralize: 'pair', 'pairs' -}}
                    </span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if block.settings.collection != blank -%}
            <a class="ssilo__all" href="{{ block.settings.collection.url }}">
              Shop all {{ silo_title | escape }}
              {%- render 'gicon', name: 'arrow_forward', size: 18 -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endcapture -%}

    <ul class="ssilo__list" role="list" data-silo-list>
      {%- for block in section.blocks -%}
        {%- liquid
          assign silo_url = block.settings.collection.url | default: '#'
        -%}
        <li class="ssilo__item" data-silo-item="{{ block.id }}">
          <a
            class="ssilo__name{% if forloop.first %} is-active{% endif %}"
            href="{{ silo_url }}"
            data-silo-name="{{ block.id }}"
            aria-controls="{{ section_id }}-{{ block.id }}"
            aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <span class="ssilo__name-text">{{ block.settings.title | escape }}</span>
            <span class="ssilo__toggle" aria-hidden="true">
              {%- render 'gicon', name: 'keyboard_arrow_down', class: 'ssilo__chevron', size: 28 -%}
              {%- render 'gicon', name: 'close', class: 'ssilo__close', size: 26 -%}
            </span>
          </a>
          {%- comment -%} Phones: this silo's generations drop down here (moved in by the script) {%- endcomment -%}
          <div class="ssilo__drop" data-silo-drop="{{ block.id }}"></div>
        </li>
      {%- endfor -%}
    </ul>

    <div class="ssilo__stage" data-silo-stage>
      {{ panels }}
    </div>
  </shop-by-silo>
</div>

<script type="module">
  import { animate, stagger } from 'motion';

  const EASE = [0.3, 0.7, 0.3, 1];
  const MOVE = 0.55;
  const desktop = window.matchMedia('(min-width: 990px)');
  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  class ShopBySilo extends HTMLElement {
    connectedCallback() {
      this.stage = this.querySelector('[data-silo-stage]');
      this.panels = new Map([...this.querySelectorAll('[data-silo-panel]')].map((p) => [p.dataset.siloPanel, p]));
      this.names = [...this.querySelectorAll('[data-silo-name]')];
      this.active = this.names[0] ? this.names[0].dataset.siloName : null;
      this.open = null; // phones: the open silo
      this.hoverTimer = 0;

      this.names.forEach((name) => {
        const id = name.dataset.siloName;
        name.addEventListener('pointerenter', (e) => {
          if (!desktop.matches || e.pointerType === 'touch') return;
          clearTimeout(this.hoverTimer);
          // A short pause, so sweeping across the row doesn't flick through every silo
          this.hoverTimer = setTimeout(() => this.show(id), 90);
        });
        name.addEventListener('pointerleave', () => clearTimeout(this.hoverTimer));
        name.addEventListener('focus', () => desktop.matches && this.show(id));
        name.addEventListener('click', (e) => {
          if (desktop.matches) return; // desktop: the link opens the silo's collection
          e.preventDefault();
          this.toggle(id);
        });
      });

      this.layout();
      desktop.addEventListener('change', () => this.layout());
    }

    /** Desktop: every panel in the stage below the row. Phones: each panel under its own silo. */
    layout() {
      this.panels.forEach((panel, id) => {
        panel.getAnimations().forEach((a) => a.cancel());
        panel.style.removeProperty('height');
        if (desktop.matches) {
          this.stage.append(panel);
          panel.hidden = id !== this.active;
        } else {
          this.querySelector(`[data-silo-drop="${id}"]`).append(panel);
          panel.hidden = id !== this.open;
        }
      });
      this.names.forEach((n) => {
        const id = n.dataset.siloName;
        const on = desktop.matches ? id === this.active : id === this.open;
        n.classList.toggle('is-active', on);
        n.setAttribute('aria-expanded', String(on));
      });
      this.stage.style.removeProperty('height');
    }

    /** Desktop: swap the panel below the row, easing the stage to the new height */
    show(id) {
      if (id === this.active) return;
      const from = this.panels.get(this.active);
      const to = this.panels.get(id);
      if (!to) return;
      this.active = id;
      this.names.forEach((n) => {
        const on = n.dataset.siloName === id;
        n.classList.toggle('is-active', on);
        n.setAttribute('aria-expanded', String(on));
      });

      const startHeight = this.stage.getBoundingClientRect().height;
      this.stage.getAnimations().forEach((a) => a.cancel());
      this.panels.forEach((p) => {
        p.getAnimations().forEach((a) => a.cancel());
        p.querySelectorAll('[data-silo-tile]').forEach((t) => t.getAnimations().forEach((a) => a.cancel()));
        if (p !== to && p !== from) p.hidden = true;
      });
      if (from) {
        from.hidden = true;
        from.classList.remove('is-leaving');
      }
      to.hidden = false;
      if (reduced()) return;

      const endHeight = this.stage.getBoundingClientRect().height;
      // The old grid fades out over the new one while the stage eases to its height
      if (from) {
        from.hidden = false;
        from.classList.add('is-leaving');
        animate(from, { opacity: [1, 0] }, { duration: 0.18, ease: 'linear' }).then(() => {
          from.hidden = true;
          from.classList.remove('is-leaving');
          from.style.removeProperty('opacity');
        });
      }
      if (Math.abs(endHeight - startHeight) > 1) {
        this.stage.style.overflow = 'hidden';
        animate(this.stage, { height: [startHeight + 'px', endHeight + 'px'] }, { duration: MOVE, ease: EASE }).then(() => {
          this.stage.style.removeProperty('height');
          this.stage.style.removeProperty('overflow');
        });
      }
      const tiles = to.querySelectorAll('[data-silo-tile], .ssilo__all');
      animate(tiles, { opacity: [0, 1], transform: ['translateY(14px)', 'translateY(0px)'] }, { duration: 0.45, ease: EASE, delay: stagger(0.025) });
    }

    /** Phones: drop a silo's generations down from under its title, closing any other */
    toggle(id) {
      const opening = this.open !== id;
      const previous = this.open;
      const name = this.names.find((n) => n.dataset.siloName === id);
      // Where the tapped title is now, before anything above it closes (v2)
      const titleTop = name.getBoundingClientRect().top;
      if (previous) this.collapse(previous, opening);
      if (!opening) {
        this.open = null;
        return;
      }
      this.open = id;
      const panel = this.panels.get(id);
      name.classList.add('is-active');
      name.setAttribute('aria-expanded', 'true');
      panel.getAnimations().forEach((a) => a.cancel());
      panel.hidden = false;
      // Keep the tapped title where it was on screen when one above closes at the same time
      // (instant: the theme scrolls smoothly by default, which would show the jump)
      if (previous) window.scrollBy({ top: name.getBoundingClientRect().top - titleTop, behavior: 'instant' });
      if (reduced()) return;
      const height = panel.getBoundingClientRect().height;
      panel.style.overflow = 'hidden';
      animate(panel, { height: ['0px', height + 'px'] }, { duration: MOVE, ease: EASE }).then(() => {
        panel.style.removeProperty('height');
        panel.style.removeProperty('overflow');
      });
      const tiles = panel.querySelectorAll('[data-silo-tile], .ssilo__all');
      animate(tiles, { opacity: [0, 1], transform: ['translateY(-16px)', 'translateY(0px)'] }, { duration: MOVE, ease: EASE, delay: stagger(0.02) });
    }

    /** Phones: a silo's generations fade, then it eases shut */
    collapse(id, instant) {
      const name = this.names.find((n) => n.dataset.siloName === id);
      const panel = this.panels.get(id);
      name.classList.remove('is-active');
      name.setAttribute('aria-expanded', 'false');
      panel.getAnimations().forEach((a) => a.cancel());
      // Closing because another opened: shut at once so the page doesn't move twice
      if (instant || reduced()) {
        panel.hidden = true;
        panel.style.removeProperty('height');
        panel.style.removeProperty('overflow');
        return;
      }
      const height = panel.getBoundingClientRect().height;
      panel.style.overflow = 'hidden';
      animate(panel, { opacity: [1, 0] }, { duration: 0.18, ease: 'linear' })
        .then(() => animate(panel, { height: [height + 'px', '0px'] }, { duration: 0.35, ease: EASE }))
        .then(() => {
          if (this.open === id) return; // reopened meanwhile
          panel.hidden = true;
          panel.style.removeProperty('height');
          panel.style.removeProperty('overflow');
          panel.style.removeProperty('opacity');
        });
    }
  }

  if (!customElements.get('shop-by-silo')) customElements.define('shop-by-silo', ShopBySilo);
</script>

{% stylesheet %}
  .ssilo {
    display: block;
  }

  .ssilo__heading {
    margin: 0 0 18px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .ssilo__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Phones and tablets: rows like the menu drawer */
  .ssilo__name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 10px;
    color: var(--color-foreground);
    font-size: clamp(1.75rem, 7vw, 2.25rem);
    font-weight: 750;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-variation-settings: 'opsz' 32;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .ssilo__toggle {
    display: grid;
    flex: none;
    width: 28px;
    height: 28px;
  }

  .ssilo__toggle svg {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
  }

  .ssilo__close,
  .ssilo__name.is-active .ssilo__chevron {
    display: none;
  }

  .ssilo__name.is-active .ssilo__close {
    display: block;
  }

  .ssilo__drop .ssilo__panel {
    padding-block: 6px 18px;
  }

  /* Phones: the panels wait in the stage until the script moves each under its silo */
  @media screen and (max-width: 989px) {
    .ssilo__stage .ssilo__panel {
      display: none;
    }
  }

  .ssilo__panel[hidden] {
    display: none !important;
  }

  .ssilo__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ssilo__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 6px 6px 10px;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 1px 2px rgb(18 18 18 / 0.06), 0 6px 18px rgb(18 18 18 / 0.05);
    color: #121212;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: box-shadow 0.2s ease, transform 0.25s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  .ssilo__media {
    display: block;
    aspect-ratio: 1;
    margin-block-end: 6px;
    border-radius: 8px;
    overflow: hidden;
    background: #ffffff;
  }

  .ssilo__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ssilo__label {
    font-size: 0.8125rem;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .ssilo__count {
    margin-block-start: 2px;
    font-size: 0.6875rem;
    color: rgb(18 18 18 / 0.5);
    font-variant-numeric: tabular-nums;
  }

  .ssilo__all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-block-start: 14px;
    color: var(--color-foreground);
    font-size: 0.9375rem;
    font-weight: 650;
    text-decoration: none;
  }

  .ssilo__all:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (hover: hover) {
    .ssilo__card:hover {
      box-shadow: 0 1px 2px rgb(18 18 18 / 0.08), 0 10px 26px rgb(18 18 18 / 0.1);
      transform: translateY(-2px);
    }
  }

  .ssilo__card:focus-visible,
  .ssilo__name:focus-visible,
  .ssilo__all:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
    border-radius: 8px;
  }

  /* Desktop: a row of silos like the header menu, with their generations in the panel below */
  @media screen and (min-width: 990px) {
    .ssilo__list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 30px;
      margin-block-end: 22px;
    }

    .ssilo__name {
      padding-block: 4px;
      font-size: clamp(1.75rem, 2.6vw, 2.5rem);
      color: rgb(var(--color-foreground-rgb) / 0.32);
      transition: color 0.2s ease;
    }

    .ssilo__name:hover,
    .ssilo__name.is-active {
      color: var(--color-foreground);
    }

    .ssilo__toggle,
    .ssilo__drop {
      display: none;
    }

    .ssilo__stage {
      position: relative;
    }

    /* The outgoing grid fades over the incoming one */
    .ssilo__panel.is-leaving {
      position: absolute;
      inset: 0 0 auto 0;
      pointer-events: none;
    }

    .ssilo__grid {
      grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
      gap: 12px;
    }

    .ssilo__label {
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ssilo__card,
    .ssilo__name {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by silo",
  "tag": "section",
  "class": "section-shop-by-silo",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by silo"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "silo",
      "name": "Silo",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Silo name",
          "info": "Also removed from the start of each generation's title for its tile, e.g. 'Nike Mercurial' turns 'Nike Mercurial Vapor 16' into 'Vapor 16'.",
          "default": "Nike Mercurial"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Silo collection",
          "info": "Opened by the silo's name on desktop, and by 'Shop all'."
        },
        {
          "type": "collection_list",
          "id": "generations",
          "label": "Generations",
          "info": "In the order to show them, newest first. Empty ones are hidden.",
          "limit": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by silo",
      "blocks": [{ "type": "silo" }]
    }
  ]
}
{% endschema %}
