      width: 44px;
      height: 26px;
      border-radius: 6px;
    }

    .ssilo--page .ssilo__row .ssilo__plus {
      width: 22px;
      height: 22px;
    }

    .ssilo--page .ssilo__row .ssilo__plus svg {
      width: 20px;
      height: 20px;
    }

    .ssilo--page .ssilo__gens {
      grid-template-columns: repeat(6, minmax(0, max-content) max-content minmax(12px, 1fr));
      grid-template-rows: repeat(var(--rows-6, 1), auto);
      column-gap: 10px;
    }

    .ssilo--page .ssilo__gen {
      padding-block: 3px;
    }

    .ssilo--page .ssilo__gen-name {
      font-size: 1rem;
      letter-spacing: -0.01em;
    }

    .ssilo--page .ssilo__gen-pic {
      display: block;
      width: 36px;
      height: 20px;
    }

    .ssilo--page .ssilo__all,
    .ssilo--page .ssilo__close {
      font-size: 0.9375rem;
    }
  }

  /* The silo (or generation) being viewed */
  .ssilo__silo.is-current > .ssilo__row .ssilo__row-name,
  .ssilo__gen[aria-current] .ssilo__gen-name {
    text-decoration: underline;
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.12em;
  }

  @media (prefers-reduced-motion: reduce) {
    .ssilo__brand,
    .ssilo__brand-image,
    .ssilo__brand-text,
    .ssilo__brand-head::before,
    .ssilo__brand-head::after,
    .ssilo__plus svg,
    .ssilo__row {
      transition: none;
    }
  }
{% endstylesheet %}

