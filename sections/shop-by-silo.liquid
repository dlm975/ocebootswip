      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Silo name",
          "info": "Also removed from the start of each generation's title, e.g. 'Nike Mercurial' turns 'Nike Mercurial Vapor 16' into 'Vapor 16'.",
          "default": "Nike Mercurial"
        },
        {
          "type": "collection",
          "id": "collection",
