          "info": "Defaults to the silo collection's image."
        },
        {
          "type": "collection_list",
          "id": "generations",
          "label": "Generations",
          "info": "In the order to show them, newest first. Empty ones are hidden.",
          "limit": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by silo",
      "blocks": [{ "type": "brand" }, { "type": "silo" }]
    }
  ]
}
