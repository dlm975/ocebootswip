  }

  .ssilo__brands,
  .ssilo__silos,
  .ssilo__gens {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Brand cards, two a row; an open card takes its row at full width */
  .ssilo__brands {
    --ssilo-gap: 10px;
    --ssilo-cols: 2;
    --per-row: var(--ssilo-cols);
    --ssilo-ratio: 1;
    display: grid;
    grid-template-columns: repeat(var(--ssilo-cols), minmax(0, 1fr));
    gap: var(--ssilo-gap);
    align-items: start;
    container-type: inline-size;
  }

  /* A card per brand */
  .ssilo__brand {
    border-radius: 20px;
    overflow: hidden;
    background: #ffffff;
    color: #121212;
    position: relative;
    box-shadow: 0 1px 2px rgb(18 18 18 / 0.06), 0 8px 24px rgb(18 18 18 / 0.06);
    /* Coming back (a brand closed): the others fade in only as they arrive in their places, so
       their paths crossing on the way are never seen */
    transition:
      opacity 0.3s ease 0.32s,
      box-shadow 0.35s ease;
  }

  .ssilo__brand.is-open {
    grid-column: 1 / -1;
  }

  /* One brand open: it comes forward, the others step back at once (before they move) */
  .ssilo__brands.has-open > .ssilo__brand:not(.is-open):not(.is-next) {
    opacity: 0.07;
    transition:
      opacity 0.14s linear,
      box-shadow 0.35s ease;
  }

  .ssilo__brand.is-open {
    box-shadow: 0 2px 4px rgb(18 18 18 / 0.08), 0 20px 48px rgb(18 18 18 / 0.18);
  }

  .ssilo__brand-head {
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: #ffffff;
    color: #ffffff;
    font: inherit;
    text-align: start;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* The same height closed and open (a column's width x the ratio), so a card can widen smoothly */
  .ssilo__brand-media {
    display: block;
    height: calc((100cqi - (var(--ssilo-cols) - 1) * var(--ssilo-gap)) / var(--ssilo-cols) * var(--ssilo-ratio));
    /* A whole number of pixels, so no sliver opens up where the image meets the panel */
    height: round(down, calc((100cqi - (var(--ssilo-cols) - 1) * var(--ssilo-gap)) / var(--ssilo-cols) * var(--ssilo-ratio)), 1px);
    overflow: hidden;
  }

  .ssilo__brand-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ssilo-ease);
  }

  .ssilo__brand.is-open .ssilo__brand-head .ssilo__brand-image {
    transform: scale(1.06);
