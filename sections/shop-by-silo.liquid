{%- comment -%}
  Shop by silo: a card per brand, two a row (image, name over it, a plus to open).
  - Opening a brand brings its card forward: it widens to fill its row (the others slide to their new
    places and step back), its image fades to white, and its silos roll down in a panel joined to
    the card: one row per silo, a small image and the name on one line.
  - Opening a silo does the same inside the brand: the row comes forward and its generations roll
    down beneath it as plain lines (name left, picture right), each linking to that generation's
    collection (tag gen:<brand>-<model>-<gen>).
  - The plus turns into an X to close; each open panel also ends with Close. One brand, and one silo
    per brand, open at a time. Opening scrolls the card or row up under the header; closing scrolls
    the closed card or row to the middle of the screen.

  Blocks are flat in the editor: each Silo belongs to the Brand block above it.
  A silo with no generations is a plain link to its collection.
  Animations: Motion (motion.dev), house timing.
{%- endcomment -%}

{%- liquid
  assign section_id = 'ssilo-' | append: section.id

  # On a collection page: just the brand this collection belongs to (its own page, one of its silos
  # or one of their generations), already open, its silos as dropdowns. Nothing for any other collection.
  assign page_mode = false
  assign match_brand = ''
  assign match_silo = ''
  assign here = ''
  if template.name == 'collection' and collection
    assign page_mode = true
    assign here = collection.handle
    assign current_brand = ''
    for b in section.blocks
      if b.type == 'brand'
        assign current_brand = b.id
        if b.settings.collection.handle == here and match_brand == ''
          assign match_brand = b.id
        endif
      elsif match_brand == ''
        assign hit = false
        if b.settings.collection.handle == here
          assign hit = true
        else
          for g in b.settings.generations
            if g.handle == here
              assign hit = true
              break
            endif
          endfor
        endif
        if hit
          assign match_brand = current_brand
          assign match_silo = b.id
        endif
      endif
    endfor
  endif
-%}

{%- unless page_mode and match_brand == '' -%}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }}">
  <shop-by-silo
    class="ssilo spacing-style{% if page_mode %} ssilo--page{% endif %}"
    id="{{ section_id }}"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- if section.settings.heading != blank and page_mode == false -%}
      <h2 class="ssilo__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="ssilo__brands" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'brand' -%}
          {%- if page_mode and block.id != match_brand -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign brand_name = block.settings.title | strip
            assign brand_prefix = brand_name | append: ' '
            assign brand_url = block.settings.collection.url
            assign brand_image = block.settings.image | default: block.settings.collection.featured_image
            assign start = forloop.index
          -%}
          <li class="ssilo__brand{% if page_mode %} ssilo__brand--page is-open{% endif %}" data-item="{{ block.id }}" {{ block.shopify_attributes }}>
            {%- unless page_mode -%}
            <button
              type="button"
              class="ssilo__brand-head"
              data-toggle="{{ block.id }}"
              aria-expanded="false"
              aria-controls="{{ section_id }}-{{ block.id }}"
            >
              <span class="ssilo__brand-media">
                {%- if brand_image -%}
                  {{
                    brand_image
                    | image_url: width: 1400
                    | image_tag:
                      widths: '480, 720, 960, 1200, 1400',
                      sizes: '(min-width: 990px) 46vw, 92vw',
                      loading: 'lazy',
                      class: 'ssilo__brand-image',
                      alt: ''
                  }}
                {%- endif -%}
              </span>
              <span class="ssilo__brand-text">
                <span class="ssilo__brand-name">{{ brand_name | escape }}</span>
              </span>
              <span class="ssilo__plus ssilo__plus--brand" aria-hidden="true">
                {%- render 'gicon', name: 'add', size: 24 -%}
              </span>
            </button>
            {%- endunless -%}

            <div class="ssilo__panel" id="{{ section_id }}-{{ block.id }}" data-panel{% unless page_mode %} hidden{% endunless %}>
              <div class="ssilo__inner ssilo__inner--brand">
                {%- liquid
                  # Desktop shows the silos in two columns, read down the left then down the right:
                  # each silo's place in that order (the first half on the left, the rest on the right)
                  assign silo_count = 0
                  for silo in section.blocks offset: start
                    if silo.type == 'brand'
                      break
                    endif
                    assign silo_count = silo_count | plus: 1
                  endfor
                  assign half = silo_count | plus: 1 | divided_by: 2
                  # On a collection page: at most 3 rows on phones and 2 on desktop, read down each column
                  assign rows_m = 3
                  if silo_count < 3
                    assign rows_m = silo_count
                  endif
                  assign rows_d = 2
                  if silo_count < 2
                    assign rows_d = silo_count
                  endif
                  assign cols_m = silo_count | plus: rows_m | minus: 1 | divided_by: rows_m
                  assign cols_d = silo_count | plus: rows_d | minus: 1 | divided_by: rows_d
                -%}
                <ul class="ssilo__silos" role="list"{% if page_mode %} style="--cols-m: {{ cols_m }}; --cols-d: {{ cols_d }}; --open-m: {{ rows_m | plus: 1 }}; --open-d: {{ rows_d | plus: 1 }};"{% endif %}>
                  {%- for silo in section.blocks offset: start -%}
                    {%- if silo.type == 'brand' -%}{%- break -%}{%- endif -%}
                    {%- liquid
                      assign silo_title = silo.settings.title | strip
                      assign silo_prefix = silo_title | append: ' '
                      assign silo_label = silo_title | remove_first: brand_prefix
                      assign last_word = silo_title | split: ' ' | last
                      assign shown = 0
                      assign first_image = nil
                      for generation in silo.settings.generations
                        if generation.products_count > 0
                          assign shown = shown | plus: 1
                          if first_image == nil
                            assign first_image = generation.featured_image
                          endif
                        endif
                      endfor
                      assign silo_image = silo.settings.image | default: silo.settings.collection.featured_image | default: first_image
                    -%}
                    {%- capture silo_face -%}
                      <span class="ssilo__row-text">
                        <span class="ssilo__row-name">{{ silo_label | escape }}</span>
                      </span>
                      <span class="ssilo__thumb">
                        {%- if silo_image -%}
                          {{
                            silo_image
                            | image_url: width: 280
                            | image_tag: widths: '120, 200, 280', sizes: '(min-width: 750px) 104px, 54px', loading: 'eager', fetchpriority: 'low', class: 'ssilo__thumb-image', alt: ''
                          }}
                        {%- endif -%}
                      </span>
                    {%- endcapture -%}

                    {%- liquid
                      assign silo_index = forloop.index0
                      if silo_index < half
                        assign desk_order = silo_index | times: 2
                      else
                        assign desk_order = silo_index | minus: half | times: 2 | plus: 1
                      endif
                      assign place = ''
                      if page_mode
                        assign r_m = silo_index | modulo: rows_m | plus: 1
                        assign c_m = silo_index | divided_by: rows_m | times: 3 | plus: 1
                        assign r_d = silo_index | modulo: rows_d | plus: 1
                        assign c_d = silo_index | divided_by: rows_d | times: 3 | plus: 1
                        assign place = ' --pr-m: ' | append: r_m | append: '; --pc-m: ' | append: c_m | append: '; --pr-d: ' | append: r_d | append: '; --pc-d: ' | append: c_d | append: ';'
                      endif
                      # Generations read down each column: the rows each column count needs
                      assign rows_2 = shown | plus: 1 | divided_by: 2
                      assign rows_3 = shown | plus: 2 | divided_by: 3
                      assign rows_6 = shown | plus: 5 | divided_by: 6
                    -%}
                    <li class="ssilo__silo{% if silo.id == match_silo %} is-current{% endif %}" data-item="{{ silo.id }}" data-order="{{ desk_order }}" style="--desk-order: {{ desk_order }};{{ place }}" data-anim {{ silo.shopify_attributes }}>
                      {%- if shown > 0 -%}
                        <button
                          type="button"
                          class="ssilo__row"
                          data-toggle="{{ silo.id }}"
                          aria-expanded="false"
                          aria-controls="{{ section_id }}-{{ silo.id }}"
                        >
                          {{ silo_face }}
                          <span class="ssilo__plus" aria-hidden="true">
                            {%- render 'gicon', name: 'add', size: 20 -%}
                          </span>
                        </button>

                        <div class="ssilo__panel" id="{{ section_id }}-{{ silo.id }}" data-panel hidden>
                          <div class="ssilo__inner ssilo__inner--silo">
                            <ul class="ssilo__gens" role="list" style="--rows-2: {{ rows_2 }}; --rows-3: {{ rows_3 }}; --rows-6: {{ rows_6 }};">
                              {%- for generation in silo.settings.generations -%}
                                {%- if generation.products_count > 0 -%}
                                  {%- liquid
                                    assign label = generation.title | remove_first: silo_prefix | strip
                                    if label == generation.title
                                      assign label = generation.title | remove_first: brand_prefix
                                    endif
                                    # A bare number or code reads with its model ("6" -> "Phantom 6", "19" -> "X 19")
                                    # (only a bare number: "GX" and "GT" read fine on their own)
                                    assign label_number = label | times: 1 | append: ''
                                    if label.size <= 2 and label_number == label
                                      assign label = last_word | append: ' ' | append: label
                                    endif
                                  -%}
                                  <li data-anim>
                                    <a class="ssilo__gen" href="{{ generation.url }}"{% if generation.handle == here %} aria-current="page"{% endif %}>
                                      <span class="ssilo__row-text">
                                        <span class="ssilo__gen-name">{{ label | escape }}</span>
                                      </span>
                                      <span class="ssilo__gen-pic">
                                        {%- if generation.featured_image -%}
                                          {{
                                            generation.featured_image
                                            | image_url: width: 160
                                            | image_tag: widths: '100, 160', sizes: '(min-width: 750px) 88px, 44px', loading: 'lazy', class: 'ssilo__thumb-image', alt: ''
                                          }}
                                        {%- endif -%}
                                      </span>
                                    </a>
                                  </li>
                                {%- endif -%}
                              {%- endfor -%}
                            </ul>
                            <div class="ssilo__foot" data-anim>
                              {%- if silo.settings.collection != blank -%}
                                <a class="ssilo__all" href="{{ silo.settings.collection.url }}">
                                  Shop all {{ silo_label | escape }}
                                  {%- render 'gicon', name: 'arrow_forward', size: 16 -%}
                                </a>
                              {%- else -%}
                                <span></span>
                              {%- endif -%}
                              <button type="button" class="ssilo__close" data-close="{{ silo.id }}">
                                Close
                                {%- render 'gicon', name: 'keyboard_arrow_up', size: 18 -%}
                              </button>
                            </div>
                          </div>
                        </div>
                      {%- else -%}
                        <a class="ssilo__row" href="{{ silo.settings.collection.url | default: brand_url | default: '#' }}">
                          {{ silo_face }}
                          <span class="ssilo__plus" aria-hidden="true">
                            {%- render 'gicon', name: 'arrow_forward', size: 18 -%}
                          </span>
                        </a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
                {%- unless page_mode -%}
                <div class="ssilo__foot" data-anim>
                  {%- if brand_url != blank -%}
                    <a class="ssilo__all" href="{{ brand_url }}">
                      Shop all {{ brand_name | escape }}
                      {%- render 'gicon', name: 'arrow_forward', size: 16 -%}
                    </a>
                  {%- else -%}
                    <span></span>
                  {%- endif -%}
                  <button type="button" class="ssilo__close" data-close="{{ block.id }}">
                    Close
                    {%- render 'gicon', name: 'keyboard_arrow_up', size: 18 -%}
                  </button>
                </div>
                {%- endunless -%}
              </div>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </shop-by-silo>
</div>
{%- endunless -%}

<script type="module">
  import { animate, stagger } from 'motion';

  const EASE = [0.3, 0.7, 0.3, 1];
  const MOVE = 0.65; // a touch slower than the house 0.55s: many things move at once here
  const OUT = 0.18;
  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // This script's own animations: not the CSS fades (the cards stepping back), which must run on
  const ours = (el) => el.getAnimations().filter((a) => !(a instanceof CSSTransition) && !(a instanceof CSSAnimation));
  const moving = (el) => ours(el).length > 0;
  const stop = (el) => ours(el).forEach((a) => a.cancel());
  const clear = (el, ...props) => props.forEach((p) => el.style.removeProperty(p));

  /** Where a card is seen: its box, less any part clipped off its right edge (a width change in
      progress is a clip, not a real width, so a tap mid-way carries on from what is on screen) */
  const shown = (card) => {
    const box = card.getBoundingClientRect();
    const clip = getComputedStyle(card).clipPath;
    const right = clip && clip.startsWith('inset(') ? parseFloat(clip.slice(6).split(' ')[1]) || 0 : 0;
    return { left: box.left, top: box.top, width: box.width - right, height: box.height };
  };


  class ShopBySilo extends HTMLElement {
    connectedCallback() {
      this.brands = this.querySelector('.ssilo__brands');
      this.open = new Map(); // list -> its open item
      this.pending = new Map(); // list -> the latest choice, so an older swap step can stand down
      this.scrollFrame = 0;

      this.addEventListener('click', (event) => {
        const control = event.target.closest('[data-toggle], [data-close]');
        if (!control || !this.contains(control)) return;
        const item = this.itemOf(control.dataset.toggle || control.dataset.close);
        if (!item) return;
        const shut = control.dataset.close || item.classList.contains('is-open');
        this.choose(item.parentElement, shut ? null : item);
      });

      // Start loading a panel's images as soon as its opener is pointed at or pressed
      const warm = (event) => {
        const control = event.target.closest && event.target.closest('[data-toggle]');
        const panel = control && this.itemOf(control.dataset.toggle)?.querySelector(':scope > [data-panel]');
        if (panel) panel.querySelectorAll('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
      };
      this.addEventListener('pointerover', warm, { passive: true });
      this.addEventListener('pointerdown', warm, { passive: true });

      // Theme editor: selecting a Brand or Silo block opens it (and its brand)
      this.onBlockSelect = (event) => {
        const target = event.target.closest && event.target.closest('[data-item]');
        if (!target || !this.contains(target)) return;
        const chain = [];
        for (let el = target; el && el !== this; el = el.parentElement.closest('[data-item]')) chain.unshift(el);
        chain.forEach((el) => {
          if (!el.querySelector(':scope > [data-panel]') || el.classList.contains('is-open')) return;
          this.choose(el.parentElement, el);
        });
      };
      document.addEventListener('shopify:block:select', this.onBlockSelect);
    }

    disconnectedCallback() {
      document.removeEventListener('shopify:block:select', this.onBlockSelect);
    }

    itemOf(id) {
      return this.querySelector(`[data-item="${id}"]`);
    }

    parts(item) {
      const panel = item.querySelector(':scope > [data-panel]');
      return { head: item.querySelector(':scope > [data-toggle]'), panel, inner: panel ? panel.firstElementChild : null };
    }

    /** What rolls in when a panel opens: its own rows, not those of panels inside it */
    rollers(panel) {
      return [...panel.querySelectorAll('[data-anim]')].filter((el) => el.closest('[data-panel]') === panel);
    }

    setOpen(item, on) {
      const list = item.parentElement;
      item.classList.toggle('is-open', on);
      item.querySelector(':scope > [data-toggle]')?.setAttribute('aria-expanded', String(on));
      if (on) this.open.set(list, item);
      else if (this.open.get(list) === item) this.open.delete(list);
      // The other cards or rows step back while one is open
      list.classList.toggle('has-open', this.open.has(list));
    }

    headerOffset() {
      const header = document.querySelector('#header-component[sticky]');
      return (header ? Math.max(0, header.getBoundingClientRect().bottom) : 0) + 12;
    }

    /** A panel's rows roll down into place, one after another */
    roll(panel) {
      const rows = this.rollers(panel);
      if (!rows.length) return;
      rows.forEach(stop);
      animate(
        rows,
        {
          opacity: [0, 1],
          transform: ['perspective(700px) translateY(-14px) rotateX(-32deg)', 'perspective(700px) translateY(0px) rotateX(0deg)'],
        },
        { duration: MOVE, ease: EASE, delay: stagger(Math.min(0.04, 0.4 / rows.length), { startDelay: 0.06 }) }
      ).then(() => rows.forEach((row) => clear(row, 'opacity', 'transform')));
    }

    /** Scroll so something (by its page top and height) sits in the middle of the screen below the header */
    centre(top, height) {
      const offset = this.headerOffset();
      const room = window.innerHeight - offset;
      // Too tall to fit: its top just under the header instead
      if (height > room - 16) {
        this.scrollTo(top - offset);
        return;
      }
      this.scrollTo(top + height / 2 - (offset + room / 2));
    }

    /**
     * Open one brand or silo in its list (or none). The open one takes its row at full width, the others
     * slide to their new places, its panel eases open as the one it replaces eases shut, and the page
     * scrolls with it: an opened one up under the header, a closed one to the middle of the screen.
     * Positions are animated from where they are (FLIP), so a tap mid-way carries on smoothly.
     */
    /**
     * Choose one in a list (or none). Swapping one open card for another goes in three beats:
     * 1. the open one's contents fade where they are;
     * 2. everything moves in one straight line to where it ends up (the chosen one up under the
     *    header, at full width) as the old panel closes;
     * 3. then the chosen one's contents roll out.
     * The others stay stepped back throughout, and a tap at any point takes over from there.
     */
    choose(list, target) {
      // (one pending choice per list)
      const previous = this.open.get(list) || null;
      const token = {};
      this.pending.set(list, token);
      // Opening a brand: the others fade back first (so they are barely there as they move), then
      // it widens and settles into its place, then its silos roll down
      if (!previous && target && list === this.brands && !reduced()) {
        target.classList.add('is-next');
        list.classList.add('has-open');
        setTimeout(() => {
          if (this.pending.get(list) !== token) return;
          this.switchIn(list, target, { deferOpen: true });
        }, 140);
        return;
      }
      // Closing a brand: its silos fade first, then it narrows back and the others return
      if (previous && !target && list === this.brands && !reduced() && !moving(this.parts(previous).panel)) {
        const inner = this.parts(previous).inner;
        const from = parseFloat(getComputedStyle(inner).opacity);
        stop(inner);
        animate(inner, { opacity: [from, 0] }, { duration: OUT, ease: 'linear' }).then(() => {
          if (this.pending.get(list) !== token) return;
          inner.style.opacity = '0';
          this.switchIn(list, null);
        });
        return;
      }
      if (!previous || !target || previous === target || reduced()) {
        this.switchIn(list, target);
        return;
      }
      target.classList.add('is-next');
      const { panel, inner } = this.parts(previous);
      // Things still moving from the last choice: go straight into the move from where they are
      if (moving(panel) || [...list.children].some((card) => moving(card))) {
        this.switchIn(list, target, { deferOpen: true });
        return;
      }
      // Still opening? Hold it where it is, so nothing drifts before the straight move
      if (moving(panel)) {
        const height = panel.getBoundingClientRect().height;
        stop(panel);
        panel.style.height = height + 'px';
        panel.style.overflow = 'hidden';
      }
      const from = parseFloat(getComputedStyle(inner).opacity);
      stop(inner);
      animate(inner, { opacity: [from, 0] }, { duration: OUT, ease: 'linear' }).then(() => {
        if (this.pending.get(list) !== token) return;
        inner.style.opacity = '0';
        this.switchIn(list, target, { deferOpen: true });
      });
    }

    switchIn(list, target, { focus = null, duration = MOVE, deferOpen = false } = {}) {
      const cards = [...list.children];
      const previous = this.open.get(list) || null;
      cards.forEach((card) => card.classList.remove('is-next'));
      if (previous === target) {
        list.classList.toggle('has-open', this.open.has(list));
        return;
      }
      const was = previous && this.parts(previous);
      const next = target && this.parts(target);

      // The cards are briefly laid out where they end up, to be measured: the browser must not
      // shift the page's scroll to keep things still while they are (it jumped it by ~90px, which
      // the eased scroll then had to undo)
      this.holdScroll(duration);

      const before = new Map(cards.map((card) => [card, shown(card)]));
      const wasHeight = was && !was.panel.hidden ? was.panel.getBoundingClientRect().height : 0;
      const wasOpacity = was && !was.panel.hidden ? parseFloat(getComputedStyle(was.inner).opacity) : 1;
      const wasWidth = was && !was.panel.hidden ? was.inner.getBoundingClientRect().width : 0;
      const nextFrom = next && !next.panel.hidden ? next.panel.getBoundingClientRect().height : 0;
      const nextOpacity = next && !next.panel.hidden ? parseFloat(getComputedStyle(next.inner).opacity) : null;

      // Panels around this list that are still easing open: carry them to their new height too
      const outer = [];
      for (let p = list.parentElement.closest('[data-panel]'); p; p = p.parentElement.closest('[data-panel]')) {
        if (moving(p)) outer.push([p, p.getBoundingClientRect().height]);
      }

      // Settle everything into its end state, without animation
      cards.forEach((card) => {
        stop(card);
        clear(card, 'transform', 'width', 'z-index', 'grid-row', 'clip-path');
        const { panel, inner } = this.parts(card);
        if (!panel) return; // a silo that is just a link
        stop(panel);
        stop(inner);
        clear(panel, 'height', 'overflow');
        clear(inner, 'opacity', 'width');
        if (card === target) return;
        if (!panel.hidden) {
          panel.hidden = true;
          if (card !== previous) this.resetInside(panel);
        }
        this.setOpen(card, false);
      });
      if (target) {
        this.setOpen(target, true);
        // It keeps its own row, at full width; its row-mate moves down
        const columns = parseInt(getComputedStyle(list).getPropertyValue('--per-row'), 10) || 1;
        // Its place as seen: silos on desktop are ordered down one column then the other
        const place = columns > 1 && target.dataset.order !== undefined ? Number(target.dataset.order) : cards.indexOf(target);
        if (!this.classList.contains('ssilo--page')) target.style.gridRow = String(Math.floor(place / columns) + 1);
        next.panel.querySelectorAll('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
        next.panel.hidden = false;
      }

      // Scroll to where things end up: the opened card under the header, or the closed one mid-screen
      const nextHeight = target ? next.panel.getBoundingClientRect().height : 0;
      if (focus) {
        // First step of a swap: bring the card about to open up under the header as this one closes
        this.scrollTo(focus.getBoundingClientRect().top + window.scrollY - this.headerOffset(), duration);
      } else if (target) {
        // The opened card, at its full size, in the middle of the screen
        const end = target.getBoundingClientRect();
        this.centre(end.top + window.scrollY, end.height);
      } else if (previous) {
        const end = previous.getBoundingClientRect();
        this.centre(end.top + window.scrollY, end.height);
      }

      if (reduced()) {
        if (was) this.resetInside(was.panel);
        return;
      }

      // Start: the panels at the heights they have now
      if (was) {
        was.panel.hidden = false;
        was.panel.style.height = wasHeight + 'px';
        was.panel.style.overflow = 'hidden';
        was.inner.style.opacity = String(wasOpacity);
      }
      if (next) {
        next.panel.style.height = nextFrom + 'px';
        next.panel.style.overflow = 'hidden';
      }
      const after = new Map(cards.map((card) => [card, card.getBoundingClientRect()]));

      // While a card widens or narrows, its contents keep the width they have at the end (or had at
      // the start, for the one closing) and are clipped by it, so the names never re-wrap mid-way:
      // no list ballooning to the height of the screen and snapping back.
      const pin = (card, inner, width) => {
        if (!inner || !width || Math.abs(before.get(card).width - after.get(card).width) <= 1) return;
        inner.style.width = width + 'px';
        setTimeout(() => {
          if (!ours(card).some((a) => a.effect && a.effect.getKeyframes().some((k) => 'width' in k))) clear(inner, 'width');
        }, duration * 1000 + 30);
      };
      if (next) pin(target, next.inner, next.inner.getBoundingClientRect().width);
      if (was) pin(previous, was.inner, wasWidth);

      // Whichever of a card's moves ends last clears what they all set (each checking only that
      // nothing else was still running left the clip in place when both ended in the same frame)
      const settle = (card) => {
        requestAnimationFrame(() => {
          if (!moving(card)) clear(card, 'width', 'z-index', 'clip-path', 'transform');
        });
      };

      cards.forEach((card) => {
        const b = before.get(card);
        const a = after.get(card);
        if (Math.abs(b.width - a.width) > 1) {
          // Growing to (or shrinking from) the full row, the closing card on top as it shrinks. Not a
          // real width change (the page re-laid out and the photo re-scaled every frame, which
          // phones can't keep up with): the card takes the wider of its two sizes for the move and
          // its right edge is a clip sliding in or out, which costs nothing per frame.
          card.style.zIndex = card === previous ? '2' : '1';
          const wide = Math.max(b.width, a.width);
          if (b.width > a.width) card.style.width = wide + 'px';
          // Brand cards are rounded; silo rows are plain text, so a square clip (a rounded one cut
          // into the first letter)
          const round = card.classList.contains('ssilo__brand') ? 20 : 0;
          const edge = (width) => `inset(0px ${wide - width}px 0px 0px round ${round}px)`;
          animate(card, { clipPath: [edge(b.width), edge(a.width)] }, { duration, ease: EASE }).then(() => settle(card));
        }
        const dx = b.left - a.left;
        const dy = b.top - a.top;
        if (Math.abs(dx) > 0.5 || Math.abs(dy) > 0.5) {
          animate(card, { transform: [`translate(${dx}px, ${dy}px)`, 'translate(0px, 0px)'] }, { duration, ease: EASE }).then(() => settle(card));
        }
      });

      if (was) {
        animate(was.inner, { opacity: [wasOpacity, 0] }, { duration: OUT, ease: 'linear' });
        animate(was.panel, { height: [wasHeight + 'px', '0px'] }, { duration, ease: EASE }).then(() => {
          if (previous.classList.contains('is-open') || moving(was.panel)) return;
          was.panel.hidden = true;
          clear(was.panel, 'height', 'overflow');
          clear(was.inner, 'opacity', 'width');
          this.resetInside(was.panel);
        });
      }
      outer.forEach(([p, height]) => {
        stop(p);
        clear(p, 'height');
        this.ease(p, height, p.getBoundingClientRect().height);
      });
      if (next && deferOpen) {
        // Its contents wait until it has arrived, then roll out
        setTimeout(() => {
          if (this.open.get(list) !== target || moving(next.panel)) return;
          if (next.panel.style.height !== '0px') return;
          clear(next.panel, 'height');
          const height = next.panel.getBoundingClientRect().height;
          next.panel.style.height = '0px';
          this.ease(next.panel, 0, height);
          this.roll(next.panel);
        }, duration * 1000);
      } else if (next) {
        this.ease(next.panel, nextFrom, nextHeight, duration);
        if (nextOpacity !== null && nextOpacity > 0) {
          if (nextOpacity < 1) {
            animate(next.inner, { opacity: [nextOpacity, 1] }, { duration: 0.25, ease: EASE }).then(() => clear(next.inner, 'opacity'));
          }
        } else {
          this.roll(next.panel);
        }
      }
    }

    /** No scroll anchoring on the page while things move (the eased scroll does the moving) */
    holdScroll(duration) {
      const root = document.documentElement;
      root.style.overflowAnchor = 'none';
      clearTimeout(this.anchorTimer);
      this.anchorTimer = setTimeout(() => root.style.removeProperty('overflow-anchor'), duration * 1000 + 400);
    }

    /** Anything left open inside a closed panel is shut, out of sight */
    resetInside(panel) {
      panel.querySelectorAll('[data-item].is-open').forEach((child) => {
        this.setOpen(child, false);
        const parts = this.parts(child);
        stop(parts.panel);
        stop(parts.inner);
        parts.panel.hidden = true;
        clear(parts.panel, 'height', 'overflow');
        clear(parts.inner, 'opacity');
      });
    }

    ease(panel, from, to, duration = MOVE) {
      if (Math.abs(to - from) < 1) {
        clear(panel, 'height', 'overflow');
        return;
      }
      panel.style.overflow = 'hidden';
      animate(panel, { height: [from + 'px', to + 'px'] }, { duration, ease: EASE }).then(() => {
        if (moving(panel)) return;
        clear(panel, 'height', 'overflow');
      });
    }

    /** Ease the page to a scroll position, in step with the panels; a touch or wheel takes over */
    /* The page's own smooth scroll, which phones run off the main thread (stepping the scroll
       from a script each frame stuttered on iPhones); a touch or wheel takes over as usual */
    scrollTo(target) {
      const top = Math.max(0, target);
      if (Math.abs(top - window.scrollY) < 4) return;
      window.scrollTo({ top, behavior: reduced() ? 'instant' : 'smooth' });
    }
  }

  if (!customElements.get('shop-by-silo')) customElements.define('shop-by-silo', ShopBySilo);
</script>

{% stylesheet %}
  .ssilo {
    display: block;
    --ssilo-ease: cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  .ssilo__heading {
    margin: 0 0 16px;
    font-size: clamp(1.75rem, 6.5vw, 2.5rem);
