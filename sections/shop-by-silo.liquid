{%- comment -%}
  Shop by silo: a card per brand, two a row (image, name over it, a plus to open).
  - Opening a brand brings its card forward: it widens to fill its row (the others slide to their new
    places and step back), its image fades to white, and its silos roll down in a panel joined to
    the card: one row per silo, a small image and the name on one line.
  - Opening a silo does the same inside the brand: the row comes forward and its generations roll
    down beneath it as plain lines (name left, picture right), each linking to that generation's
    collection (tag gen:<brand>-<model>-<gen>).
  - The plus turns into an X to close; each open panel also ends with Close. One brand, and one silo
    per brand, open at a time. Opening scrolls the card or row up under the header; closing scrolls
    the closed card or row to the middle of the screen.

  Blocks are flat in the editor: each Silo belongs to the Brand block above it.
  A silo with no generations is a plain link to its collection.
  Animations: Motion (motion.dev), house timing.
{%- endcomment -%}

{%- liquid
  assign section_id = 'ssilo-' | append: section.id
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }}">
  <shop-by-silo
    class="ssilo spacing-style"
    id="{{ section_id }}"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="ssilo__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="ssilo__brands" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'brand' -%}
          {%- liquid
            assign brand_name = block.settings.title | strip
            assign brand_prefix = brand_name | append: ' '
            assign brand_url = block.settings.collection.url
            assign brand_image = block.settings.image | default: block.settings.collection.featured_image
            assign start = forloop.index
          -%}
          <li class="ssilo__brand" data-item="{{ block.id }}" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="ssilo__brand-head"
              data-toggle="{{ block.id }}"
              aria-expanded="false"
              aria-controls="{{ section_id }}-{{ block.id }}"
            >
              <span class="ssilo__brand-media">
                {%- if brand_image -%}
                  {{
                    brand_image
                    | image_url: width: 1400
                    | image_tag:
                      widths: '480, 720, 960, 1200, 1400',
                      sizes: '(min-width: 990px) 46vw, 92vw',
                      loading: 'lazy',
                      class: 'ssilo__brand-image',
                      alt: ''
                  }}
                {%- endif -%}
              </span>
              <span class="ssilo__brand-text">
                <span class="ssilo__brand-name">{{ brand_name | escape }}</span>
              </span>
              <span class="ssilo__plus ssilo__plus--brand" aria-hidden="true">
                {%- render 'gicon', name: 'add', size: 24 -%}
              </span>
            </button>

            <div class="ssilo__panel" id="{{ section_id }}-{{ block.id }}" data-panel hidden>
              <div class="ssilo__inner ssilo__inner--brand">
                <ul class="ssilo__silos" role="list">
                  {%- for silo in section.blocks offset: start -%}
                    {%- if silo.type == 'brand' -%}{%- break -%}{%- endif -%}
                    {%- liquid
                      assign silo_title = silo.settings.title | strip
                      assign silo_prefix = silo_title | append: ' '
                      assign silo_label = silo_title | remove_first: brand_prefix
                      assign last_word = silo_title | split: ' ' | last
                      assign shown = 0
                      assign first_image = nil
                      for generation in silo.settings.generations
                        if generation.products_count > 0
                          assign shown = shown | plus: 1
                          if first_image == nil
                            assign first_image = generation.featured_image
                          endif
                        endif
                      endfor
                      assign silo_image = silo.settings.image | default: silo.settings.collection.featured_image | default: first_image
                    -%}
                    {%- capture silo_face -%}
                      <span class="ssilo__row-text">
                        <span class="ssilo__row-name">{{ silo_label | escape }}</span>
                      </span>
                      <span class="ssilo__thumb">
                        {%- if silo_image -%}
                          {{
                            silo_image
                            | image_url: width: 280
                            | image_tag: widths: '120, 200, 280', sizes: '(min-width: 750px) 104px, 60px', loading: 'eager', fetchpriority: 'low', class: 'ssilo__thumb-image', alt: ''
                          }}
                        {%- endif -%}
                      </span>
                    {%- endcapture -%}

                    <li class="ssilo__silo" data-item="{{ silo.id }}" data-anim {{ silo.shopify_attributes }}>
                      {%- if shown > 0 -%}
                        <button
                          type="button"
                          class="ssilo__row"
                          data-toggle="{{ silo.id }}"
                          aria-expanded="false"
                          aria-controls="{{ section_id }}-{{ silo.id }}"
                        >
                          {{ silo_face }}
                          <span class="ssilo__plus" aria-hidden="true">
                            {%- render 'gicon', name: 'add', size: 20 -%}
                          </span>
                        </button>

                        <div class="ssilo__panel" id="{{ section_id }}-{{ silo.id }}" data-panel hidden>
                          <div class="ssilo__inner ssilo__inner--silo">
                            <ul class="ssilo__gens" role="list">
                              {%- for generation in silo.settings.generations -%}
                                {%- if generation.products_count > 0 -%}
                                  {%- liquid
                                    assign label = generation.title | remove_first: silo_prefix | strip
                                    if label == generation.title
                                      assign label = generation.title | remove_first: brand_prefix
                                    endif
                                    # A bare number or code reads with its model ("6" -> "Phantom 6", "19" -> "X 19")
                                    if label.size <= 2
                                      assign label = last_word | append: ' ' | append: label
                                    endif
                                  -%}
                                  <li data-anim>
                                    <a class="ssilo__gen" href="{{ generation.url }}">
                                      <span class="ssilo__row-text">
                                        <span class="ssilo__gen-name">{{ label | escape }}</span>
                                      </span>
                                      <span class="ssilo__gen-pic">
                                        {%- if generation.featured_image -%}
                                          {{
                                            generation.featured_image
                                            | image_url: width: 160
                                            | image_tag: widths: '100, 160', sizes: '(min-width: 750px) 76px, 52px', loading: 'lazy', class: 'ssilo__thumb-image', alt: ''
                                          }}
                                        {%- endif -%}
                                      </span>
                                    </a>
                                  </li>
                                {%- endif -%}
                              {%- endfor -%}
                            </ul>
                            <div class="ssilo__foot" data-anim>
                              {%- if silo.settings.collection != blank -%}
                                <a class="ssilo__all" href="{{ silo.settings.collection.url }}">
                                  Shop all {{ silo_label | escape }}
                                  {%- render 'gicon', name: 'arrow_forward', size: 16 -%}
                                </a>
                              {%- else -%}
                                <span></span>
                              {%- endif -%}
                              <button type="button" class="ssilo__close" data-close="{{ silo.id }}">
                                Close
                                {%- render 'gicon', name: 'keyboard_arrow_up', size: 18 -%}
                              </button>
                            </div>
                          </div>
                        </div>
                      {%- else -%}
                        <a class="ssilo__row" href="{{ silo.settings.collection.url | default: brand_url | default: '#' }}">
                          {{ silo_face }}
                          <span class="ssilo__plus" aria-hidden="true">
                            {%- render 'gicon', name: 'arrow_forward', size: 18 -%}
                          </span>
                        </a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
                <div class="ssilo__foot" data-anim>
                  {%- if brand_url != blank -%}
                    <a class="ssilo__all" href="{{ brand_url }}">
                      Shop all {{ brand_name | escape }}
                      {%- render 'gicon', name: 'arrow_forward', size: 16 -%}
                    </a>
                  {%- else -%}
                    <span></span>
                  {%- endif -%}
                  <button type="button" class="ssilo__close" data-close="{{ block.id }}">
                    Close
                    {%- render 'gicon', name: 'keyboard_arrow_up', size: 18 -%}
                  </button>
                </div>
              </div>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </shop-by-silo>
</div>

<script type="module">
  import { animate, stagger } from 'motion';

  const EASE = [0.3, 0.7, 0.3, 1];
  const MOVE = 0.55;
  const SWAP = 0.4; // the first step of swapping one open card for another
  const OUT = 0.18;
  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stop = (el) => el.getAnimations().forEach((a) => a.cancel());
  const clear = (el, ...props) => props.forEach((p) => el.style.removeProperty(p));

  /** cubic-bezier(x1, y1, x2, y2) as a function of progress, for the page scroll */
  const bezier = (x1, y1, x2, y2) => {
    const a = (p, q) => 1 - 3 * q + 3 * p;
    const b = (p, q) => 3 * q - 6 * p;
    const c = (p) => 3 * p;
    const at = (t, p, q) => ((a(p, q) * t + b(p, q)) * t + c(p)) * t;
    const slope = (t, p, q) => 3 * a(p, q) * t * t + 2 * b(p, q) * t + c(p);
    return (x) => {
      let t = x;
      for (let i = 0; i < 8; i++) {
        const err = at(t, x1, x2) - x;
        const s = slope(t, x1, x2);
        if (Math.abs(err) < 1e-5 || !s) break;
        t -= err / s;
      }
      return at(Math.min(1, Math.max(0, t)), y1, y2);
    };
  };
  const scrollEase = bezier(...EASE);

  class ShopBySilo extends HTMLElement {
    connectedCallback() {
      this.brands = this.querySelector('.ssilo__brands');
      this.open = new Map(); // list -> its open item
      this.pending = new Map(); // list -> the latest choice, so an older swap step can stand down
      this.scrollFrame = 0;

      this.addEventListener('click', (event) => {
        const control = event.target.closest('[data-toggle], [data-close]');
        if (!control || !this.contains(control)) return;
        const item = this.itemOf(control.dataset.toggle || control.dataset.close);
        if (!item) return;
        const shut = control.dataset.close || item.classList.contains('is-open');
        this.choose(item.parentElement, shut ? null : item);
      });

      // Start loading a panel's images as soon as its opener is pointed at or pressed
      const warm = (event) => {
        const control = event.target.closest && event.target.closest('[data-toggle]');
        const panel = control && this.itemOf(control.dataset.toggle)?.querySelector(':scope > [data-panel]');
        if (panel) panel.querySelectorAll('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
      };
      this.addEventListener('pointerover', warm, { passive: true });
      this.addEventListener('pointerdown', warm, { passive: true });

      // Theme editor: selecting a Brand or Silo block opens it (and its brand)
      this.onBlockSelect = (event) => {
        const target = event.target.closest && event.target.closest('[data-item]');
        if (!target || !this.contains(target)) return;
        const chain = [];
        for (let el = target; el && el !== this; el = el.parentElement.closest('[data-item]')) chain.unshift(el);
        chain.forEach((el) => {
          if (!el.querySelector(':scope > [data-panel]') || el.classList.contains('is-open')) return;
          this.choose(el.parentElement, el);
        });
      };
      document.addEventListener('shopify:block:select', this.onBlockSelect);
    }

    disconnectedCallback() {
      document.removeEventListener('shopify:block:select', this.onBlockSelect);
      cancelAnimationFrame(this.scrollFrame);
    }

    itemOf(id) {
      return this.querySelector(`[data-item="${id}"]`);
    }

    parts(item) {
      const panel = item.querySelector(':scope > [data-panel]');
      return { head: item.querySelector(':scope > [data-toggle]'), panel, inner: panel ? panel.firstElementChild : null };
    }

    /** What rolls in when a panel opens: its own rows, not those of panels inside it */
    rollers(panel) {
      return [...panel.querySelectorAll('[data-anim]')].filter((el) => el.closest('[data-panel]') === panel);
    }

    setOpen(item, on) {
      const list = item.parentElement;
      item.classList.toggle('is-open', on);
      item.querySelector(':scope > [data-toggle]')?.setAttribute('aria-expanded', String(on));
      if (on) this.open.set(list, item);
      else if (this.open.get(list) === item) this.open.delete(list);
      // The other cards or rows step back while one is open
      list.classList.toggle('has-open', this.open.has(list));
    }

    headerOffset() {
      const header = document.querySelector('#header-component[sticky]');
      return (header ? Math.max(0, header.getBoundingClientRect().bottom) : 0) + 12;
    }

    /** A panel's rows roll down into place, one after another */
    roll(panel) {
      const rows = this.rollers(panel);
      if (!rows.length) return;
      rows.forEach(stop);
      animate(
        rows,
        {
          opacity: [0, 1],
          transform: ['perspective(700px) translateY(-14px) rotateX(-32deg)', 'perspective(700px) translateY(0px) rotateX(0deg)'],
        },
        { duration: MOVE, ease: EASE, delay: stagger(Math.min(0.04, 0.4 / rows.length), { startDelay: 0.06 }) }
      ).then(() => rows.forEach((row) => clear(row, 'opacity', 'transform')));
    }

    /** Scroll so something (by its page top and height) sits in the middle of the screen below the header */
    centre(top, height) {
      const offset = this.headerOffset();
      const middle = offset + (window.innerHeight - offset) / 2;
      this.scrollTo(top + height / 2 - middle);
    }

    /**
     * Open one brand or silo in its list (or none). The open one takes its row at full width, the others
     * slide to their new places, its panel eases open as the one it replaces eases shut, and the page
     * scrolls with it: an opened one up under the header, a closed one to the middle of the screen.
     * Positions are animated from where they are (FLIP), so a tap mid-way carries on smoothly.
     */
    /**
     * Choose one in a list (or none). Swapping one open card for another runs in two steps, so cards
     * never cross: the open one closes quickly back into the grid, then the new one opens. The others
     * stay stepped back throughout, and a tap during the swap takes over from wherever it is.
     */
    choose(list, target) {
      const previous = this.open.get(list) || null;
      const token = {};
      this.pending.set(list, token);
      if (!previous || !target || previous === target || reduced()) {
        this.switchIn(list, target);
        return;
      }
      this.switchIn(list, null, { focus: target, duration: SWAP });
      list.classList.add('has-open');
      target.classList.add('is-next');
      setTimeout(() => {
        if (this.pending.get(list) === token) this.switchIn(list, target);
      }, SWAP * 1000);
    }

    switchIn(list, target, { focus = null, duration = MOVE } = {}) {
      const cards = [...list.children];
      const previous = this.open.get(list) || null;
      cards.forEach((card) => card.classList.remove('is-next'));
      if (previous === target) {
        list.classList.toggle('has-open', this.open.has(list));
        return;
      }
      const was = previous && this.parts(previous);
      const next = target && this.parts(target);

      const before = new Map(cards.map((card) => [card, card.getBoundingClientRect()]));
      const wasHeight = was && !was.panel.hidden ? was.panel.getBoundingClientRect().height : 0;
      const wasOpacity = was && !was.panel.hidden ? parseFloat(getComputedStyle(was.inner).opacity) : 1;
      const nextFrom = next && !next.panel.hidden ? next.panel.getBoundingClientRect().height : 0;
      const nextOpacity = next && !next.panel.hidden ? parseFloat(getComputedStyle(next.inner).opacity) : null;

      // Panels around this list that are still easing open: carry them to their new height too
      const outer = [];
      for (let p = list.parentElement.closest('[data-panel]'); p; p = p.parentElement.closest('[data-panel]')) {
        if (p.getAnimations().length) outer.push([p, p.getBoundingClientRect().height]);
      }

      // Settle everything into its end state, without animation
      cards.forEach((card) => {
        stop(card);
        clear(card, 'transform', 'width', 'z-index', 'grid-row');
        const { panel, inner } = this.parts(card);
        if (!panel) return; // a silo that is just a link
        stop(panel);
        stop(inner);
        clear(panel, 'height', 'overflow');
        clear(inner, 'opacity');
        if (card === target) return;
        if (!panel.hidden) {
          panel.hidden = true;
          if (card !== previous) this.resetInside(panel);
        }
        this.setOpen(card, false);
      });
      if (target) {
        this.setOpen(target, true);
        // It keeps its own row, at full width; its row-mate moves down
        const columns = parseInt(getComputedStyle(list).getPropertyValue('--per-row'), 10) || 1;
        target.style.gridRow = String(Math.floor(cards.indexOf(target) / columns) + 1);
        next.panel.querySelectorAll('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
        next.panel.hidden = false;
      }

      // Scroll to where things end up: the opened card under the header, or the closed one mid-screen
      const nextHeight = target ? next.panel.getBoundingClientRect().height : 0;
      if (focus) {
        // First step of a swap: bring the card about to open up under the header as this one closes
        this.scrollTo(focus.getBoundingClientRect().top + window.scrollY - this.headerOffset(), duration);
      } else if (target) {
        this.scrollTo(target.getBoundingClientRect().top + window.scrollY - this.headerOffset());
      } else if (previous) {
        const end = previous.getBoundingClientRect();
        this.centre(end.top + window.scrollY, end.height);
      }

      if (reduced()) {
        if (was) this.resetInside(was.panel);
        return;
      }

      // Start: the panels at the heights they have now
      if (was) {
        was.panel.hidden = false;
        was.panel.style.height = wasHeight + 'px';
        was.panel.style.overflow = 'hidden';
        was.inner.style.opacity = String(wasOpacity);
      }
      if (next) {
        next.panel.style.height = nextFrom + 'px';
        next.panel.style.overflow = 'hidden';
      }
      const after = new Map(cards.map((card) => [card, card.getBoundingClientRect()]));

      cards.forEach((card) => {
        const b = before.get(card);
        const a = after.get(card);
        if (Math.abs(b.width - a.width) > 1) {
          // Growing to (or shrinking from) the full row; the closing card stays on top as it shrinks
          card.style.zIndex = card === previous ? '2' : '1';
          animate(card, { width: [b.width + 'px', a.width + 'px'] }, { duration, ease: EASE }).then(() => {
            if (!card.getAnimations().length) clear(card, 'width', 'z-index');
          });
        }
        const dx = b.left - a.left;
        const dy = b.top - a.top;
        if (Math.abs(dx) > 0.5 || Math.abs(dy) > 0.5) {
          animate(card, { transform: [`translate(${dx}px, ${dy}px)`, 'translate(0px, 0px)'] }, { duration, ease: EASE }).then(() => {
            if (!card.getAnimations().length) clear(card, 'transform');
          });
        }
      });

      if (was) {
        animate(was.inner, { opacity: [wasOpacity, 0] }, { duration: OUT, ease: 'linear' });
        animate(was.panel, { height: [wasHeight + 'px', '0px'] }, { duration, ease: EASE }).then(() => {
          if (previous.classList.contains('is-open') || was.panel.getAnimations().length) return;
          was.panel.hidden = true;
          clear(was.panel, 'height', 'overflow');
          clear(was.inner, 'opacity');
          this.resetInside(was.panel);
        });
      }
      outer.forEach(([p, height]) => {
        stop(p);
        clear(p, 'height');
        this.ease(p, height, p.getBoundingClientRect().height);
      });
      if (next) {
        this.ease(next.panel, nextFrom, nextHeight, duration);
        if (nextOpacity !== null && nextOpacity > 0) {
          if (nextOpacity < 1) {
            animate(next.inner, { opacity: [nextOpacity, 1] }, { duration: 0.25, ease: EASE }).then(() => clear(next.inner, 'opacity'));
          }
        } else {
          this.roll(next.panel);
        }
      }
    }

    /** Anything left open inside a closed panel is shut, out of sight */
    resetInside(panel) {
      panel.querySelectorAll('[data-item].is-open').forEach((child) => {
        this.setOpen(child, false);
        const parts = this.parts(child);
        stop(parts.panel);
        stop(parts.inner);
        parts.panel.hidden = true;
        clear(parts.panel, 'height', 'overflow');
        clear(parts.inner, 'opacity');
      });
    }

    ease(panel, from, to, duration = MOVE) {
      if (Math.abs(to - from) < 1) {
        clear(panel, 'height', 'overflow');
        return;
      }
      panel.style.overflow = 'hidden';
      animate(panel, { height: [from + 'px', to + 'px'] }, { duration, ease: EASE }).then(() => {
        if (panel.getAnimations().length) return;
        clear(panel, 'height', 'overflow');
      });
    }

    /** Ease the page to a scroll position, in step with the panels; a touch or wheel takes over */
    scrollTo(target, duration = MOVE) {
      cancelAnimationFrame(this.scrollFrame);
      const start = window.scrollY;
      const distance = Math.max(0, target) - start;
      if (Math.abs(distance) < 4) return;
      if (reduced()) {
        window.scrollTo({ top: start + distance, behavior: 'instant' });
        return;
      }
      const yieldScroll = () => cancelAnimationFrame(this.scrollFrame);
      window.addEventListener('wheel', yieldScroll, { once: true, passive: true });
      window.addEventListener('touchstart', yieldScroll, { once: true, passive: true });
      const began = performance.now();
      const step = (now) => {
        const p = Math.min(1, (now - began) / (duration * 1000));
        window.scrollTo({ top: start + distance * scrollEase(p), behavior: 'instant' });
        if (p < 1) this.scrollFrame = requestAnimationFrame(step);
      };
      this.scrollFrame = requestAnimationFrame(step);
    }
  }

  if (!customElements.get('shop-by-silo')) customElements.define('shop-by-silo', ShopBySilo);
</script>

{% stylesheet %}
  .ssilo {
    display: block;
    --ssilo-ease: cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  .ssilo__heading {
    margin: 0 0 16px;
    font-size: clamp(1.75rem, 6.5vw, 2.5rem);
    font-weight: 750;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .ssilo__brands,
  .ssilo__silos,
  .ssilo__gens {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Brand cards, two a row; an open card takes its row at full width */
  .ssilo__brands {
    --ssilo-gap: 10px;
    --ssilo-cols: 2;
    --per-row: var(--ssilo-cols);
    --ssilo-ratio: 1;
    display: grid;
    grid-template-columns: repeat(var(--ssilo-cols), minmax(0, 1fr));
    gap: var(--ssilo-gap);
    align-items: start;
    container-type: inline-size;
  }

  /* A card per brand */
  .ssilo__brand {
    border-radius: 20px;
    overflow: hidden;
    background: #ffffff;
    color: #121212;
    position: relative;
    box-shadow: 0 1px 2px rgb(18 18 18 / 0.06), 0 8px 24px rgb(18 18 18 / 0.06);
    transition:
      opacity 0.35s ease,
      box-shadow 0.35s ease;
  }

  .ssilo__brand.is-open {
    grid-column: 1 / -1;
  }

  /* One brand open: it comes forward, the others step back */
  .ssilo__brands.has-open > .ssilo__brand:not(.is-open):not(.is-next) {
    opacity: 0.07;
  }

  .ssilo__brand.is-open {
    box-shadow: 0 2px 4px rgb(18 18 18 / 0.08), 0 20px 48px rgb(18 18 18 / 0.18);
  }

  .ssilo__brand-head {
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: #ffffff;
    color: #ffffff;
    font: inherit;
    text-align: start;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* The same height closed and open (a column's width x the ratio), so a card can widen smoothly */
  .ssilo__brand-media {
    display: block;
    height: calc((100cqi - (var(--ssilo-cols) - 1) * var(--ssilo-gap)) / var(--ssilo-cols) * var(--ssilo-ratio));
    /* A whole number of pixels, so no sliver opens up where the image meets the panel */
    height: round(down, calc((100cqi - (var(--ssilo-cols) - 1) * var(--ssilo-gap)) / var(--ssilo-cols) * var(--ssilo-ratio)), 1px);
    overflow: hidden;
  }

  .ssilo__brand-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ssilo-ease);
  }

  .ssilo__brand.is-open .ssilo__brand-head .ssilo__brand-image {
    transform: scale(1.06);
  }

  /* Closed: the foot of the image darkens so the white name reads.
     Open: the image fades to white into the panel below, and the name turns dark. */
  .ssilo__brand-head::before,
  .ssilo__brand-head::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 0.55s var(--ssilo-ease);
  }

  .ssilo__brand-head::after {
    background: linear-gradient(to top, rgb(0 0 0 / 0.68), rgb(0 0 0 / 0.18) 55%, rgb(0 0 0 / 0.05));
  }

  .ssilo__brand-head::before {
    z-index: 1;
    bottom: -1px;
    opacity: 0;
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0) 20%,
      rgb(255 255 255 / 0.55) 55%,
      rgb(255 255 255 / 0.92) 82%,
      #ffffff 100%
    );
  }

  .ssilo__brand.is-open .ssilo__brand-head::before {
    opacity: 1;
  }

  /* Opening: the dark shade clears quickly, so the join is white from the start */
  .ssilo__brand.is-open .ssilo__brand-head::before {
    transition-duration: 0.35s;
  }

  .ssilo__brand.is-open .ssilo__brand-head::after {
    transition: opacity 0.2s linear;
    opacity: 0;
  }

  .ssilo__brand-text {
    position: absolute;
    inset: auto 60px 12px 14px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    transition: color 0.45s ease;
  }

  .ssilo__brand.is-open .ssilo__brand-text {
    color: #121212;
  }

  .ssilo__brand-name {
    font-size: clamp(1.375rem, 6vw, 2.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }


  .ssilo__plus {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ffffff;
    color: #121212;
    transition: background-color 0.25s ease;
  }

  .ssilo__plus svg {
    transition: transform 0.45s var(--ssilo-ease);
  }

  .ssilo__plus--brand {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    width: 38px;
    height: 38px;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.25);
  }

  /* The plus turns into an X while open */
  .is-open > [data-toggle] .ssilo__plus svg {
    transform: rotate(45deg);
  }

  .ssilo__panel[hidden] {
    display: none !important;
  }

  .ssilo__inner--brand {
    padding: 4px 10px 8px;
  }

  /* A row per silo: small image and name on one line */
  /* A line per silo on the white panel: the name on the left, its image on the right */
  /* Columns: name (as wide as the longest), image, then the plus at the far end. Each row uses the
     list's columns (subgrid), so every image lines up just after the longest name. */
  .ssilo__silos {
    --per-row: 1;
    display: grid;
    grid-template-columns: minmax(0, max-content) max-content minmax(24px, 1fr);
    column-gap: 14px;
  }

  .ssilo__silo {
    position: relative;
    display: grid;
    grid-column: span 3;
    grid-template-columns: subgrid;
    background: #ffffff;
    transform-origin: 50% 0;
  }

  .ssilo__silo > .ssilo__panel {
    grid-column: 1 / -1;
  }

  /* An open silo takes its row at full width (desktop has two a row) */
  .ssilo__silo.is-open {
    grid-column: 1 / -1;
  }

  .ssilo__silos.has-open > .ssilo__silo:not(.is-open):not(.is-next) > .ssilo__row {
    opacity: 0.07;
  }

  .ssilo__row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    min-height: 0;
    margin: 0;
    padding: 3px 2px;
    border: 0;
    background: none;
    color: #121212;
    font: inherit;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: opacity 0.35s ease;
  }

  /* A silo's plus is just the icon, no circle */
  .ssilo__row .ssilo__plus {
    grid-column: -2 / -1;
    justify-self: end;
    width: 24px;
    height: 24px;
    background: none;
    color: rgb(18 18 18 / 0.55);
  }

  .ssilo__thumb {
    display: block;
    flex: none;
    width: 60px;
    height: 36px;
    border-radius: 7px;
    overflow: hidden;
  }

  .ssilo__thumb .ssilo__thumb-image {
    object-fit: cover;
  }

  .ssilo__thumb-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ssilo__row-text {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-width: 0;
  }

  /* Names as tall as their images */
  .ssilo__row-name {
    font-size: 2.125rem;
    font-weight: 750;
    line-height: 1.06;
    letter-spacing: -0.03em;
    overflow-wrap: break-word;
  }

  .ssilo__row-sub {
    margin-block-start: 2px;
    font-size: 0.75rem;
    color: rgb(18 18 18 / 0.5);
    font-variant-numeric: tabular-nums;
  }

  /* Generations, beneath their silo row */
  .ssilo__inner--silo {
    padding: 0 0 8px;
  }

  /* Generations: plain lines, the name on the left and a picture on the right */
  .ssilo__gens {
    display: grid;
    grid-template-columns: minmax(0, max-content) max-content minmax(0, 1fr);
    column-gap: 12px;
  }

  .ssilo__gens > li {
    display: grid;
    grid-column: span 3;
    grid-template-columns: subgrid;
    transform-origin: 50% 0;
  }

  .ssilo__gen {
    display: grid;
    grid-column: 1 / 3;
    grid-template-columns: subgrid;
    align-items: center;
    height: 100%;
    min-height: 0;
    padding: 3px 2px;
    color: #121212;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .ssilo__gen-pic {
    display: block;
    width: 52px;
    height: 30px;
  }

  .ssilo__gen-name {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    overflow-wrap: break-word;
  }

  .ssilo__silo [data-anim],
  .ssilo__foot {
    transform-origin: 50% 0;
  }

  .ssilo__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 4px 4px;
  }

  .ssilo__all,
  .ssilo__close {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 36px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: #121212;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
  }

  .ssilo__close {
    color: rgb(18 18 18 / 0.6);
  }

  .ssilo__all svg,
  .ssilo__close svg {
    width: 18px;
    height: 18px;
  }

  @media (hover: hover) {
    .ssilo__brand:hover {
      box-shadow: 0 2px 4px rgb(18 18 18 / 0.08), 0 14px 36px rgb(18 18 18 / 0.14);
    }

    .ssilo__brands.has-open > .ssilo__brand:not(.is-open):not(.is-next):hover {
      opacity: 0.4;
    }

    .ssilo__silos.has-open > .ssilo__silo:not(.is-open):not(.is-next) > .ssilo__row:hover {
      opacity: 0.4;
    }

    .ssilo__row:hover .ssilo__row-name {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .ssilo__gen:hover .ssilo__gen-name {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .ssilo__all:hover,
    .ssilo__close:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  .ssilo__brand-head:focus-visible,
  .ssilo__row:focus-visible,
  .ssilo__gen:focus-visible,
  .ssilo__all:focus-visible,
  .ssilo__close:focus-visible {
    outline: 2px solid #121212;
    outline-offset: -2px;
    border-radius: 12px;
  }

  .ssilo__brand-head:focus-visible {
    outline-color: #ffffff;
    outline-offset: -6px;
  }

  @media screen and (min-width: 750px) {
    .ssilo__brands {
      --ssilo-gap: 16px;
      --ssilo-ratio: 0.4375;
    }
  }

  /* Desktop: four brands a row */
  @media screen and (min-width: 990px) {
    .ssilo__brands {
      --ssilo-cols: 4;
      --per-row: 4;
      --ssilo-ratio: 0.72;
    }
  }

  @media screen and (min-width: 750px) {
    .ssilo__plus--brand {
      right: 16px;
      bottom: 16px;
      width: 42px;
      height: 42px;
    }

    .ssilo__brand-text {
      inset: auto 72px 16px 18px;
    }


    .ssilo__inner--brand {
      padding: 4px 16px 12px;
    }

    /* Desktop: larger text in the panels */
    /* Two silos a row, each column lined up on its own longest name */
    .ssilo__silos {
      --per-row: 2;
      grid-template-columns: repeat(2, minmax(0, max-content) max-content minmax(40px, 1fr));
      column-gap: 20px;
    }

    .ssilo__row {
      padding-block: 4px;
    }

    .ssilo__row-name {
      font-size: 3.75rem;
      line-height: 1;
      letter-spacing: -0.035em;
    }

    .ssilo__gen-name {
      font-size: 2.75rem;
      line-height: 1;
      letter-spacing: -0.03em;
    }

    .ssilo__row-sub {
      font-size: 1rem;
    }

    .ssilo__all,
    .ssilo__close {
      font-size: 1.125rem;
    }

    .ssilo__gen {
      padding-block: 2px;
    }

    .ssilo__thumb {
      width: 104px;
      height: 60px;
      border-radius: 10px;
    }

    .ssilo__gen-pic {
      width: 76px;
      height: 44px;
    }

    /* Three generations a row, each column lined up on its own longest name */
    .ssilo__gens {
      grid-template-columns: repeat(3, minmax(0, max-content) max-content minmax(24px, 1fr));
    }

    .ssilo__row .ssilo__plus {
      width: 32px;
      height: 32px;
    }

    .ssilo__row .ssilo__plus svg {
      width: 28px;
      height: 28px;
    }

    .ssilo__gens {
      column-gap: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ssilo__brand,
    .ssilo__brand-image,
    .ssilo__brand-text,
    .ssilo__brand-head::before,
    .ssilo__brand-head::after,
    .ssilo__plus svg,
    .ssilo__row {
      transition: none;
    }
  }
{% endstylesheet %}

