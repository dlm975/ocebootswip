{%- liquid
  assign photos = section.blocks | where: 'type', 'photo'
  assign placeholder = false
  if photos.size == 0 and request.design_mode
    assign placeholder = true
  endif

  comment
    Scatter is driven by repeating factor lists rather than random values
    so the layout is identical on every render — a random tilt would
    reshuffle on each page load and look broken rather than casual.

    The tilt list cycles every 8 and the shape list every 5, so the two
    only line up again after 40 photos — a shared cycle length would make
    the second row an obvious copy of the first.
  endcomment
  assign tilt = '-0.9,0.6,-0.35,1,-0.7,0.45,-1,0.75' | split: ','
  assign drift = '-0.2,0.6,-0.5,0.25,-0.15,1,-0.7,0.35' | split: ','
  assign ratios = '4/5,1/1,3/4,5/4,1/1' | split: ','
-%}

{%- if photos.size > 0 or placeholder -%}
  <div
    class="ccg spacing-style"
    style="
      --ccg-cols-m: {{ section.settings.columns_mobile }};
      --ccg-cols-d: {{ section.settings.columns_desktop }};
      --ccg-overlap: {{ section.settings.overlap }}px;
      --ccg-row-overlap: {{ section.settings.row_overlap }}px;
      --ccg-spread: {{ section.settings.max_rotation }};
      --ccg-drift: {{ section.settings.max_drift }}px;
      --ccg-radius: {{ section.settings.corner_radius }}px;
      --ccg-frame: {{ section.settings.frame_width }}px;
      --ccg-title: {{ section.settings.title_color }};
      --ccg-plate: {{ section.settings.plate_color }};
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    <div class="ccg__stage">
      <div class="ccg__grid">
        {%- if placeholder -%}
          {%- for i in (1..8) -%}
            {%- assign n = forloop.index0 | modulo: 8 -%}
            {%- assign r = forloop.index0 | modulo: 5 -%}
            <div
              class="ccg__item"
              style="--rot: {{ tilt[n] }}; --dy: {{ drift[n] }}; --ratio: {{ ratios[r] }}; z-index: {{ forloop.index0 | modulo: 3 }};"
            >
              <div class="ccg__photo">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'ccg__svg' }}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for block in photos -%}
            {%- liquid
              assign n = forloop.index0 | modulo: 8
              assign r = forloop.index0 | modulo: 5
            -%}
            <div
              class="ccg__item"
              style="--rot: {{ tilt[n] }}; --dy: {{ drift[n] }}; --ratio: {{ ratios[r] }}; z-index: {{ forloop.index0 | modulo: 3 }};"
              {{ block.shopify_attributes }}
            >
              <div class="ccg__photo">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    srcset="{{ block.settings.image | image_url: width: 300 }} 300w, {{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w"
                    sizes="(max-width: 749px) 40vw, 22vw"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    decoding="async"
                    width="600"
                    height="750"
                  >
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'ccg__svg' }}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if section.settings.heading != blank or section.settings.subtext != blank -%}
        <div class="ccg__overlay">
          <div class="ccg__plate">
            {%- if section.settings.heading != blank -%}
              <h2 class="ccg__heading">
                <span>{{ section.settings.heading }}</span>

                {%- if section.settings.handle != blank or section.settings.show_verified -%}
                  <span class="ccg__tag">
                    {%- if section.settings.handle != blank -%}
                      <span class="ccg__handle">
                        {%- unless section.settings.handle contains '@' -%}@{%- endunless -%}
                        {{- section.settings.handle -}}
                      </span>
                    {%- endif -%}
                    {%- if section.settings.show_verified -%}
                      <svg class="ccg__badge" viewBox="0 0 24 24" width="18" height="18" aria-label="Verified" role="img">
                        <path fill="{{ section.settings.badge_color | default: '#3897f0' }}" d="M23.5 12c0-1.4-.8-2.6-1.9-3.3.3-1.3-.1-2.7-1.1-3.7s-2.4-1.4-3.7-1.1C16.1 2.8 14.9 2 13.5 2h-3c-1.4 0-2.6.8-3.3 1.9-1.3-.3-2.7.1-3.7 1.1S2.1 7.4 2.4 8.7C1.3 9.4.5 10.6.5 12s.8 2.6 1.9 3.3c-.3 1.3.1 2.7 1.1 3.7s2.4 1.4 3.7 1.1c.7 1.1 1.9 1.9 3.3 1.9h3c1.4 0 2.6-.8 3.3-1.9 1.3.3 2.7-.1 3.7-1.1s1.4-2.4 1.1-3.7c1.1-.7 1.9-1.9 1.9-3.3z"/>
                        <path fill="#fff" d="M10.6 16.2l-3.3-3.3 1.5-1.5 1.8 1.8 4.6-4.6 1.5 1.5z"/>
                      </svg>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </h2>
            {%- endif -%}

            {%- if section.settings.subtext != blank -%}
              <p class="ccg__sub">{{ section.settings.subtext }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .ccg {
    width: 100%;
  }

  .ccg__stage {
    position: relative;
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
  }

  /* Flex with negative margins rather than a grid: the overlap is what
     makes it read as a pile of photos instead of a tidy gallery. */
  .ccg__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    padding-block: calc(var(--ccg-drift) + 4px);
  }

  /* Spacing is pure negative margin — no padding. Padding was only ever
     creating the gap, and it also shrank each photo inside its slot, so
     removing it lets the photos fill the width they are given. Rows and
     columns tuck independently, because row pitch is what drives the
     section's height. */
  .ccg__item {
    position: relative;
    width: calc(100% / var(--ccg-cols-m));
    margin-inline: calc(var(--ccg-overlap) * -1);
    margin-block: calc(var(--ccg-row-overlap) * -1);
    transform: rotate(calc(var(--ccg-spread) * var(--rot) * 1deg))
      translateY(calc(var(--ccg-drift) * var(--dy)));
    transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  }

  /* Straighten and lift on hover — the pile tidies itself as you point at it */
  .ccg__item:hover {
    transform: rotate(0deg) translateY(calc(var(--ccg-drift) * var(--dy) - 6px)) scale(1.04);
    z-index: 5 !important;
  }

  .ccg__photo {
    aspect-ratio: var(--ratio, 4 / 5);
    overflow: hidden;
    border-radius: var(--ccg-radius, 6px);
    border: var(--ccg-frame, 6px) solid #fff;
    background: rgba(0, 0, 0, 0.05);
    box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.45), 0 2px 6px rgba(0, 0, 0, 0.12);
  }

  .ccg__photo img,
  .ccg__svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Overlaid title ── */
  .ccg__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 6;
    padding-inline: var(--page-margin, 16px);
  }

  .ccg__plate {
    text-align: center;
    padding: clamp(14px, 3vw, 26px) clamp(20px, 5vw, 44px);
    border-radius: 18px;
    background: var(--ccg-plate, rgba(255, 255, 255, 0.82));
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    backdrop-filter: blur(14px) saturate(160%);
    box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.4);
    max-width: min(100%, 640px);
  }

  .ccg__heading {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    color: var(--ccg-title, #111);
    font-size: clamp(1.25rem, 4vw, 2.4rem);
    font-weight: 800;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .ccg__tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .ccg__badge {
    display: block;
    flex-shrink: 0;
  }

  .ccg__sub {
    margin: 8px 0 0;
    color: var(--ccg-title, #111);
    opacity: 0.7;
    font-size: clamp(0.8rem, 1.8vw, 0.95rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media screen and (min-width: 750px) {
    .ccg__item {
      width: calc(100% / var(--ccg-cols-d));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ccg__item {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer Collage",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "WORN BY YOU"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle beside the title",
      "default": "@oceboots",
      "info": "Optional. The @ is added automatically."
    },
    {
      "type": "checkbox",
      "id": "show_verified",
      "label": "Show Instagram verified badge",
      "default": true
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge colour",
      "default": "#3897f0"
    },
    {
      "type": "header",
      "content": "Collage"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Photos across (mobile)",
      "min": 2, "max": 6, "step": 1, "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Photos across (desktop)",
      "min": 3, "max": 10, "step": 1, "default": 7
    },
    {
      "type": "range",
      "id": "overlap",
      "label": "Side overlap",
      "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16,
      "info": "How far photos tuck under the ones beside them."
    },
    {
      "type": "range",
      "id": "row_overlap",
      "label": "Row overlap",
      "min": 0, "max": 60, "step": 2, "unit": "px", "default": 18,
      "info": "How far rows tuck into each other. This is what controls the section's height."
    },
    {
      "type": "range",
      "id": "max_rotation",
      "label": "Tilt",
      "min": 0, "max": 12, "step": 1, "unit": "°", "default": 5
    },
    {
      "type": "range",
      "id": "max_drift",
      "label": "Vertical scatter",
      "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8,
      "info": "Adds to the section's height, so keep it low if space is tight."
    },
    {
      "type": "range",
      "id": "frame_width",
      "label": "White border",
      "min": 0, "max": 14, "step": 1, "unit": "px", "default": 4
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0, "max": 20, "step": 1, "unit": "px", "default": 4
    },
    {
      "type": "header",
      "content": "Title plate"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Text colour",
      "default": "#111111"
    },
    {
      "type": "color_background",
      "id": "plate_color",
      "label": "Plate background",
      "default": "rgba(255, 255, 255, 0.82)",
      "info": "Sits over the photos, so keep some transparency."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [
    {
      "name": "Customer Collage",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
