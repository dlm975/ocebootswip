{%- comment -%}
  "Who we've worked with": the Pros and Worn by sections in one. A big heading on the left and the
  leagues' logos floating in a close jumble on the right; tapping one pulls it forward onto a card
  with the player (or players) from that league we sold boots to: their photo, club, country and
  the boots. A ring travels from logo to logo, and a "Tap a league" hint shows, until the first tap.
  Each league is a block (its logo, and up to three players picked from the shared pro roster in
  Theme settings > Pro players). A league with no player connected yet floats but can't be opened.
  Animations: Motion (assets/motion.js).
{%- endcomment -%}

{%- liquid
  assign positions = '30,20|72,17|47,44|15,75|84,63|52,86|84,90|14,40|88,36|20,92' | split: '|'
  assign sizes = '1.1,0.92,1.2,0.95,1.05,0.9,0.85,0.8,0.85,0.8' | split: ','
  assign count = 0
  assign openable = 0
-%}

{%- capture logos -%}
  {%- for block in section.blocks -%}
    {%- liquid
      if block.settings.logo == blank or count >= 10
        continue
      endif
      assign connected = ''
      for n in (1..3)
        assign pick_key = 'player_' | append: n
        assign slot = block.settings[pick_key]
        if slot == blank or slot == 'none'
          continue
        endif
        assign k = 'ppw_player_' | append: slot
        assign k_name = k | append: '_name'
        assign k_image = k | append: '_image'
        if settings[k_name] != blank and settings[k_image] != blank
          assign connected = connected | append: slot | append: ','
        endif
      endfor
      assign at = positions[count] | split: ','
      assign drift = count | times: 7 | modulo: 5 | plus: 7
      assign delay = count | times: 1.7 | modulo: 6
      assign size = sizes[count]
      assign count = count | plus: 1
      assign league = block.settings.name | default: 'League'
    -%}
    {%- if connected != blank -%}
      {%- assign openable = openable | plus: 1 -%}
      <button
        type="button"
        class="wbp__logo"
        style="--x: {{ at[0] }}%; --y: {{ at[1] }}%; --s: {{ size }}; --drift: {{ drift }}s; --delay: -{{ delay }}s;"
        data-wbp-logo="{{ block.id }}"
        aria-expanded="false"
        aria-label="{{ league | escape }}: see the players"
        {{ block.shopify_attributes }}
      >
    {%- else -%}
      <span
        class="wbp__logo wbp__logo--idle"
        style="--x: {{ at[0] }}%; --y: {{ at[1] }}%; --s: {{ size }}; --drift: {{ drift }}s; --delay: -{{ delay }}s;"
        {{ block.shopify_attributes }}
      >
    {%- endif -%}
      <span class="wbp__float">
        <span class="wbp__ring" aria-hidden="true"></span>
        {{ block.settings.logo | image_url: width: 320 | image_tag: class: 'wbp__crest', loading: 'lazy', alt: league, width: 160, height: 160 }}
      </span>
    {%- if connected != blank -%}</button>{%- else -%}</span>{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if count > 0 or request.design_mode -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="section section--page-width color-{{ section.settings.color_scheme }} wbp{% if section.settings.heading contains '|' %} wbp--compact{% endif %} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="wbp__box">
      <div class="wbp__layout" data-wbp-layout>
        <div class="wbp__text">
          <h2 class="wbp__heading">
            {%- comment -%} One word a line; or, with "|" in the heading, those lines (a compact section) {%- endcomment -%}
            {%- if section.settings.heading contains '|' -%}
              {%- assign words = section.settings.heading | split: '|' -%}
            {%- else -%}
              {%- assign words = section.settings.heading | split: ' ' -%}
            {%- endif -%}
            {%- for word in words -%}
              <span>{{ word | strip | escape }}</span>{% unless forloop.last %} {% endunless %}
            {%- endfor -%}
          </h2>
          {%- if section.settings.hint != blank and openable > 0 -%}
            <p class="wbp__hint" data-wbp-hint>
              {%- render 'gicon', name: 'touch_app', class: 'wbp__hint-icon', size: 20 -%}
              <span>{{ section.settings.hint | escape }}</span>
            </p>
          {%- endif -%}
        </div>

        {%- if count > 0 -%}
          <div class="wbp__stage" data-wbp-stage>
            {{ logos }}
          </div>

          {%- if openable > 0 -%}
            <div class="wbp__card" data-wbp-card hidden>
              <button type="button" class="wbp__close" data-wbp-close aria-label="Close">
                {%- render 'gicon', name: 'close', size: 20 -%}
              </button>
              {%- for block in section.blocks -%}
                {%- liquid
                  assign connected = ''
                  for n in (1..3)
                    assign pick_key = 'player_' | append: n
                    assign slot = block.settings[pick_key]
                    if slot == blank or slot == 'none'
                      continue
                    endif
                    assign k = 'ppw_player_' | append: slot
                    assign k_name = k | append: '_name'
                    assign k_image = k | append: '_image'
                    if settings[k_name] != blank and settings[k_image] != blank
                      assign connected = connected | append: slot | append: ','
                    endif
                  endfor
                  if block.settings.logo == blank or connected == blank
                    continue
                  endif
                  assign slots = connected | split: ','
                -%}
                <div class="wbp__group" data-wbp-group="{{ block.id }}" hidden>
                  {%- for slot in slots -%}
                    {%- liquid
                      assign k = 'ppw_player_' | append: slot
                      assign k_name = k | append: '_name'
                      assign k_image = k | append: '_image'
                      assign k_badge = k | append: '_badge'
                      assign k_club = k | append: '_club'
                      assign k_flag = k | append: '_flag'
                      assign k_boot = k | append: '_boot'
                      assign k_link = k | append: '_link'
                    -%}
                    <div class="wbp__player" data-wbp-player{% unless forloop.first %} hidden{% endunless %}>
                      <div class="wbp__photo">
                        {{
                          settings[k_image]
                          | image_url: width: 800
                          | image_tag:
                            widths: '300, 450, 600, 800',
                            sizes: '(min-width: 990px) 300px, 40vw',
                            loading: 'lazy',
                            class: 'wbp__photo-image',
                            alt: settings[k_name]
                        }}
                      </div>
                      <div class="wbp__info">
                        {%- comment -%} The league logo lands in the slot; on phones the flag and club badge sit beside it {%- endcomment -%}
                        <div class="wbp__marks">
                          <span class="wbp__slot" data-wbp-slot aria-hidden="true"></span>
                          {%- if settings[k_flag] != blank -%}
                            {{ settings[k_flag] | image_url: width: 96 | image_tag: class: 'wbp__flag wbp__mark', loading: 'lazy', alt: '' }}
                          {%- endif -%}
                          {%- if settings[k_badge] != blank -%}
                            {{ settings[k_badge] | image_url: width: 96 | image_tag: class: 'wbp__badge wbp__mark', loading: 'lazy', alt: settings[k_club] }}
                          {%- endif -%}
                        </div>
                        <p class="wbp__club">
                          {%- if settings[k_flag] != blank -%}
                            {{ settings[k_flag] | image_url: width: 64 | image_tag: class: 'wbp__flag', loading: 'lazy', alt: '' }}
                          {%- endif -%}
                          {%- if settings[k_badge] != blank -%}
                            {{ settings[k_badge] | image_url: width: 64 | image_tag: class: 'wbp__badge', loading: 'lazy', alt: '' }}
                          {%- endif -%}
                          <span>{{ settings[k_club] | escape }}</span>
                        </p>
                        <h3 class="wbp__name">{{ settings[k_name] | escape }}</h3>
                        {%- if settings[k_boot] != blank -%}
                          <p class="wbp__boot">
                            <span class="wbp__boot-label">Wore</span>
                            <span class="wbp__boot-name">{{ settings[k_boot] | escape }}</span>
                          </p>
                        {%- endif -%}
                        {%- if settings[k_link] != blank -%}
                          <a class="wbp__shop" href="{{ settings[k_link] }}">
                            <span>Shop the boots</span>
                            <span class="wbp__disk oce-disk" aria-hidden="true">
                              {%- render 'gicon', name: 'arrow_forward', size: 18 -%}
                            </span>
                          </a>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endfor -%}
                  {%- if slots.size > 1 -%}
                    <div class="wbp__picks" role="group" aria-label="Players">
                      {%- for slot in slots -%}
                        {%- assign k_name = 'ppw_player_' | append: slot | append: '_name' -%}
                        <button type="button" class="wbp__pick" data-wbp-pick="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                          {{- settings[k_name] | escape -}}
                        </button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <p class="wbp__empty">
            Add leagues as blocks: a logo each, and the players from that league (from Theme settings &gt; Pro players). Only shown in the editor.
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

<script type="module">
  import { animate } from 'motion';

  const root = document.getElementById('shopify-section-{{ section.id }}');

  // Compact heading: the last line (e.g. "Pros.") sized up to the width of the widest line above it
  const heading = root?.querySelector('.wbp--compact .wbp__heading');
  if (heading && heading.children.length > 1) {
    const lines = [...heading.children];
    const last = lines[lines.length - 1];
    const fit = () => {
      last.style.removeProperty('font-size');
      const widest = Math.max(...lines.slice(0, -1).map((line) => line.getBoundingClientRect().width));
      // Two passes: text doesn't grow exactly in proportion to its size, so the second corrects the first
      for (let pass = 0; pass < 2; pass++) {
        const own = last.getBoundingClientRect().width;
        if (!(own > 0 && widest > 0)) return;
        last.style.fontSize = (parseFloat(getComputedStyle(last).fontSize) * widest) / own + 'px';
      }
    };
    fit();
    document.fonts?.ready.then(fit);
    let queued = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(queued);
      queued = requestAnimationFrame(fit);
    });
  }
  const stage = root?.querySelector('[data-wbp-stage]');
  const layout = root?.querySelector('[data-wbp-layout]');
  if (stage && layout) {
    const logos = [...stage.querySelectorAll('[data-wbp-logo]')];
    const groupOf = (logo) => layout.querySelector(`[data-wbp-group="${logo.dataset.wbpLogo}"]`);
    const activePlayer = (group) => group.querySelector('[data-wbp-player]:not([hidden])');
    const card = layout.querySelector('[data-wbp-card]');
    const hint = root.querySelector('[data-wbp-hint]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const EASE = [0.3, 0.7, 0.3, 1];
    const IN = 0.55;
    const OUT = 0.22;
    let current = -1;
    let closing = 0;

    // Stop this script's animations on an element (not its CSS transitions and drifts)
    const finish = (el) =>
      el.getAnimations().forEach((a) => {
        if (!(a instanceof CSSTransition) && !(a instanceof CSSAnimation)) a.cancel();
      });

    /** The logo's transform right now (mid-flight included), then cleared to measure from home */
    const takeTransform = (el) => {
      const now = getComputedStyle(el).transform;
      finish(el);
      return now === 'none' ? 'translate(0px, 0px) scale(1)' : now;
    };

    /** The badge drifts on its own; stop the drift where it is and ease that offset away */
    const settle = (logo) => {
      const float = logo.querySelector('.wbp__float');
      const now = getComputedStyle(float).transform;
      logo.classList.add('is-still');
      if (now !== 'none' && !reduce.matches) {
        animate(float, { transform: [now, 'none'] }, { duration: IN, ease: EASE });
      }
    };

    const flyHome = (logo) => {
      const from = takeTransform(logo);
      logo.style.transform = '';
      logo.classList.remove('is-picked', 'is-still');
      logo.setAttribute('aria-expanded', 'false');
      if (!reduce.matches) animate(logo, { transform: [from, 'translate(0px, 0px) scale(1)'] }, { duration: IN, ease: EASE });
    };

    /** The transform that puts the logo on a player's card, measured from its place in the field */
    const spotFor = (logo, player) => {
      logo.style.transform = '';
      const home = logo.getBoundingClientRect();
      const slot = player.querySelector('[data-wbp-slot]').getBoundingClientRect();
      const scale = slot.width / home.width;
      const dx = slot.left + slot.width / 2 - (home.left + home.width / 2);
      const dy = slot.top + slot.height / 2 - (home.top + home.height / 2);
      return `translate(${dx}px, ${dy}px) scale(${scale})`;
    };

    /** A league with more than one player: switch between them; the logo glides to its new spot */
    const pick = (button) => {
      const group = button.closest('[data-wbp-group]');
      const players = [...group.querySelectorAll('[data-wbp-player]')];
      const next = players[Number(button.dataset.wbpPick)];
      if (!next.hidden) return;
      group.querySelectorAll('[data-wbp-pick]').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      const logo = logos[current];
      const from = takeTransform(logo);
      players.forEach((p) => (p.hidden = p !== next));
      const to = spotFor(logo, next);
      logo.style.transform = to;
      if (reduce.matches) return;
      animate(logo, { transform: [from, to] }, { duration: IN, ease: EASE });
      finish(next);
      animate(next, { opacity: [0, 1] }, { duration: 0.3, ease: 'easeOut' });
    };

    const open = (i) => {
      const logo = logos[i];
      const previous = current >= 0 ? logos[current] : null;
      current = i;
      clearTimeout(closing);
      stopHint();

      // Show this league's card (at its resting place, so the logo's spot can be measured)
      const group = groupOf(logo);
      finish(card);
      card.hidden = false;
      layout.querySelectorAll('[data-wbp-group]').forEach((g) => (g.hidden = g !== group));
      layout.classList.add('is-open');
      if (previous && previous !== logo) flyHome(previous);

      // Measure and start in the same frame: from where the logo is, to its spot on the card
      const from = takeTransform(logo);
      const to = spotFor(logo, activePlayer(group));
      logo.style.transform = to;
      logo.classList.add('is-picked');
      logo.setAttribute('aria-expanded', 'true');
      settle(logo);

      if (reduce.matches) return;
      animate(logo, { transform: [from, to] }, { duration: IN, ease: EASE });
      animate(card, { opacity: [0, 1], transform: ['translateY(14px) scale(0.97)', 'none'] }, { duration: IN, ease: EASE });
    };

    const close = () => {
      if (current < 0) return;
      const logo = logos[current];
      current = -1;
      layout.classList.remove('is-open');
      flyHome(logo);
      finish(card);
      if (reduce.matches) {
        card.hidden = true;
        return;
      }
      animate(card, { opacity: [1, 0], transform: ['none', 'translateY(8px) scale(0.98)'] }, { duration: OUT, ease: 'easeOut' });
      closing = setTimeout(() => {
        if (current < 0) {
          finish(card);
          card.hidden = true;
        }
      }, OUT * 1000);
    };

    layout.addEventListener('click', (event) => {
      const chip = event.target.closest('[data-wbp-pick]');
      if (chip) {
        pick(chip);
        return;
      }
      const logo = event.target.closest('[data-wbp-logo]');
      if (logo) {
        const i = logos.indexOf(logo);
        i === current ? close() : open(i);
        return;
      }
      if (event.target.closest('[data-wbp-close]') || !event.target.closest('[data-wbp-card]')) close();
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && current >= 0) {
        const logo = logos[current];
        close();
        logo.focus();
      }
    });

    // The prompt: a ring passes from badge to badge while the section is on screen, until the
    // first tap
    let hintIndex = -1;
    let hintTimer = 0;
    let hinting = true;
    const step = () => {
      logos[hintIndex]?.classList.remove('is-hinting');
      hintIndex = (hintIndex + 1) % logos.length;
      logos[hintIndex].classList.add('is-hinting');
    };
    const startHint = () => {
      if (!hinting || hintTimer) return;
      step();
      hintTimer = setInterval(step, 2400);
    };
    const pauseHint = () => {
      clearInterval(hintTimer);
      hintTimer = 0;
    };
    function stopHint() {
      if (!hinting) return;
      hinting = false;
      pauseHint();
      logos[hintIndex]?.classList.remove('is-hinting');
      hint?.classList.add('is-done');
    }
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? startHint() : pauseHint()), { threshold: 0.35 }).observe(stage);
  }
</script>

{% stylesheet %}
  /* Free on the page: no container around it */
  .wbp__box {
    min-width: 0;
  }

  /* The big stacked heading in the left half; the badges in a close jumble in the right half;
     a player's card opens across both */
  .wbp__layout {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 8px;
  }

  .wbp__text {
    min-width: 0;
    transition: opacity 0.35s ease;
  }

  .wbp__layout.is-open .wbp__text {
    opacity: 0.14;
  }

  .wbp__heading {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-size: clamp(2.5rem, 11.5vw, 8.5rem);
    font-weight: 850;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .wbp__heading > span {
    display: block;
  }

  /* "Tap a club to meet the player", with a finger that taps */
  .wbp__hint {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 14px 0 0;
    color: rgb(18 18 18 / 0.6);
    font-size: 0.875rem;
    font-weight: 600;
    transition: opacity 0.25s ease;
  }

  .wbp__hint.is-done {
    opacity: 0;
  }

  .wbp__hint-icon {
    flex: none;
    animation: wbp-tap 2.4s cubic-bezier(0.3, 0.7, 0.3, 1) infinite;
  }

  @keyframes wbp-tap {
    0%, 40%, 100% {
      transform: none;
    }

    55% {
      transform: translateY(3px) scale(0.92);
    }

    70% {
      transform: none;
    }
  }

  /* The field the badges float in */
  /* Phones: the badges take the same height as the heading and prompt beside them */
  .wbp__stage {
    --wbp-logo: 58px;
    position: relative;
    align-self: stretch;
    min-height: 200px;
  }

  @media screen and (min-width: 750px) {
    .wbp__stage {
      --wbp-logo: 150px;
      align-self: center;
      height: 520px;
    }
  }

  .wbp__logo {
    position: absolute;
    --size: calc(var(--wbp-logo) * var(--s, 1));
    --cx: calc(50% + (var(--x) - 50%) * var(--tight, 1));
    --cy: calc(50% + (var(--y) - 50%) * var(--tight, 1));
    top: calc(var(--cy) - var(--size) / 2);
    left: calc(var(--cx) - var(--size) / 2);
    z-index: 1;
    width: var(--size);
    height: var(--size);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform-origin: 50% 50%;
    -webkit-tap-highlight-color: transparent;
    transition:
      opacity 0.35s ease,
      scale 0.55s cubic-bezier(0.3, 0.7, 0.3, 1),
      filter 0.35s ease;
  }

  /* Not the edge of the field: keep the badges whole inside it */
  @media screen and (max-width: 749px) {
    .wbp__logo {
      /* Phones: less size difference, so the bigger logos don't cover their neighbours */
      --size: calc(var(--wbp-logo) * min(var(--s, 1), 1.05));
      left: clamp(0px, calc(var(--cx) - var(--size) / 2), calc(100% - var(--size)));
    }
  }

  .wbp__float {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    animation: wbp-drift var(--drift, 9s) ease-in-out var(--delay, 0s) infinite;
  }

  /* Picked: the drift stops (its offset eases away in the script), and starts again from rest */
  .wbp__logo.is-still .wbp__float {
    animation: none;
  }

  .wbp__logo:not(.is-still) .wbp__float {
    animation-delay: var(--delay, 0s);
  }

  @keyframes wbp-drift {
    0%, 100% {
      transform: none;
    }

    25% {
      transform: translate(6px, -9px) rotate(2.5deg);
    }

    50% {
      transform: translate(-4px, -14px) rotate(-1.5deg);
    }

    75% {
      transform: translate(-8px, -4px) rotate(-3deg);
    }
  }

  .wbp__crest {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 8px 14px rgb(18 18 18 / 0.18));
    transition: transform 0.25s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  @media (hover: hover) {
    .wbp__logo:hover .wbp__crest {
      transform: scale(1.06);
    }
  }

  .wbp__logo:active .wbp__crest {
    transform: scale(0.94);
  }

  .wbp__logo:focus-visible {
    outline: 2px solid #121212;
    outline-offset: 6px;
    border-radius: 50%;
  }

  /* The prompt's ring: a soft pulse out from the badge it is passing */
  .wbp__ring {
    position: absolute;
    inset: -10%;
    border-radius: 50%;
    border: 2px solid rgb(18 18 18 / 0.35);
    opacity: 0;
    pointer-events: none;
  }

  .wbp__logo.is-hinting .wbp__ring {
    animation: wbp-ring 1.6s cubic-bezier(0.3, 0.7, 0.3, 1) 2;
  }

  .wbp__logo.is-hinting .wbp__crest {
    animation: wbp-nudge 1.6s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  @keyframes wbp-ring {
    0% {
      opacity: 0.9;
      transform: scale(0.85);
    }

    100% {
      opacity: 0;
      transform: scale(1.35);
    }
  }

  @keyframes wbp-nudge {
    0%, 100% {
      transform: none;
    }

    20% {
      transform: scale(1.1);
    }

    40% {
      transform: scale(0.98);
    }
  }

  /* A badge picked: the others step back; it comes forward onto the card */
  .wbp__layout.is-open .wbp__logo:not(.is-picked) {
    opacity: 0.14;
    scale: 0.86;
    filter: grayscale(1);
  }

  .wbp__logo.is-picked {
    z-index: 3;
  }

  .wbp__logo.is-picked .wbp__crest {
    filter: drop-shadow(0 10px 18px rgb(18 18 18 / 0.25));
  }

  /* The player's card, in the middle of the field */
  .wbp__card {
    position: absolute;
    inset: 50% 0 auto;
    z-index: 2;
    max-width: 820px;
    margin-inline: auto;
    translate: 0 -50%;
    border-radius: 20px;
    background: #ffffff;
    box-shadow: 0 0 0 1px rgb(18 18 18 / 0.06), 0 18px 48px rgb(18 18 18 / 0.18);
  }

  .wbp__card[hidden] {
    display: none;
  }

  .wbp__player {
    display: grid;
    grid-template-columns: 42% 1fr;
    gap: 14px;
    padding: 10px;
  }

  .wbp__player[hidden] {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .wbp__player {
      grid-template-columns: 300px 1fr;
      gap: 28px;
      padding: 14px;
    }
  }

  .wbp__photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 14px;
    background: #e7e7ea;
  }

  .wbp__photo-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wbp__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 6px;
    min-width: 0;
    padding-block: 4px;
    padding-inline-end: 30px;
  }

  /* Where the badge lands */
  .wbp__slot {
    display: block;
    width: 64px;
    height: 64px;
    margin-bottom: 4px;
  }

  @media screen and (min-width: 750px) {
    .wbp__slot {
      width: 132px;
      height: 132px;
      margin-bottom: 8px;
    }
  }

  .wbp__club {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    color: rgb(18 18 18 / 0.6);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .wbp__marks {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Desktop: the flag and badge stay with the club's name */
  .wbp__mark {
    display: none;
  }

  .wbp__club > span {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .wbp__badge {
    flex: none;
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  /* More than one player from the league: their names as pills under the card, to switch */
  .wbp__picks {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0 10px 12px;
  }

  @media screen and (min-width: 750px) {
    .wbp__picks {
      padding: 0 14px 16px;
    }
  }

  .wbp__pick {
    height: 32px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: #f1f1f1;
    color: #121212;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease;
  }

  .wbp__pick[aria-pressed='true'] {
    background: #121212;
    color: #ffffff;
  }

  .wbp__group[hidden] {
    display: none;
  }

  /* A league not connected to a player yet: it floats, but isn't a button */
  .wbp__logo--idle {
    cursor: default;
  }

  .wbp__flag {
    flex: none;
    width: 20px;
    height: 14px;
    border-radius: 3px;
    object-fit: cover;
    box-shadow: 0 0 0 1px rgb(18 18 18 / 0.08);
  }

  .wbp__name {
    margin: 0;
    font-size: clamp(1.375rem, 6vw, 2.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .wbp__boot {
    display: flex;
    flex-direction: column;
    margin: 4px 0 0;
    font-size: 0.9375rem;
    line-height: 1.25;
  }

  .wbp__boot-label {
    color: rgb(18 18 18 / 0.55);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .wbp__boot-name {
    font-weight: 750;
  }

  .wbp__shop {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    color: #121212;
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
  }

  .wbp__disk {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
  }

  .wbp__disk svg {
    position: relative;
  }

  .wbp__close {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #f1f1f1;
    color: #121212;
    cursor: pointer;
    transition: background-color 0.18s ease;
  }

  @media (hover: hover) {
    .wbp__close:hover {
      background: #e4e4e4;
    }
  }

  .wbp__empty {
    margin: 16px 0 0;
    padding: 28px 20px;
    border-radius: 16px;
    background: #f4f4f2;
    color: rgb(18 18 18 / 0.6);
    font-size: 0.875rem;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .wbp__float,
    .wbp__hint-icon,
    .wbp__logo.is-hinting .wbp__crest {
      animation: none;
    }

    .wbp__logo,
    .wbp__crest {
      transition: none;
    }
  }

  /*
    Phones: a 3:4 card. The photo on top; under it the league logo (landed from the field), the
    country flag and the club badge in a row, the name below, and the boots they wore under that.
  */
  @media screen and (max-width: 749px) {
    .wbp__card {
      max-width: 320px;
    }

    .wbp__player {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 8px;
    }

    .wbp__photo {
      aspect-ratio: 8 / 7;
      border-radius: 14px;
    }

    .wbp__photo-image {
      object-position: 50% 18%;
    }

    .wbp__info {
      gap: 6px;
      padding: 12px 6px 8px;
    }

    .wbp__slot {
      width: 46px;
      height: 46px;
      margin: 0;
    }

    .wbp__mark {
      display: block;
    }

    .wbp__marks .wbp__flag {
      width: 32px;
      height: 22px;
      border-radius: 4px;
    }

    .wbp__marks .wbp__badge {
      width: 34px;
      height: 34px;
    }

    .wbp__club {
      display: none;
    }

    .wbp__name {
      font-size: 1.75rem;
    }

    .wbp__boot {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 0.35em;
      margin: 0;
    }

    .wbp__boot-label {
      font-size: 0.875rem;
    }

    /* The close button over the photo's corner */
    .wbp__close {
      top: 16px;
      right: 16px;
      background: rgb(255 255 255 / 0.85);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }
  }

  /* Compact (a heading in chosen lines, e.g. "Trusted | By The Pros"): smaller text kept to its
     lines, and the logos and their field scaled down to match */
  .wbp--compact .wbp__heading {
    font-size: clamp(2rem, 9vw, 6.5rem);
  }

  .wbp--compact .wbp__heading {
    align-items: flex-start;
  }

  /* Each line its own width, so the last can be sized to match the widest (script below) */
  .wbp--compact .wbp__heading > span {
    width: max-content;
    white-space: nowrap;
  }

  /* The logos a little closer together */
  .wbp--compact .wbp__stage {
    --tight: 0.8;
  }

  @media screen and (max-width: 749px) {
    .wbp--compact .wbp__heading {
      font-size: 12vw;
    }

    .wbp--compact .wbp__stage {
      --wbp-logo: 44px;
      min-height: 140px;
    }

    /* Phones: every logo, drift included, stays within the height of the text beside it (the
       drift reaches up to 14px up, 8px left and 6px right of a logo's place) */
    .wbp--compact .wbp__logo {
      top: clamp(14px, calc(var(--cy) - var(--size) / 2), calc(100% - var(--size)));
      left: clamp(8px, calc(var(--cx) - var(--size) / 2), calc(100% - var(--size) - 6px));
    }
  }

  @media screen and (min-width: 750px) {
    .wbp--compact .wbp__stage {
      --wbp-logo: 104px;
      height: 340px;
    }
  }
{% endstylesheet %}

