{%- comment -%}
  Player collections as short looping videos: a row of tall cards, each a muted clip on loop (a
  photo stands in until a video is added), the player's name in bold beside a holographic
  disk arrow; the whole card opens their collection. Phones swipe through them; desktop shows them side by side.
  A clip plays while any part of its card is on screen, and not at all with reduced motion (the poster
  shows instead).
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} preels spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="preels__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <player-reels class="preels__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign link = block.settings.collection.url | default: '#'
        assign name = block.settings.name | default: block.settings.collection.title
      -%}
      <a
        class="preels__card"
        href="{{ link }}"
        {{ block.shopify_attributes }}
      >
        <span class="preels__media">
          {%- if block.settings.video != blank -%}
            {%- liquid
              # Light and smooth: HLS first (Safari streams it at the size it can manage), then one
              # MP4 no taller than 720p for everyone else, never the full-size original
              assign clip = block.settings.video
              assign hls = nil
              assign mp4 = nil
              assign mp4_height = 0
              assign smallest = nil
              for source in clip.sources
                if source.format == 'm3u8'
                  assign hls = source
                elsif source.format == 'mp4'
                  if smallest == nil or source.height < smallest.height
                    assign smallest = source
                  endif
                  if source.height <= 720 and source.height > mp4_height
                    assign mp4 = source
                    assign mp4_height = source.height
                  endif
                endif
              endfor
              if mp4 == nil
                assign mp4 = smallest
              endif
            -%}
            <video
              class="preels__video"
              muted
              loop
              playsinline
              preload="none"
              disablepictureinpicture
              disableremoteplayback
              aria-hidden="true"
              {% if clip.preview_image %}
                poster="{{ clip.preview_image | image_url: width: 720 }}"
              {% endif %}
            >
              {%- if hls -%}
                <source src="{{ hls.url }}" type="{{ hls.mime_type }}">
              {%- endif -%}
              {%- if mp4 -%}
                <source src="{{ mp4.url }}" type="{{ mp4.mime_type }}">
              {%- endif -%}
            </video>
          {%- elsif block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 720
              | image_tag:
                widths: '360, 540, 720',
                sizes: '(min-width: 990px) 20vw, (min-width: 750px) 30vw, 62vw',
                loading: 'lazy',
                class: 'preels__image',
                alt: ''
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'preels__image preels__placeholder' }}
          {%- endif -%}
        </span>
        <span class="preels__shade" aria-hidden="true"></span>
        <span class="preels__text">
          <span class="preels__name">{{ name | escape }}</span>
          <span class="preels__disk oce-disk" aria-hidden="true">
            {%- render 'gicon', name: 'arrow_forward', size: 20 -%}
          </span>
          <span class="visually-hidden">{{ block.settings.button_label | default: 'Shop collection' | escape }}</span>
        </span>
      </a>
    {%- endfor -%}
  </player-reels>
</div>

<script type="module">
  /*
    Keeping the clips smooth without slowing the page:
    - nothing downloads until a card is about to scroll into view (preload="none" until then);
    - a clip plays while any part of its card is on screen (peeking cards too), and pauses when it leaves or the tab hides;
    - with reduced motion, Data Saver or a slow connection, the poster stays and nothing plays.
  */
  class PlayerReels extends HTMLElement {
    connectedCallback() {
      this.videos = [...this.querySelectorAll('video')];
      if (!this.videos.length) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const connection = navigator.connection;
      const lean = () =>
        reduce.matches || !!(connection && (connection.saveData || /(^|-)2g|3g/.test(connection.effectiveType || '')));
      this.visible = new Set();

      const sync = (video) => {
        const on = this.visible.has(video) && !document.hidden && !lean();
        if (on && video.paused) video.play().catch(() => {});
        else if (!on && !video.paused) video.pause();
      };

      // Fetch a clip shortly before it's seen
      this.near = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting || lean()) return;
            const video = entry.target;
            if (video.preload !== 'auto') video.preload = 'auto';
            this.near.unobserve(video);
          }),
        { rootMargin: '300px 300px' }
      );

      // Play while any part of the card is on screen, including cards peeking in at the sides
      this.seen = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) this.visible.add(entry.target);
            else this.visible.delete(entry.target);
            sync(entry.target);
          }),
        { threshold: 0 }
      );

      this.videos.forEach((video) => {
        video.muted = true;
        this.near.observe(video);
        this.seen.observe(video);
      });

      this.onVisibility = () => this.videos.forEach(sync);
      document.addEventListener('visibilitychange', this.onVisibility);
    }

    disconnectedCallback() {
      this.near?.disconnect();
      this.seen?.disconnect();
      if (this.onVisibility) document.removeEventListener('visibilitychange', this.onVisibility);
    }
  }

  if (!customElements.get('player-reels')) customElements.define('player-reels', PlayerReels);
</script>

{% stylesheet %}
  .preels__heading {
    margin: 0 0 clamp(14px, 2vw, 22px);
    font-size: clamp(1.75rem, 6.5vw, 2.5rem);
    font-weight: 750;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  /* Phones: swipe through, about one and a half cards in view */
  .preels__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 62%;
    gap: 10px;
    margin-inline: calc(-1 * var(--page-margin, 16px));
    padding-inline: var(--page-margin, 16px);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-margin, 16px);
    scrollbar-width: none;
  }

  .preels__track::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .preels__track {
      grid-auto-columns: calc((100% - 2 * 14px) / 3);
      gap: 14px;
    }
  }

  @media screen and (min-width: 990px) {
    .preels__track {
      grid-auto-columns: calc((100% - 4 * 14px) / 5);
    }
  }

  .preels__card {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 20px;
    background: #121212;
    color: #ffffff;
    text-decoration: none;
    scroll-snap-align: start;
    isolation: isolate;
    -webkit-tap-highlight-color: transparent;
  }

  .preels__media,
  .preels__video,
  .preels__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .preels__video,
  .preels__image {
    object-fit: cover;
  }

  .preels__image {
    transition: transform 0.55s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  /* Its own layer, so a playing clip doesn't repaint the card around it */
  .preels__video {
    transform: translateZ(0);
    background: #121212;
  }

  .preels__placeholder {
    background: #2a2a2a;
    fill: rgb(255 255 255 / 0.25);
  }

  /* Darker towards the foot, so the name reads over any clip */
  .preels__shade {
    position: absolute;
    inset: 40% 0 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0) 0%, rgb(0 0 0 / 0.45) 55%, rgb(0 0 0 / 0.75) 100%);
    pointer-events: none;
  }

  /* The player's name in bold, with the holographic disk beside it */
  .preels__text {
    position: absolute;
    inset: auto 14px 16px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
  }

  .preels__name {
    min-width: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 7vw, 2.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  @media screen and (min-width: 990px) {
    .preels__name {
      font-size: clamp(1.625rem, 2.2vw, 2.375rem);
    }
  }

  .preels__disk {
    display: grid;
    flex: none;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    transition: transform 0.25s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  .preels__disk svg {
    position: relative;
    width: 55%;
    height: 55%;
    transition: transform 0.25s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  .preels__card .preels__disk::after {
    animation: none;
  }

  @media (hover: hover) {
    .preels__card:hover .preels__image {
      transform: scale(1.04);
    }

    .preels__card:hover .preels__disk {
      transform: translateY(-1px);
    }

    .preels__card:hover .preels__disk svg {
      transform: translateX(2px);
    }

    .preels__card:hover .preels__disk::after {
      animation: preels-glint 0.8s cubic-bezier(0.45, 0, 0.25, 1) 0.1s 1 both;
    }
  }

  .preels__card:active .preels__disk {
    transform: scale(0.94);
  }

  .preels__card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @keyframes preels-glint {
    from {
      transform: translateX(-110%);
    }
    to {
      transform: translateX(110%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preels__video,
    .preels__image,
    .preels__disk,
    .preels__disk svg {
      transition: none;
    }

    .preels__card:hover .preels__disk::after {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Player reels",
  "tag": "section",
  "class": "section-player-reels",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Player collections"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "player",
      "name": "Player",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Player name",
          "info": "Leave empty to use the collection's name."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "A short clip, played muted on loop. Portrait (9:16) works best."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Shown until a video is added."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Link text for screen readers",
          "default": "Shop collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Player reels",
      "blocks": [{ "type": "player" }, { "type": "player" }, { "type": "player" }]
    }
  ]
}
{% endschema %}
