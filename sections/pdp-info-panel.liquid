{%- liquid
  assign p = product
  if p == blank
    assign p = closest.product
  endif
  if p == blank and request.visual_preview_mode
    assign p = collections.all.products.first
  endif

  assign desc = p.description
  assign show_desc = false
  if section.settings.show_description and desc != blank
    assign show_desc = true
  endif

  assign has_faq = false
  for i in (1..8)
    assign q_key = 'q' | append: i
    assign a_key = 'a' | append: i
    if section.settings[q_key] != blank and section.settings[a_key] != blank
      assign has_faq = true
      break
    endif
  endfor
-%}

{%- if show_desc or has_faq -%}
  <div
    class="pip"
    id="pip-{{ section.id }}"
    data-attach-details="{{ section.settings.attach_to_details }}"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="pip__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="pip__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="pip__list">
        {%- if show_desc -%}
          <details class="pip__item"{% if section.settings.open_description %} open{% endif %}>
            <summary class="pip__q">
              <span>{{ section.settings.description_heading | default: 'Details' }}</span>
              <svg class="pip__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" width="15" height="15" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <div class="pip__a pip__a--rte rte">{{ desc }}</div>
          </details>
        {%- endif -%}

        {%- for i in (1..8) -%}
          {%- assign q_key = 'q' | append: i -%}
          {%- assign a_key = 'a' | append: i -%}
          {%- assign q_text = section.settings[q_key] -%}
          {%- assign a_text = section.settings[a_key] -%}
          {%- if q_text != blank and a_text != blank -%}
            <details class="pip__item">
              <summary class="pip__q">
                <span>{{ q_text }}</span>
                <svg class="pip__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" width="15" height="15" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </summary>
              <div class="pip__a">{{ a_text }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .pip {
    width: 100%;
  }

  .pip__inner {
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
  }

  .pip__title {
    font-size: clamp(1.1rem, 2.4vw, 1.5rem);
    font-weight: 800;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0 0 10px;
  }

  .pip__item {
    border-top: 1px solid var(--color-border, rgba(0, 0, 0, 0.1));
  }

  .pip__item:last-child {
    border-bottom: 1px solid var(--color-border, rgba(0, 0, 0, 0.1));
  }

  .pip__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 15px 0;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    list-style: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .pip__q::-webkit-details-marker {
    display: none;
  }

  .pip__chev {
    flex-shrink: 0;
    transition: transform 0.24s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .pip__item[open] .pip__chev {
    transform: rotate(180deg);
  }

  .pip__a {
    padding-bottom: 16px;
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.7;
    max-width: 62ch;
  }

  .pip__a--rte :first-child {
    margin-top: 0;
  }

  .pip__a--rte :last-child {
    margin-bottom: 0;
  }

  /* ── Inside the product details column ──
     Moved there at runtime on desktop. The column carries
     .sticky-content--desktop, which pins it while the page scrolls — with
     this much content added it would pin and then clip, so release it. */
  .product-details:has(.pip) {
    position: static;
  }

  .product-details .pip__inner {
    padding-inline: 0;
    max-width: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .pip__chev {
      transition: none;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.getElementById('pip-{{ section.id }}');
    if (!root) return;
    if (root.dataset.attachDetails !== 'true') return;

    /* Desktop only: on mobile the columns stack, so leaving it where the
       template puts it already reads in the right order. */
    var homeMarker = null;

    function sectionEl() {
      return root.closest('.shopify-section') || root;
    }

    function sync() {
      var column = document.querySelector('.product-details');
      if (!column) return;

      var el = sectionEl();

      if (window.matchMedia('(min-width: 750px)').matches) {
        if (el.parentElement === column) return;
        if (!homeMarker) {
          homeMarker = document.createComment('pdp-info-panel-home');
          el.parentElement.insertBefore(homeMarker, el);
        }
        column.appendChild(el);
      } else {
        if (!homeMarker || el.parentElement === homeMarker.parentElement) return;
        homeMarker.parentElement.insertBefore(el, homeMarker);
      }
    }

    sync();

    var timer;
    window.addEventListener('resize', function () {
      clearTimeout(timer);
      timer = setTimeout(sync, 200);
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Product Details & FAQ",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "attach_to_details",
      "label": "Sit in the buy button column (desktop)",
      "default": true,
      "info": "Desktop only — moves this section into the product details column on the right. On mobile it stays where the section sits in the template."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show the product description",
      "default": true
    },
    {
      "type": "text",
      "id": "description_heading",
      "label": "Description row label",
      "default": "Details"
    },
    {
      "type": "checkbox",
      "id": "open_description",
      "label": "Open the description by default",
      "default": false
    },
    {
      "type": "header",
      "content": "FAQ"
    },
    { "type": "text", "id": "q1", "label": "Question 1" },
    { "type": "textarea", "id": "a1", "label": "Answer 1" },
    { "type": "text", "id": "q2", "label": "Question 2" },
    { "type": "textarea", "id": "a2", "label": "Answer 2" },
    { "type": "text", "id": "q3", "label": "Question 3" },
    { "type": "textarea", "id": "a3", "label": "Answer 3" },
    { "type": "text", "id": "q4", "label": "Question 4" },
    { "type": "textarea", "id": "a4", "label": "Answer 4" },
    { "type": "text", "id": "q5", "label": "Question 5" },
    { "type": "textarea", "id": "a5", "label": "Answer 5" },
    { "type": "text", "id": "q6", "label": "Question 6" },
    { "type": "textarea", "id": "a6", "label": "Answer 6" },
    { "type": "text", "id": "q7", "label": "Question 7" },
    { "type": "textarea", "id": "a7", "label": "Answer 7" },
    { "type": "text", "id": "q8", "label": "Question 8" },
    { "type": "textarea", "id": "a8", "label": "Answer 8" },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32
    }
  ],
  "presets": [
    {
      "name": "Product Details & FAQ"
    }
  ]
}
{% endschema %}
