{%- liquid
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign title = section.settings.title | default: 'RE-STOCKED'
  assign placeholder = false
  if product_blocks.size == 0 and request.design_mode
    assign placeholder = true
  endif

  assign n = product_blocks.size
  if placeholder
    assign n = 1
  endif

  # Column counts scale with how many products are shown
  if n <= 1
    assign cols_d = 1
    assign cols_m = 1
  elsif n == 2
    assign cols_d = 2
    assign cols_m = 2
  elsif n == 3
    assign cols_d = 3
    assign cols_m = 2
  else
    assign cols_d = 4
    assign cols_m = 2
  endif
-%}

{%- if product_blocks.size > 0 or placeholder -%}
<div class="rss" id="rss-{{ section.id }}">

  {%- comment -%} ── Floating side trigger ── {%- endcomment -%}
  <button
    type="button"
    class="rss-trigger"
    id="rss-open-{{ section.id }}"
    aria-haspopup="dialog"
    aria-label="{{ title | escape }} — view restocked products"
  >
    <span class="rss-trigger__title">{{ title }}</span>
    <span class="rss-trigger__stack" aria-hidden="true">
      {%- if placeholder -%}
        {%- for i in (1..3) -%}
          <span class="rss-thumb rss-thumb--empty">{{ 'product-1' | placeholder_svg_tag: 'rss-thumb-svg' }}</span>
        {%- endfor -%}
      {%- else -%}
        {%- for block in product_blocks limit: 4 -%}
          {%- assign p = block.settings.product -%}
          {%- assign timg = block.settings.image | default: p.featured_image -%}
          {%- if timg != blank -%}
            <img
              class="rss-thumb"
              src="{{ timg | image_url: width: 120 }}"
              alt=""
              loading="lazy"
              decoding="async"
              width="120"
              height="120"
            >
          {%- else -%}
            <span class="rss-thumb rss-thumb--empty">{{ 'product-1' | placeholder_svg_tag: 'rss-thumb-svg' }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if product_blocks.size > 4 -%}
          <span class="rss-more">+{{ product_blocks.size | minus: 4 }}</span>
        {%- endif -%}
      {%- endif -%}
    </span>
  </button>

  {%- comment -%} ── Overlay ── {%- endcomment -%}
  <div
    class="rss-overlay"
    id="rss-overlay-{{ section.id }}"
    role="dialog"
    aria-modal="true"
    aria-label="{{ title | escape }}"
    aria-hidden="true"
  >
    <div class="rss-backdrop" id="rss-backdrop-{{ section.id }}"></div>

    <button type="button" class="rss-close" id="rss-close-{{ section.id }}" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" width="18" height="18" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <div class="rss-overlay__inner">
      <h2 class="rss-overlay__title">{{ title }}</h2>

      <div class="rss-grid-wrap">
        <div
          class="rss-grid"
          style="--rss-cols: {{ cols_d }}; --rss-cols-m: {{ cols_m }};"
        >
          {%- if placeholder -%}
            <div class="rss-card">
              <div class="rss-card__link">
                <div class="rss-card__media">
                  {{ 'product-1' | placeholder_svg_tag: 'rss-card__svg' }}
                  <span class="rss-badge">Condition</span>
                </div>
                <p class="rss-card__name">Product Name</p>
              </div>
              <div class="rss-sizes">
                <span class="rss-sizes__label">Sizes:</span>
                <div class="rss-sizes__grid">
                  <span class="rss-size-pill">US 10 - UK 9 - EU 44</span>
                  <span class="rss-size-pill">US 10.5 - UK 10 - EU 45</span>
                  <span class="rss-size-pill">US 11 - UK 10.5 - EU 46</span>
                  <span class="rss-size-pill">US 11.5 - UK 11 - EU 46.5</span>
                </div>
              </div>
            </div>
          {%- else -%}
            {%- for block in product_blocks -%}
              {%- liquid
                assign p = block.settings.product
                if p == blank
                  continue
                endif

                assign cimg = block.settings.image | default: p.featured_image
                assign condition = block.settings.condition | default: section.settings.condition_default

                # Detect which option is the size option
                assign size_opt = 1
                for opt in p.options
                  assign opt_lower = opt | downcase
                  if opt_lower contains 'size'
                    assign size_opt = forloop.index
                    break
                  endif
                endfor

                # Collect unique, available sizes with their variant id (for deep-linking)
                assign seen = '|'
                assign size_list = ''
                for variant in p.variants
                  if variant.available
                    case size_opt
                      when 1
                        assign sv = variant.option1
                      when 2
                        assign sv = variant.option2
                      when 3
                        assign sv = variant.option3
                    endcase
                    assign key = '|' | append: sv | append: '|'
                    unless seen contains key
                      assign seen = seen | append: sv | append: '|'
                      assign size_list = size_list | append: sv | append: '@@' | append: variant.id | append: '~~'
                    endunless
                  endif
                endfor
                assign size_arr = size_list | split: '~~'
              -%}

              <div class="rss-card" {{ block.shopify_attributes }}>
                <a class="rss-card__link" href="{{ p.url }}">
                  <div class="rss-card__media">
                    {%- if cimg != blank -%}
                      <img
                        class="rss-card__img"
                        src="{{ cimg | image_url: width: 700 }}"
                        srcset="{{ cimg | image_url: width: 400 }} 400w, {{ cimg | image_url: width: 700 }} 700w"
                        sizes="(max-width: 749px) 44vw, 300px"
                        alt="{{ p.title | escape }}"
                        loading="lazy"
                        decoding="async"
                        width="700"
                        height="700"
                      >
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'rss-card__svg' }}
                    {%- endif -%}
                    {%- if condition != blank -%}
                      <span class="rss-badge">{{ condition }}</span>
                    {%- endif -%}
                  </div>
                  <p class="rss-card__name">{{ p.title }}</p>
                </a>

                {%- if size_arr.size > 0 -%}
                  <div class="rss-sizes">
                    <span class="rss-sizes__label">Sizes:</span>
                    <div class="rss-sizes__grid">
                      {%- for entry in size_arr -%}
                        {%- if entry != blank -%}
                          {%- assign parts = entry | split: '@@' -%}
                          <a class="rss-size-pill" href="{{ p.url }}?variant={{ parts[1] }}">{{ parts[0] }}</a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

</div>
{%- endif -%}

{% stylesheet %}
  .rss * { box-sizing: border-box; }

  /* ── Floating side trigger ── */
  .rss-trigger {
    position: fixed;
    top: 50%;
    right: 12px;
    transform: translateY(-50%);
    z-index: 9000;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    padding: 11px 12px 13px;
    background: rgba(10, 10, 10, 0.82);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    box-shadow: 0 10px 28px -8px rgba(0, 0, 0, 0.45);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.25s cubic-bezier(0.32, 0.72, 0, 1), box-shadow 0.2s ease;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .rss-trigger:hover {
    transform: translateY(-50%) scale(1.04);
    box-shadow: 0 14px 34px -8px rgba(0, 0, 0, 0.55);
  }

  .rss-trigger:active { transform: translateY(-50%) scale(0.96); }

  .rss-trigger__title {
    color: #fff;
    font-style: italic;
    font-weight: 800;
    font-size: 0.58rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .rss-trigger__stack {
    display: flex;
    align-items: center;
    padding-left: 12px;
  }

  .rss-thumb {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    object-fit: cover;
    border: 2px solid rgba(18, 18, 18, 0.95);
    background: #2a2a2a;
    margin-left: -12px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .rss-thumb-svg { width: 70%; height: 70%; opacity: 0.4; }

  .rss-more {
    margin-left: 4px;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .rss-trigger { right: 8px; padding: 9px 10px 11px; gap: 7px; }
    .rss-thumb { width: 30px; height: 30px; }
  }

  /* ── Overlay ── */
  .rss-overlay {
    position: fixed;
    inset: 0;
    z-index: 9998;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease-out;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .rss-overlay.rss-open {
    opacity: 1;
    pointer-events: all;
    touch-action: none;
  }

  .rss-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    backdrop-filter: blur(24px) saturate(160%);
  }

  .rss-close {
    position: fixed;
    top: max(18px, calc(12px + env(safe-area-inset-top, 0px)));
    right: 18px;
    z-index: 3;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.15s, transform 0.2s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .rss-close:hover { background: rgba(255, 255, 255, 0.2); color: #fff; }
  .rss-close:active { transform: scale(0.92); }

  .rss-overlay__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(16px, 3vh, 34px);
    padding-block: max(8vh, calc(26px + env(safe-area-inset-top, 0px))) calc(20px + env(safe-area-inset-bottom, 0px));
    transform: translateY(24px) scale(0.98);
    transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .rss-overlay.rss-open .rss-overlay__inner {
    transform: translateY(0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .rss-overlay, .rss-overlay__inner { transition-duration: 0.01s; }
  }

  .rss-overlay__title {
    flex-shrink: 0;
    color: #fff;
    font-style: italic;
    font-weight: 800;
    font-size: clamp(1.8rem, 7vw, 2.9rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-align: center;
    margin: 0;
    padding-inline: 20px;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.4);
  }

  /* ── One-screen grid of cards ── */
  .rss-grid-wrap {
    flex: 1;
    min-height: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-y: auto;   /* graceful fallback if a very dense grid can't fit */
    touch-action: pan-y;
    overscroll-behavior: contain;
  }

  .rss-grid {
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: clamp(14px, 3vw, 28px);
    display: grid;
    grid-template-columns: repeat(var(--rss-cols-m, 2), minmax(0, 1fr));
    gap: clamp(10px, 2vw, 18px);
    align-content: center;
    justify-items: center;
  }

  @media screen and (min-width: 750px) {
    .rss-grid {
      grid-template-columns: repeat(var(--rss-cols, 4), minmax(0, 1fr));
    }
  }

  /* ── Card (white) — container-query driven so type/pills scale with width ── */
  .rss-card {
    container-type: inline-size;
    width: 100%;
    max-width: 320px;
    background: #ffffff;
    border-radius: clamp(14px, 4cqi, 20px);
    padding: clamp(8px, 3.4cqi, 14px);
    box-shadow: 0 24px 48px -18px rgba(0, 0, 0, 0.5), 0 3px 10px rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    gap: clamp(7px, 2.6cqi, 12px);
  }

  .rss-card__link {
    display: flex;
    flex-direction: column;
    gap: clamp(5px, 2cqi, 9px);
    text-decoration: none;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.2s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .rss-card__link:active { transform: scale(0.98); }

  .rss-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #f2f2f2;
    border-radius: clamp(10px, 3cqi, 14px);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rss-card__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .rss-card__svg { width: 70%; height: 70%; opacity: 0.3; }

  .rss-badge {
    position: absolute;
    top: clamp(6px, 2.5cqi, 10px);
    right: clamp(6px, 2.5cqi, 10px);
    background: #33a1ff;
    color: #fff;
    font-style: italic;
    font-weight: 800;
    font-size: clamp(0.46rem, 3.8cqi, 0.62rem);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: clamp(3px, 1.4cqi, 5px) clamp(8px, 3.4cqi, 13px);
    border-radius: 999px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    white-space: nowrap;
  }

  .rss-card__name {
    margin: 0;
    padding-inline: clamp(2px, 1cqi, 4px);
    color: #1a1a1a;
    font-style: italic;
    font-weight: 800;
    font-size: clamp(0.72rem, 7cqi, 1.1rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  /* ── Sizes box (compact, 2-column pills) ── */
  .rss-sizes {
    background: #111;
    border-radius: clamp(10px, 3cqi, 14px);
    padding: clamp(7px, 2.6cqi, 11px);
    display: flex;
    flex-direction: column;
    gap: clamp(4px, 1.8cqi, 7px);
  }

  .rss-sizes__label {
    color: #fff;
    font-style: italic;
    font-weight: 800;
    font-size: clamp(0.5rem, 4cqi, 0.7rem);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding-left: 2px;
  }

  .rss-sizes__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(4px, 1.8cqi, 7px);
  }

  .rss-size-pill {
    background: #fff;
    color: #111;
    border-radius: 999px;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(0.48rem, 3.6cqi, 0.68rem);
    line-height: 1.1;
    padding: clamp(3px, 1.6cqi, 5px) clamp(6px, 3cqi, 12px);
    letter-spacing: 0.01em;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.15s cubic-bezier(0.32, 0.72, 0, 1), background 0.15s;
  }

  .rss-size-pill:hover { background: #e9e9e9; }
  .rss-size-pill:active { transform: scale(0.93); }
{% endstylesheet %}

<script>
  (function () {
    var sid      = {{ section.id | json }};
    var overlay  = document.getElementById('rss-overlay-' + sid);
    if (!overlay) return;

    var trigger  = document.getElementById('rss-open-' + sid);
    var backdrop = document.getElementById('rss-backdrop-' + sid);
    var closeBtn = document.getElementById('rss-close-' + sid);

    function open() {
      overlay.classList.add('rss-open');
      overlay.setAttribute('aria-hidden', 'false');
    }

    function close() {
      overlay.classList.remove('rss-open');
      overlay.setAttribute('aria-hidden', 'true');
    }

    if (trigger)  trigger.addEventListener('click', open);
    if (closeBtn) closeBtn.addEventListener('click', close);
    if (backdrop) backdrop.addEventListener('click', close);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.classList.contains('rss-open')) close();
    });
  })();
</script>

{% schema %}
{
  "name": "Re-stocked Showcase",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "RE-STOCKED"
    },
    {
      "type": "text",
      "id": "condition_default",
      "label": "Default condition badge",
      "info": "Shown on cards that don't set their own condition. Leave blank to hide the badge by default."
    },
    {
      "type": "paragraph",
      "content": "Add a product block for each item. The floating tab shows their images stacked; tapping it opens all cards on one screen. Sizes and their variant links are pulled automatically from each product's available variants."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Overrides the product's featured image"
        },
        {
          "type": "text",
          "id": "condition",
          "label": "Condition badge",
          "info": "e.g. New, Used - Excellent. Overrides the section default."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Re-stocked Showcase",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
