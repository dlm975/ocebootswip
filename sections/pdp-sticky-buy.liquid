{%- liquid
  assign p = product
  if p == blank
    assign p = closest.product
  endif
  if p == blank and request.visual_preview_mode
    assign p = collections.all.products.first
  endif

  comment
    Find the option that holds the size so the pill can show just "US 7 …"
    instead of the whole variant title. Falls back to the variant title when
    the product isn't sized (accessories, gift cards).
  endcomment
  assign size_pos = 0
  assign size_name = ''
  for opt in p.options_with_values
    assign lower_name = opt.name | downcase
    if lower_name contains 'size'
      assign size_pos = forloop.index
      assign size_name = opt.name
      break
    endif
  endfor

  assign current = p.selected_or_first_available_variant

  case size_pos
    when 1
      assign size_label = current.option1
    when 2
      assign size_label = current.option2
    when 3
      assign size_label = current.option3
    else
      assign size_label = current.title
  endcase

  comment
    Shopify names the sole variant of an option-less product "Default
    Title" — a label worth showing to nobody.
  endcomment
  if size_label == 'Default Title'
    assign size_label = ''
  endif

  comment
    Two separate questions: whether there is a size worth showing, and
    whether there is a choice to make. A one-size product still displays
    its size, just as a plain label rather than a picker that opens onto
    a single option.
  endcomment
  assign show_size = false
  if size_label != blank
    assign show_size = true
  endif

  assign show_picker = false
  if p.variants.size > 1 and show_size
    assign show_picker = true
  endif

  assign form_id = 'psb-form-' | append: section.id
  assign atc_id = 'psb-atc-' | append: section.id

  assign thumb = current.featured_media.preview_image
  if thumb == blank
    assign thumb = p.featured_image
  endif
-%}

{%- if p != blank -%}
  <div
    class="psb"
    id="psb-{{ section.id }}"
    data-size-option="{{ size_name | escape }}"
    data-reveal="{{ section.settings.reveal_mode }}"
    {% if section.settings.reveal_mode == 'after_button' %}data-hidden{% endif %}
    style="--psb-accent: {{ section.settings.button_color }}; --psb-accent-text: {{ section.settings.button_text_color }};"
  >
    {%- comment -%} Dims the page behind the size sheet on mobile {%- endcomment -%}
    <div class="psb__scrim" data-psb-scrim hidden></div>

    <div class="psb__bar">
      {%- if thumb != blank -%}
        <img
          class="psb__thumb"
          data-psb-thumb
          src="{{ thumb | image_url: width: 120 }}"
          alt=""
          width="40"
          height="40"
          loading="lazy"
          decoding="async"
        >
      {%- endif -%}

      {%- if show_picker -%}
        <button
          type="button"
          class="psb__pill"
          data-psb-trigger
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span class="psb__pill-label" data-psb-label>{{ size_label }}</span>
          {%- render 'gicon', name: 'keyboard_arrow_down', class: 'psb__chev', size: 13 -%}
        </button>
      {%- elsif show_size -%}
        {%- comment -%}
          One variant only: the size still shows, but as a label with no
          chevron and nothing to open.
        {%- endcomment -%}
        <span class="psb__pill psb__pill--static">
          <span class="psb__pill-label" data-psb-label>{{ size_label }}</span>
        </span>
      {%- endif -%}

      <product-form-component
        class="psb__form"
        data-section-id="{{ section.id }}"
        data-product-id="{{ p.id }}"
        data-product-url="{{ p.url }}"
        on:submit="/handleSubmit"
        data-quantity-default="1"
      >
        <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>

        {%- form 'product', p, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" ref="variantId" value="{{ current.id }}">
          <input type="hidden" name="quantity" value="1">

          {% render 'add-to-cart-button',
            id: atc_id,
            class: 'psb__atc',
            can_add_to_cart: current.available,
            product: p,
            add_to_cart_text: section.settings.button_text
          %}

          <span class="product-form-text__error hidden" ref="addToCartTextError">
            <span class="svg-wrapper product-form-icon--error">
              {{- 'icon-error.svg' | inline_asset_content -}}
            </span>
          </span>
        {%- endform -%}
      </product-form-component>
    </div>

    {%- if show_picker -%}
      <div class="psb__sheet" data-psb-sheet hidden>
        <div class="psb__sheet-grip" aria-hidden="true"></div>

        <div class="psb__sheet-head">
          <span>{{ section.settings.sheet_heading | default: 'Select size' }}</span>
          <button type="button" class="psb__sheet-close" data-psb-close aria-label="Close">
            {%- render 'gicon', name: 'close', size: 16 -%}
          </button>
        </div>

        <div class="psb__opts" role="listbox" aria-label="{{ section.settings.sheet_heading | default: 'Select size' | escape }}">
          {%- for v in p.variants -%}
            {%- liquid
              case size_pos
                when 1
                  assign v_label = v.option1
                when 2
                  assign v_label = v.option2
                when 3
                  assign v_label = v.option3
                else
                  assign v_label = v.title
              endcase
            -%}
            <button
              type="button"
              class="psb__opt"
              role="option"
              data-psb-opt
              data-variant-id="{{ v.id }}"
              data-label="{{ v_label | escape }}"
              aria-selected="{% if v.id == current.id %}true{% else %}false{% endif %}"
              {% unless v.available %}disabled aria-disabled="true"{% endunless %}
            >
              {%- liquid
                assign v_parts = v_label | split: ' - '
                assign v_main = v_parts | first
                assign v_rest = v_parts | slice: 1, 4 | join: ' · '
              -%}
              <span class="psb__opt-label">{{ v_main }}</span>
              {%- if v_rest != blank -%}
                <span class="psb__opt-meta">{{ v_rest }}</span>
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  /* ── Floating buy bar ──
     The site's newer look: a glassy bar floating clear of the screen edges (phones) or in the
     bottom-right corner (desktop); the size as a raised off-white key; the holographic add to cart
     (assets/base.css); and a sheet of raised size keys, the chosen one pressed in. */
  .psb {
    --psb-ease: cubic-bezier(0.3, 0.7, 0.3, 1);
    --psb-key-face: linear-gradient(180deg, #ffffff 0%, #f7f7f5 100%);
    --psb-key-raised: inset 0 1px 0 #ffffff, 2px 3px 0 #d4d4d8, 2px 4px 8px rgb(18 18 18 / 0.06);
    --psb-key-pressed: inset 1px 2px 3px rgb(18 18 18 / 0.08), 0.5px 1px 0 #d4d4d8;

    position: fixed;
    z-index: 40;
    inset: auto 0 0 0;
    pointer-events: none;
  }

  /* Glass: the page shows through, blurred, with a light rim */
  .psb__bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 10px calc(10px + env(safe-area-inset-bottom, 0px));
    padding: 8px 8px 8px 8px;
    border-radius: 22px;
    background: rgb(255 255 255 / 0.62);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.7),
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 0 0 1px rgb(18 18 18 / 0.06),
      0 12px 32px rgb(18 18 18 / 0.16);
    transition:
      transform 0.55s var(--psb-ease),
      opacity 0.25s ease;
  }

  /* Held out of the way until the in-page add-to-cart button scrolls off */
  .psb[data-hidden] .psb__bar {
    transform: translateY(calc(100% + 32px));
    opacity: 0;
    pointer-events: none;
  }

  .psb__thumb {
    flex: 0 0 auto;
    display: block;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    object-fit: contain;
    background: #ffffff;
    box-shadow: 0 0 0 1px rgb(18 18 18 / 0.06);
  }

  /* ── Size: a raised off-white key ── */
  /* Sized to its text so the whole size reads out; it shrinks (and the label truncates) only as a
     last resort, rather than pushing the add to cart off a very narrow bar. */
  .psb__pill {
    flex: 0 1 auto;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 42px;
    margin-block-end: 3px;
    padding: 0 12px 0 14px;
    border: 1px solid #d4d4d8;
    border-radius: 12px;
    background: var(--psb-key-face);
    box-shadow: var(--psb-key-raised);
    color: #121212;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.2s var(--psb-ease),
      box-shadow 0.2s var(--psb-ease),
      border-color 0.2s ease;
  }

  .psb__pill:active,
  .psb__pill[aria-expanded='true'] {
    transform: translate(1.5px, 2px);
    box-shadow: var(--psb-key-pressed);
  }

  .psb__pill[aria-expanded='true'] {
    border-color: #121212;
  }

  /* Same shape, but nothing to press */
  .psb__pill--static {
    cursor: default;
    pointer-events: none;
  }

  .psb__pill-label {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .psb__chev {
    flex-shrink: 0;
    color: rgb(18 18 18 / 0.6);
    transition: transform 0.3s var(--psb-ease);
  }

  .psb__pill[aria-expanded='true'] .psb__chev {
    transform: rotate(180deg);
  }

  /* ── Add to cart: the holographic key (assets/base.css) ──
     Keeps its natural width and never shrinks; the auto margin sets it hard against the right. */
  .psb__form {
    flex: 0 0 auto;
    display: block;
    margin-inline-start: auto;
  }

  .psb__form form {
    display: flex;
    align-items: center;
  }

  .psb .psb__atc {
    height: 46px;
    min-height: 46px;
    margin-block-end: 2px;
    padding: 0 20px;
    border-radius: 14px;
    font-size: 0.875rem;
    font-weight: 700;
    white-space: nowrap;
  }

  /* The theme's cart icon inside the button is noise at this size */
  .psb .psb__atc .add-to-cart-icon {
    display: none;
  }

  .psb .product-form-text__error {
    display: none;
  }

  /* ── Size sheet ── */
  .psb__scrim {
    position: fixed;
    inset: 0;
    background: rgb(0 0 0 / 0.28);
    opacity: 0;
    pointer-events: auto;
    transition: opacity 0.3s ease;
    /* iOS: blocks page scroll behind the sheet without locking the body, which would stop the
       sheet itself scrolling */
    touch-action: none;
  }

  .psb[data-open] .psb__scrim {
    opacity: 1;
  }

  .psb__sheet {
    pointer-events: auto;
    position: fixed;
    inset: auto 10px calc(10px + env(safe-area-inset-bottom, 0px));
    display: flex;
    flex-direction: column;
    max-height: min(70vh, 560px);
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 0 0 1px rgb(18 18 18 / 0.06), 0 24px 60px rgb(18 18 18 / 0.28);
    transform: translateY(calc(100% + 24px));
    transition: transform 0.55s var(--psb-ease);
  }

  .psb[data-open] .psb__sheet {
    transform: translateY(0);
  }

  .psb__sheet[hidden] {
    display: none;
  }

  .psb__sheet-grip {
    flex-shrink: 0;
    width: 38px;
    height: 4px;
    margin: 8px auto 2px;
    border-radius: 999px;
    background: rgb(18 18 18 / 0.16);
  }

  .psb__sheet-head {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px 12px 18px;
    color: #121212;
    font-size: 1.0625rem;
    font-weight: 750;
    letter-spacing: -0.01em;
  }

  .psb__sheet-close {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: rgb(18 18 18 / 0.06);
    color: #121212;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* The sizes: raised off-white keys, three a row; min-height:0 lets the grid scroll */
  .psb__opts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px 8px;
    min-height: 0;
    padding: 2px 14px 18px 12px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
  }

  .psb__opt {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 54px;
    padding: 6px;
    border: 1px solid #d4d4d8;
    border-radius: 12px;
    background: var(--psb-key-face);
    box-shadow: var(--psb-key-raised);
    color: #121212;
    font: inherit;
    line-height: 1.15;
    text-align: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.2s var(--psb-ease),
      box-shadow 0.2s var(--psb-ease),
      border-color 0.2s ease;
  }

  @media (hover: hover) {
    .psb__opt:hover:not([disabled], [aria-selected='true']) {
      border-color: #b8b8bf;
      transform: translate(-0.5px, -1px);
    }
  }

  .psb__opt:active:not([disabled]),
  .psb__opt[aria-selected='true'] {
    transform: translate(1.5px, 2px);
    box-shadow: var(--psb-key-pressed);
  }

  .psb__opt[aria-selected='true'] {
    border: 1.5px solid #121212;
    background: #f4f4f2;
  }

  .psb__opt[disabled] {
    opacity: 0.45;
    background: #f7f7f5;
    border-color: #e4e4e7;
    box-shadow: none;
    cursor: default;
    text-decoration: line-through;
  }

  .psb__opt-label {
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .psb__opt-meta {
    font-size: 0.6875rem;
    font-weight: 500;
    color: rgb(18 18 18 / 0.55);
    font-variant-numeric: tabular-nums;
  }

  /* Keep page content clear of the bar */
  body:has(.psb) {
    padding-bottom: 88px;
  }

  @media (prefers-reduced-motion: reduce) {
    .psb__bar,
    .psb__sheet,
    .psb__scrim,
    .psb__chev,
    .psb__pill,
    .psb__opt {
      transition: none;
    }
  }

  /* ── Desktop: the glass card in the bottom-right corner, the sheet growing up from it ── */
  @media screen and (min-width: 750px) {
    .psb {
      inset: auto 24px 24px auto;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 12px;
    }

    /* Hugs its contents: a short size gets a compact card, a long one a wider card (up to a
       limit so it never runs off screen) */
    .psb__bar {
      width: fit-content;
      max-width: min(560px, calc(100vw - 48px));
      margin: 0;
      padding: 10px;
    }

    /* The (clear) scrim stays beneath the sheet, so clicks on the sizes reach them and only clicks
       elsewhere close it */
    .psb__scrim {
      z-index: 0;
      background: transparent;
    }

    .psb__sheet {
      position: relative;
      z-index: 2;
      inset: auto;
      order: -1;
      width: min(420px, calc(100vw - 48px));
      max-height: min(60vh, 460px);
      opacity: 0;
      transform: translateY(8px) scale(0.98);
      transform-origin: bottom right;
      transition:
        transform 0.55s var(--psb-ease),
        opacity 0.2s ease;
    }

    .psb[data-open] .psb__sheet {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    .psb__sheet-grip {
      display: none;
    }

    .psb__opts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    body:has(.psb) {
      padding-bottom: 0;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.getElementById('psb-{{ section.id }}');
    if (!root) return;

    var trigger = root.querySelector('[data-psb-trigger]');
    var sheet = root.querySelector('[data-psb-sheet]');
    var scrim = root.querySelector('[data-psb-scrim]');
    var label = root.querySelector('[data-psb-label]');
    var variantInput = root.querySelector('input[name="id"]');
    var atc = root.querySelector('.psb__atc');
    var opts = [].slice.call(root.querySelectorAll('[data-psb-opt]'));
    var thumb = root.querySelector('[data-psb-thumb]');

    /* ── Reveal ──
       Showing a floating buy bar while the real add-to-cart button is still
       on screen just duplicates it, so track that button and slide in only
       once it has scrolled away. */
    if (root.dataset.reveal === 'after_button') {
      var mainBtn = document.querySelector('.buy-buttons-block button[name="add"]');

      if (!mainBtn || !('IntersectionObserver' in window)) {
        root.removeAttribute('data-hidden');
      } else {
        new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) root.setAttribute('data-hidden', '');
            else root.removeAttribute('data-hidden');
          });
        }).observe(mainBtn);
      }
    }

    /* ── Sheet open/close ── */
    function open() {
      if (!sheet) return;
      sheet.hidden = false;
      if (scrim) scrim.hidden = false;
      /* next frame so the transition runs from the closed state */
      requestAnimationFrame(function () {
        root.setAttribute('data-open', '');
      });
      if (trigger) trigger.setAttribute('aria-expanded', 'true');

      var selected = root.querySelector('[data-psb-opt][aria-selected="true"]:not([disabled])');
      var target = selected || root.querySelector('[data-psb-opt]:not([disabled])');
      if (target) target.focus({ preventScroll: true });
    }

    function close() {
      if (!sheet) return;
      root.removeAttribute('data-open');
      if (trigger) {
        trigger.setAttribute('aria-expanded', 'false');
        trigger.focus({ preventScroll: true });
      }
      /* wait out the slide-down before removing from the a11y tree */
      setTimeout(function () {
        if (root.hasAttribute('data-open')) return;
        sheet.hidden = true;
        if (scrim) scrim.hidden = true;
      }, 380);
    }

    if (trigger) {
      trigger.addEventListener('click', function () {
        if (root.hasAttribute('data-open')) close();
        else open();
      });
    }

    if (scrim) scrim.addEventListener('click', close);

    var closeBtn = root.querySelector('[data-psb-close]');
    if (closeBtn) closeBtn.addEventListener('click', close);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && root.hasAttribute('data-open')) close();
    });

    /* ── Selection ──
       Prefer driving the main variant picker: it re-renders the gallery,
       price and buy button, and fires variant:update which syncs this bar
       back. Only fall back to setting our own input when there's no picker
       on the page (or its option value has since changed). */
    function applyLocally(id, text) {
      if (variantInput) variantInput.value = id;
      if (label && text) label.textContent = text;

      opts.forEach(function (o) {
        o.setAttribute('aria-selected', o.dataset.variantId === String(id) ? 'true' : 'false');
      });
    }

    function syncMainPicker(text) {
      var optionName = root.dataset.sizeOption;
      if (!optionName || !text) return false;

      var select = document.querySelector('select[name="options[' + optionName.replace(/"/g, '\\"') + ']"]');
      if (select) {
        var matched = false;
        for (var i = 0; i < select.options.length; i++) {
          if (select.options[i].value === text) {
            select.selectedIndex = i;
            matched = true;
            break;
          }
        }
        if (!matched) return false;
        select.dispatchEvent(new Event('change', { bubbles: true }));
        return true;
      }

      /* Button style picker renders radios instead of a select */
      var radios = document.querySelectorAll('input[type="radio"][value]');
      for (var j = 0; j < radios.length; j++) {
        if (radios[j].value === text && radios[j].closest('[data-option-name], fieldset')) {
          radios[j].click();
          return true;
        }
      }
      return false;
    }

    opts.forEach(function (opt) {
      opt.addEventListener('click', function () {
        if (opt.hasAttribute('disabled')) return;

        var id = opt.dataset.variantId;
        var text = opt.dataset.label;

        applyLocally(id, text);
        syncMainPicker(text);
        close();
      });
    });

    /* ── Follow the page's size picker straight away ──
       The size grid and dropdowns drive a hidden <select name="options[Size]">. Reading it
       directly updates this bar the moment a size is tapped, without waiting for the variant
       to load (and still updates it if that request is slow or fails). */
    document.addEventListener('change', function (e) {
      var select = e.target;
      if (!(select instanceof HTMLSelectElement) || root.contains(select)) return;
      var optionName = root.dataset.sizeOption;
      if (!optionName || select.name !== 'options[' + optionName + ']') return;
      var text = select.value;
      var match = opts.filter(function (o) {
        return o.dataset.label === text;
      })[0];
      if (match) applyLocally(match.dataset.variantId, text);
      else if (label && text) label.textContent = text;
    });

    /* ── Keep in step with the main picker ── */
    document.addEventListener('variant:update', function (e) {
      var resource = e.detail && e.detail.resource;
      if (!resource || !resource.id) return;

      var match = opts.filter(function (o) {
        return o.dataset.variantId === String(resource.id);
      })[0];

      if (match) {
        applyLocally(resource.id, match.dataset.label);
      } else if (variantInput) {
        variantInput.value = resource.id;
      }

      if (atc) {
        if (resource.available === false) atc.setAttribute('disabled', 'disabled');
        else atc.removeAttribute('disabled');
      }

      var media = resource.featured_media && resource.featured_media.preview_image;
      if (thumb && media && media.src) thumb.src = media.src + '&width=120';
    });
  })();
</script>

{% schema %}
{
  "name": "Floating Buy Bar",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "A floating add-to-cart bar — full width along the bottom on mobile, a card in the bottom-right corner on desktop. It shows the product name, the selected size and the price with currency."
    },
    {
      "type": "select",
      "id": "reveal_mode",
      "label": "When to show the bar",
      "options": [
        { "value": "after_button", "label": "After the main button scrolls out of view" },
        { "value": "always", "label": "Always" }
      ],
      "default": "after_button"
    },
    {
