{%- doc -%}
  Boot Match: a swipe game that finds a shopper their boot. A round button (the flame-and-ball
  mark) floats in the bottom-right corner; it opens a window that asks four things, then deals
  boots one at a time:
  1. Size: US, UK or EU (the same big type and number grid as the Shop by Size menu); one or more
     sizes, thirds counted with the nearest whole size (EU 41 takes in 40⅔ and 41⅓), or any size.
  2. Ground: firm grass, turf or soft grass (the collection filter's surface pictures), or any.
  3. Price: a two-handled slider over a little chart of how many boots sit at each price, in the
     shopper's own currency (as the product cards show it).
  4. Favourite silos: the brands in big type (as US / UK / EU), each opening a short list of its
     silos to tick, as many as they like.
  Only boots in stock that fit all four come up. Swipe right (or tap the heart) on ones you like,
  left (or the cross) on ones you don't; each swipe teaches it what you like within those silos:
  the silo, the line (Vapor, Superfly), the condition and the price. The next boots lean that way,
  and after a few likes it asks: continue matching, or see "your match": the boot that best fits everything liked so far,
  plus the liked boots, which can be saved to the wishlist in one tap.

  Super Like: one per shopper, unlocked by leaving an email or mobile number (in the welcome or from
  the star in the game). The boot they Super Like gets the reward (section setting, NZD; shown in
  the shopper's currency, rounded) with the discount code in the settings, claimed from the match
  screen. Emails join the store's customers (marketing consent, tagged boot-match and super-like);
  mobile numbers come to the store by the contact form.

  Welcome: on a shopper's first visit (or with ?bm-intro in the address), the page darkens and
  blurs, the mark pops up and flickers like a flame, and it offers the game, then the Super Like.

  - Boots come from a JSON feed (templates/collection.bootmatch.liquid), fetched when the shopper
    reaches for the button (hover, touch or focus), so the window opens without waiting; the first
    250 at once, the rest behind them.
  - The size and silos picked are remembered in this browser; nothing is sent anywhere.
  - Animations: Motion (the house timing); reduced motion: no flying or tilting, just changes.
{%- enddoc -%}

{%- liquid
  assign bm_collection = section.settings.collection | default: collections['all-football-boots']
  if bm_collection == blank
    assign bm_collection = collections.all
  endif
  assign bm_feed = bm_collection.url | append: '?view=bootmatch'
  # Its name, as set in the theme editor
  assign bm_full_name = section.settings.heading | strip | default: 'OCEBOOTS Match'

  # The silos to choose from: key (as the boots' gen: tags start), name, picture in Files
  assign bm_silos = 'nike-mercurial|Mercurial|Nike|silo-nike-mercurial.jpg,nike-phantom|Phantom|Nike|silo-nike-phantom.jpg,nike-tiempo|Tiempo|Nike|silo-nike-tiempo.jpg,nike-hypervenom|Hypervenom|Nike|silo-nike-hypervenom.jpg,nike-magista|Magista|Nike|silo-nike-magista.jpg,nike-ctr360|CTR360|Nike|silo-nike-ctr360.jpg,nike-total-90|Total 90|Nike|silo-nike-total-90.jpg,adidas-predator|Predator|Adidas|silo-adidas-predator.jpg,adidas-x|X|Adidas|silo-adidas-x.jpg,adidas-f50|F50|Adidas|silo-adidas-f50.jpg,adidas-copa|Copa|Adidas|silo-adidas-copa.jpg,adidas-nemeziz|Nemeziz|Adidas|silo-adidas-nemeziz.jpg,adidas-11pro|11Pro|Adidas|silo-adidas-11pro.jpg,adidas-ace|Ace|Adidas|silo-adidas-ace.jpg,puma-future|Future|Puma|silo-puma-future.jpg,puma-ultra|Ultra|Puma|silo-puma-ultra.jpg,puma-evopower|evoPOWER|Puma|silo-puma-evopower.jpg,mizuno-morelia|Morelia|Mizuno|silo-mizuno-morelia.jpg' | split: ','
-%}

{%- if section.settings.enabled -%}
  <div
    class="bm"
    data-bm
    data-feed="{{ bm_feed }}"
    data-likes-to-match="{{ section.settings.likes_to_match }}"
    data-wishlist-url="{{ routes.all_products_collection_url }}?view=wishlist"
    data-money-format="{{ shop.money_format | strip_html | escape }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-intro="{{ section.settings.intro_enabled }}"
    data-reward="{{ section.settings.reward_amount }}"
    data-code="{{ section.settings.reward_code | strip | escape }}"
  >
    <div class="bm-dock" data-bm-dock>
      <span class="bm-tip" data-bm-tip hidden>{{ section.settings.tip | escape }}</span>
      <button
        type="button"
        class="bm-launch"
        data-bm-open
        aria-haspopup="dialog"
        aria-label="{{ bm_full_name | escape }}: find your perfect boot"
      >
        <span class="bm-launch__coin oce-disk" aria-hidden="true"></span>
        <img
          class="bm-launch__logo"
          src="{{ 'boot-match-mark.png' | asset_url }}"
          alt=""
          width="197"
          height="240"
        >
      </button>
    </div>

    <dialog class="bm-dlg" data-bm-dlg aria-labelledby="bm-title-{{ section.id }}">
      <div class="bm-scrim" data-bm-close></div>
      <div class="bm-panel" data-bm-panel>
        <header class="bm-head">
          <button type="button" class="bm-icon-btn bm-head__back" data-bm-back aria-label="Back" hidden>
            {%- render 'gicon', name: 'chevron_left', size: 24 -%}
          </button>
          <span class="bm-mark bm-head__logo" style="--bm-fill: url({{ 'boot-match-fill.png' | asset_url }}); --bm-holo: url({{ 'oce-holo.webp' | asset_url }});" aria-hidden="true"><span class="bm-mark__foil"></span><img src="{{ 'boot-match-mark.png' | asset_url }}" alt="" width="197" height="240"></span>
          <h2 class="bm-head__title" id="bm-title-{{ section.id }}">{{ bm_full_name | escape }}</h2>
          <span class="bm-head__step" data-bm-step></span>
          <button type="button" class="bm-icon-btn bm-head__close" data-bm-close aria-label="Close">
            {%- render 'gicon', name: 'close', size: 22 -%}
          </button>
        </header>

        {%- comment -%} 1. Size, in the Shop by Size menu's style {%- endcomment -%}
        <div class="bm-screen bm-step" data-bm-screen="size">
          <p class="bm-step__q">What size are you?</p>
          <div class="bm-step__sub"><span class="bm-step__hint">Pick one or more</span><button type="button" class="bm-clear" data-bm-clear="size" hidden>Clear all</button></div>
          <div class="size-drill size-drill--drawer bm-sizepick" data-active>
            <ul class="size-drill__systems list-unstyled" role="list">
              {%- for system in (1..3) -%}
                {%- liquid
                  case system
                    when 1
                      assign system_name = 'US'
                    when 2
                      assign system_name = 'UK'
                    else
                      assign system_name = 'EU'
                  endcase
                -%}
                <li class="size-drill__system-item">
                  <button
                    type="button"
                    class="size-drill__system"
                    aria-expanded="{% if system == 1 %}true{% else %}false{% endif %}"
                    data-bm-system="{{ system_name }}"
                  >
                    {{- system_name -}}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
            <div class="size-drill__panels bm-sizepick__panel">
              <ul class="size-drill__sizes list-unstyled" role="list" data-bm-sizes></ul>
            </div>
          </div>
          <div class="bm-step__foot">
            <button type="button" class="bm-link" data-bm-anysize>Any size</button>
            <button type="button" class="bm-primary" data-bm-next="ground">Next</button>
          </div>
        </div>

        {%- comment -%} 2. Ground: the collection filter's surface pictures {%- endcomment -%}
        <div class="bm-screen bm-step" data-bm-screen="ground" hidden>
          <p class="bm-step__q">What do you play on?</p>
          <div class="bm-step__sub"><span class="bm-step__hint">Pick one or more</span><button type="button" class="bm-clear" data-bm-clear="ground" hidden>Clear all</button></div>
          <div class="bm-grounds" data-bm-grounds role="group" aria-label="Ground">
            {%- for ground in (1..3) -%}
              {%- liquid
                case ground
                  when 1
                    assign ground_key = 'fg'
                    assign ground_name = 'Firm grass'
                    assign ground_code = 'FG'
                  when 2
                    assign ground_key = 'ag'
                    assign ground_name = 'Turf'
                    assign ground_code = 'AG'
                  else
                    assign ground_key = 'sg'
                    assign ground_name = 'Soft grass'
                    assign ground_code = 'SG'
                endcase
                assign ground_image = 'surface-' | append: ground_key | append: '.webp'
              -%}
              <button type="button" class="bm-ground" data-ground="{{ ground_key }}" aria-pressed="false">
                <span class="bm-ground__media">
                  <img src="{{ ground_image | asset_url }}" alt="" width="120" height="120">
                  <span class="bm-ground__tick" aria-hidden="true">{%- render 'gicon', name: 'check', size: 18 -%}</span>
                </span>
                <span class="bm-ground__name">{{ ground_name }}</span>
                <span class="bm-ground__code">{{ ground_code }} · <span data-bm-ground-count></span></span>
              </button>
            {%- endfor -%}
          </div>
          <div class="bm-step__foot">
            <button type="button" class="bm-link" data-bm-anyground>Any ground</button>
            <button type="button" class="bm-primary" data-bm-next="price">Next</button>
          </div>
        </div>

        {%- comment -%} 3. Price {%- endcomment -%}
        <div class="bm-screen bm-step" data-bm-screen="price" hidden>
          <p class="bm-step__q">What do you want to spend?</p>
          <div class="bm-step__sub"><span class="bm-step__hint">Drag either end</span><button type="button" class="bm-clear" data-bm-clear="price" hidden>Clear all</button></div>
          <p class="bm-price__value" data-bm-price-label aria-live="polite"></p>
          <div class="bm-price">
            <div class="bm-hist" data-bm-hist aria-hidden="true"></div>
            <div class="bm-range" data-bm-range>
              <div class="bm-range__track"><div class="bm-range__fill" data-bm-fill></div></div>
              <input type="range" class="bm-range__input" data-bm-min aria-label="Lowest price">
              <input type="range" class="bm-range__input" data-bm-max aria-label="Highest price">
            </div>
          </div>
          <p class="bm-step__count" data-bm-price-count></p>
          <div class="bm-step__foot">
            <span></span>
            <button type="button" class="bm-primary" data-bm-next="silos">Next</button>
          </div>
        </div>

        {%- comment -%} 4. Favourite silos: brands in big type (as US / UK / EU), each with its silos to tick {%- endcomment -%}
        <div class="bm-screen bm-step" data-bm-screen="silos" hidden>
          <p class="bm-step__q">Favourite silos?</p>
          <div class="bm-step__sub"><span class="bm-step__hint">Tick as many as you like</span><button type="button" class="bm-clear" data-bm-clear="silos" hidden>Clear all</button></div>
          <div class="size-drill size-drill--drawer bm-brandpick" data-active>
            <ul class="size-drill__systems list-unstyled bm-brandpick__brands" role="list">
              {%- assign bm_brands = 'Nike,Adidas,Puma,Mizuno' | split: ',' -%}
              {%- for brand in bm_brands -%}
                <li class="size-drill__system-item">
                  <button
                    type="button"
                    class="size-drill__system"
                    aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                    data-bm-brand="{{ brand | downcase }}"
                  >
                    {{- brand -}}<span class="bm-brandpick__n" data-bm-brand-n></span>
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          </div>
          <div class="bm-silos" data-bm-silos role="group" aria-label="Favourite silos">
            {%- for entry in bm_silos -%}
              {%- assign bits = entry | split: '|' -%}
              <button
                type="button"
                class="bm-silo"
                data-silo="{{ bits[0] }}"
                data-brand="{{ bits[2] | downcase }}"
                aria-pressed="false"
                {% unless bits[2] == 'Nike' %}hidden{% endunless %}
              >
                <span class="bm-silo__media">
                  <img src="{{ bits[3] | file_img_url: '200x' }}" alt="" width="200" height="118" loading="lazy">
                </span>
                <span class="bm-silo__text">
                  <span class="bm-silo__name">{{ bits[1] }}</span>
                  <span class="bm-silo__count" data-bm-silo-count></span>
                </span>
                <span class="bm-silo__tick" aria-hidden="true">{%- render 'gicon', name: 'check', size: 18 -%}</span>
              </button>
            {%- endfor -%}
          </div>
          <div class="bm-picked" data-bm-picked aria-label="Silos ticked" hidden></div>
          <div class="bm-step__foot">
            <button type="button" class="bm-link" data-bm-anysilo>Any silo</button>
            <button type="button" class="bm-primary" data-bm-start>Start swiping</button>
          </div>
        </div>

        {%- comment -%} 4. The deck {%- endcomment -%}
        <div class="bm-screen bm-play" data-bm-screen="play" hidden>
          <p class="bm-status" data-bm-status aria-live="polite"></p>
          <div class="bm-deck" data-bm-deck></div>
          <div class="bm-ask" data-bm-ask hidden>
            <div class="bm-ask__card" role="dialog" aria-modal="false" aria-labelledby="bm-ask-title-{{ section.id }}">
              <p class="bm-ask__title" id="bm-ask-title-{{ section.id }}" data-bm-ask-title></p>
              <p class="bm-ask__text">See your match now, or keep swiping to sharpen it.</p>
              <div class="bm-ask__buttons">
                <button type="button" class="bm-secondary" data-bm-keep>Continue matching</button>
                <button type="button" class="bm-primary" data-bm-shop>Shop now</button>
              </div>
            </div>
          </div>
          <div class="bm-actions">
            <button type="button" class="bm-round bm-round--small" data-bm-undo aria-label="Undo last swipe" disabled>
              {%- render 'gicon', name: 'undo', size: 22 -%}
            </button>
            <button type="button" class="bm-round bm-round--nope" data-bm-nope aria-label="Not for me">
              {%- render 'gicon', name: 'close', size: 30 -%}
            </button>
            <button type="button" class="bm-round bm-round--super" data-bm-super aria-label="Super Like">
              {%- render 'gicon', name: 'star-fill', size: 26 -%}
              <span class="bm-round__badge" data-bm-super-badge aria-hidden="true"></span>
            </button>
            <button type="button" class="bm-round bm-round--like oce-disk" data-bm-like aria-label="Love it">
              {%- render 'gicon', name: 'favorite-fill', size: 30 -%}
            </button>
          </div>
        </div>

        {%- comment -%} 5. The match {%- endcomment -%}
        <div class="bm-screen bm-result" data-bm-screen="match" hidden>
          <p class="bm-result__kicker">
            <span class="bm-mark bm-result__logo" style="--bm-fill: url({{ 'boot-match-fill.png' | asset_url }}); --bm-holo: url({{ 'oce-holo.webp' | asset_url }});" aria-hidden="true"><span class="bm-mark__foil"></span><img src="{{ 'boot-match-mark.png' | asset_url }}" alt="" width="197" height="240"></span>
            <span>It’s a match</span>
          </p>
          <div class="bm-result__body">
            <div class="bm-superwin" data-bm-superwin hidden>
              <span class="bm-superwin__star" aria-hidden="true">{%- render 'gicon', name: 'star-fill', size: 18 -%}</span>
              <img class="bm-superwin__img" data-bm-superwin-img alt="" width="96" height="64">
              <span class="bm-superwin__text">
                <span class="bm-superwin__kicker">Your Super Like</span>
                <span class="bm-superwin__name" data-bm-superwin-name></span>
                <span class="bm-superwin__deal" data-bm-superwin-deal></span>
              </span>
              <a class="bm-superwin__claim" data-bm-superwin-claim href="#">Claim</a>
            </div>
            <a class="bm-result__card" data-bm-match-link href="#">
              <span class="bm-result__media"><img data-bm-match-img alt="" width="640" height="640"></span>
              <span class="bm-result__info">
                <span class="bm-result__name" data-bm-match-title></span>
                <span class="bm-result__meta" data-bm-match-meta></span>
                <span class="bm-result__price" data-bm-match-price></span>
              </span>
            </a>
            <div class="bm-likes" data-bm-likes-wrap hidden>
              <div class="bm-likes__head">
                <p class="bm-label">Boots you liked</p>
                <button type="button" class="bm-link" data-bm-save>Save all to wishlist</button>
              </div>
              <div class="bm-likes__row" data-bm-likes></div>
            </div>
          </div>
          <div class="bm-result__buttons">
            <button type="button" class="bm-secondary" data-bm-again>Keep swiping</button>
            <a class="bm-primary" data-bm-match-cta href="#">View this boot</a>
          </div>
        </div>
      </div>
    </dialog>

    {%- comment -%} The welcome (first visit) and the Super Like offer {%- endcomment -%}
    <dialog class="bm-intro" data-bm-intro aria-labelledby="bm-intro-title-{{ section.id }}">
      <div class="bm-intro__scrim" data-bm-intro-scrim></div>
      <div class="bm-intro__stage">
        <button type="button" class="bm-intro__x" data-bm-intro-close aria-label="Close">
          {%- render 'gicon', name: 'close', size: 22 -%}
        </button>
        <div class="bm-intro__flame" data-bm-intro-flame>
          <span class="bm-intro__glow" aria-hidden="true"></span>
          <span class="bm-intro__embers" aria-hidden="true">
            {%- for i in (1..8) -%}<i style="--i: {{ i }};"></i>{%- endfor -%}
          </span>
          <span class="bm-mark bm-intro__mark" style="--bm-fill: url({{ 'boot-match-fill.png' | asset_url }}); --bm-holo: url({{ 'oce-holo.webp' | asset_url }});" aria-hidden="true"><span class="bm-mark__foil"></span><img src="{{ 'boot-match-mark.png' | asset_url }}" alt="" width="197" height="240"></span>
        </div>

        <div class="bm-intro__step" data-bm-intro-step="hello">
          <h2 class="bm-intro__title" id="bm-intro-title-{{ section.id }}">{{ bm_full_name | escape }}</h2>
          <p class="bm-intro__tagline">FIND YOUR PERFECT BOOT</p>
          <div class="bm-intro__buttons">
            <button type="button" class="bm-intro__primary" data-bm-intro-play>
              Play and <span class="bm-gold bm-gold--on-light">EARN</span>
            </button>
            <button type="button" class="bm-intro__link" data-bm-intro-close>Not now</button>
          </div>
        </div>

        <form class="bm-intro__step" data-bm-intro-step="offer" hidden novalidate>
          <h2 class="bm-intro__title bm-intro__deal">
            <span class="bm-intro__star" aria-hidden="true">{%- render 'gicon', name: 'star-fill', size: 30 -%}</span>
            <span>SUPER LIKE = <span class="bm-gold" data-bm-reward-text></span> OFF</span>
          </h2>
          <label class="bm-intro__field">
            <span class="visually-hidden">Email or mobile number</span>
            <input
              type="text"
              name="contact"
              inputmode="email"
              autocomplete="email"
              placeholder="Email or mobile number"
              data-bm-intro-input
              required
            >
          </label>
          <p class="bm-intro__error" data-bm-intro-error aria-live="polite"></p>
          <div class="bm-intro__buttons">
            <button type="submit" class="bm-intro__primary" data-bm-intro-submit>Get my Super Like</button>
            <button type="button" class="bm-intro__link" data-bm-intro-skip>Skip, just play</button>
          </div>
          <p class="bm-intro__small">By signing up you agree to hear from OCEBOOTS. Unsubscribe any time.</p>
        </form>

        {%- comment -%}
          The sign-up goes through Shopify's own forms (an email joins the customers with marketing
          consent, tagged; a mobile number comes to the store by the contact form), submitted into a
          hidden frame so the shopper stays in the game
        {%- endcomment -%}
        <div class="bm-intro__forms" hidden>
          {%- form 'customer', id: 'bm-signup-email' -%}
            <input type="hidden" name="return_to" value="/cart.js">
            <input type="hidden" name="contact[tags]" value="boot-match,super-like,newsletter">
            <input type="email" name="contact[email]" tabindex="-1" autocomplete="off">
          {%- endform -%}
          {%- form 'contact', id: 'bm-signup-phone' -%}
            <input type="hidden" name="return_to" value="/cart.js">
            <input type="hidden" name="contact[name]" value="Boot Match Super Like">
            <input type="hidden" name="contact[email]" value="{{ shop.email | escape }}">
            <input type="tel" name="contact[phone]" tabindex="-1" autocomplete="off">
            <textarea name="contact[body]" tabindex="-1"></textarea>
          {%- endform -%}
          <iframe name="bm-signup-sink" title="Sign-up" tabindex="-1"></iframe>
        </div>

        <div class="bm-intro__step" data-bm-intro-step="done" hidden>
          <h2 class="bm-intro__title">
            <span class="bm-intro__star" aria-hidden="true">{%- render 'gicon', name: 'star-fill', size: 26 -%}</span>
            Super Like unlocked
          </h2>
          <p class="bm-intro__text">Tap the star on the boot you love most.</p>
        </div>
      </div>
    </dialog>
  </div>
{%- endif -%}

{% stylesheet %}
  /* ---- Launcher: a foil coin with the mark, bottom right ---- */
  .bm-dock {
    position: fixed;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0;
    pointer-events: none;
  }

  .bm-dock.is-shown {
    opacity: 1;
    pointer-events: auto;
  }

  .bm-launch {
    position: relative;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    filter: drop-shadow(0 6px 16px rgb(18 18 18 / 0.22));
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.2s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  .bm .bm-launch__coin {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  /* The mark on the foil disk (assets/boot-match-mark.png, black lines on clear) */
  .bm-launch__logo {
    position: relative;
    display: block;
    width: 29px;
    height: auto;
  }

  @media (hover: hover) {
    .bm-launch:hover {
      transform: scale(1.06);
    }
  }

  .bm-launch:active {
    transform: scale(0.95);
  }

  .bm-launch:focus-visible {
    outline: 2px solid #121212;
    outline-offset: 3px;
  }

  .bm-tip {
    padding: 8px 12px;
    border-radius: 999px;
    background: #121212;
    color: #ffffff;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    box-shadow: 0 6px 16px rgb(18 18 18 / 0.2);
  }

  /* ---- The window ---- */
  .bm-dlg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
    color: #121212;
  }

  .bm-dlg::backdrop {
    background: transparent;
  }

  /* The page behind: darkened while the window slides in, then blurred once it has settled (a
     blur redrawn on every frame of the slide is what made the opening stutter) */
  .bm-scrim {
    position: absolute;
    inset: 0;
    background: rgb(8 8 8 / 0.62);
    will-change: opacity;
  }

  .bm-dlg.is-settled .bm-scrim {
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition: -webkit-backdrop-filter 0.3s linear, backdrop-filter 0.3s linear;
  }

  /* A floating card on phones too: clear of the screen's edges, as on desktop */
  .bm-panel {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: calc(10px + env(safe-area-inset-bottom, 0px));
    display: flex;
    flex-direction: column;
    height: min(calc(100svh - 20px - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px)), 760px);
    padding: 14px 16px 16px;
    border-radius: 24px;
    background: #ffffff;
    box-shadow: 0 0 0 1px rgb(18 18 18 / 0.06), 0 24px 60px rgb(18 18 18 / 0.24);
    font-family: var(--font-body--family);
    overscroll-behavior: contain;
    will-change: transform;
    backface-visibility: hidden;
  }

  @media screen and (min-width: 750px) {
    .bm-panel {
      left: auto;
      right: 24px;
      bottom: 96px;
      width: 400px;
      height: min(calc(100vh - 120px), 700px);
      padding: 14px 18px 18px;
      border-radius: 24px;
      box-shadow: 0 0 0 1px rgb(18 18 18 / 0.06), 0 24px 60px rgb(18 18 18 / 0.24);
      transform-origin: 100% 100%;
    }

  }

  .bm-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  /* In the game the mark is filled with the site's foil: the foil, cut to the inside of the
     flame (assets/boot-match-fill.png), under the black lines (assets/boot-match-mark.png) */
  .bm-mark {
    position: relative;
    display: inline-block;
    flex: none;
    aspect-ratio: 197 / 240;
  }

  .bm-mark__foil {
    position: absolute;
    inset: 0;
    background: #c9c6f5 var(--bm-holo) 0 0 / 120px 60px repeat;
    -webkit-mask: var(--bm-fill) center / 100% 100% no-repeat;
    mask: var(--bm-fill) center / 100% 100% no-repeat;
    animation: bm-foil 14s linear infinite;
  }

  .bm-mark img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }

  @keyframes bm-foil {
    to {
      background-position: 120px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bm-mark__foil {
      animation: none;
    }
  }

  .bm-head__logo {
    width: 24px;
    height: auto;
    flex: none;
  }

  .bm-head__title {
    flex: 1;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(18px, 5.4vw, 22px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .bm-icon-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(18 18 18 / 0.06);
    color: #121212;
    cursor: pointer;
  }

  .bm-screen {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }

  .bm-screen[hidden] {
    display: none;
  }

  .bm-label {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(18 18 18 / 0.55);
  }

  .bm-primary,
  .bm-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 20px;
    border-radius: 999px;
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .bm-primary {
    border: 0;
    background: #121212;
    color: #ffffff;
  }

  .bm-secondary {
    border: 1.5px solid rgb(18 18 18 / 0.16);
    background: #ffffff;
    color: #121212;
  }

  .bm-link {
    padding: 0;
    border: 0;
    background: none;
    color: #121212;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  /* ---- 1–3. The questions ---- */
  .bm-head__back[hidden],
  .bm-head__step:empty {
    display: none;
  }

  .bm-head__back {
    margin-inline-start: -6px;
    background: none;
  }

  .bm-head__step {
    font-size: 13px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: rgb(18 18 18 / 0.5);
  }

  .bm-step__q {
    margin: 4px 0 16px;
    font-family: var(--font-heading--family);
    font-size: 32px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  /* Under the question: the hint, and "Clear all" once something is chosen */
  .bm-step__sub {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    min-height: 22px;
    margin: -10px 0 16px;
  }

  .bm-clear {
    flex: none;
    padding: 0;
    border: 0;
    background: none;
    color: #121212;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  .bm-clear[hidden] {
    display: none;
  }

  .bm-step__hint {
    display: block;
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0;
    color: rgb(18 18 18 / 0.5);
  }

  .bm-step__count {
    margin: 10px 0 0;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    color: rgb(18 18 18 / 0.6);
  }

  .bm-step__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 14px;
  }

  .bm-step__foot .bm-primary {
    flex: 0 1 auto;
    min-width: 50%;
  }

  .bm-primary:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* Size: the Shop by Size menu's type and grid, inside the window */
  .bm .bm-sizepick {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    padding-block: 0;
  }

  .bm .bm-sizepick .size-drill__system {
    font-size: 44px;
  }

  .bm .bm-sizepick__panel {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* The sizes fill the space: rows stretch to the window's height (and scroll when there are more
     than fit), numbers a size up from the menu's */
  .bm .bm-sizepick .size-drill__sizes {
    flex: 1;
    grid-auto-rows: minmax(46px, 1fr);
    align-content: stretch;
    padding-block: 14px 6px;
  }

  .bm .bm-sizepick .size-drill__value {
    font-size: 1.8rem;
  }

  .bm .bm-sizepick .size-drill__size {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
    justify-content: flex-start;
  }

  .bm .bm-sizepick .size-drill__size[aria-pressed='true'] .size-drill__value {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .bm .bm-sizepick[data-picked] .size-drill__size[aria-pressed='false'] {
    opacity: 0.45;
  }

  .bm-link[aria-pressed='true'] {
    text-decoration-thickness: 2px;
  }

  /* Price: how many boots at each price, and a two-handled slider under it */
  .bm-price__value {
    margin: 0 0 18px;
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  /* The chart grows to fill the space, the slider under it */
  .bm-price {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    padding: 0 4px;
  }

  .bm-hist {
    display: flex;
    flex: 1;
    align-items: flex-end;
    gap: 2px;
    min-height: 90px;
    max-height: 320px;
  }

  .bm-hist__bar {
    flex: 1;
    min-height: 2px;
    border-radius: 3px 3px 0 0;
    background: rgb(18 18 18 / 0.12);
    transition: background-color 0.18s;
  }

  .bm-hist__bar.is-in {
    background: #121212;
  }

  .bm-range {
    position: relative;
    height: 36px;
  }

  .bm-range__track {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 4px;
    margin-top: -2px;
    border-radius: 2px;
    background: rgb(18 18 18 / 0.12);
  }

  .bm-range__fill {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 2px;
    background: #121212;
  }

  .bm .bm-range__input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    outline: none;
    background: none;
    pointer-events: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .bm-range__input::-webkit-slider-runnable-track {
    background: none;
    border: 0;
  }

  .bm-range__input::-moz-range-track {
    background: none;
    border: 0;
  }

  .bm-range__input::-webkit-slider-thumb {
    width: 28px;
    height: 28px;
    border: 3px solid #121212;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 2px 8px rgb(18 18 18 / 0.2);
    pointer-events: auto;
    cursor: grab;
    -webkit-appearance: none;
    appearance: none;
  }

  .bm-range__input::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border: 3px solid #121212;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 2px 8px rgb(18 18 18 / 0.2);
    pointer-events: auto;
    cursor: grab;
  }

  .bm-range__input:focus-visible::-webkit-slider-thumb {
    outline: 2px solid #121212;
    outline-offset: 2px;
  }

  /* Ground: three full-width picture bands filling the height, the names on the pictures */
  .bm-grounds {
    display: grid;
    flex: 1;
    min-height: 0;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: repeat(3, minmax(84px, 1fr));
    gap: 10px;
  }

  .bm-ground {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 2px;
    padding: 14px 16px;
    overflow: hidden;
    border: 0;
    border-radius: 18px;
    background: none;
    color: #ffffff;
    font: inherit;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .bm-ground__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: block;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: inset 0 0 0 0 #121212;
    transition: box-shadow 0.18s;
  }

  .bm-ground__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A shade at the bottom so the white names read on the grass */
  .bm-ground__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0) 65%);
  }

  .bm-ground[aria-pressed='true'] {
    box-shadow: 0 0 0 3px #121212;
  }

  .bm-ground__name {
    font-size: 26px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .bm-ground__code {
    font-size: 13px;
    font-weight: 600;
    color: rgb(255 255 255 / 0.85);
  }

  .bm-ground__tick,
  .bm-silo__tick {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    color: transparent;
    transition: background-color 0.18s, color 0.18s, box-shadow 0.18s;
  }

  .bm-ground__tick {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    background: rgb(255 255 255 / 0.85);
  }

  .bm-ground[aria-pressed='true'] .bm-ground__tick,
  .bm-silo[aria-pressed='true'] .bm-silo__tick {
    background: #121212;
    color: #ffffff;
  }

  .bm-ground:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* Silos: the brands in big type (as US / UK / EU), the chosen brand's silos as a short list */
  .bm .bm-brandpick {
    padding-block: 0 6px;
  }

  .bm .bm-brandpick .size-drill__systems {
    gap: 0 12px;
    flex-wrap: nowrap;
  }

  /* All four brands on one line, phones included, ticked counts and all */
  .bm .bm-brandpick .size-drill__system {
    font-size: min(27px, 6.1vw);
    white-space: nowrap;
  }

  .bm-brandpick__n {
    align-self: flex-start;
    margin-inline-start: 2px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .bm-silos {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .bm-silo {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 64px;
    padding: 8px 2px;
    border: 0;
    border-bottom: 1px solid rgb(18 18 18 / 0.08);
    background: none;
    color: #121212;
    font: inherit;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .bm-silo[hidden] {
    display: none;
  }

  .bm-silo:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .bm-silo__media {
    flex: none;
    display: block;
    width: 72px;
    height: 42px;
  }

  .bm-silo__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .bm-silo__text {
    display: flex;
    flex: 1;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
  }

  .bm-silo__name {
    font-size: 22px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .bm-silo__count {
    font-size: 12px;
    font-weight: 600;
    color: rgb(18 18 18 / 0.5);
  }

  /* What's ticked, under the list: small tiles, tap one to untick it */
  .bm-picked {
    display: flex;
    gap: 5px;
    overflow-x: auto;
    padding: 10px 2px 2px;
    margin-top: 4px;
    border-top: 1px solid rgb(18 18 18 / 0.08);
    scrollbar-width: none;
  }

  .bm-picked::-webkit-scrollbar {
    display: none;
  }

  .bm-picked[hidden] {
    display: none;
  }

  .bm-picked__tile {
    flex: none;
    display: flex;
    align-items: center;
    gap: 4px;
    height: 26px;
    padding: 0 7px 0 3px;
    border: 0;
    border-radius: 999px;
    background: #121212;
    color: #ffffff;
    font: inherit;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
  }

  .bm-picked__tile img {
    display: block;
    width: 32px;
    height: 20px;
    padding: 1px 3px;
    border-radius: 999px;
    background: #ffffff;
    object-fit: contain;
  }

  .bm-picked__tile svg {
    width: 11px;
    height: 11px;
    opacity: 0.7;
  }

  .bm-silo__tick {
    flex: none;
    box-shadow: inset 0 0 0 2px rgb(18 18 18 / 0.2);
  }

  .bm-silo[aria-pressed='true'] .bm-silo__tick {
    box-shadow: none;
  }

  /* ---- Super Like ---- */
  .bm .bm-round--super {
    position: relative;
    width: 52px;
    height: 52px;
    color: #3897f0;
  }

  .bm .bm-round--super[data-state='locked'] {
    color: rgb(18 18 18 / 0.35);
  }

  .bm-round__badge {
    position: absolute;
    top: -4px;
    right: -4px;
    display: grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    background: #3897f0;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    box-shadow: 0 0 0 2px #ffffff;
  }

  .bm-round__badge:empty {
    display: none;
  }

  .bm-round--super[data-state='locked'] .bm-round__badge {
    background: #121212;
  }

  .bm-stamp--super {
    left: 50%;
    top: auto;
    bottom: 38%;
    color: #3897f0;
    transform: translateX(-50%) rotate(-4deg);
    white-space: nowrap;
  }

  .bm-superwin {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    padding: 10px 10px 10px 12px;
    border-radius: 16px;
    background: #eef6ff;
    box-shadow: inset 0 0 0 1.5px #3897f0;
  }

  .bm-superwin[hidden] {
    display: none;
  }

  .bm-superwin__star {
    flex: none;
    color: #3897f0;
  }

  .bm-superwin__img {
    flex: none;
    width: 56px;
    height: 38px;
    object-fit: contain;
  }

  .bm-superwin__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .bm-superwin__kicker {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #3897f0;
  }

  .bm-superwin__name {
    overflow: hidden;
    font-size: 14px;
    font-weight: 800;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .bm-superwin__deal {
    font-size: 12px;
    color: rgb(18 18 18 / 0.7);
  }

  .bm-superwin__claim {
    flex: none;
    padding: 8px 14px;
    border-radius: 999px;
    background: #3897f0;
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
  }

  /* ---- The welcome: the page darkens and blurs, the flame pops up and flickers ---- */
  .bm-intro {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
    color: #ffffff;
    font-family: var(--font-body--family);
  }

  .bm-intro::backdrop {
    background: transparent;
  }

  .bm-intro__scrim {
    position: absolute;
    inset: 0;
    background: rgb(6 6 6 / 0.7);
    will-change: opacity;
  }

  .bm-intro.is-settled .bm-intro__scrim {
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transition: -webkit-backdrop-filter 0.5s linear, backdrop-filter 0.5s linear;
  }

  .bm-intro__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    width: min(420px, 100%);
    height: 100%;
    margin: 0 auto;
    padding: calc(24px + env(safe-area-inset-top, 0px)) 24px calc(24px + env(safe-area-inset-bottom, 0px));
    text-align: center;
  }

  .bm-intro__x {
    position: absolute;
    top: calc(14px + env(safe-area-inset-top, 0px));
    right: 14px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    color: #ffffff;
    cursor: pointer;
  }

  .bm-intro__flame {
    position: relative;
    width: 128px;
  }

  .bm-intro__mark {
    width: 100%;
    filter: drop-shadow(0 6px 24px rgb(255 120 40 / 0.45));
  }

  /* The lines go white on the dark */
  .bm-intro__mark img {
    filter: invert(1);
  }

  /* Alive: a flicker from the base, the foil drifting faster, a warm glow breathing behind */
  .bm-intro__flame.is-alive .bm-intro__mark {
    transform-origin: 50% 100%;
    animation: bm-flicker 1.7s ease-in-out infinite;
  }

  .bm-intro__flame.is-alive .bm-mark__foil {
    animation-duration: 5s;
  }

  .bm-intro__glow {
    position: absolute;
    left: 50%;
    bottom: 4%;
    width: 170%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 140 40 / 0.45), rgb(255 80 40 / 0.12) 45%, rgb(255 80 40 / 0) 70%);
    transform: translateX(-50%);
    opacity: 0;
    pointer-events: none;
  }

  .bm-intro__flame.is-alive .bm-intro__glow {
    animation: bm-glow 1.9s ease-in-out infinite alternate;
  }

  .bm-intro__embers i {
    position: absolute;
    left: calc(18% + var(--i) * 8%);
    bottom: 30%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #ffc531;
    box-shadow: 0 0 6px #ff6a00;
    opacity: 0;
  }

  .bm-intro__flame.is-alive .bm-intro__embers i {
    animation: bm-ember 2.4s ease-out infinite;
    animation-delay: calc(var(--i) * 0.31s);
  }

  @keyframes bm-flicker {
    0%,
    100% {
      transform: scale(1, 1) skewX(0deg);
    }
    18% {
      transform: scale(0.97, 1.05) skewX(-2.5deg);
    }
    37% {
      transform: scale(1.02, 0.98) skewX(1.5deg);
    }
    58% {
      transform: scale(0.98, 1.04) skewX(2deg);
    }
    79% {
      transform: scale(1.01, 0.99) skewX(-1deg);
    }
