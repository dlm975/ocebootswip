<script type="module">
  import { animate, spring, stagger } from 'motion';

  const root = document.querySelector('[data-bm]');
  if (root && !root.dataset.ready) {
    root.dataset.ready = '1';

    const $ = (selector) => root.querySelector(selector);
    const $$ = (selector) => Array.from(root.querySelectorAll(selector));
    const dock = $('[data-bm-dock]');
    const tip = $('[data-bm-tip]');
    const dlg = $('[data-bm-dlg]');
    const panel = $('[data-bm-panel]');
    const scrim = $('.bm-scrim');
    const deck = $('[data-bm-deck]');
    const status = $('[data-bm-status]');
    const undoBtn = $('[data-bm-undo]');
    const backBtn = $('[data-bm-back]');
    const stepEl = $('[data-bm-step]');

    const EASE = [0.3, 0.7, 0.3, 1];
    const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const desktop = () => window.matchMedia('(min-width: 750px)').matches;
    const dur = (seconds) => (reduced() ? 0 : seconds);
    const LIKES_TO_MATCH = Math.max(2, Number(root.dataset.likesToMatch) || 4);
    const MAX_SWIPES = 16;
    const CURRENCY = root.dataset.currency || '';

    const store = {
      get(key) {
        try {
          return localStorage.getItem(key);
        } catch (e) {
          return null;
        }
      },
      set(key, value) {
        try {
          localStorage.setItem(key, value);
        } catch (e) {
          /* private mode: nothing remembered */
        }
      },
    };

    /* Money in the shopper's currency, with its own symbol ($, £, €...) */
    function money(units, decimals) {
      try {
        return new Intl.NumberFormat(undefined, {
          style: 'currency',
          currency: CURRENCY || 'NZD',
          currencyDisplay: 'narrowSymbol',
          minimumFractionDigits: decimals ? 2 : 0,
          maximumFractionDigits: decimals ? 2 : 0,
        }).format(units);
      } catch (e) {
        return '$' + (decimals ? Number(units).toFixed(2) : Math.round(units));
      }
    }

    /* The Super Like reward in the shopper's currency: exact in NZD; elsewhere the NZD amount at
       today's rate, rounded to a tidy figure (5s, or the like for big currencies) */
    const REWARD = Number(root.dataset.reward) || 25;
    const CODE = root.dataset.code || '';

    function rewardText() {
      const currency = CURRENCY || 'NZD';
      if (currency === 'NZD') return money(REWARD) + ' NZD';
      const rate = Number(window.Shopify && window.Shopify.currency && window.Shopify.currency.rate) || 1;
      const local = REWARD * rate;
      const step = local < 20 ? 1 : local < 200 ? 5 : 5 * Math.pow(10, Math.floor(Math.log10(local)) - 1);
      const tidy = Math.max(step, Math.round(local / step) * step);
      return 'about ' + money(tidy) + ' ' + currency;
    }

    // For headlines: "$25" in NZ; elsewhere "≈£10"
    function rewardShort() {
      const currency = CURRENCY || 'NZD';
      if (currency === 'NZD') return money(REWARD);
      return '≈' + rewardText().replace(/^about /, '').replace(' ' + currency, '');
    }

    /* The Super Like: locked until they leave an email or number, then one to use */
    const SUPER_KEY = 'oce-bm-super';
    function superState() {
      try {
        return JSON.parse(store.get(SUPER_KEY) || '{}');
      } catch (e) {
        return {};
      }
    }
    function setSuper(state) {
      store.set(SUPER_KEY, JSON.stringify(state));
      paintSuper();
    }
    function paintSuper() {
      const state = superState();
      const button = $('[data-bm-super]');
      const badge = $('[data-bm-super-badge]');
      if (state.status === 'ready') {
        button.dataset.state = 'ready';
        button.disabled = false;
        badge.textContent = '1';
        button.setAttribute('aria-label', 'Super Like this boot: ' + rewardText() + ' off');
      } else if (state.status === 'used') {
        button.dataset.state = 'used';
        button.disabled = true;
        badge.textContent = '';
        button.setAttribute('aria-label', 'Super Like used');
      } else {
        button.dataset.state = 'locked';
        button.disabled = false;
        badge.textContent = '+';
        button.setAttribute('aria-label', 'Unlock a Super Like');
      }
    }

    /* ---------- The launcher: pops in once the page has settled ---------- */
    setTimeout(() => {
      dock.classList.add('is-shown');
      if (!reduced()) {
        animate(dock, { opacity: [0, 1], transform: ['translateY(12px) scale(0.8)', 'none'] }, { duration: 0.55, ease: EASE });
      }
      if (!store.get('oce-bm-tip')) setTimeout(showTip, 1400);
    }, 1200);

    function showTip() {
      if (dlg.open) return;
      tip.hidden = false;
      animate(tip, { opacity: [0, 1], transform: ['translateX(8px)', 'none'] }, { duration: dur(0.55), ease: EASE });
      setTimeout(hideTip, 5000);
    }

    function hideTip() {
      if (tip.hidden) return;
      store.set('oce-bm-tip', '1');
      animate(tip, { opacity: 0 }, { duration: dur(0.2) }).finished.then(() => {
        tip.hidden = true;
      });
    }

    /* ---------- Boots: loaded from the feed when the game first opens ---------- */
    let boots = [];
    let loading = null;
    let fullyLoaded = false;

    function siloOf(gen) {
      if (!gen) return '';
      const parts = gen.split('-');
      let name = parts[1] || '';
      if (name === 'adipure') name = '11pro';
      if (name === 'total') name = 'total-90';
      return parts[0] + '-' + name;
    }

    // "US 9 - UK 8 - EU 42.5" -> { US: '9', UK: '8', EU: '42.5' }
    function sizeSet(label) {
      const set = {};
      String(label)
        .split(' - ')
        .forEach((part) => {
          const found = /^\s*(US|UK|EU)\s+(.+?)\s*$/i.exec(part);
          if (found) set[found[1].toUpperCase()] = found[2];
        });
      return set;
    }

    // FG (and HG) is firm grass, AG and TF are turf, SG is soft grass; FG/AG counts for both
    function groundsOf(title) {
      const text = ' ' + String(title).toUpperCase().replace(/[-\/]/g, ' ') + ' ';
      const found = [];
      if (/ (FG|HG) /.test(text)) found.push('fg');
      if (/ (AG|TF) /.test(text)) found.push('ag');
      if (/ SG /.test(text)) found.push('sg');
      return found;
    }

    function prepare(item) {
      const brand = (item.t.split(' ')[0] || '').toLowerCase();
      const units = (item.p || 0) / 100;
      return {
        handle: item.h,
        title: item.t,
        url: item.u,
        image: item.i,
        price: item.m,
        units: units,
        was: (item.c || 0) / 100,
        off: item.o || 0,
        sale: item.o > 0 ? 'yes' : 'no',
        labels: item.s || [],
        grounds: groundsOf(item.t),
        sizes: (item.s || []).map(sizeSet),
        condition: item.k || '',
        silo: siloOf(item.g) || brand,
        line: item.g ? item.g.replace(/-\d+$/, '') : brand,
        brand: brand,
        band: units > 0 ? Math.round(Math.log2(units / 50) * 2) : 0,
      };
    }

    async function fetchPage(page) {
      const response = await fetch(root.dataset.feed + '&page=' + page, { credentials: 'same-origin' });
      if (!response.ok) throw new Error('Boot Match feed: ' + response.status);
      return response.json();
    }

    function load() {
      if (loading) return loading;
      loading = fetchPage(1).then((first) => {
        boots = first.items.filter((item) => item.i).map(prepare);
        const pages = Math.min(first.pages || 1, 8);
        (async () => {
          for (let page = 2; page <= pages; page++) {
            try {
              const next = await fetchPage(page);
              boots = boots.concat(next.items.filter((item) => item.i).map(prepare));
              refresh();
            } catch (e) {
              break;
            }
          }
          fullyLoaded = true;
          refresh();
        })();
      });
      loading.catch(() => {
        loading = null;
      });
      return loading;
    }

    /* ---------- The shopper's answers ---------- */
    let system = store.get('oce-bm-system') || 'US';
    // Sizes picked (several allowed), as whole or half sizes: thirds count with the nearest whole
    let sizeValues = (store.get('oce-bm-sizes') || '').split(',').filter(Boolean);
    let priceLo = null;
    let priceHi = null;
    let picked = (store.get('oce-bm-silos') || '').split(',').filter(Boolean);
    let grounds = (store.get('oce-bm-grounds') || '').split(',').filter(Boolean);

    function numeric(value) {
      const [whole, fraction] = String(value).split(' ');
      let n = parseFloat(whole) || 0;
      if (fraction && fraction.includes('/')) {
        const [a, b] = fraction.split('/');
        n += Number(a) / Number(b);
      }
      return n;
    }

    // A size as a chip: EU 41⅓ goes with 41 and 41⅔ with 42 (as the site's size filter); halves stay
    function sizeKey(value) {
      const n = numeric(value);
      const part = n - Math.floor(n);
      const rounded = Math.abs(part - 1 / 3) < 0.02 ? Math.floor(n) : Math.abs(part - 2 / 3) < 0.02 ? Math.ceil(n) : n;
      return String(Math.round(rounded * 2) / 2);
    }

    // A boot fits a picked size when its size in the chosen system is within a third of it
    const near = (value, key) => Math.abs(numeric(value) - Number(key)) <= 0.34;
    const sizeIn = (set) => Boolean(set[system]) && sizeValues.some((key) => near(set[system], key));
    const inSize = (boot) => !sizeValues.length || boot.sizes.some(sizeIn);
    const inPrice = (boot) => (priceLo === null || boot.units >= priceLo) && (priceHi === null || boot.units <= priceHi);
    const inSilos = (boot) => !picked.length || picked.includes(boot.silo);
    // Ground: a boot whose soleplate isn't named in its title counts for any ground
    const inGround = (boot) => !grounds.length || !boot.grounds.length || grounds.some((ground) => boot.grounds.includes(ground));
    const eligible = (boot) => inSize(boot) && inGround(boot) && inPrice(boot) && inSilos(boot);

    const pretty = (key) => String(key).replace('.5', '½');
    const sizeText = () => sizeValues.map((key) => system + ' ' + pretty(key)).join(', ');

    function saveSizes() {
      store.set('oce-bm-system', system);
      store.set('oce-bm-sizes', sizeValues.join(','));
    }

    /* 1. Size: US / UK / EU, then the sizes in stock in that system (pick one or more) */
    const sizePick = $('.bm-sizepick');
    const sizeList = $('[data-bm-sizes]');

    function markSizes() {
      $$('.bm-sizepick .size-drill__size').forEach((button) => {
        button.setAttribute('aria-pressed', String(sizeValues.includes(button.dataset.value)));
      });
      sizePick.toggleAttribute('data-picked', sizeValues.length > 0);
      $('[data-bm-anysize]').setAttribute('aria-pressed', String(!sizeValues.length));
      updateClear();
    }

    function renderSizes(animated) {
      $$('[data-bm-system]').forEach((button) => {
        button.setAttribute('aria-expanded', String(button.dataset.bmSystem === system));
      });
      const counts = new Map();
      boots.forEach((boot) => {
        const keys = new Set(boot.sizes.map((set) => set[system] && sizeKey(set[system])).filter(Boolean));
        keys.forEach((key) => counts.set(key, (counts.get(key) || 0) + 1));
      });
      const keys = Array.from(counts.keys()).sort((a, b) => Number(a) - Number(b));
      if (fullyLoaded) sizeValues = sizeValues.filter((key) => counts.has(key));
      sizeList.replaceChildren();
      keys.forEach((key) => {
        const item = document.createElement('li');
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'size-drill__size';
        button.dataset.value = key;
        button.setAttribute('aria-label', system + ' ' + key + ', ' + counts.get(key) + ' boots');
        const shown = document.createElement('span');
        shown.className = 'size-drill__value';
        shown.textContent = pretty(key);
        const count = document.createElement('span');
        count.className = 'size-drill__count';
        count.textContent = counts.get(key);
        button.append(shown, count);
        item.appendChild(button);
        sizeList.appendChild(item);
      });
      if (!keys.length) {
        const item = document.createElement('li');
        item.className = 'bm-step__count';
        item.textContent = 'Loading sizes…';
        sizeList.appendChild(item);
      }
      markSizes();
      if (animated && !reduced()) {
        animate(sizeList, { opacity: [0, 1], transform: ['translateY(-12px)', 'none'] }, { duration: 0.55, ease: EASE });
      }
    }

    // The most common size in another system for boots of this size (US 9 -> UK 8)
    function convert(key, from, to) {
      const tally = new Map();
      boots.forEach((boot) =>
        boot.sizes.forEach((set) => {
          if (set[from] && set[to] && Math.abs(numeric(set[from]) - Number(key)) <= 0.34) {
            const other = sizeKey(set[to]);
            tally.set(other, (tally.get(other) || 0) + 1);
          }
        })
      );
      let best = '';
      let most = 0;
      tally.forEach((n, other) => {
        if (n > most) {
          most = n;
          best = other;
        }
      });
      return best;
    }

    $$('[data-bm-system]').forEach((button) => {
      button.addEventListener('click', () => {
        const next = button.dataset.bmSystem;
        if (next === system) return;
        sizeValues = Array.from(new Set(sizeValues.map((key) => convert(key, system, next)).filter(Boolean)));
        system = next;
        saveSizes();
        renderSizes(true);
      });
    });

    sizeList.addEventListener('click', (event) => {
      const button = event.target.closest('[data-value]');
      if (!button) return;
      const key = button.dataset.value;
      sizeValues = sizeValues.includes(key) ? sizeValues.filter((other) => other !== key) : sizeValues.concat(key);
      saveSizes();
      markSizes();
    });

    $('[data-bm-anysize]').addEventListener('click', () => {
      sizeValues = [];
      saveSizes();
      renderSizes(false);
      go('ground');
    });

    /* Clear all, on each step */
    function updateClear() {
      const has = {
        size: sizeValues.length > 0,
        ground: grounds.length > 0,
        price: priceLo !== null || priceHi !== null,
        silos: picked.length > 0,
      };
      $$('[data-bm-clear]').forEach((button) => {
        button.hidden = !has[button.dataset.bmClear];
      });
    }

    $$('[data-bm-clear]').forEach((button) => {
      button.addEventListener('click', () => {
        const step = button.dataset.bmClear;
        if (step === 'size') {
          sizeValues = [];
          saveSizes();
          renderSizes(false);
        } else if (step === 'ground') {
          grounds = [];
          store.set('oce-bm-grounds', '');
          renderGrounds();
        } else if (step === 'price') {
          priceLo = null;
          priceHi = null;
          renderPrice();
        } else if (step === 'silos') {
          picked = [];
          store.set('oce-bm-silos', '');
          renderSilos();
        }
        updateClear();
      });
    });

    /* 2. Ground */
    function renderGrounds() {
      $$('.bm-ground').forEach((tile) => {
        const key = tile.dataset.ground;
        const n = boots.filter((boot) => inSize(boot) && boot.grounds.includes(key)).length;
        tile.setAttribute('aria-pressed', String(grounds.includes(key)));
        tile.disabled = fullyLoaded && n === 0 && !grounds.includes(key);
        tile.querySelector('[data-bm-ground-count]').textContent = boots.length ? n + (n === 1 ? ' boot' : ' boots') : '…';
      });
      $('[data-bm-anyground]').setAttribute('aria-pressed', String(!grounds.length));
      updateClear();
    }

    $('[data-bm-grounds]').addEventListener('click', (event) => {
      const tile = event.target.closest('.bm-ground');
      if (!tile || tile.disabled) return;
      const key = tile.dataset.ground;
      grounds = grounds.includes(key) ? grounds.filter((other) => other !== key) : grounds.concat(key);
      store.set('oce-bm-grounds', grounds.join(','));
      if (!reduced() && grounds.includes(key)) {
        animate(tile.querySelector('.bm-ground__media'), { transform: ['scale(0.95)', 'none'] }, { type: spring, visualDuration: 0.3, bounce: 0.4 });
      }
      renderGrounds();
    });

    $('[data-bm-anyground]').addEventListener('click', () => {
      grounds = [];
      store.set('oce-bm-grounds', '');
      go('price');
    });

    /* 3. Price: a slider over a chart of how many boots sit at each price */
    const minInput = $('[data-bm-min]');
    const maxInput = $('[data-bm-max]');
    const fillEl = $('[data-bm-fill]');
    const hist = $('[data-bm-hist]');
    const BINS = 24;
    let bounds = { lo: 0, hi: 0, step: 10 };

    function renderPrice() {
      const pool = boots.filter((boot) => inSize(boot) && inGround(boot));
      const prices = pool.map((boot) => boot.units).filter((n) => n > 0);
      if (!prices.length) {
        $('[data-bm-price-label]').textContent = boots.length ? 'No boots in that size yet' : 'Loading…';
        $('[data-bm-price-count]').textContent = '';
        hist.replaceChildren();
        return;
      }
      const min = Math.min(...prices);
      const max = Math.max(...prices);
      const spread = max - min;
      const step = spread <= 300 ? 5 : spread <= 1500 ? 10 : spread <= 4000 ? 25 : 50;
      const lo = Math.floor(min / step) * step;
      const hi = Math.max(lo + step, Math.ceil(max / step) * step);
      bounds = { lo, hi, step };
      [minInput, maxInput].forEach((input) => {
        input.min = lo;
        input.max = hi;
        input.step = step;
      });
      minInput.value = priceLo === null ? lo : Math.max(lo, Math.min(priceLo, hi));
      maxInput.value = priceHi === null ? hi : Math.min(hi, Math.max(priceHi, lo));

      // The chart: boots per slice of the price range
      const bins = new Array(BINS).fill(0);
      prices.forEach((n) => {
        bins[Math.min(BINS - 1, Math.floor(((n - lo) / (hi - lo)) * BINS))] += 1;
      });
      const tallest = Math.max(...bins, 1);
      hist.replaceChildren();
      bins.forEach((n, index) => {
        const bar = document.createElement('span');
        bar.className = 'bm-hist__bar';
        bar.style.height = Math.max(3, (n / tallest) * 100) + '%';
        bar.dataset.from = String(lo + ((hi - lo) * index) / BINS);
        bar.dataset.to = String(lo + ((hi - lo) * (index + 1)) / BINS);
        hist.appendChild(bar);
      });
      updatePrice();
    }

    function updatePrice() {
      let low = Number(minInput.value);
      let high = Number(maxInput.value);
      if (low > high - bounds.step) {
        if (document.activeElement === minInput) {
          low = high - bounds.step;
          minInput.value = low;
        } else {
          high = low + bounds.step;
          maxInput.value = high;
        }
      }
      priceLo = low <= bounds.lo ? null : low;
      priceHi = high >= bounds.hi ? null : high;
      const span = bounds.hi - bounds.lo || 1;
      fillEl.style.left = ((low - bounds.lo) / span) * 100 + '%';
      fillEl.style.right = (1 - (high - bounds.lo) / span) * 100 + '%';
      $$('.bm-hist__bar').forEach((bar) => {
        bar.classList.toggle('is-in', Number(bar.dataset.to) > low && Number(bar.dataset.from) < high);
      });
      $('[data-bm-price-label]').textContent =
        money(low) + ' – ' + money(high) + (priceHi === null ? '+' : '') + (CURRENCY ? ' ' + CURRENCY : '');
      const count = boots.filter((boot) => inSize(boot) && inGround(boot) && inPrice(boot)).length;
      $('[data-bm-price-count]').textContent =
        count + (count === 1 ? ' boot' : ' boots') + (sizeValues.length ? ' in ' + sizeText() : '') + ' at this price';
      $('[data-bm-next="silos"]').disabled = count === 0;
      updateClear();
    }

    minInput.addEventListener('input', updatePrice);
    maxInput.addEventListener('input', updatePrice);

    /* 4. Favourite silos: one brand's silos at a time */
    const silosEl = $('[data-bm-silos]');
    let brand = '';

    function showBrand(next, animated) {
      brand = next;
      $$('[data-bm-brand]').forEach((button) => button.setAttribute('aria-expanded', String(button.dataset.bmBrand === brand)));
      $$('.bm-silo').forEach((row) => {
        row.hidden = row.dataset.brand !== brand;
      });
      silosEl.scrollTop = 0;
      if (animated && !reduced()) {
        animate(silosEl, { opacity: [0, 1], transform: ['translateY(-12px)', 'none'] }, { duration: 0.55, ease: EASE });
      }
    }

    function renderSilos() {
      const counts = new Map();
      boots.forEach((boot) => {
        if (inSize(boot) && inGround(boot) && inPrice(boot)) counts.set(boot.silo, (counts.get(boot.silo) || 0) + 1);
      });
      if (fullyLoaded) picked = picked.filter((silo) => counts.get(silo));
      const perBrand = new Map();
      $$('.bm-silo').forEach((row) => {
        const n = counts.get(row.dataset.silo) || 0;
        const on = picked.includes(row.dataset.silo);
        row.setAttribute('aria-pressed', String(on));
        row.disabled = n === 0 && !on && fullyLoaded;
        row.querySelector('[data-bm-silo-count]').textContent = n ? String(n) : fullyLoaded ? 'none' : '…';
        if (on) perBrand.set(row.dataset.brand, (perBrand.get(row.dataset.brand) || 0) + 1);
      });
      $$('[data-bm-brand]').forEach((button) => {
        const n = perBrand.get(button.dataset.bmBrand) || 0;
        button.querySelector('[data-bm-brand-n]').textContent = n ? String(n) : '';
      });
      // Open on the brand of their first pick, or the brand with the most boots
      if (!brand) {
        const first = picked[0] ? picked[0].split('-')[0] : '';
        let most = 'nike';
        let mostN = -1;
        ['nike', 'adidas', 'puma', 'mizuno'].forEach((name) => {
          let n = 0;
          counts.forEach((count, silo) => {
            if (silo.startsWith(name + '-')) n += count;
          });
          if (n > mostN) {
            mostN = n;
            most = name;
          }
        });
        showBrand(first || most, false);
      }
      const start = $('[data-bm-start]');
      start.textContent = picked.length ? 'Start swiping' : 'Tick a silo';
      start.disabled = !picked.length;
      renderPicked();
      updateClear();
    }

    function renderPicked() {
      const strip = $('[data-bm-picked]');
      strip.replaceChildren();
      picked.forEach((silo) => {
        const row = $('.bm-silo[data-silo="' + silo + '"]');
        if (!row) return;
        const tile = el('button', 'bm-picked__tile');
        tile.type = 'button';
        tile.dataset.silo = silo;
        const name = row.querySelector('.bm-silo__name').textContent;
        tile.setAttribute('aria-label', 'Untick ' + name);
        const img = row.querySelector('img').cloneNode();
        img.removeAttribute('loading');
        img.alt = '';
        tile.append(img, el('span', '', name), closeIcon.cloneNode(true));
        strip.appendChild(tile);
      });
      strip.hidden = picked.length === 0;
      // The newest tile in view
      strip.scrollLeft = strip.scrollWidth;
    }

    // The close icon from the window's own close button
    const closeIcon = $('.bm-head__close svg').cloneNode(true);

    $('[data-bm-picked]').addEventListener('click', (event) => {
      const tile = event.target.closest('.bm-picked__tile');
      if (!tile) return;
      picked = picked.filter((silo) => silo !== tile.dataset.silo);
      store.set('oce-bm-silos', picked.join(','));
      renderSilos();
    });

    $$('[data-bm-brand]').forEach((button) => {
      button.addEventListener('click', () => {
        if (button.dataset.bmBrand !== brand) showBrand(button.dataset.bmBrand, true);
      });
    });

    silosEl.addEventListener('click', (event) => {
      const tile = event.target.closest('.bm-silo');
      if (!tile || tile.disabled) return;
      const silo = tile.dataset.silo;
      if (picked.includes(silo)) {
        picked = picked.filter((other) => other !== silo);
      } else {
        picked.push(silo);
        if (!reduced()) animate(tile.querySelector('.bm-silo__tick'), { transform: ['scale(0.6)', 'none'] }, { type: spring, visualDuration: 0.3, bounce: 0.45 });
      }
      store.set('oce-bm-silos', picked.join(','));
      renderSilos();
    });

    $('[data-bm-anysilo]').addEventListener('click', () => {
      picked = [];
      store.set('oce-bm-silos', '');
      start();
    });

    /* ---------- Learning what the shopper likes, within their answers ---------- */
    let taste;
    let seen;
    let liked;
    let history;
    let swipes;
    let target;

    function reset() {
      taste = { silo: {}, line: {}, brand: {}, condition: {}, band: {}, sale: {} };
      seen = new Set();
      liked = [];
      history = [];
      swipes = 0;
      target = LIKES_TO_MATCH;
    }
    reset();

    // How much each thing counts. Liking sale boots raises "sale" and pulls the price band down,
    // so a shopper who keeps liking sale boots is shown more sale boots, and cheaper ones.
    const WEIGHTS = { silo: 3, line: 1.5, brand: 1, condition: 0.8, band: 1, sale: 1.4 };

    function learn(boot, amount) {
      Object.keys(WEIGHTS).forEach((key) => {
        const value = boot[key];
        taste[key][value] = (taste[key][value] || 0) + amount;
      });
      // Neighbouring price bands count a little too, so a budget emerges rather than exact prices
      [-1, 1].forEach((offset) => {
        const near = boot.band + offset;
        taste.band[near] = (taste.band[near] || 0) + amount * 0.4;
      });
    }

    function fit(boot) {
      let total = 0;
      Object.keys(WEIGHTS).forEach((key) => {
        total += WEIGHTS[key] * (taste[key][boot[key]] || 0);
      });
      return total;
    }

    // Beyond the answers, closest first: other silos at their price, then any price; always their size
    const pickedBrands = () => new Set(picked.map((silo) => silo.split('-')[0]));

    function nearest(exclude) {
      const open = (boot) => inSize(boot) && !seen.has(boot.handle) && !exclude.has(boot.handle);
      let pool = boots.filter((boot) => open(boot) && inGround(boot) && inPrice(boot));
      if (!pool.length) pool = boots.filter((boot) => open(boot) && inGround(boot));
      if (!pool.length) pool = boots.filter(open);
      if (!pool.length) return null;
      const brands = pickedBrands();
      let best = null;
      let bestScore = -Infinity;
      pool.forEach((boot) => {
        const score = fit(boot) + (brands.has(boot.brand) ? 1 : 0) + Math.random() * 0.6;
        if (score > bestScore) {
          bestScore = score;
          best = boot;
        }
      });
      return best;
    }

    function pickNext(exclude) {
      const pool = boots.filter((boot) => eligible(boot) && !seen.has(boot.handle) && !exclude.has(boot.handle));
      if (!pool.length) return fullyLoaded ? nearest(exclude) : null;
      // First few (or nothing liked yet): take turns between the chosen silos
      if (liked.length === 0 || swipes < 3) {
        const recent = new Set(history.slice(-Math.max(1, picked.length - 1)).map((step) => step.boot.silo));
        const fresh = pool.filter((boot) => !recent.has(boot.silo));
        const from = fresh.length ? fresh : pool;
        return from[Math.floor(Math.random() * from.length)];
      }
      // Then lean towards what's liked, with one in four a wildcard so it stays fun
      if (Math.random() < 0.25) return pool[Math.floor(Math.random() * pool.length)];
      const sample = pool.length > 150 ? pool.slice().sort(() => Math.random() - 0.5).slice(0, 150) : pool;
      let best = null;
      let bestScore = -Infinity;
      sample.forEach((boot) => {
        const score = fit(boot) + Math.random() * 1.2;
        if (score > bestScore) {
          bestScore = score;
          best = boot;
        }
      });
      return best;
    }

    function bestMatch() {
      const likedHandles = new Set(liked.map((boot) => boot.handle));
      let best = null;
      let bestScore = -Infinity;
      const pool = boots.filter(eligible);
      (pool.length ? pool : boots.filter(inSize)).forEach((boot) => {
        const score = fit(boot) + (likedHandles.has(boot.handle) ? 0.5 : 0);
        if (score > bestScore) {
          bestScore = score;
          best = boot;
        }
      });
      return best || liked[0] || null;
    }

    /* ---------- Cards ---------- */
    function el(tag, className, text) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    function priceLine(boot, className) {
      const line = el('p', className);
      line.appendChild(el('span', '', boot.price));
      if (boot.off > 0 && boot.was > 0) {
        line.append(' ', el('s', 'bm-was', money(boot.was, true)));
        // Red bold "% off", as on the product page
        line.append(' ', el('span', 'bm-off', boot.off + '% off'));
      }
      return line;
    }

    function metaText(boot) {
      const parts = [];
      if (boot.condition) parts.push(boot.condition);
      const index = sizeValues.length ? boot.sizes.findIndex(sizeIn) : 0;
      const label = boot.labels[index >= 0 ? index : 0];
      if (label) parts.push(label.replace(/\s*-\s*/g, ' · '));
      return parts.join(' · ');
    }

    function cardFor(boot) {
      const card = el('article', 'bm-card');
      card.dataset.handle = boot.handle;
      card.setAttribute('aria-label', boot.title + (boot.off ? ', ' + boot.off + '% off' : ''));

      const media = el('div', 'bm-card__media');
      const img = el('img');
      img.src = boot.image;
      img.alt = boot.title;
      img.width = 640;
      img.height = 640;
      img.draggable = false;
      img.decoding = 'async';
      media.appendChild(img);

      const info = el('div', 'bm-card__info');
      if (!eligible(boot)) {
        const why = !inGround(boot) ? 'Other ground' : !inPrice(boot) ? 'Outside your price' : 'Outside your silos';
        info.appendChild(el('p', 'bm-card__note', why + ' · close to what you like'));
      }
      info.append(el('h3', 'bm-card__name', boot.title), el('p', 'bm-card__meta', metaText(boot)), priceLine(boot, 'bm-card__price'));

      const like = el('span', 'bm-stamp bm-stamp--like', 'LOVE');
      like.setAttribute('aria-hidden', 'true');
      const nope = el('span', 'bm-stamp bm-stamp--nope', 'PASS');
      nope.setAttribute('aria-hidden', 'true');
      const superStamp = el('span', 'bm-stamp bm-stamp--super', 'SUPER LIKE');
      superStamp.setAttribute('aria-hidden', 'true');

      card.append(media, info, like, nope, superStamp);
      card._boot = boot;
      return card;
    }

    const STACK = [
      { transform: 'none', opacity: 1 },
      { transform: 'translateY(10px) scale(0.955)', opacity: 1 },
      { transform: 'translateY(20px) scale(0.91)', opacity: 0.9 },
    ];

    const cards = () => Array.from(deck.querySelectorAll('.bm-card:not(.is-leaving):not(.bm-card--empty)'));

    function layout(animated) {
      cards().forEach((card, index) => {
        card.style.zIndex = String(10 - index);
        card.classList.toggle('is-top', index === 0);
        const place = STACK[Math.min(index, STACK.length - 1)];
        if (animated && !reduced()) {
          animate(card, place, { duration: 0.4, ease: EASE });
        } else {
          card.style.transform = place.transform;
          card.style.opacity = String(place.opacity);
        }
      });
      undoBtn.disabled = history.length === 0;
    }

    function fill() {
      deck.querySelectorAll('.bm-card--empty').forEach((note) => note.remove());
      const showing = new Set(cards().map((card) => card.dataset.handle));
      while (cards().length < 3) {
        const boot = pickNext(showing);
        if (!boot) break;
        showing.add(boot.handle);
        const card = cardFor(boot);
        card.style.transform = STACK[2].transform;
        card.style.opacity = '0';
        deck.appendChild(card);
      }
      if (!cards().length) {
        const empty = el(
          'div',
          'bm-card bm-card--empty',
          fullyLoaded ? (liked.length ? 'That’s every boot in your size. Here’s your match.' : 'That’s every boot in your size. Try more sizes.') : 'Loading more boots…'
        );
        deck.appendChild(empty);
        if (fullyLoaded && liked.length) setTimeout(showMatch, 900);
      }
      layout(true);
      updateStatus();
    }

    function updateStatus() {
      const left = Math.max(0, target - liked.length);
      status.textContent =
        liked.length === 0
          ? 'Swipe right on boots you love'
          : left > 0
            ? left + (left === 1 ? ' more like' : ' more likes') + ' to find your match'
            : 'Your match is ready';
    }

    /* ---------- Swiping ---------- */
    let flying = null;

    function decide(card, liking, isSuper) {
      const boot = card._boot;
      seen.add(boot.handle);
      swipes += 1;
      history.push({ boot: boot, liked: liking, super: Boolean(isSuper) });
      if (isSuper) {
        liked.push(boot);
        learn(boot, 2);
        setSuper({ status: 'used', handle: boot.handle, title: boot.title, url: boot.url, image: boot.image });
      } else if (liking) {
        liked.push(boot);
        learn(boot, 1);
      } else {
        learn(boot, -0.6);
      }
      updateStatus();
    }

    // Enough likes (or a long run of swipes with some): ask, rather than ending the game
    let askedAt = 0;
    const askEl = $('[data-bm-ask]');
    const asking = () => !askEl.hidden;

    function afterDecision() {
      fill();
      const ready = liked.length >= target || (swipes >= askedAt + MAX_SWIPES && liked.length > 0);
      if (ready) ask();
    }

    function ask() {
      askedAt = swipes;
      $('[data-bm-ask-title]').textContent = 'You’ve liked ' + liked.length + (liked.length === 1 ? ' boot' : ' boots');
      askEl.hidden = false;
      if (!reduced()) {
        animate(askEl, { opacity: [0, 1] }, { duration: 0.25 });
        animate($('.bm-ask__card'), { transform: ['translateY(24px)', 'none'], opacity: [0, 1] }, { duration: 0.55, ease: EASE });
      }
      $('[data-bm-shop]').focus({ preventScroll: true });
    }

    function unask() {
      if (!asking()) return;
      if (reduced()) {
        askEl.hidden = true;
        return;
      }
      animate(askEl, { opacity: 0 }, { duration: 0.2 }).finished.then(() => {
        askEl.hidden = true;
        askEl.style.opacity = '';
      });
    }

    $('[data-bm-keep]').addEventListener('click', () => {
      target = liked.length + 3;
      unask();
      updateStatus();
    });

    $('[data-bm-shop]').addEventListener('click', () => {
      askEl.hidden = true;
      showMatch();
    });

    function stamps(card, x) {
      const amount = Math.max(-1, Math.min(1, x / 110));
      card.querySelector('.bm-stamp--like').style.opacity = String(Math.max(0, amount));
      card.querySelector('.bm-stamp--nope').style.opacity = String(Math.max(0, -amount));
    }

    function fling(card, liking, from) {
      const start = from || { x: 0, y: 0 };
      const direction = liking ? 1 : -1;
      card.classList.add('is-leaving');
      card.classList.remove('is-top');
      decide(card, liking);
      stamps(card, direction * 110);
      const done = () => {
        card.remove();
        flying = null;
        afterDecision();
      };
      if (reduced()) {
        done();
        return;
      }
      const distance = Math.max(window.innerWidth, 500) * direction;
      flying = animate(
        card,
        {
          transform: [
            'translate(' + start.x + 'px,' + start.y + 'px) rotate(' + start.x * 0.06 + 'deg)',
            'translate(' + distance + 'px,' + (start.y + 40) + 'px) rotate(' + direction * 28 + 'deg)',
          ],
        },
        { duration: 0.32, ease: [0.4, 0, 1, 1] }
      );
      flying.finished.then(done);
      layout(true);
    }

    function superLike() {
      if (asking()) return;
      const state = superState();
      if (state.status === 'used') return;
      if (state.status !== 'ready') {
        offer(true);
        return;
      }
      if (flying) flying.complete();
      const card = cards()[0];
      if (!card || !card._boot) return;
      card.classList.add('is-leaving');
      card.classList.remove('is-top');
      decide(card, true, true);
      card.querySelector('.bm-stamp--super').style.opacity = '1';
      status.textContent = 'Super Like! ' + rewardText() + ' off this boot, on your match screen';
      const done = () => {
        card.remove();
        flying = null;
        afterDecision();
      };
      if (reduced()) {
        done();
        return;
      }
      flying = animate(
        card,
        { transform: ['none', 'translateY(-14px) scale(1.04)', 'translateY(-130%) scale(0.9)'] },
        { duration: 0.6, ease: [0.4, 0, 0.6, 1], times: [0, 0.3, 1] }
      );
      flying.finished.then(done);
      layout(true);
    }

    $('[data-bm-super]').addEventListener('click', superLike);

    function choose(liking) {
      if (asking()) return;
      if (flying) flying.complete();
      const card = cards()[0];
      if (card && card._boot) fling(card, liking);
    }

    $('[data-bm-like]').addEventListener('click', () => choose(true));
    $('[data-bm-nope]').addEventListener('click', () => choose(false));

    undoBtn.addEventListener('click', () => {
      if (flying) flying.complete();
      const step = history.pop();
      if (!step) return;
      seen.delete(step.boot.handle);
      swipes = Math.max(0, swipes - 1);
      if (step.super) {
        setSuper({ status: 'ready' });
        learn(step.boot, -1);
      }
      if (step.liked) {
        liked = liked.filter((boot) => boot.handle !== step.boot.handle);
        learn(step.boot, -1);
      } else {
        learn(step.boot, 0.6);
      }
      const card = cardFor(step.boot);
      deck.querySelectorAll('.bm-card--empty').forEach((note) => note.remove());
      deck.prepend(card);
      cards()
        .slice(3)
        .forEach((spare) => spare.remove());
      layout(true);
      if (!reduced()) {
        const side = step.liked ? 1 : -1;
        animate(card, { transform: ['translateX(' + side * 420 + 'px) rotate(' + side * 20 + 'deg)', 'none'], opacity: [0, 1] }, { duration: 0.55, ease: EASE });
      }
      updateStatus();
    });

    let drag = null;

    deck.addEventListener('pointerdown', (event) => {
      const card = event.target.closest('.bm-card.is-top');
      if (!card || !card._boot || event.button > 0 || asking()) return;
      if (flying) flying.complete();
      card.getAnimations().forEach((animation) => animation.cancel());
      card.setPointerCapture(event.pointerId);
      card.classList.add('is-dragging');
      drag = { card: card, id: event.pointerId, x0: event.clientX, y0: event.clientY, x: 0, y: 0, t: performance.now(), vx: 0 };
    });

    deck.addEventListener('pointermove', (event) => {
      if (!drag || event.pointerId !== drag.id) return;
      const x = event.clientX - drag.x0;
      const y = event.clientY - drag.y0;
      const now = performance.now();
      drag.vx = (x - drag.x) / Math.max(1, now - drag.t);
      drag.x = x;
      drag.y = y;
      drag.t = now;
      drag.card.style.transform = 'translate(' + x + 'px,' + y + 'px) rotate(' + (reduced() ? 0 : x * 0.06) + 'deg)';
      stamps(drag.card, x);
    });

    function endDrag(event) {
      if (!drag || event.pointerId !== drag.id) return;
      const { card, x, y, vx } = drag;
      drag = null;
      card.classList.remove('is-dragging');
      const far = Math.abs(x) > Math.min(120, deck.clientWidth * 0.3);
      const fast = Math.abs(vx) > 0.6 && Math.abs(x) > 30;
      if (far || fast) {
        fling(card, (fast ? vx : x) > 0, { x: x, y: y });
        return;
      }
      stamps(card, 0);
      if (reduced()) {
        card.style.transform = 'none';
        return;
      }
      animate(
        card,
        { transform: ['translate(' + x + 'px,' + y + 'px) rotate(' + x * 0.06 + 'deg)', 'translate(0px,0px) rotate(0deg)'] },
        { type: spring, visualDuration: 0.35, bounce: 0.3 }
      );
    }

    deck.addEventListener('pointerup', endDrag);
    deck.addEventListener('pointercancel', endDrag);

    dlg.addEventListener('keydown', (event) => {
      if ($('[data-bm-screen="play"]').hidden) return;
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        choose(true);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        choose(false);
      }
    });

    /* ---------- Screens ---------- */
    const STEPS = { size: '1/4', ground: '2/4', price: '3/4', silos: '4/4' };
    const BACK = { ground: 'size', price: 'ground', silos: 'price', play: 'silos' };
    let screen = 'size';

    function render(name) {
      if (name === 'size') renderSizes(false);
      if (name === 'ground') renderGrounds();
      if (name === 'price') renderPrice();
      if (name === 'silos') renderSilos();
    }

    function go(name, quiet) {
      screen = name;
      $$('[data-bm-screen]').forEach((node) => {
        node.hidden = node.dataset.bmScreen !== name;
      });
      stepEl.textContent = STEPS[name] || '';
      backBtn.hidden = !BACK[name];
      render(name);
      const node = $('[data-bm-screen="' + name + '"]');
      if (!quiet && !reduced()) animate(node, { opacity: [0, 1], transform: ['translateX(16px)', 'none'] }, { duration: 0.4, ease: EASE });
    }

    // Boots arriving while the window is still sliding in wait until it has settled
    let opening = null;

    function refresh() {
      if (!dlg.open) return;
      if (opening) {
        opening.then(refresh);
        return;
      }
      if (screen === 'size') renderSizes(false);
      if (screen === 'ground') renderGrounds();
      if (screen === 'price') renderPrice();
      if (screen === 'silos') renderSilos();
      if (screen === 'play' && cards().length < 3) fill();
    }

    $$('[data-bm-next]').forEach((button) => button.addEventListener('click', () => go(button.dataset.bmNext)));
    backBtn.addEventListener('click', () => go(BACK[screen] || 'size'));

    async function start() {
      reset();
      askedAt = 0;
      askEl.hidden = true;
      deck.replaceChildren();
      go('play');
      if (!boots.length) {
        status.textContent = 'Loading boots…';
        try {
          await load();
        } catch (e) {
          status.textContent = 'Couldn’t load the boots. Please try again.';
          return;
        }
      }
      fill();
    }

    $('[data-bm-start]').addEventListener('click', start);

    // The big card: one boot's photo, name, size and price, linking to it
    function showInCard(boot, animated) {
      $('[data-bm-match-link]').href = boot.url;
      $('[data-bm-match-cta]').href = boot.url;
      const img = $('[data-bm-match-img]');
      img.src = boot.image;
      img.alt = boot.title;
      $('[data-bm-match-title]').textContent = boot.title;
      $('[data-bm-match-meta]').textContent = metaText(boot);
      $('[data-bm-match-price]').replaceChildren(...priceLine(boot, '').childNodes);
      $$('.bm-like-thumb').forEach((thumb) => thumb.setAttribute('aria-pressed', String(thumb.dataset.handle === boot.handle)));
      if (animated && !reduced()) {
        animate($('[data-bm-match-link]'), { opacity: [0.4, 1], transform: ['scale(0.97)', 'none'] }, { duration: 0.4, ease: EASE });
      }
    }

    function thumbs(row, list) {
      row.replaceChildren();
      list.forEach((boot) => {
        const button = el('button', 'bm-like-thumb');
        button.type = 'button';
        button.dataset.handle = boot.handle;
        button.setAttribute('aria-label', 'Show ' + boot.title);
        button.setAttribute('aria-pressed', 'false');
        const thumb = el('img');
        thumb.src = boot.image;
        thumb.alt = '';
        button.appendChild(thumb);
        button._boot = boot;
        row.appendChild(button);
      });
    }

    $('.bm-result').addEventListener('click', (event) => {
      const button = event.target.closest('.bm-like-thumb');
      if (button && button._boot) showInCard(button._boot, true);
    });

    function showMatch() {
      const match = bestMatch();
      if (!match) {
        go('silos');
        return;
      }
      thumbs($('[data-bm-likes]'), liked);
      $('[data-bm-likes-wrap]').hidden = liked.length === 0;
      showInCard(match, false);
      const won = superState();
      const win = $('[data-bm-superwin]');
      win.hidden = !(won.status === 'used' && won.url && CODE);
      if (!win.hidden) {
        $('[data-bm-superwin-img]').src = won.image || '';
        $('[data-bm-superwin-name]').textContent = won.title || '';
        $('[data-bm-superwin-deal]').textContent = rewardText() + ' off with code ' + CODE;
        const claim = $('[data-bm-superwin-claim]');
        claim.textContent = 'Claim';
        claim.href = '/discount/' + encodeURIComponent(CODE) + '?redirect=' + encodeURIComponent(won.url);
      }
      const save = $('[data-bm-save]');
      save.textContent = 'Save all to wishlist';
      save.onclick = null;

      go('match');
      if (!reduced()) {
        animate($('[data-bm-match-link]'), { transform: ['scale(0.85)', 'none'], opacity: [0, 1] }, { type: spring, visualDuration: 0.45, bounce: 0.35 });
      }
    }

    $('[data-bm-again]').addEventListener('click', () => {
      target = liked.length + 3;
      askedAt = swipes;
      askEl.hidden = true;
      go('play');
      fill();
    });

    $('[data-bm-save]').addEventListener('click', (event) => {
      const button = event.currentTarget;
      if (button.onclick) return;
      const wishlist = window.OceWishlist;
      if (!wishlist) {
        window.location.href = root.dataset.wishlistUrl;
        return;
      }
      liked
        .slice()
        .reverse()
        .forEach((boot) => wishlist.set(boot.handle, true));
      button.textContent = 'Saved ✓ View wishlist';
      button.onclick = () => {
        window.location.href = root.dataset.wishlistUrl;
      };
    });

    /* ---------- Opening and closing ---------- */
    let closing = false;

    // Fetch the boots as soon as the shopper reaches for the button, so they're ready on open
    const launch = $('[data-bm-open]');
    const warm = () => {
      if (!boots.length) load().then(refresh).catch(() => {});
    };
    ['pointerenter', 'touchstart', 'focus'].forEach((type) => launch.addEventListener(type, warm, { passive: true, once: true }));

    function lockPage(lock) {
      const html = document.documentElement;
      if (lock) {
        // Keep the page where it is: make up for the scrollbar that hiding overflow removes
        const bar = window.innerWidth - html.clientWidth;
        html.style.overflow = 'hidden';
        if (bar > 0) html.style.paddingRight = bar + 'px';
      } else {
        html.style.overflow = '';
        html.style.paddingRight = '';
      }
    }

    function open() {
      hideTip();
      if (dlg.open) return;
      // Everything is in place before the window shows, so nothing redraws while it moves
      if (screen !== 'play' && screen !== 'match') go('size', true);
      warm();
      if (!reduced()) {
        scrim.style.opacity = '0';
        panel.style.transform = desktop() ? 'translateY(16px) scale(0.92)' : 'translateY(calc(100% + 40px))';
        if (desktop()) panel.style.opacity = '0';
      }
      dlg.classList.remove('is-settled');
      dlg.showModal();
      lockPage(true);
      if (reduced()) {
        dlg.classList.add('is-settled');
        return;
      }
      // Start on the next frame, once the window is laid out, so the first frame isn't skipped
      opening = new Promise((resolve) => {
        requestAnimationFrame(() => {
          const moves = [
            animate(scrim, { opacity: [0, 1] }, { duration: 0.35, ease: 'linear' }),
            animate(
              panel,
              desktop() ? { opacity: [0, 1], transform: ['translateY(16px) scale(0.92)', 'none'] } : { transform: ['translateY(calc(100% + 40px))', 'none'] },
              { duration: 0.55, ease: EASE }
            ),
          ];
          Promise.all(moves.map((move) => move.finished)).then(() => {
            scrim.style.opacity = '';
            panel.style.transform = '';
            panel.style.opacity = '';
            dlg.classList.add('is-settled');
            opening = null;
            resolve();
          });
        });
      });
    }

    function close() {
      if (!dlg.open || closing) return;
      closing = true;
      const finish = () => {
        dlg.close();
        lockPage(false);
        closing = false;
        panel.style.transform = '';
        panel.style.opacity = '';
        scrim.style.opacity = '';
        $('[data-bm-open]').focus({ preventScroll: true });
      };
      if (reduced()) {
        finish();
        return;
      }
      dlg.classList.remove('is-settled');
      animate(scrim, { opacity: 0 }, { duration: 0.22 });
      animate(panel, desktop() ? { opacity: 0, transform: 'translateY(10px) scale(0.96)' } : { transform: 'translateY(calc(100% + 40px))' }, {
        duration: desktop() ? 0.2 : 0.28,
        ease: [0.4, 0, 1, 1],
      }).finished.then(() => {
        panel.getAnimations().forEach((animation) => animation.cancel());
        scrim.getAnimations().forEach((animation) => animation.cancel());
        finish();
      });
    }

    launch.addEventListener('click', open);

    /* ---------- The welcome, and the Super Like offer ---------- */
    const intro = $('[data-bm-intro]');
    const introScrim = $('[data-bm-intro-scrim]');
    const flame = $('[data-bm-intro-flame]');
    const introInput = $('[data-bm-intro-input]');
    const introError = $('[data-bm-intro-error]');
    let thenPlay = false;

    // Show a step; its lines rise in one after another (after `wait` seconds), or start hidden
    // when `held` (the welcome brings them in itself, once the flame has had the stage)
    function introStep(name, held) {
      $$('[data-bm-intro-step]').forEach((step) => {
        step.hidden = step.dataset.bmIntroStep !== name;
      });
      const step = $('[data-bm-intro-step="' + name + '"]');
      $('[data-bm-reward-text]').textContent = rewardShort();
      if (reduced()) return step;
      if (held) {
        Array.from(step.children).forEach((child) => {
          child.style.opacity = '0';
        });
      } else {
        animate(step.children, { opacity: [0, 1], transform: ['translateY(14px)', 'none'] }, { duration: 0.55, ease: EASE, delay: stagger(0.07) });
      }
      return step;
    }

    function showIntro(step, fromGame) {
      if (intro.open) return;
      thenPlay = !fromGame;
      hideTip();
      const stepEl = introStep(step, !fromGame);
      introError.textContent = '';
      intro.classList.remove('is-settled');
      flame.classList.remove('is-alive');
      intro.showModal();
      lockPage(true);
      if (reduced()) {
        intro.classList.add('is-settled');
        flame.classList.add('is-alive');
        return;
      }
      introScrim.style.opacity = '0';
      flame.style.opacity = '0';
      requestAnimationFrame(() => {
        // The page darkens, then blurs
        animate(introScrim, { opacity: [0, 1] }, { duration: fromGame ? 0.3 : 0.6, ease: 'linear' }).finished.then(() => {
          introScrim.style.opacity = '';
          intro.classList.add('is-settled');
        });

        if (fromGame) {
          animate(
            flame,
            { opacity: [0, 1], transform: ['translateY(40px) scale(0.2) rotate(-12deg)', 'none'] },
            { type: spring, visualDuration: 0.6, bounce: 0.45, delay: 0.05 }
          ).finished.then(() => {
            flame.style.opacity = '';
            flame.classList.add('is-alive');
          });
          return;
        }

        // The welcome: the flame takes centre stage, big and alive, then zooms out a little to its
        // place above the words, which rise in as it settles
        const box = flame.getBoundingClientRect();
        const dy = window.innerHeight / 2 - (box.top + box.height / 2);
        const big = Math.max(1.2, Math.min(1.9, (window.innerHeight * 0.38) / box.height));
        const centre = 'translateY(' + dy + 'px) scale(' + big + ')';
        flame.style.transform = centre;
        const POP = 0.35;
        const HOLD = 1.0;
        animate(
          flame,
          { opacity: [0, 1], transform: ['translateY(' + dy + 'px) scale(0.3) rotate(-14deg)', centre] },
          { type: spring, visualDuration: 0.7, bounce: 0.4, delay: POP }
        ).finished.then(() => {
          flame.style.opacity = '';
          flame.classList.add('is-alive');
          animate(flame, { transform: [centre, 'none'] }, { duration: 0.8, ease: EASE, delay: HOLD }).finished.then(() => {
            flame.style.transform = '';
          });
          animate(
            stepEl.children,
            { opacity: [0, 1], transform: ['translateY(18px)', 'none'] },
            { duration: 0.55, ease: EASE, delay: stagger(0.08, { startDelay: HOLD + 0.35 }) }
          );
        });
      });
    }

    function hideIntro() {
      if (!intro.open) return Promise.resolve();
      store.set('oce-bm-intro', '1');
      const finish = () => {
        intro.close();
        if (!dlg.open) lockPage(false);
        flame.classList.remove('is-alive');
      };
      if (reduced()) {
        finish();
        return Promise.resolve();
      }
      intro.classList.remove('is-settled');
      return animate(intro, { opacity: [1, 0] }, { duration: 0.25 }).finished.then(() => {
        intro.getAnimations().forEach((animation) => animation.cancel());
        finish();
      });
    }

    // From the game's star: the offer over the game
    function offer() {
      showIntro(superState().status === 'ready' ? 'done' : 'offer', true);
    }

    function play() {
      hideIntro().then(() => {
        if (!dlg.open) open();
      });
    }

    $$('[data-bm-intro-close]').forEach((button) => button.addEventListener('click', () => hideIntro()));
    intro.addEventListener('cancel', (event) => {
      event.preventDefault();
      hideIntro();
    });
    $('[data-bm-intro-play]').addEventListener('click', () => {
      if (superState().status) play();
      else introStep('offer');
    });
    $('[data-bm-intro-skip]').addEventListener('click', () => (thenPlay ? play() : hideIntro()));

    // Email: joins the store's customers (marketing consent, tagged); mobile: sent to the store.
    // Through Shopify's own forms, so its spam protection runs, into a hidden frame.
    function signUp(value) {
      const isEmail = value.includes('@');
      const form = document.getElementById(isEmail ? 'bm-signup-email' : 'bm-signup-phone');
      if (!form) return Promise.resolve(false);
      if (isEmail) {
        form.querySelector('[name="contact[email]"]').value = value;
      } else {
        form.querySelector('[name="contact[phone]"]').value = value;
        form.querySelector('[name="contact[body]"]').value =
          'Boot Match Super Like sign-up by mobile: ' + value + '. Happy to hear from OCEBOOTS by text.';
      }
      form.target = 'bm-signup-sink';
      const sink = root.querySelector('iframe[name="bm-signup-sink"]');
      return new Promise((resolve) => {
        const timer = setTimeout(() => resolve(false), 5000);
        sink.addEventListener(
          'load',
          () => {
            clearTimeout(timer);
            let ok = true;
            try {
              ok = !/challenge/.test(sink.contentWindow.location.href);
            } catch (e) {
              /* another origin: assume it went through */
            }
            resolve(ok);
          },
          { once: true }
        );
        if (form.requestSubmit) form.requestSubmit();
        else form.submit();
      });
    }

    $('[data-bm-intro-step="offer"]').addEventListener('submit', async (event) => {
      event.preventDefault();
      const value = introInput.value.trim();
      const isEmail = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value);
      const isPhone = /^\+?[\d\s().-]{8,}$/.test(value) && value.replace(/\D/g, '').length >= 8;
      if (!isEmail && !isPhone) {
        introError.textContent = 'Enter an email address or a mobile number.';
        introInput.focus();
        return;
      }
      introError.textContent = '';
      const submit = $('[data-bm-intro-submit]');
      submit.disabled = true;
      submit.textContent = 'One moment…';
      // Sent in the background (the hidden frame finishes it); the shopper moves straight on
      signUp(value);
      setSuper({ status: 'ready' });
      submit.disabled = false;
      submit.textContent = 'Get my Super Like';
      introStep('done');
      setTimeout(() => (thenPlay ? play() : hideIntro()), 1400);
    });

    paintSuper();

    // First visit (or ?bm-intro): the welcome as the page comes in
    const forced = /[?&]bm-intro\b/.test(window.location.search);
    if (forced || (root.dataset.intro === 'true' && !store.get('oce-bm-intro'))) {
      store.set('oce-bm-tip', '1');
      requestAnimationFrame(() => showIntro('hello', false));
    }
    $$('[data-bm-close]').forEach((button) => button.addEventListener('click', close));
    dlg.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });
  }
</script>

