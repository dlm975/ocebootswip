{%- comment -%}
  Top of the search results page: "You searched for", the search term, and the same category
  suggestions the full-screen search shows (assets/search-suggestions.js), above the product cards.

  Suggestions shown in the search as it was typed are remembered for the visit and appear at
  once; otherwise (a shared link, a search from elsewhere) they're fetched and ease open.
{%- endcomment -%}

{%- liquid
  assign term = search.terms | strip
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }}">
  <div
    class="search-summary spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- if search.performed and term != blank -%}
      <p class="search-summary__label">You searched for</p>
      <h1 class="search-summary__term">{{ term | escape }}</h1>
      <p class="search-summary__count">
        {{- search.results_count }}
        {{ search.results_count | pluralize: 'result', 'results' -}}
      </p>
      <nav
        class="search-summary__suggest"
        aria-label="Suggested categories"
        data-search-summary-suggest
        data-term="{{ term | escape }}"
        data-suggest-url="{{ routes.predictive_search_url }}"
        data-search-url="{{ routes.search_url }}"
        hidden
      >
        <ul
          class="search-summary__list"
          role="list"
        ></ul>
      </nav>
    {%- else -%}
      <h1 class="search-summary__term">Search</h1>
      <button
        type="button"
        class="search-summary__open"
        onclick="window.customSearchOpen && window.customSearchOpen()"
      >
        Search boots, brands and models
      </button>
    {%- endif -%}
  </div>
</div>

{%- if search.performed and term != blank -%}
  {% render 'search-catalog', id: 'search-summary-catalog' %}
  <script src="{{ 'search-suggestions.js' | asset_url }}"></script>
  <script>
    (function () {
      const box = document.querySelector('[data-search-summary-suggest]');
      const api = window.OceSearchSuggest;
      if (!box || !api) return;
      const list = box.querySelector('ul');
      const term = box.dataset.term;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /** @param {{ text: string, url: string }[]} suggestions */
      function render(suggestions) {
        const shown = suggestions
          .filter(function (suggestion) {
            // The search itself isn't suggested back
            return suggestion.text.trim().toLowerCase() !== term.trim().toLowerCase();
          })
          .slice(0, 4);
        if (!shown.length) return false;
        list.replaceChildren();
        shown.forEach(function (suggestion) {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.className = 'search-summary__link';
          link.href = suggestion.url;
          link.textContent = suggestion.text;
          item.append(link);
          list.append(item);
        });
        box.hidden = false;
        return true;
      }

      // Shown in the search as it was typed: straight away, before the products below are drawn
      const remembered = api.recall(term);
      if (remembered && render(remembered)) return;

      const catalog = api.readCatalog('search-summary-catalog');
      api
        .fetchResults(term, box.dataset.suggestUrl)
        .then(function (data) {
          const suggestions = api.build(term, data.titles, 5).map(function (suggestion) {
            return { text: suggestion.text, url: api.url(suggestion.text, catalog, box.dataset.searchUrl) };
          });
          api.remember(term, suggestions);
          if (!render(suggestions) || reducedMotion) return;
          // Ease open, so the products below glide down rather than jump
          const height = box.getBoundingClientRect().height;
          box.style.overflow = 'hidden';
          const animation = box.animate(
            [
              { height: '0px', opacity: 0 },
              { height: height + 'px', opacity: 1 },
            ],
            { duration: 550, easing: 'cubic-bezier(0.3, 0.7, 0.3, 1)' }
          );
          const done = function () {
            box.style.removeProperty('overflow');
          };
          animation.finished.then(done, done);
        })
        .catch(function () {
          /* no suggestions: the results are still there */
        });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .search-summary {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .search-summary__label {
    margin: 0 0 8px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .search-summary__term {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 750;
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-variation-settings: 'opsz' 32;
    overflow-wrap: anywhere;
  }

  .search-summary__count {
    margin: 12px 0 0;
    font-size: 0.875rem;
    color: rgb(var(--color-foreground-rgb) / 0.55);
    font-variant-numeric: tabular-nums;
  }

  .search-summary__suggest[hidden] {
    display: none;
  }

  .search-summary__list {
    margin: 0;
    padding: 20px 0 0;
    list-style: none;
  }

  /* Same as the suggestions in the full-screen search */
  .search-summary__link {
    display: inline-block;
    padding-block: 6px;
    color: var(--color-foreground);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-variation-settings: 'opsz' 32;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  @media screen and (min-width: 750px) {
    .search-summary__link {
      font-size: 1.75rem;
    }
  }

  .search-summary__link:is(:hover, :focus-visible) {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .search-summary__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .search-summary__open {
    margin-top: 16px;
    padding: 0 0 6px;
    border: 0;
    border-bottom: 2px solid currentColor;
    background: none;
    color: rgb(var(--color-foreground-rgb) / 0.55);
    font: inherit;
    font-size: 1.25rem;
    cursor: pointer;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search summary",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
