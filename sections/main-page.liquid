

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section page-width-content color-{{ section.settings.color_scheme }} page-article">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  /*
    Store pages (about, FAQ, guides, policies, sell your boots): one clear type scale. A big bold title,
    section headings a step down, questions a step below that, and comfortable reading text; tables,
    lists and links styled to match the site.
  */
  :root .page-article {
    --pa-text: rgb(18 18 18 / 0.78);
    --pa-line: #e4e4e7;
  }

  :root .page-article h1 {
    margin: 0 0 18px;
    color: #121212;
    font-size: clamp(2rem, 8vw, 3.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  :root .page-article .rte {
    color: var(--pa-text);
    font-size: 1rem;
    line-height: 1.65;
  }

  /* The opening paragraph (the direct answer) reads a size up */
  :root .page-article .rte > p:first-child {
    color: #121212;
    font-size: 1.125rem;
    line-height: 1.55;
  }

  :root .page-article .rte p {
    margin: 0 0 14px;
  }

  :root .page-article .rte h2 {
    margin: 36px 0 12px;
    padding-top: 22px;
    border-top: 1px solid var(--pa-line);
    color: #121212;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  :root .page-article .rte h3 {
    margin: 22px 0 6px;
    color: #121212;
    font-size: 1.0625rem;
    font-weight: 750;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  :root .page-article .rte h2 + h3 {
    margin-top: 10px;
  }

  :root .page-article .rte strong {
    color: #121212;
    font-weight: 700;
  }

  :root .page-article .rte a {
    color: #121212;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  :root .page-article .rte ul,
  :root .page-article .rte ol {
    margin: 0 0 16px;
    padding-left: 1.25em;
  }

  :root .page-article .rte li {
    margin: 0 0 8px;
    padding-left: 2px;
  }

  :root .page-article .rte li::marker {
    color: rgb(18 18 18 / 0.4);
  }

  /* Tables: the size charts and comparisons. Wider than the screen on phones? They scroll sideways
     on their own rather than squashing */
  :root .page-article .rte table {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 6px 0 20px;
    overflow-x: auto;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--pa-line);
    border-radius: 14px;
    font-size: 0.9375rem;
    line-height: 1.4;
    -webkit-overflow-scrolling: touch;
  }

  :root .page-article .rte table thead,
  :root .page-article .rte table tbody {
    display: table;
    width: 100%;
    table-layout: fixed;
  }

  :root .page-article .rte th,
  :root .page-article .rte td {
    padding: 10px 14px;
    border: 0;
    border-bottom: 1px solid var(--pa-line);
    text-align: left;
    vertical-align: top;
  }

  :root .page-article .rte th {
    background: #f4f4f5;
    color: #121212;
    font-size: 0.8125rem;
    font-weight: 750;
    letter-spacing: 0.01em;
  }

  :root .page-article .rte tbody tr:last-child td {
    border-bottom: 0;
  }

  :root .page-article .rte tbody td:first-child {
    color: #121212;
    font-weight: 650;
  }

  /* The Instagram message link: a clear button */
  :root .page-article .rte a[href^="https://ig.me/"] {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    background: #121212;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
  }

  :root .page-article .rte a[href^="https://ig.me/"] strong {
    color: inherit;
  }

  @media screen and (min-width: 750px) {
    :root .page-article .rte {
      font-size: 1.0625rem;
    }

    :root .page-article .rte > p:first-child {
      font-size: 1.25rem;
    }

    :root .page-article .rte h2 {
      font-size: 1.75rem;
    }

    :root .page-article .rte h3 {
      font-size: 1.125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
